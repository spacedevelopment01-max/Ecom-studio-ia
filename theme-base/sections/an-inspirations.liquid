{%- comment -%}
  ATELIER NUANCE : inspirations (planche 03). Filtres Toutes / Coupe / Couleur / Soin qui filtrent réellement les
  groupes, trois photos par catégorie, lien « Voir plus » et visionneuse accessible (titre et texte éditables,
  précédent / suivant, Échap, clavier, retour du focus). Scènes de démonstration, jamais présentées comme des
  réalisations d'un vrai salon.
  Blocs : « Catégorie » (titre, texte, lien), suivi de ses « Photo ».
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="an-section an-inspi" data-an-filter-root data-an-lightbox-root>
  <div class="an-wrap">
    {%- if s.show_filters -%}
      <div class="an-tabs an-tabs--plain" role="group" aria-label="{{ s.filters_label | escape }}">
        <button type="button" class="an-tabs__btn" aria-pressed="true" data-an-filter="all">{{ s.all_label }}</button>
        {%- for block in section.blocks -%}{%- if block.type == 'group' -%}<button type="button" class="an-tabs__btn" aria-pressed="false" data-an-filter="{{ block.settings.key }}">{{ block.settings.tab_label | default: block.settings.heading }}</button>{%- endif -%}{%- endfor -%}
      </div>
    {%- endif -%}
    {%- for group in section.blocks -%}
      {%- if group.type != 'group' -%}{%- continue -%}{%- endif -%}
      {%- assign g = group.settings -%}
      <div class="an-inspi__group" data-an-cat="{{ g.key }}" {{ group.shopify_attributes }}>
        <div class="an-inspi__head">
          <div>
            <h2 class="an-title an-title--md">{{ g.heading }}</h2>
            {%- if g.text != blank -%}<p class="an-inspi__text">{{ g.text | escape | newline_to_br }}</p>{%- endif -%}
          </div>
          {%- if g.link_label != blank -%}<a class="an-link" href="{{ g.link | default: '/pages/prestations' }}">{{ g.link_label }}{% render 'an-icon', name: 'arrow' %}</a>{%- endif -%}
        </div>
        <ul class="an-inspi__grid" role="list">
          {%- for block in section.blocks offset: forloop.index -%}
            {%- if block.type == 'group' -%}{%- break -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li {{ block.shopify_attributes }}>
              <button type="button" class="an-inspi__photo" data-an-open data-title="{{ b.title | escape }}" data-text="{{ b.text | escape }}">
                {% render 'an-img', image: b.image, asset: b.image_asset, alt: b.title, pos: b.image_position %}
                <span class="visually-hidden">{{ s.open_label }} : {{ b.title }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
  <div class="an-lightbox" role="dialog" aria-modal="true" aria-label="{{ s.viewer_label | escape }}" data-an-lightbox hidden>
    <div class="an-lightbox__panel">
      <button type="button" class="an-lightbox__close" data-an-lb-close aria-label="{{ s.close_label | escape }}">{% render 'an-icon', name: 'close' %}</button>
      <figure>
        <img alt="" data-an-lb-img width="1536" height="1024">
        <figcaption><strong data-an-lb-title></strong><span data-an-lb-text></span><span class="an-lightbox__count" data-an-lb-count></span></figcaption>
      </figure>
      <button type="button" class="an-lightbox__nav an-lightbox__nav--prev" data-an-lb-prev aria-label="{{ s.prev_label | escape }}">{% render 'an-icon', name: 'prev' %}</button>
      <button type="button" class="an-lightbox__nav an-lightbox__nav--next" data-an-lb-next aria-label="{{ s.next_label | escape }}">{% render 'an-icon', name: 'next' %}</button>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Inspirations du salon",
  "class": "an-inspi-section",
  "max_blocks": 40,
  "settings": [
    { "type": "checkbox", "id": "show_filters", "label": "Afficher les filtres", "default": true },
    { "type": "text", "id": "filters_label", "label": "Nom du groupe de filtres (lecteurs d'écran)", "default": "Filtrer les inspirations" },
    { "type": "text", "id": "all_label", "label": "Filtre « toutes »", "default": "Toutes" },
    { "type": "text", "id": "open_label", "label": "Ouvrir une photo (lecteurs d'écran)", "default": "Agrandir" },
    { "type": "text", "id": "viewer_label", "label": "Nom de la visionneuse", "default": "Visionneuse des inspirations" },
    { "type": "text", "id": "close_label", "label": "Bouton fermer", "default": "Fermer" },
    { "type": "text", "id": "prev_label", "label": "Bouton précédent (lecteurs d'écran)", "default": "Photo précédente" },
    { "type": "text", "id": "next_label", "label": "Bouton suivant (lecteurs d'écran)", "default": "Photo suivante" }
  ],
  "blocks": [
    {
      "type": "group", "name": "Catégorie",
      "settings": [
        { "type": "select", "id": "key", "label": "Catégorie", "default": "coupe", "options": [{ "value": "coupe", "label": "Coupe" }, { "value": "couleur", "label": "Couleur" }, { "value": "coiffage", "label": "Coiffage" }, { "value": "soin", "label": "Soin" }] },
        { "type": "text", "id": "tab_label", "label": "Nom du filtre" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Coupe" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Voir plus" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    },
    {
      "type": "photo", "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Inspiration" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Inspirations du salon" }]
}
{% endschema %}
