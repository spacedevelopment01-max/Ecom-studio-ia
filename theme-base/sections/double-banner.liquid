{%- comment -%}
  Double bannière premium : deux grandes bannières côte à côte (empilées sur mobile), image ou vidéo,
  titre, texte et bouton ; zoom doux au survol ; toute la bannière est cliquable (lien du bouton).
{%- endcomment -%}
<section class="es-section es-dbl es-dbl--{{ section.settings.layout }} es-dbl--{{ section.settings.text_position }}{% if section.settings.hover_zoom %} es-dbl--zoom{% endif %}{% if section.settings.full_width %} es-dbl--full{% endif %} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --dbl-gap: {{ section.settings.gap }}px; --overlay: {{ section.settings.overlay | divided_by: 100.0 }};" data-es-autoplay-media>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="es-container">
      <header class="es-section-head">
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
      </header>
    </div>
  {%- endif -%}
  <div class="es-dbl__wrap{% unless section.settings.full_width %} es-container{% endunless %}">
    <div class="es-dbl__grid">
      {%- for block in section.blocks limit: 2 -%}
        {%- assign link = block.settings.link | default: routes.all_products_collection_url -%}
        <article class="es-dbl__item es-dbl__item--{{ section.settings.ratio }}" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="es-dbl__media">
            {% render 'es-section-media', image: block.settings.image, asset: block.settings.image_asset, video: block.settings.video, video_asset: block.settings.video_asset, alt: block.settings.image_alt, sizes: '(min-width: 750px) 50vw, 100vw' %}
          </div>
          <div class="es-dbl__body">
            {%- if block.settings.eyebrow != blank -%}<p class="es-eyebrow es-dbl__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h3 class="es-heading es-dbl__title">{{ block.settings.heading }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="es-rte es-dbl__text">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ link }}" class="es-dbl__link es-button{% if block.settings.button_style == 'secondary' %} es-button--secondary{% endif %}">{{ block.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.es-dbl__grid { display: grid; gap: var(--dbl-gap, 16px); }
@media (min-width: 750px) {
  .es-dbl__grid { grid-template-columns: 1fr 1fr; }
  .es-dbl--wide-left .es-dbl__grid { grid-template-columns: 1.45fr 1fr; }
  .es-dbl--wide-right .es-dbl__grid { grid-template-columns: 1fr 1.45fr; }
}
.es-dbl__item { position: relative; overflow: hidden; border-radius: var(--radius-card); background: var(--c-surface); display: flex; flex-direction: column; isolation: isolate; }
.es-dbl--full .es-dbl__item { border-radius: 0; }
.es-dbl__media { position: relative; overflow: hidden; aspect-ratio: 4 / 5; }
.es-dbl__item--square .es-dbl__media { aspect-ratio: 1; }
.es-dbl__item--landscape .es-dbl__media { aspect-ratio: 3 / 2; }
.es-dbl__item--tall .es-dbl__media { aspect-ratio: 2 / 3; }
@media (min-width: 750px) { .es-dbl--wide-left .es-dbl__media, .es-dbl--wide-right .es-dbl__media { aspect-ratio: auto; height: 100%; min-height: clamp(420px, 48vw, 760px); } }
.es-dbl__media > * { position: absolute; inset: 0; }
.es-dbl__media img, .es-dbl__media video { transition: transform 1.2s var(--ease-out); }
.es-dbl--zoom .es-dbl__item:hover .es-dbl__media img, .es-dbl--zoom .es-dbl__item:hover .es-dbl__media video, .es-dbl--zoom .es-dbl__item:focus-within .es-dbl__media img { transform: scale(1.06); }
.es-dbl__media .es-smedia__video { opacity: 0; transition: opacity .8s ease, transform 1.2s var(--ease-out); }
.es-dbl__media .es-smedia__video.is-playing, .es-dbl__media .es-smedia__video:only-child { opacity: 1; }
.es-dbl__body { position: relative; z-index: 2; padding: clamp(20px, 3vw, 36px); }
.es-dbl__title { font-size: calc(clamp(1.6rem, 3vw, 2.6rem) * var(--heading-scale)); margin-bottom: .3em; color: inherit; }
.es-dbl__text { max-width: 46ch; opacity: .88; margin-bottom: 1.2rem; }
.es-dbl__link::before { content: ""; position: absolute; inset: 0; z-index: 1; }
.es-dbl__item:has(.es-dbl__link) { cursor: pointer; }
/* Texte sur l'image */
.es-dbl--overlay .es-dbl__item { color: #fff; }
.es-dbl--overlay .es-dbl__media { flex: 1; }
.es-dbl--overlay .es-dbl__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0, calc(var(--overlay) + .25))), rgba(0,0,0, calc(var(--overlay) * .35)); }
.es-dbl--overlay .es-dbl__body { position: absolute; left: 0; right: 0; bottom: 0; }
.es-dbl--overlay-center .es-dbl__item { color: #fff; }
.es-dbl--overlay-center .es-dbl__media::after { content: ""; position: absolute; inset: 0; background: rgba(0,0,0, calc(var(--overlay) + .1)); }
.es-dbl--overlay-center .es-dbl__body { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.es-dbl--overlay-center .es-dbl__text { margin-inline: auto; }
.es-dbl--overlay .es-eyebrow, .es-dbl--overlay-center .es-eyebrow { color: inherit; opacity: .85; }
.es-dbl--overlay .es-button--secondary, .es-dbl--overlay-center .es-button--secondary { --b-fg: #fff; }
/* Texte sous l'image */
.es-dbl--below .es-dbl__item { background: transparent; border-radius: 0; overflow: visible; }
.es-dbl--below .es-dbl__media { border-radius: var(--radius-card); }
.es-dbl--below .es-dbl__body { padding-inline: 0; }
@media (prefers-reduced-motion: reduce) { .es-dbl__media img, .es-dbl__media video { transition: none !important; transform: none !important; } }
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.EsVisibleMedia) return;
  window.EsVisibleMedia = true;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || (window.themeSettings && window.themeSettings.motion === false);
  function init(ctx) {
    if (reduce || !('IntersectionObserver' in window)) return;
    Array.prototype.forEach.call((ctx || document).querySelectorAll('[data-es-autoplay-media] .es-smedia__video'), function (v) {
      if (v._esObs) return;
      v._esObs = new IntersectionObserver(function (es) {
        if (es[0].isIntersecting) { var p = v.play(); v.classList.add('is-playing'); if (p && p.catch) p.catch(function () { v.classList.remove('is-playing'); }); }
        else v.pause();
      }, { threshold: 0.1 });
      v._esObs.observe(v);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); }); else init();
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Double bannière premium",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "select", "id": "layout", "label": "Répartition", "default": "equal", "options": [ { "value": "equal", "label": "Deux moitiés égales" }, { "value": "wide-left", "label": "Plus large à gauche" }, { "value": "wide-right", "label": "Plus large à droite" } ] },
    { "type": "select", "id": "ratio", "label": "Format des bannières", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait (4:5)" }, { "value": "tall", "label": "Haut (2:3)" }, { "value": "square", "label": "Carré" }, { "value": "landscape", "label": "Paysage (3:2)" } ] },
    { "type": "select", "id": "text_position", "label": "Position du texte", "default": "overlay", "options": [ { "value": "overlay", "label": "Sur l'image, en bas" }, { "value": "overlay-center", "label": "Sur l'image, au centre" }, { "value": "below", "label": "Sous l'image" } ] },
    { "type": "range", "id": "overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "label": "Voile sur l'image", "default": 15 },
    { "type": "checkbox", "id": "hover_zoom", "label": "Zoom doux au survol", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": false },
    { "type": "range", "id": "gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Espace entre les bannières", "default": 16 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 64 }
  ],
  "blocks": [
    { "type": "banner", "name": "Bannière", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (ou affiche de la vidéo)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "image_alt", "label": "Description de l'image (accessibilité)" },
      { "type": "video", "id": "video", "label": "Vidéo (hébergée par Shopify)" },
      { "type": "text", "id": "video_asset", "label": "Vidéo fournie avec le thème (MP4)" },
      { "type": "text", "id": "eyebrow", "label": "Surtitre" },
      { "type": "text", "id": "heading", "label": "Titre", "default": "Un univers à découvrir" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>[À compléter : une phrase vraie sur cette sélection.]</p>" },
      { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir" },
      { "type": "url", "id": "link", "label": "Lien" },
      { "type": "select", "id": "button_style", "label": "Style du bouton", "default": "primary", "options": [ { "value": "primary", "label": "Plein" }, { "value": "secondary", "label": "Contour" } ] }
    ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Double bannière premium", "blocks": [
    { "type": "banner" },
    { "type": "banner", "settings": { "heading": "Une seconde sélection", "button_style": "secondary" } }
  ] }]
}
{% endschema %}
