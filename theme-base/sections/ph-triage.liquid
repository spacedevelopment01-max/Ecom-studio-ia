{%- comment -%}
  PHASE : « Préparer votre demande » au téléphone (dépannage, planche 07) — petit questionnaire : localisation (ville ou
  commune) et symptômes observés (cases à cocher, un bloc par symptôme), puis bouton « Décrire le problème » qui ouvre le
  formulaire de demande en y reprenant ces réponses (rien n'est envoyé depuis cette section). Encadré gris dessous
  (pictogramme, titre, texte) : aucune disponibilité ni délai n'est promis par le thème.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ph_id = 'ph-tri-' | append: section.id
-%}
<section class="ph ph-triage ph-pad{% if s.show == 'desktop' %} ph-only-d{% elsif s.show == 'mobile' %} ph-only-m{% endif %}" style="--ph-ts-m: {{ s.title_size_mobile }}; --ph-pad-t: {{ s.pad_top }}; --ph-pad-b: {{ s.pad_bottom }}; --ph-pad-t-m: {{ s.pad_top_mobile }}; --ph-pad-b-m: {{ s.pad_bottom_mobile }};">
  <div class="ph-c">
    {%- if s.eyebrow != blank -%}<p class="ph-eyebrow ph-triage__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}{% render 'ph-title', text: s.heading, tag: 'h2', class: 'ph-triage__title' %}{%- endif -%}
    <form class="ph-triage__form" action="{{ s.form_link | default: routes.root_url }}" method="get" data-ph-triage>
      <label class="ph-triage__label" for="{{ ph_id }}-lieu">{{ s.place_label }}</label>
      <div class="ph-triage__field">
        {% render 'ph-icon', name: 'lieu-repere', class: 'ph-triage__pin', stroke: 1.8 %}
        <input class="ph-triage__input" id="{{ ph_id }}-lieu" name="commune" type="text" autocomplete="address-level2" placeholder="{{ s.place_placeholder | escape }}">
      </div>
      <fieldset class="ph-triage__set">
        <legend class="ph-triage__label">{{ s.symptoms_label }}</legend>
        {%- for b in section.blocks -%}
          <label class="ph-triage__check" {{ b.shopify_attributes }}>
            <input type="checkbox" name="symptome" value="{{ b.settings.label | escape }}">
            <span class="ph-triage__box" aria-hidden="true">{% render 'ph-icon', name: 'coche', stroke: 2.6 %}</span>
            <span>{{ b.settings.label }}</span>
          </label>
        {%- endfor -%}
      </fieldset>
      <input type="hidden" name="motif" value="{{ s.symptoms_label | escape }}">
      <button class="ph-btn ph-btn--yellow ph-triage__btn" type="submit"><span>{{ s.button_label }}</span>{% render 'ph-icon', name: 'fleche-droite', stroke: 2.4 %}</button>
    </form>
    {%- if s.box_title != blank -%}
      <aside class="ph-triage__info">
        {%- if s.box_icon != blank -%}<span class="ph-triage__info-icon" aria-hidden="true">{% render 'ph-icon', name: s.box_icon, stroke: 1.8 %}</span>{%- endif -%}
        <h3 class="ph-triage__info-title">{{ s.box_title }}</h3>
        {%- if s.box_text != blank -%}<p class="ph-triage__info-text">{{ s.box_text | newline_to_br }}</p>{%- endif -%}
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Questionnaire de dépannage",
  "class": "ph-section",
  "settings": [
    { "type": "select", "id": "show", "label": "Affichage", "default": "all", "options": [{ "value": "all", "label": "Ordinateur et téléphone" }, { "value": "desktop", "label": "Ordinateur seulement" }, { "value": "mobile", "label": "Téléphone seulement" }] },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Préparer votre demande" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Quelques informations pour mieux\ncomprendre votre situation." },
    { "type": "range", "id": "title_size_mobile", "label": "Taille du titre (téléphone, repère 390 px)", "min": 16, "max": 48, "step": 0.5, "default": 22 },
    { "type": "text", "id": "place_label", "label": "Libellé de la localisation", "default": "Votre localisation" },
    { "type": "text", "id": "place_placeholder", "label": "Exemple dans le champ", "default": "Votre ville ou commune" },
    { "type": "text", "id": "symptoms_label", "label": "Libellé des symptômes", "default": "Symptômes observés" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Décrire le problème" },
    { "type": "url", "id": "form_link", "label": "Page du formulaire de demande", "info": "Les réponses y sont reprises ; rien n'est envoyé depuis cette section." },
    { "type": "header", "content": "Encadré" },
    { "type": "text", "id": "box_icon", "label": "Pictogramme (nom)", "default": "bulle" },
    { "type": "text", "id": "box_title", "label": "Titre de l'encadré", "default": "Disponibilités à confirmer" },
    { "type": "textarea", "id": "box_text", "label": "Texte de l'encadré" },
    { "type": "range", "id": "pad_top", "label": "Marge haute (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 40 },
    { "type": "range", "id": "pad_top_mobile", "label": "Marge haute (téléphone)", "min": 0, "max": 100, "step": 1, "default": 24 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Marge basse (téléphone)", "min": 0, "max": 100, "step": 1, "default": 32 }
  ],
  "blocks": [
    { "type": "symptom", "name": "Symptôme", "settings": [
      { "type": "text", "id": "label", "label": "Symptôme" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Questionnaire de dépannage" }]
}
{% endschema %}
