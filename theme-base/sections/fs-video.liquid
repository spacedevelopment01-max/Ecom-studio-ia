{%- comment -%}
Démonstration vidéo (boutique spécialisée) : grand lecteur, vidéo et points clés, ou vidéo verticale.
  Vidéo de la bibliothèque, fichier du thème ou adresse directe ; affiche facultative ; lecture automatique muette en
  boucle seulement si demandée (et jamais avec « réduire les animations »). Sans vidéo : l'aperçu du studio signale le
  média attendu, la boutique publiée n'affiche pas de lecteur vide.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-video fs-video--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
{%- liquid
  assign v_src = ''
  assign v_poster = ''
  if s.video != blank
    for source in s.video.sources
      if source.mime_type == 'video/mp4'
        assign v_src = source.url
      endif
    endfor
    assign v_poster = s.video.preview_image | image_url: width: 1600
  elsif s.video_asset != blank
    assign v_src = s.video_asset | asset_url
  elsif s.video_url != blank
    assign v_src = s.video_url
  endif
  if s.poster != blank
    assign v_poster = s.poster | image_url: width: 1600
  elsif s.poster_asset != blank
    assign v_poster = s.poster_asset | asset_url
  endif
-%}
    <div class="fs-video__grid">
      <figure class="fs-video__frame fs-ratio--{{ s.ratio | replace: '/', '-' }}"{% render 'fs-reveal', effect: fx %}>
        {%- if v_src != blank -%}
          <video class="fs-video__el" src="{{ v_src }}"{% if v_poster != blank %} poster="{{ v_poster }}"{% endif %} playsinline preload="metadata"{% if s.controls %} controls{% endif %}{% if s.autoplay %} muted loop data-fs-autoplay{% endif %} aria-label="{{ s.heading | default: s.caption | escape }}"></video>
        {%- elsif v_poster != blank -%}
          <img class="fs-video__poster" src="{{ v_poster }}" alt="{{ s.caption | escape }}" loading="lazy" width="1600" height="900">
        {%- elsif request.host == 'apercu' -%}
          <div class="ed-media ed-media--pending" role="img" aria-label="{{ s.media_role | default: 'Vidéo de démonstration' | escape }}"><p>{{ 'editorial.pending_media' | t }}<span>{{ s.media_role | default: 'Vidéo de démonstration' | escape }}</span></p></div>
        {%- endif -%}
        {%- if s.caption != blank -%}<figcaption class="fs-caption">{{ s.caption | escape }}</figcaption>{%- endif -%}
      </figure>
      {%- if section.blocks.size > 0 -%}
        <ol class="fs-video__points" role="list">
          {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
            <li class="fs-video__point"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
              {%- if block.settings.time != blank -%}<span class="fs-chip">{{ block.settings.time | escape }}</span>{%- endif -%}
              <strong class="fs-item__title">{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank -%}<div class="fs-item__text">{{ block.settings.text }}</div>{%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Démonstration vidéo",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "wide",
          "label": "Grand lecteur"
        },
        {
          "value": "split",
          "label": "Vidéo et points clés"
        },
        {
          "value": "vertical",
          "label": "Vidéo verticale"
        }
      ],
      "default": "wide"
    },
    {
      "type": "header",
      "content": "Vidéo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo de la bibliothèque"
    },
    {
      "type": "text",
      "id": "video_asset",
      "label": "Fichier vidéo du projet"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Adresse directe de la vidéo (MP4)"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Affiche"
    },
    {
      "type": "text",
      "id": "poster_asset",
      "label": "Fichier d'affiche du projet"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format",
      "options": [
        {
          "value": "16/9",
          "label": "Paysage 16:9"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        },
        {
          "value": "9/16",
          "label": "Vertical 9:16"
        },
        {
          "value": "1/1",
          "label": "Carré"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Afficher les commandes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Lecture automatique muette en boucle",
      "default": false
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Média attendu (aperçu du studio)"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point clé",
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Moment (ex. 0:12)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Démonstration vidéo",
      "settings": {
        "layout": "wide"
      }
    }
  ],
  "max_blocks": 6
}
{% endschema %}
