{%- comment -%}
  PARENTHÈSE : cartes de la page « Les séances individuelles » (planche 01).
  - modes : « Deux façons de vous accompagner » : photo, titre, texte, bouton vert (Au cabinet, En visioconférence) ;
  - pricing : « Les séances » : titre, texte, tarif indicatif et durée suivis des « Réglages du cabinet », bouton large.
  Blocs : « Carte ».
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="pa-section pa-cards pa-cards--{{ s.layout }}">
  <div class="pa-wrap">
    {%- if s.heading != blank -%}
      <div class="pa-cards__head">
        <h2 class="pa-title pa-title--md">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="pa-cards__sub">{{ s.text | escape | newline_to_br }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="pa-cards__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="pa-card" {{ block.shopify_attributes }}{% if b.seance_id != blank %} data-pa-svc="{{ b.seance_id | escape }}"{% endif %}>
          {%- if s.layout == 'modes' -%}{% render 'pa-img', image: b.image, asset: b.image_asset, alt: b.image_alt, pos: b.image_position, class: 'pa-card__img' %}{%- endif -%}
          <div class="pa-card__body">
            <h3 class="pa-card__title">{{ b.title }}</h3>
            {%- if b.text != blank -%}<p class="pa-card__text">{{ b.text | escape | newline_to_br }}</p>{%- endif -%}
            {%- if s.layout == 'pricing' -%}
              <ul class="pa-card__meta" role="list">
                <li>{% render 'pa-icon', name: 'tag' %}<strong data-pa-f="price">{{ b.price }}</strong>{%- if b.price_note != blank -%}<small>{{ b.price_note }}</small>{%- endif -%}</li>
                <li>{% render 'pa-icon', name: 'clock' %}<span data-pa-f="duration-long">{{ b.duration }}</span></li>
              </ul>
            {%- endif -%}
            {%- if b.button_label != blank -%}<a class="pa-btn pa-btn--forest{% if s.layout == 'modes' %} pa-btn--sm{% else %} pa-btn--block{% endif %}" href="{{ b.button_link | default: '/pages/prendre-rendez-vous' }}"{% if b.book_kind != blank %} data-pa-book="{{ b.book_kind }}"{% endif %}>{{ b.button_label }}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.demo_note != blank -%}<p class="pa-note pa-cards__note" data-pa-demo-note>{{ s.demo_note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Cartes des séances",
  "class": "pa-cards-section",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposition", "default": "modes", "options": [{ "value": "modes", "label": "Modalités avec photo" }, { "value": "pricing", "label": "Séances avec tarif" }] },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Deux façons de vous accompagner" },
    { "type": "textarea", "id": "text", "label": "Sous-titre" },
    { "type": "text", "id": "demo_note", "label": "Mention des tarifs d'exemple", "info": "Ex. « Tarifs de démonstration ». Vide : aucune mention. Masquée quand le service réel est activé." }
  ],
  "blocks": [
    {
      "type": "card", "name": "Carte",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Photo fournie avec le thème" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de la photo" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Au cabinet" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "seance_id", "label": "Identifiant de la séance (tarif et durée)" },
        { "type": "text", "id": "price", "label": "Tarif affiché sans script" },
        { "type": "text", "id": "price_note", "label": "Mention du tarif", "default": "(tarif indicatif)" },
        { "type": "text", "id": "duration", "label": "Durée affichée sans script" },
        { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "En savoir plus" },
        { "type": "url", "id": "button_link", "label": "Lien du bouton" },
        { "type": "text", "id": "book_kind", "label": "Réservation préparée", "info": "Ex. « seance:suivi »." }
      ]
    }
  ],
  "presets": [{ "name": "Cartes des séances" }]
}
{% endschema %}
