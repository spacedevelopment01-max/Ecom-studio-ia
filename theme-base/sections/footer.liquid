<footer class="es-footer color-{{ section.settings.color_scheme }}">
  <div class="es-container">
    {%- if section.settings.show_wordmark -%}
      <p class="es-footer__wordmark" data-reveal="mask">{{ shop.name }}</p>
    {%- endif -%}
    <div class="es-footer__grid">
      {%- for block in section.blocks -%}
        <div class="es-footer__block es-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h2 class="es-footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
              <div class="es-rte">{{ block.settings.text }}</div>
            {%- when 'links' -%}
              <h2 class="es-footer__heading">{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h2>
              <ul role="list" class="es-footer__links">
                {%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              </ul>
            {%- when 'newsletter' -%}
              <h2 class="es-footer__heading">{{ block.settings.heading }}</h2>
              {%- if block.settings.text != blank -%}<p class="es-muted">{{ block.settings.text }}</p>{%- endif -%}
              {%- form 'customer', class: 'es-newsletter-form', id: 'FooterNewsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.label' | t }}</label>
                <div class="es-inline-field">
                  <input id="FooterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
                  <button type="submit" class="es-button es-button--small">{{ 'newsletter.button' | t }}</button>
                </div>
                {%- if form.posted_successfully? -%}<p class="es-form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
                {%- if form.errors -%}<p class="es-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
              {%- endform -%}
            {%- when 'social' -%}
              <h2 class="es-footer__heading">{{ block.settings.heading }}</h2>
              {% render 'social-icons' %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="es-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- if section.settings.show_policies -%}
        <ul role="list" class="es-footer__policies">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment -%}
        <ul class="es-footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'es-payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "es-footer-section",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "show_wordmark", "label": "Grand nom de marque", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Liens vers les politiques", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Moyens de paiement", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-3" }
  ],
  "blocks": [
    { "type": "text", "name": "Texte", "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "La marque" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Présentez votre marque en une phrase.</p>" }
    ] },
    { "type": "links", "name": "Liens", "settings": [
      { "type": "text", "id": "heading", "label": "Titre" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "newsletter", "name": "Lettre d'information", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Restons en contact" },
      { "type": "text", "id": "text", "label": "Texte", "default": "Nouveautés et coulisses, sans excès." }
    ] },
    { "type": "social", "name": "Réseaux sociaux", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Suivez-nous" }
    ] }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
