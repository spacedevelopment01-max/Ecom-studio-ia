{%- liquid
  assign style = section.settings.style
  assign news_block = section.blocks | where: 'type', 'newsletter' | first
-%}
<footer class="es-footer es-footer--{{ style }} es-ambient color-{{ section.settings.color_scheme }}">
  <div class="es-container">
    {%- if style == 'card' and news_block -%}
      <div class="es-footer__card es-glow" data-reveal="up">
        <div>
          <h2 class="es-heading es-h2">{{ news_block.settings.heading }}</h2>
          {%- if news_block.settings.text != blank -%}<p class="es-lead">{{ news_block.settings.text }}</p>{%- endif -%}
        </div>
        {%- form 'customer', class: 'es-newsletter-form', id: 'FooterNewsletterCard' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmailCard">{{ 'newsletter.label' | t }}</label>
          <div class="es-inline-field">
            <input id="FooterEmailCard" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
            <button type="submit" class="es-button">{{ 'newsletter.button' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="es-form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark and style != 'wordmark' and style != 'minimal' and style != 'centered' and style != 'brand-left' and style != 'split' -%}
      <p class="es-footer__wordmark" data-reveal="mask">{{ shop.name }}</p>
    {%- endif -%}

    {%- if style == 'centered' or style == 'minimal' -%}
      <div class="es-footer__inline">
        <a href="{{ routes.root_url }}" class="es-footer__brand">
          {%- liquid
            assign footer_logo = settings.logo_asset
            if section.settings.logo_asset != blank
              assign footer_logo = section.settings.logo_asset
            endif
          -%}
          {%- if footer_logo != blank and style == 'centered' -%}<img src="{{ footer_logo | asset_url }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: 3 }}" loading="lazy">{%- else -%}{{ shop.name }}{%- endif -%}
        </a>
        <ul role="list" class="es-footer__inline-links">
          {%- assign seen_links = '|' -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'links' -%}
              {%- for link in linklists[block.settings.menu].links -%}
                {%- assign link_key = '|' | append: link.url | append: '|' -%}
                {%- unless seen_links contains link_key -%}
                  {%- assign seen_links = seen_links | append: link.url | append: '|' -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {% render 'social-icons' %}
      </div>
    {%- else -%}
      {%- liquid
        assign has_brand_col = false
        if style == 'brand-left' or style == 'split'
          assign has_brand_col = true
        endif
      -%}
      {%- if has_brand_col -%}<div class="es-footer__layout">{%- endif -%}
      {%- if has_brand_col -%}
        <div class="es-footer__brandcol">
          <a href="{{ routes.root_url }}" class="es-footer__brand">
            {%- liquid
              assign footer_logo = settings.logo_asset
              if section.settings.logo_asset != blank
                assign footer_logo = section.settings.logo_asset
              endif
            -%}
            {%- if footer_logo != blank -%}<img src="{{ footer_logo | asset_url }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: 3 }}" loading="lazy">{%- else -%}{{ shop.name }}{%- endif -%}
          </a>
          {%- if section.settings.tagline != blank -%}<p class="es-footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
          {%- if style == 'split' and news_block -%}
            <div class="es-footer__brand-news">
              <h2 class="es-footer__heading">{{ news_block.settings.heading }}</h2>
              {%- form 'customer', class: 'es-newsletter-form', id: 'FooterNewsletterSplit' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmailSplit">{{ 'newsletter.label' | t }}</label>
                <div class="es-inline-field">
                  <input id="FooterEmailSplit" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
                  <button type="submit" class="es-button es-button--small">{{ 'newsletter.button' | t }}</button>
                </div>
                {%- if form.posted_successfully? -%}<p class="es-form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}
          {% render 'social-icons' %}
        </div>
      {%- endif -%}
      <div class="es-footer__grid">
        {%- for block in section.blocks -%}
          {%- if style == 'card' and block.type == 'newsletter' -%}{%- continue -%}{%- endif -%}
          {%- if style == 'split' and block.type == 'newsletter' -%}{%- continue -%}{%- endif -%}
          {%- if has_brand_col and block.type == 'social' -%}{%- continue -%}{%- endif -%}
          <div class="es-footer__block es-footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}<h2 class="es-footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                <div class="es-rte">{{ block.settings.text }}</div>
              {%- when 'links' -%}
                <h2 class="es-footer__heading">{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h2>
                <ul role="list" class="es-footer__links">
                  {%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
                </ul>
              {%- when 'newsletter' -%}
                <h2 class="es-footer__heading">{{ block.settings.heading }}</h2>
                {%- if block.settings.text != blank -%}<p class="es-muted">{{ block.settings.text }}</p>{%- endif -%}
                {%- form 'customer', class: 'es-newsletter-form', id: 'FooterNewsletter' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.label' | t }}</label>
                  <div class="es-inline-field">
                    <input id="FooterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
                    <button type="submit" class="es-button es-button--small">{{ 'newsletter.button' | t }}</button>
                  </div>
                  {%- if form.posted_successfully? -%}<p class="es-form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
                  {%- if form.errors -%}<p class="es-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
                {%- endform -%}
              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}<h2 class="es-footer__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                <ul role="list" class="es-footer__contact">
                  {%- if block.settings.address != blank -%}<li>{% render 'icon', name: 'globe' %}<span>{{ block.settings.address | newline_to_br }}</span></li>{%- endif -%}
                  {%- if block.settings.phone != blank -%}<li>{% render 'icon', name: 'phone' %}<a href="tel:{{ block.settings.phone | remove: ' ' | remove: '.' | remove: '-' }}">{{ block.settings.phone }}</a></li>{%- endif -%}
                  {%- if block.settings.email != blank -%}<li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ block.settings.email | strip }}">{{ block.settings.email }}</a></li>{%- endif -%}
                  {%- if block.settings.hours != blank -%}<li>{% render 'icon', name: 'clock' %}<span>{{ block.settings.hours | newline_to_br }}</span></li>{%- endif -%}
                </ul>
              {%- when 'social' -%}
                <h2 class="es-footer__heading">{{ block.settings.heading }}</h2>
                {% render 'social-icons' %}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if has_brand_col -%}</div>{%- endif -%}
    {%- endif -%}

    {%- if style == 'wordmark' and section.settings.show_wordmark -%}
      <p class="es-footer__wordmark es-footer__wordmark--bottom" data-reveal="mask">{{ shop.name }}</p>
    {%- endif -%}

    <div class="es-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- if section.settings.show_policies -%}
        <ul role="list" class="es-footer__policies">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment -%}
        <ul class="es-footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'es-payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
/* Lueur d'ambiance contenue dans le pied de page (sinon elle élargit la page). */
.es-footer.es-ambient { position: relative; }
.es-footer__contact { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: .95rem; }
.es-footer__contact li { display: flex; gap: 10px; align-items: flex-start; }
.es-footer__contact .es-icon { width: 18px; height: 18px; flex: none; margin-top: 3px; color: var(--c-accent); }
.es-footer__contact a { color: inherit; text-decoration: none; border-bottom: 1px solid rgba(var(--c-text-rgb), .25); }
.es-footer__contact a:hover { border-color: currentColor; }
/* Styles supplémentaires du pied de page */
.es-footer__layout { display: grid; gap: clamp(36px, 5vw, 72px); }
.es-footer__brandcol { display: grid; gap: 18px; align-content: start; justify-items: start; }
.es-footer__brandcol .es-footer__brand { font-size: clamp(1.6rem, 3vw, 2.2rem); }
.es-footer__tagline { margin: 0; max-width: 34ch; opacity: .8; font-size: 1rem; line-height: 1.5; }
.es-footer__brand-news { width: 100%; max-width: 420px; }
@media (min-width: 990px) {
  .es-footer--brand-left .es-footer__layout { grid-template-columns: minmax(240px, .8fr) 2fr; }
  .es-footer--split .es-footer__layout { grid-template-columns: 1fr 1.3fr; align-items: stretch; }
}
.es-footer--split .es-footer__brandcol { padding: clamp(24px, 4vw, 48px); border-radius: var(--radius-card, 20px); background: rgba(var(--c-accent-rgb), .12); border: 1px solid rgba(var(--c-accent-rgb), .25); }
.es-footer--split .es-footer__grid { align-content: center; }
.es-footer--stacked .es-footer__grid { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 32px; }
.es-footer--stacked .es-footer__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; }
.es-footer--stacked .es-footer__contact li { justify-content: center; }
.es-footer--stacked .es-footer__block--newsletter { width: min(100%, 460px); }
.es-footer--stacked .es-footer__wordmark { text-align: center; }
.es-footer--stacked .es-footer__bottom { justify-content: center; text-align: center; }
.es-footer--boxed .es-footer__grid { padding: clamp(24px, 4vw, 48px); border-radius: var(--radius-card, 20px); border: 1px solid rgba(var(--c-text-rgb), .12); background: rgba(var(--c-text-rgb), .04); }
{% endstylesheet %}

{% schema %}
{
  "name": "Pied de page",
  "class": "es-footer-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "style", "label": "Style", "default": "columns",
      "options": [
        { "value": "columns", "label": "Colonnes" },
        { "value": "wordmark", "label": "Colonnes et nom géant en bas" },
        { "value": "card", "label": "Carte d'inscription puis colonnes" },
        { "value": "centered", "label": "Centré (logo, liens, réseaux)" },
        { "value": "minimal", "label": "Minimal sur une ligne" },
        { "value": "brand-left", "label": "Marque à gauche, colonnes à droite" },
        { "value": "split", "label": "Deux panneaux (marque et inscription | liens)" },
        { "value": "stacked", "label": "Empilé et centré" },
        { "value": "boxed", "label": "Colonnes dans une carte arrondie" }
      ]
    },
    { "type": "text", "id": "tagline", "label": "Phrase sous le logo", "info": "Styles « Marque à gauche » et « Deux panneaux ». Facultatif." },
    { "type": "text", "id": "logo_asset", "label": "Logo du pied de page (fichier assets)", "info": "Styles Centré, Marque à gauche et Deux panneaux : version du logo lisible sur le fond du pied de page. Vide : logo du thème." },
    { "type": "checkbox", "id": "show_wordmark", "label": "Grand nom de marque", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Liens vers les politiques", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Moyens de paiement", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-3" }
  ],
  "blocks": [
    { "type": "text", "name": "Texte", "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "La marque" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Présentez votre marque en une phrase.</p>" }
    ] },
    { "type": "links", "name": "Liens", "settings": [
      { "type": "text", "id": "heading", "label": "Titre" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "newsletter", "name": "Lettre d'information", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Restons en contact" },
      { "type": "text", "id": "text", "label": "Texte", "default": "Nouveautés et coulisses, sans excès." }
    ] },
    { "type": "contact", "name": "Coordonnées", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Nous trouver" },
      { "type": "textarea", "id": "address", "label": "Adresse ou zone d'intervention" },
      { "type": "text", "id": "phone", "label": "Téléphone" },
      { "type": "text", "id": "email", "label": "E-mail" },
      { "type": "textarea", "id": "hours", "label": "Horaires" }
    ] },
    { "type": "social", "name": "Réseaux sociaux", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Suivez-nous" }
    ] }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
