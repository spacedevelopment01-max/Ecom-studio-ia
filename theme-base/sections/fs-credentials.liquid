          "type": "text",
          "id": "title",
          "label": "Intitulé"
        },
        {
          "type": "text",
          "id": "issuer",
          "label": "Organisme"
        },
        {
          "type": "text",
          "id": "reference",
          "label": "Numéro ou référence"
        },
        {
          "type": "text",
          "id": "validity",
          "label": "Validité (ex. Valable jusqu'en 2027)"
        },
        {
          "type": "url",
          "id": "doc_link",
          "label": "Lien du justificatif"
        },
        {
          "type": "image_picker",
