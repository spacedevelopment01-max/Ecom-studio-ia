{%- comment -%}
Certifications, assurances et labels (services) : chaque mention porte son organisme, sa référence, sa validité et
  un lien vers le justificatif. La section n'en invente aucune : sans justificatif renseigné, l'aperçu du studio le
  signale « à compléter ». Liste, cartes ou tableau.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-credentials fs-credentials--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- if s.layout == 'table' -%}
      <div class="fs-table-wrap"{% render 'fs-reveal', effect: fx %}>
        <table class="fs-table">
          <thead><tr><th scope="col">{{ s.label_title | default: 'Mention' | escape }}</th><th scope="col">{{ s.label_issuer | default: 'Organisme' | escape }}</th><th scope="col">{{ s.label_reference | default: 'Référence' | escape }}</th><th scope="col">{{ s.label_validity | default: 'Validité' | escape }}</th><th scope="col"><span class="visually-hidden">{{ s.doc_label | default: 'Justificatif' | escape }}</span></th></tr></thead>
          <tbody>{%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.title | escape }}</th><td>{{ block.settings.issuer | default: '—' | escape }}</td><td>{{ block.settings.reference | default: '—' | escape }}</td><td>{{ block.settings.validity | default: '—' | escape }}</td><td>{% if block.settings.doc_link != blank %}<a class="fs-link" href="{{ block.settings.doc_link }}">{{ s.doc_label | default: 'Justificatif' | escape }}</a>{% endif %}</td></tr>{%- endfor -%}</tbody>
        </table>
      </div>
    {%- else -%}
      <ul class="fs-cred__list fs-cred__list--{{ s.layout }}{% if s.layout == 'cards' %} fs-grid fs-grid--{{ section.blocks.size | at_most: 3 | at_least: 1 }}{% endif %}" role="list">
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-cred{% if s.layout == 'cards' %} {{ cards }}{% endif %}"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank or block.settings.logo_asset != blank -%}<span class="fs-cred__logo">{% render 'ed-media', image: block.settings.logo, asset: block.settings.logo_asset, alt: block.settings.title %}</span>{%- else -%}<span class="fs-commit__icon">{% render 'fs-icon', name: 'award' %}</span>{%- endif -%}
            <div>
              <span class="fs-meta">{% case block.settings.kind %}{% when 'insurance' %}Assurance{% when 'label' %}Label{% when 'training' %}Formation{% when 'approval' %}Agrément{% else %}Certification{% endcase %}{% if block.settings.issuer != blank %} · {{ block.settings.issuer | escape }}{% endif %}</span>
              <h3 class="fs-item__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.reference != blank or block.settings.validity != blank -%}<p class="fs-meta">{% if block.settings.reference != blank %}{{ s.label_reference | default: 'Référence' | escape }} {{ block.settings.reference | escape }}{% endif %}{% if block.settings.reference != blank and block.settings.validity != blank %} · {% endif %}{% if block.settings.validity != blank %}{{ block.settings.validity | escape }}{% endif %}</p>{%- endif -%}
              {%- if block.settings.doc_link != blank -%}<a class="fs-link" href="{{ block.settings.doc_link }}">{{ s.doc_label | default: 'Justificatif' | escape }}</a>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.note != blank -%}<p class="fs-note">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Certifications",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "list",
          "label": "Liste"
        },
        {
          "value": "cards",
          "label": "Cartes"
        },
        {
          "value": "table",
          "label": "Tableau"
        }
      ],
      "default": "list"
    },
    {
      "type": "text",
      "id": "doc_label",
      "label": "Libellé des justificatifs",
      "default": "Justificatif"
    },
    {
      "type": "text",
      "id": "label_title",
      "label": "Intitulé : mention",
      "default": "Mention"
    },
    {
      "type": "text",
      "id": "label_issuer",
      "label": "Intitulé : organisme",
      "default": "Organisme"
    },
    {
      "type": "text",
      "id": "label_reference",
      "label": "Intitulé : référence",
      "default": "Référence"
    },
    {
      "type": "text",
      "id": "label_validity",
      "label": "Intitulé : validité",
      "default": "Validité"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
