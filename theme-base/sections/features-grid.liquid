<section class="es-section es-features es-features--{{ section.settings.style }}{% if section.settings.style == 'glow' %} es-ambient es-ambient--left{% endif %} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    <header class="es-section-head es-section-head--{{ section.settings.heading_align }}">
      {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>{%- endif -%}
      {%- if section.settings.link_label != blank -%}<a class="es-link-arrow" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-reveal="up">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </header>
    <div class="es-features__grid" style="--cols: {{ section.settings.columns }}" data-reveal-stagger>
      {%- for block in section.blocks -%}
        <article class="es-feature{% if section.settings.style == 'glow' %} es-glow{% endif %}" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if section.settings.style == 'glow' -%}
            <span class="es-feature__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- assign tile_icon = block.settings.icon -%}
            {%- if tile_icon == 'none' -%}{%- assign tile_icon = 'sparkle' -%}{%- endif -%}
            <span class="es-feature__tile">{% render 'icon', name: tile_icon %}</span>
          {%- elsif block.settings.image != blank or block.settings.image_asset != blank -%}
            <div class="es-feature__media es-media-frame">{% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, sizes: '(min-width: 990px) 30vw, 90vw', class: 'es-cover' %}</div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="es-feature__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- else -%}
            <span class="es-feature__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <h3 class="es-heading es-h4">{{ block.settings.title }}</h3>
          <div class="es-rte es-muted">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}<a class="es-link-arrow es-feature__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.es-features .es-feature .es-h4 { margin: 0 0 .45em; }
.es-features .es-feature .es-rte { font-size: max(.98rem, 15px); line-height: 1.65; }
.es-features .es-feature__icon { color: var(--c-accent); }
.es-features .es-feature__icon .es-icon { width: 22px; height: 22px; }
.es-features--cards .es-feature { border: 1px solid rgba(var(--c-text-rgb), .06); transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
.es-features--cards .es-feature:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -44px rgba(0, 0, 0, .45); }
.es-features--cards .es-feature__icon { box-shadow: 0 10px 24px -16px rgba(var(--c-accent-rgb), .9); }
.es-features .es-section-head--center { max-width: 760px; margin-inline: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Grille d'atouts",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pensé dans les moindres détails" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre mise en valeur" },
    { "type": "text", "id": "link_label", "label": "Lien sous le titre" },
    { "type": "url", "id": "link", "label": "Adresse du lien" },
    { "type": "select", "id": "heading_align", "label": "Alignement du titre", "default": "left", "options": [ { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centré" } ] },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Colonnes", "default": 3 },
    { "type": "select", "id": "style", "label": "Style", "default": "plain", "options": [ { "value": "glow", "label": "Cartes lumineuses (néon)" }, { "value": "plain", "label": "Épuré" }, { "value": "cards", "label": "Cartes" }, { "value": "lines", "label": "Filets" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "feature", "name": "Atout", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "none", "options": [
        { "value": "none", "label": "Numéro" }, { "value": "sparkle", "label": "Éclat" }, { "value": "leaf", "label": "Feuille" }, { "value": "drop", "label": "Goutte" },
        { "value": "hand", "label": "Main" }, { "value": "shield", "label": "Bouclier" }, { "value": "truck", "label": "Livraison" }, { "value": "check", "label": "Coche" },
        { "value": "star", "label": "Étoile" }, { "value": "bolt", "label": "Éclair" }, { "value": "heart", "label": "Cœur" }, { "value": "globe", "label": "Globe" }, { "value": "clock", "label": "Horloge" }, { "value": "waves", "label": "Vagues" }, { "value": "gift", "label": "Cadeau" }
      ] },
      { "type": "image_picker", "id": "image", "label": "Image (remplace l'icône)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Un atout réel" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Décrivez un bénéfice vérifiable.</p>" },
      { "type": "text", "id": "link_label", "label": "Lien (ex. Découvrir)" },
      { "type": "url", "id": "link", "label": "Adresse du lien" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Grille d'atouts", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
