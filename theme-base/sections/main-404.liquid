{%- comment -%}
  Page introuvable. NOCTIL (maquettes du 23 octobre, planche 07) : photo de fond facultative sous un voile, illustration
  (étoile et planètes dessinées, modifiables) à la place du « 404 », un seul bouton réglable (« Retour à l'accueil »).
  Sans ces réglages, la page garde sa présentation d'origine (404, continuer les achats, rechercher).
  SOUPLE (planche 06) : « Photo dans une forme en S » : texte à gauche, la photo vue à travers une grande courbe en S
  dessinée en SVG (la photo n'est pas modifiée : le fond de la page la recouvre autour de la forme).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_photo = false
  if s.image != blank or s.image_asset != blank
    assign has_photo = true
  endif
-%}
{%- if s.illustration == 'shape' -%}
<section class="es-section es-404 es-404--shape color-{{ s.color_scheme }}" style="--pt: 64px; --pb: 64px;">
  <div class="es-container es-404__split">
    <div class="es-404__copy">
      <h1 class="es-heading es-404__title">{{ s.heading | escape | newline_to_br }}</h1>
      <p class="es-404__text">{{ s.text }}</p>
      <a href="{{ s.button_link | default: routes.root_url }}" class="es-button">{{ s.button_label | default: 'conversion.home' | t | escape }} {% render 'icon', name: 'arrow' %}</a>
    </div>
    {%- if has_photo -%}
    <div class="es-404__shape">
      {% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, focus_x: 50, focus_y: 55, loading: 'eager' %}
      <svg class="es-404__mask" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><defs><mask id="Shape404-{{ section.id }}" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="120"><rect width="100" height="120" fill="#fff"/><path d="M78 6 C46 2 18 14 22 36 C26 58 78 54 80 80 C82 104 50 116 20 114" fill="none" stroke="#000" stroke-width="30" stroke-linecap="round"/></mask></defs><rect width="100" height="120" mask="url(#Shape404-{{ section.id }})" class="es-404__mask-fill"/></svg>
    </div>
    {%- endif -%}
  </div>
</section>
{%- else -%}
<section class="es-section es-404{% if has_photo %} es-404--photo{% endif %} color-{{ s.color_scheme }}" style="--pt: 120px; --pb: 160px;">
  {%- if has_photo -%}<div class="es-404__bg">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: '', focus_x: 50, focus_y: 70, loading: 'eager' %}</div>{%- endif -%}
  <div class="es-container es-center es-404__inner">
    {%- if s.illustration == 'star' -%}<span class="es-404__illus" aria-hidden="true">{% render 'star-illustration' %}</span>{%- else -%}<p class="es-404__code" data-reveal="mask">404</p>{%- endif -%}
    <h1 class="es-heading es-h2">{{ s.heading }}</h1>
    <p class="es-muted">{{ s.text }}</p>
    <div class="es-actions es-actions--center">
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.root_url }}" class="es-button">{{ s.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="es-button">{{ 'cart.continue' | t }}</a>
        <a href="{{ routes.search_url }}" class="es-button es-button--secondary">{{ 'general.search' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Page introuvable",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Cette page s'est égarée." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Le lien est peut-être ancien. Le reste de la boutique vous attend." },
    { "type": "select", "id": "illustration", "label": "Au-dessus du titre", "default": "code", "options": [ { "value": "code", "label": "Le nombre 404" }, { "value": "star", "label": "Étoile et planètes dessinées" }, { "value": "shape", "label": "Photo dans une forme en S, texte à gauche" } ] },
    { "type": "image_picker", "id": "image", "label": "Photo de fond" },
    { "type": "text", "id": "image_asset", "label": "Photo de fond (fichier du thème)" },
    { "type": "text", "id": "image_alt", "label": "Description de la photo" },
    { "type": "text", "id": "button_label", "label": "Bouton", "info": "Vide : « Continuer mes achats » et « Rechercher »." },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" }
  ]
}
{% endschema %}
