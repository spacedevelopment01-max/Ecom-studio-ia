<section class="es-section es-404 color-{{ section.settings.color_scheme }}" style="--pt: 120px; --pb: 160px;">
  <div class="es-container es-center">
    <p class="es-404__code" data-reveal="mask">404</p>
    <h1 class="es-heading es-h2">{{ section.settings.heading }}</h1>
    <p class="es-muted">{{ section.settings.text }}</p>
    <div class="es-actions es-actions--center">
      <a href="{{ routes.all_products_collection_url }}" class="es-button">{{ 'cart.continue' | t }}</a>
      <a href="{{ routes.search_url }}" class="es-button es-button--secondary">{{ 'general.search' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page introuvable",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Cette page s'est égarée." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Le lien est peut-être ancien. Le reste de la boutique vous attend." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" }
  ]
}
{% endschema %}
