{%- comment -%}
  Avis clients immersifs : un avis par grande carte plein cadre (photo ou vidéo en fond), accroche magnétique,
  défilement automatique doux et réglable. Uniquement de vrais avis, saisis par le marchand avec l'accord du client :
  les blocs par défaut sont des espaces réservés explicites « [À compléter …] », sans note ni mention « Achat vérifié ».
  La note globale n'est affichée que si l'application d'avis l'a fournie (métachamps reviews), sinon rien.
{%- endcomment -%}
{%- liquid
  assign rating_product = product | default: section.settings.product
  assign has_app_rating = false
  if section.settings.show_app_rating and rating_product != blank
    assign app_rating = rating_product.metafields.reviews.rating.value
    if app_rating.rating != blank and app_rating.scale_max != blank
      assign has_app_rating = true
    endif
  endif
  assign label_default = 'sections.immersive_reviews.label' | t
  assign label = section.settings.heading | default: label_default
-%}
<section class="es-section es-irev es-irev--{{ section.settings.height }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --car-speed: {{ section.settings.speed }}s;" data-car data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}" aria-roledescription="{{ 'sections.carousel.carousel' | t | escape }}" aria-label="{{ label | strip_html | escape }}">
  {%- if section.blocks.size > 0 -%}
    <div class="es-container es-irev__head">
      <div class="es-irev__titles">
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="es-irev__sub es-muted" data-reveal="up">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if has_app_rating -%}
          {%- assign pct = app_rating.rating | times: 100.0 | divided_by: app_rating.scale_max | round -%}
          <p class="es-irev__app" data-reveal="up">
            <span class="es-stars" style="--pct: {{ pct }}%" aria-hidden="true"></span>
            <b>{{ app_rating.rating | round: 1 }}</b><span class="es-muted">/ {{ app_rating.scale_max }}</span>
            {%- if rating_product.metafields.reviews.rating_count != blank -%}<span class="es-muted">· {{ 'products.product.reviews_count' | t: count: rating_product.metafields.reviews.rating_count }}</span>{%- endif -%}
            <span class="visually-hidden">{{ 'products.product.rating_of' | t: rating: app_rating.rating, max: app_rating.scale_max }}</span>
          </p>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="es-car__nav">
          {%- if section.settings.autoplay -%}
            <button type="button" class="es-icon-button es-icon-button--outline es-car__toggle" data-car-toggle aria-pressed="false" aria-label="{{ 'general.pause' | t | escape }}" data-label-pause="{{ 'general.pause' | t | escape }}" data-label-play="{{ 'general.play' | t | escape }}"><span class="es-car__pause" aria-hidden="true"></span></button>
          {%- endif -%}
          <button type="button" class="es-icon-button es-icon-button--outline" data-car-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" class="es-icon-button es-icon-button--outline" data-car-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      {%- endif -%}
    </div>
    <div class="es-irev__viewport" data-reveal="up">
      <div class="es-car__track es-irev__track" data-car-track tabindex="0" aria-label="{{ label | strip_html | escape }}">
        {%- for block in section.blocks -%}
          {%- assign stars = block.settings.rating | plus: 0 -%}
          {%- assign q = block.settings.quote | strip -%}
          <figure class="es-car__slide es-irev__card{% if q.size > 170 %} es-irev__card--long{% endif %}" data-car-slide role="group" aria-roledescription="{{ 'sections.carousel.slide' | t | escape }}" aria-label="{{ 'sections.carousel.slide_of' | t: index: forloop.index, count: forloop.length | escape }}" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="es-irev__media es-mbg-box">
              {% render 'es-media-bg', image: block.settings.image, asset: block.settings.image_asset, video: block.settings.video, video_url: block.settings.video_url, video_asset: block.settings.video_asset, alt: block.settings.author, sizes: '(min-width: 990px) 1100px, 92vw' %}
            </div>
            <div class="es-irev__shade" aria-hidden="true"></div>
            <div class="es-irev__body">
              {%- if section.settings.show_stars and stars > 0 -%}
                <p class="es-irev__stars" role="img" aria-label="{{ 'products.product.rating_of' | t: rating: stars, max: 5 | escape }}">{%- for i in (1..5) -%}<span{% if i > stars %} class="is-off"{% endif %}>★</span>{%- endfor -%}</p>
              {%- endif -%}
              {%- if q != blank -%}<blockquote class="es-irev__quote"><p>{{ q | newline_to_br }}</p></blockquote>{%- endif -%}
              <figcaption class="es-irev__who">
                {%- if block.settings.author != blank -%}<b>{{ block.settings.author }}</b>{%- endif -%}
                {%- if block.settings.detail != blank -%}<span>{{ block.settings.detail }}</span>{%- endif -%}
                {%- if block.settings.verified -%}<span class="es-irev__verified">{% render 'icon', name: 'check' %}{{ 'sections.immersive_reviews.verified' | t }}</span>{%- endif -%}
              </figcaption>
            </div>
          </figure>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="es-container">
        <div class="es-car__dots" role="group" aria-label="{{ 'general.pagination' | t | escape }}">
          {%- for block in section.blocks -%}
            <button type="button" class="es-car__dot" data-car-dot aria-label="{{ 'sections.carousel.go_to' | t: index: forloop.index | escape }}"{% if forloop.first %} aria-current="true"{% endif %}><i></i></button>
          {%- endfor -%}
        </div>
      </div>
      <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-car-status></p>
    {%- endif -%}
  {%- elsif request.design_mode -%}
    <div class="es-container"><p class="es-reviews__hint">{{ 'sections.reviews.testimonials_hint' | t }}</p></div>
  {%- endif -%}
</section>
{% render 'es-premium-media' %}

{% stylesheet %}
.es-irev { --car-w: min(86vw, 1180px); overflow: hidden; }
.es-irev--medium { --irev-h: clamp(440px, 64vh, 620px); }
.es-irev--large { --irev-h: clamp(480px, 80vh, 800px); }
.es-irev--full { --irev-h: max(480px, calc(100svh - var(--header-h) - 48px)); }
.es-irev__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(24px, 4vw, 48px); }
.es-irev__titles .es-heading { margin-bottom: .2em; }
.es-irev__sub { margin: 0; max-width: 58ch; }
.es-irev__app { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 16px 0 0; padding: 8px 16px; border: 1px solid var(--c-border); border-radius: 99px; font-size: .9rem; }
.es-irev__card { position: relative; height: var(--irev-h); border-radius: var(--radius-card); overflow: hidden; isolation: isolate; background: #101010; color: #fff; display: flex; align-items: flex-end; transition: transform .9s var(--ease-out), opacity .9s var(--ease-out); }
.es-irev__media { position: absolute; inset: 0; z-index: -2; }
.es-irev__media .es-placeholder { min-height: 0; background: #2a2a2a; }
.es-irev__shade { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,0) 28%, rgba(0,0,0,.38) 56%, rgba(0,0,0,.84) 100%), linear-gradient(90deg, rgba(0,0,0,.42) 0%, rgba(0,0,0,0) 62%); }
.es-irev__body { position: relative; width: 100%; max-width: 980px; padding: clamp(22px, 5vw, 64px); display: grid; gap: clamp(12px, 1.8vw, 22px); }
.es-irev__stars { margin: 0; color: #F5B921; font-size: clamp(1.05rem, 1.6vw, 1.4rem); letter-spacing: 4px; line-height: 1; }
.es-irev__stars .is-off { color: rgba(255,255,255,.28); }
.es-irev__quote { margin: 0; }
.es-irev__quote p { margin: 0; font-family: var(--font-heading); font-style: var(--font-heading-style); font-weight: var(--font-heading-weight); font-size: calc(clamp(1.55rem, 3.6vw, 3.4rem) * var(--heading-scale)); line-height: 1.1; letter-spacing: -.01em; text-wrap: balance; text-shadow: 0 2px 30px rgba(0,0,0,.25); }
.es-irev__quote p::before { content: open-quote; }
.es-irev__quote p::after { content: close-quote; }
.es-irev__quote p:lang(fr) { quotes: "\00AB\202F" "\202F\00BB"; }
.es-irev__card--long .es-irev__quote p { font-size: calc(clamp(1.2rem, 2.3vw, 2.15rem) * var(--heading-scale)); line-height: 1.22; }
.es-irev__who { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0; font-size: .95rem; color: rgba(255,255,255,.82); }
.es-irev__who b { color: #fff; font-size: 1.05rem; letter-spacing: .01em; }
.es-irev__who b + span::before { content: ""; display: inline-block; width: 18px; height: 1px; margin-right: 12px; vertical-align: middle; background: currentColor; opacity: .6; }
.es-irev__verified { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px 5px 8px; border-radius: 99px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); color: #fff; font-size: .78rem; font-weight: var(--font-body-weight-bold); letter-spacing: .03em; }
.es-irev__verified .es-icon { width: 14px; height: 14px; }
.es-irev .es-car__toggle { color: inherit; }
/* Carte active au premier plan, voisines en retrait ; entrée du texte en cascade et léger zoom arrière du média. */
.es-irev.is-ready .es-irev__card:not(.is-active) { transform: scale(.93); opacity: .45; cursor: pointer; }
.motion-ready .es-irev.is-ready .es-irev__body > * { opacity: 0; transform: translateY(26px); transition: opacity .9s var(--ease-out), transform 1.1s var(--ease-out); }
.motion-ready .es-irev.is-ready .is-active .es-irev__body > * { opacity: 1; transform: none; }
.motion-ready .es-irev.is-ready .is-active .es-irev__body > :nth-child(2) { transition-delay: .12s; }
.motion-ready .es-irev.is-ready .is-active .es-irev__body > :nth-child(3) { transition-delay: .24s; }
.motion-ready .es-irev .es-mbg__img, .motion-ready .es-irev .es-mbg__video { transform: scale(1.08); transition: transform 7s var(--ease-out); }
.motion-ready .es-irev .is-active .es-mbg__img, .motion-ready .es-irev .is-active .es-mbg__video { transform: none; }
@media (max-width: 749px) {
  .es-irev { --car-w: 88vw; }
  .es-irev__card { height: auto; aspect-ratio: 4 / 5; }
  .es-irev__head { align-items: flex-start; flex-direction: column; gap: 12px; }
  .es-irev__head [data-car-prev], .es-irev__head [data-car-next] { display: none; }
  .es-irev__head .es-car__nav { position: absolute; right: var(--gutter); top: 0; }
  .es-irev__head { position: relative; padding-right: calc(var(--gutter) + 52px); }
  .es-irev.is-ready .es-irev__card:not(.is-active) { transform: scale(.95); }
}
@media (prefers-reduced-motion: reduce) {
  .es-irev__card, .es-irev .es-mbg__img, .es-irev .es-mbg__video, .es-irev__body > * { transition: none !important; transform: none !important; }
  .es-irev__body > * { opacity: 1 !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Avis clients immersifs",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "N'utilisez que des avis réels et vérifiables, recopiés avec l'accord du client. Les espaces réservés « [À compléter …] » sont à remplacer ou à supprimer avant publication." },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qu'en disent nos clients" },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "select", "id": "height", "label": "Hauteur des cartes", "default": "large", "options": [{ "value": "medium", "label": "Moyenne" }, { "value": "large", "label": "Grande" }, { "value": "full", "label": "Plein écran" }] },
    { "type": "checkbox", "id": "autoplay", "label": "Défilement automatique", "default": true, "info": "Désactivé automatiquement si le visiteur a demandé moins d'animations ; un bouton permet de le mettre en pause." },
    { "type": "range", "id": "speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Durée d'affichage de chaque avis", "default": 7 },
    { "type": "checkbox", "id": "show_stars", "label": "Afficher les étoiles", "default": true },
    { "type": "checkbox", "id": "show_app_rating", "label": "Afficher la note de l'application d'avis", "default": false, "info": "Note réelle fournie par votre application d'avis (métachamps reviews.rating et reviews.rating_count) : produit de la page, sinon le produit choisi ci-dessous. Sans note, rien ne s'affiche." },
    { "type": "product", "id": "product", "label": "Produit (hors page produit)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    { "type": "review", "name": "Avis", "settings": [
      { "type": "paragraph", "content": "Uniquement de vrais avis, recopiés avec l'accord du client." },
      { "type": "textarea", "id": "quote", "label": "Avis", "default": "[À compléter : avis réel d'un client]" },
      { "type": "text", "id": "author", "label": "Prénom du client", "default": "[Prénom]" },
      { "type": "text", "id": "detail", "label": "Précision (ville, produit acheté…)" },
      { "type": "select", "id": "rating", "label": "Note", "default": "0", "options": [{ "value": "0", "label": "Sans note" }, { "value": "5", "label": "5 / 5" }, { "value": "4", "label": "4 / 5" }, { "value": "3", "label": "3 / 5" }, { "value": "2", "label": "2 / 5" }, { "value": "1", "label": "1 / 5" }] },
      { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": false, "info": "Cochez seulement si l'achat est confirmé par votre boutique ou votre application d'avis." },
      { "type": "image_picker", "id": "image", "label": "Photo (avec accord)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "video", "id": "video", "label": "Vidéo (hébergée par Shopify)" },
      { "type": "video_url", "id": "video_url", "label": "Vidéo YouTube ou Vimeo", "accept": ["youtube", "vimeo"] },
      { "type": "text", "id": "video_asset", "label": "Vidéo fournie avec le thème (MP4)" }
    ] }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Avis clients immersifs", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
