{%- comment -%}
  FRAISE : questions fréquentes (planches 03 et 06) — recherche, catégories Produit / Utilisation / Commande (filtres
  combinés à la recherche, état « aucune réponse » utile), questions dépliables ; à droite (ordinateur) : photo avec mot
  manuscrit et encart « Une autre question ? ». Les réponses renvoient à l'étiquette et aux pages d'aide : rien d'inventé.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="fg fg-faq" data-fg-faq aria-label="{{ s.label | escape }}">
  <div class="fg-c">
    <div class="fg-faq__main">
      <label class="fg-faq__search">{% render 'fg-icon', name: 'search' %}<span class="visually-hidden">{{ s.search_label }}</span><input type="search" placeholder="{{ s.search_placeholder | escape }}" data-fg-faq-search></label>
      {%- assign cats = s.filters | split: ',' -%}
      <div class="fg-faq__filters" role="group" aria-label="{{ s.filters_label | escape }}">
        {%- for c in cats -%}{%- assign cn = c | strip -%}<button type="button" class="fg-faq__pill" aria-pressed="false" data-fg-faq-filter="{{ cn | handleize }}">{{ cn }}</button>{%- endfor -%}
      </div>
      <div class="fg-faq__list">
        {%- for block in section.blocks -%}
          <details class="fg-faq__item" data-cat="{{ block.settings.category | handleize }}"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question }}</span>{% render 'fg-icon', name: 'down', class: 'fg-faq__chev' %}</summary>
            <div class="fg-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
      <p class="fg-faq__empty" role="status" hidden data-fg-faq-empty>{{ s.empty_text }} <a href="{{ s.contact_link | default: routes.root_url }}">{{ s.contact_button }}</a></p>
    </div>
    <aside class="fg-faq__side">
      {%- if s.image != blank or s.image_asset != blank -%}
        <div class="fg-faq__photo">{% render 'fg-img', image: s.image, asset: s.image_asset, alt: '', pos: s.image_position, zoom: s.image_zoom, class: 'fg-faq__img' %}{%- if s.bubble != blank -%}<p class="fg-faq__bubble"><span class="fg-hand">{{ s.bubble | escape | newline_to_br }}</span></p>{%- endif -%}</div>
      {%- endif -%}
      <div class="fg-faq__help">
        <p class="fg-faq__ht">{{ s.contact_title }}</p>
        <p class="fg-faq__hx">{{ s.contact_text }}</p>
        <a class="fg-btn fg-btn--red fg-faq__btn" href="{{ s.contact_link | default: routes.root_url }}">{{ s.contact_button }}{% render 'fg-icon', name: 'arrow' %}</a>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Questions fréquentes",
  "class": "fg-faq-section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "label", "label": "Nom (lecteurs d'écran)", "default": "Questions fréquentes" },
    { "type": "text", "id": "search_label", "label": "Recherche (lecteurs d'écran)", "default": "Rechercher une question" },
    { "type": "text", "id": "search_placeholder", "label": "Texte du champ", "default": "Rechercher une question…" },
    { "type": "text", "id": "filters", "label": "Catégories (séparées par des virgules)", "default": "Produit, Utilisation, Commande" },
    { "type": "text", "id": "filters_label", "label": "Catégories (lecteurs d'écran)", "default": "Catégories de questions" },
    { "type": "text", "id": "empty_text", "label": "Aucune réponse", "default": "Aucune réponse ne correspond à votre recherche. Écrivez-nous :" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
    { "type": "text", "id": "image_position", "label": "Cadrage", "default": "50% 50%" },
    { "type": "range", "id": "image_zoom", "label": "Agrandissement", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
    { "type": "textarea", "id": "bubble", "label": "Mot manuscrit" },
    { "type": "text", "id": "contact_title", "label": "Encart : titre", "default": "Une autre question ?" },
    { "type": "text", "id": "contact_text", "label": "Encart : texte", "default": "Notre équipe est là pour vous aider." },
    { "type": "text", "id": "contact_button", "label": "Encart : bouton", "default": "Nous contacter" },
    { "type": "url", "id": "contact_link", "label": "Encart : lien" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "category", "label": "Catégorie" },
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Réponse" }
    ] }
  ],
  "presets": [{ "name": "Questions fréquentes" }]
}
{% endschema %}
