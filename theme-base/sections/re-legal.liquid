{%- comment -%}
  Informations légales à onglets (Maison & Horizon, planche 07) : mentions, honoraires, confidentialité, cookies…
  Un onglet par bloc ; l'adresse « #identifiant » ouvre l'onglet voulu (lien depuis le pied de page ou le bandeau de
  cookies). Les informations professionnelles manquantes restent « à renseigner » : rien n'est inventé.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="es-section re-legal color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;" data-re-legal data-initial="{{ s.initial_tab | handleize }}">
  <div class="es-container re-legal__grid">
    <div class="re-legal__main">
      <h1 class="re-title">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<p class="re-muted">{{ s.text | escape }}</p>{%- endif -%}
      <div class="re-tabs re-tabs--line" role="tablist" aria-label="{{ s.heading | escape }}">
        {%- for block in section.blocks -%}
        {%- assign tab_id = block.settings.anchor | default: block.settings.title | handleize -%}
        <button type="button" role="tab" id="Onglet-{{ tab_id }}" class="re-tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="Panneau-{{ tab_id }}"{% unless forloop.first %} tabindex="-1"{% endunless %} data-re-legal-tab="{{ tab_id }}" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</button>
        {%- endfor -%}
      </div>
      {%- if s.notice != blank -%}<p class="re-notice re-notice--warn">{% render 'mh-icon', name: 'info' %}<span>{{ s.notice | escape }}</span></p>{%- endif -%}
      {%- for block in section.blocks -%}
      {%- assign tab_id = block.settings.anchor | default: block.settings.title | handleize -%}
      <div class="re-legal__panel" role="tabpanel" id="Panneau-{{ tab_id }}" aria-labelledby="Onglet-{{ tab_id }}"{% unless forloop.first %} hidden{% endunless %} tabindex="0">
        <h2 class="re-legal__title">{{ block.settings.heading | default: block.settings.title | escape }}</h2>
        <div class="re-legal__body">{{ block.settings.body }}</div>
        {%- if block.settings.cookie_button -%}<p><a class="re-btn re-btn--line" href="#cookies">{{ block.settings.cookie_button_label | default: 'Modifier mes choix de cookies' | escape }}</a></p>{%- endif -%}
      </div>
      {%- endfor -%}
      {%- if s.contact_text != blank -%}<p class="re-muted re-legal__contact">{{ s.contact_text }}</p>{%- endif -%}
    </div>
    {%- if s.image != blank or s.image_asset != blank -%}
    <div class="re-legal__media">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, loading: 'lazy' %}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Informations légales",
  "tag": "div",
  "class": "section-re-legal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Informations légales" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "text", "id": "notice", "label": "Avertissement", "default": "Les contenus de cette page sont à compléter et à valider avant publication." },
    { "type": "text", "id": "initial_tab", "label": "Onglet ouvert d'office (identifiant)", "info": "Ex. « cookies ». Vide : le premier onglet." },
    { "type": "inline_richtext", "id": "contact_text", "label": "Phrase de contact" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
    { "type": "text", "id": "image_alt", "label": "Description de la photo" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Onglet",
      "settings": [
        { "type": "text", "id": "title", "label": "Nom de l'onglet" },
        { "type": "text", "id": "anchor", "label": "Identifiant (adresse #…)" },
        { "type": "text", "id": "heading", "label": "Titre du contenu" },
        { "type": "richtext", "id": "body", "label": "Contenu" },
        { "type": "checkbox", "id": "cookie_button", "label": "Bouton pour modifier les choix de cookies", "default": false, "info": "Rouvre le bandeau de cookies du thème (réglages du thème › Cookies)." },
        { "type": "text", "id": "cookie_button_label", "label": "Libellé du bouton", "default": "Modifier mes choix de cookies" }
      ]
    }
  ],
  "presets": [ { "name": "Informations légales", "blocks": [ { "type": "tab" } ] } ]
}
{% endschema %}
