{%- comment -%}
  TABLE SAISON : produits de saison : texte et lien à gauche, quatre photos d'ingrédients à droite (deux par ligne sur
  téléphone). Une photo sans fichier n'est pas affichée.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ts-section ts-ingredients">
  <div class="ts-ingredients__text">
    {%- if s.eyebrow != blank -%}<p class="ts-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="ts-title ts-title--l">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="ts-text">{{ s.text }}</div>{%- endif -%}
    {%- if s.link_label != blank -%}<a class="ts-link" href="{{ s.link | default: '/pages/le-lieu' }}">{{ s.link_label }} {% render 'ts-icon', name: 'arrow' %}</a>{%- endif -%}
  </div>
  <div class="ts-ingredients__tiles">
    {%- for block in section.blocks -%}
      {%- capture pic -%}{% render 'ts-img', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.alt, pos: block.settings.image_position, sizes: '(min-width: 750px) 14vw, 50vw' %}{%- endcapture -%}
      {%- if pic != blank -%}<div {{ block.shopify_attributes }}>{{ pic }}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Produits de saison",
  "class": "ts-ingredients-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit texte au-dessus", "default": "Des produits de saison" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "L'authenticité commence par de beaux ingrédients." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "link_label", "label": "Texte du lien" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
      { "type": "text", "id": "alt", "label": "Description de l'image" }
    ] }
  ],
  "presets": [{ "name": "Produits de saison" }]
}
{% endschema %}
