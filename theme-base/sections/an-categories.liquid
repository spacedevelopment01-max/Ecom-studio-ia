{%- comment -%}
  ATELIER NUANCE : trois catégories (Coupe & coiffage, Couleur & lumière, Soin & rituel) avec photo, texte et lien.
  Ordinateur : trois colonnes. Téléphone : lignes compactes avec vignette et flèche ronde (planche 04).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign shown = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.image_asset != blank
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 -%}
<section class="an-section an-categories">
  <div class="an-wrap">
    {%- if s.heading != blank -%}<h2 class="an-title an-title--md">{{ s.heading }}</h2>{%- endif -%}
    <ul class="an-categories__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="an-categories__item" {{ block.shopify_attributes }}>
          <a class="an-categories__link" href="{{ b.link | default: '/pages/prestations' }}">
            {% render 'an-img', image: b.image, asset: b.image_asset, alt: b.image_alt, pos: b.image_position, class: 'an-categories__img' %}
            <span class="an-categories__body">
              <span class="an-categories__name">{{ b.heading }}</span>
              {%- if b.text != blank -%}<span class="an-categories__text">{{ b.text }}</span>{%- endif -%}
              {%- if b.link_label != blank -%}<span class="an-categories__more">{{ b.link_label }}{% render 'an-icon', name: 'arrow' %}</span>{%- endif -%}
            </span>
            <span class="an-round" aria-hidden="true">{% render 'an-icon', name: 'next' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Catégories du salon",
  "class": "an-categories-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (facultatif)" }
  ],
  "blocks": [
    {
      "type": "category", "name": "Catégorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Coupe & coiffage" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Catégories du salon" }]
}
{% endschema %}
