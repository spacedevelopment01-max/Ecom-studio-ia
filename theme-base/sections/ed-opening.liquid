{% assign s = section.settings %}
<section class="ed-section ed-opening ed-opening--{{ s.layout }}{% if s.copy_surface == false %} ed-opening--clear{% endif %} color-{{ s.color_scheme }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-ed-motion="{{ s.motion }}" style="--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;">
<div class="ed-shell">
 <header class="ed-opening__copy">{% if s.label != blank %}<p class="ed-kicker">{{ s.label | escape }}</p>{% endif %}
 <{{ s.heading_tag }} class="ed-title ed-opening__title" data-ed-title>{{ s.heading | escape | newline_to_br }}</{{ s.heading_tag }}>
 <div class="ed-prose">{{ s.text }}</div>{% if s.button_label != blank and s.button_link != blank %}<a class="ed-button" href="{{ s.button_link }}">{{ s.button_label | escape }}<span aria-hidden="true">↗</span></a>{% endif %}</header>
 <div class="ed-opening__media">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y, mobile_focus_x: s.mobile_focus_x, mobile_focus_y: s.mobile_focus_y, mobile_image: s.mobile_image, mobile_asset: s.mobile_image_asset, loading: 'eager' %}</div>
 {% if s.caption != blank %}<p class="ed-caption">{{ s.caption | escape }}</p>{% endif %}
</div></section>
{% schema %}
{
  "name": "Ouverture photographique",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre de navigation"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Mouvement",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "reveal",
          "label": "Entrée unique"
        },
        {
          "value": "drift",
          "label": "Déplacement léger"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "label",
      "label": "Repère éditorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du lien"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Destination"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fichier du projet"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image sur téléphone",
      "info": "Cadrage vertical propre au téléphone (le produit entier, visible). Vide : l’image principale est recadrée selon le point focal mobile."
    },
    {
      "type": "text",
      "id": "mobile_image_asset",
      "label": "Fichier du projet (téléphone)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Rôle du visuel attendu"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Point focal horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Point focal vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_focus_x",
      "label": "Point focal horizontal (mobile)",
      "info": "Vide : même cadrage que sur ordinateur.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_focus_y",
      "label": "Point focal vertical (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Composition d’ouverture",
      "options": [
        {
          "value": "immersive",
          "label": "Promesse dans la scène"
        },
        {
          "value": "arch",
          "label": "Arche et promesse"
        },
        {
          "value": "journal",
          "label": "Titre puis paysage"
        },
        {
          "value": "fullscreen",
          "label": "Plein écran"
        },
        {
          "value": "ecrin",
          "label": "Écrin sombre, photo jusqu’au bord"
        },
        {
          "value": "cartouche",
          "label": "Photo pleine largeur et cartouche"
        }
      ],
      "default": "journal"
    },
    {
      "type": "checkbox",
      "id": "copy_surface",
      "label": "Voile clair sous le texte",
      "info": "Décoché : le texte se pose directement sur la zone calme de la photographie.",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre",
      "options": [
        {
          "value": "h1",
          "label": "Titre de page"
        },
        {
          "value": "h2",
          "label": "Titre de section"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende"
    }
  ],
  "presets": [
    {
      "name": "Ouverture photographique"
    }
  ]
}
{% endschema %}
