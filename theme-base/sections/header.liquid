{%- liquid
  assign menu = linklists[section.settings.menu]
  assign transparent = false
  if section.settings.transparent_on_home and request.page_type == 'index'
    assign transparent = true
  endif
  assign shape = section.settings.shape
  if shape == 'theme'
    assign shape = settings.header_shape
  endif
  assign phone_href = section.settings.phone | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
  comment
    Bouton d'action (site de services) : lien saisi, sinon appel du numéro de téléphone.
  endcomment
  assign cta_href = section.settings.cta_link
  assign cta_external = false
  if cta_href == blank and section.settings.phone != blank
    assign cta_href = 'tel:' | append: phone_href
  elsif cta_href == blank
    assign cta_href = routes.root_url
  endif
  if cta_href contains '://'
    assign cta_external = true
  endif
  assign mega = section.settings.mega_menu | default: 'none'
-%}
<header class="es-header es-header--{{ section.settings.layout }} es-header--shape-{{ shape }} es-header--icons-{{ section.settings.icons }}{% if section.settings.sticky %} es-header--sticky{% endif %}{% if transparent %} es-header--transparent{% endif %} color-{{ section.settings.color_scheme }}" data-header>
  <div class="es-header__inner es-container">
    <button class="es-header__burger es-icon-button" type="button" aria-controls="MobileMenu" aria-expanded="false" data-menu-open>
      {% render 'icon', name: 'menu' %}<span class="visually-hidden">{{ 'sections.header.menu' | t }}</span>
    </button>

    <a href="{{ routes.root_url }}" class="es-header__logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 600 | image_tag: class: 'es-header__logo-img', widths: '150, 300, 600', sizes: '200px', alt: shop.name, loading: 'eager' }}
      {%- elsif settings.logo_asset != blank -%}
        <img src="{{ settings.logo_asset | asset_url }}" alt="{{ shop.name | escape }}" class="es-header__logo-img" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: 3 }}" loading="eager">
      {%- else -%}
        <span class="es-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="es-header__nav" aria-label="{{ 'sections.header.navigation' | t }}">
      <ul role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign has_children = false
            if link.links.size > 0
              assign has_children = true
            endif
          -%}
          <li class="es-nav__item{% if has_children %} es-nav__item--parent{% if mega != 'none' %} es-nav__item--mega{% endif %}{% endif %}">
            <a href="{{ link.url }}" class="es-nav__link"{% if link.active %} aria-current="page"{% endif %}{% if has_children %} aria-haspopup="true"{% endif %}>
              {%- if section.settings.desktop_icons %}{% render 'es-link-extra', blocks: section.blocks, title: link.title, mode: 'icon' %}{% endif -%}
              <span>{{ link.title }}</span>
              {%- if has_children %}<span class="es-nav__caret" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>{% endif -%}
            </a>
            {%- if has_children -%}
              {%- if mega == 'none' -%}
                <ul class="es-dropdown color-{{ section.settings.color_scheme }}" role="list">
                  {%- for child in link.links -%}
                    <li>
                      <a href="{{ child.url }}">{% render 'es-link-extra', blocks: section.blocks, title: child.title, mode: 'icon' %}<span>{{ child.title }}</span></a>
                      {%- if child.links.size > 0 -%}
                        <ul class="es-dropdown__sub" role="list">
                          {%- for grandchild in child.links -%}<li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>{%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <div class="es-mega es-mega--{{ mega }} color-{{ section.settings.color_scheme }}">
                  <div class="es-container es-mega__inner">
                    {%- if mega == 'featured' -%}
                      <div class="es-mega__promos es-mega__promos--lead">{% render 'es-menu-promo', blocks: section.blocks, where: 'mega', menu_title: link.title, limit: 1, size: 'large' %}</div>
                    {%- endif -%}
                    <div class="es-mega__links">
                      {%- for child in link.links -%}
                        {%- if mega == 'cards' -%}
                          {%- capture card_img -%}{% render 'es-link-extra', blocks: section.blocks, title: child.title, mode: 'image', class: 'es-mega__card-img' %}{%- endcapture -%}
                          <a href="{{ child.url }}" class="es-mega__card">
                            {%- if card_img != blank -%}{{ card_img }}{%- else -%}<span class="es-link-img es-mega__card-img es-mega__card-img--empty" aria-hidden="true">{{ child.title | slice: 0 }}</span>{%- endif -%}
                            <span class="es-mega__card-title">{% render 'es-link-extra', blocks: section.blocks, title: child.title, mode: 'icon' %}<span>{{ child.title }}</span></span>
                          </a>
                        {%- else -%}
                          <div class="es-mega__col">
                            <a href="{{ child.url }}" class="es-mega__heading">{% render 'es-link-extra', blocks: section.blocks, title: child.title, mode: 'icon' %}<span>{{ child.title }}</span></a>
                            {%- if child.links.size > 0 -%}
                              <ul role="list">
                                {%- for grandchild in child.links -%}<li><a href="{{ grandchild.url }}">{% render 'es-link-extra', blocks: section.blocks, title: grandchild.title, mode: 'icon' %}<span>{{ grandchild.title }}</span></a></li>{%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                      <a href="{{ link.url }}" class="es-mega__all">{{ 'sections.header.see_all' | t }} {% render 'icon', name: 'arrow' %}</a>
                    </div>
                    {%- if mega == 'columns-promo' or mega == 'cards' -%}
                      <div class="es-mega__promos">{% render 'es-menu-promo', blocks: section.blocks, where: 'mega', menu_title: link.title, limit: 2, size: 'small' %}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="es-header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="es-icon-button" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="es-icon-button es-hide-mobile" aria-label="{{ 'customer.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ phone_href }}" class="es-icon-button es-header__phone{% if section.settings.cta_label != blank %} es-header__phone--compact{% endif %}" aria-label="{{ 'sections.header.call' | t }} {{ section.settings.phone | escape }}">{% render 'icon', name: 'phone' %}<span class="es-header__phone-number">{{ section.settings.phone }}</span></a>
      {%- endif -%}
      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="es-icon-button es-cart-link" data-cart-open aria-label="{{ 'cart.title' | t }}">
          {% render 'icon', name: 'cart' %}
          <span class="es-cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ cta_href }}" class="es-button es-button--small es-header__cta"{% if cta_external %} target="_blank" rel="noopener"{% endif %}>{% render 'icon', name: section.settings.cta_icon %}<span>{{ section.settings.cta_label }}</span></a>
      {%- endif -%}
    </div>
  </div>

  <div class="es-mobile-menu es-mobile-menu--{{ section.settings.mobile_menu }} es-mobile-menu--sub-{{ section.settings.mobile_submenu }} color-{{ section.settings.color_scheme }}" id="MobileMenu" hidden data-mobile-menu>
    <div class="es-mobile-menu__head">
      <span class="es-header__wordmark">{{ shop.name }}</span>
      <button type="button" class="es-icon-button" data-menu-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    {%- if section.settings.mobile_promo == 'top' -%}
      <div class="es-mobile-menu__promos">{% render 'es-menu-promo', blocks: section.blocks, where: 'mobile', limit: 2, size: 'small' %}</div>
    {%- endif -%}
    <ul role="list" class="es-mobile-menu__list">
      {%- for link in menu.links -%}
        <li style="--i: {{ forloop.index }}">
          {%- if link.links.size > 0 -%}
            <details class="es-mm__group"{% if section.settings.mobile_submenu == 'open' %} open{% endif %}>
              <summary class="es-mm__link">{% render 'es-link-extra', blocks: section.blocks, title: link.title, mode: 'icon' %}<span>{{ link.title }}</span><span class="es-mm__caret" aria-hidden="true">{% render 'icon', name: 'plus' %}</span></summary>
              <ul role="list" class="es-mm__sub">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}">{% render 'es-link-extra', blocks: section.blocks, title: child.title, mode: 'icon' %}<span>{{ child.title }}</span></a>
                    {%- if child.links.size > 0 -%}
                      <ul role="list" class="es-mm__sub2">
                        {%- for grandchild in child.links -%}<li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>{%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                <li><a href="{{ link.url }}" class="es-mm__all">{{ 'sections.header.see_all' | t }}</a></li>
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="es-mm__link">{% render 'es-link-extra', blocks: section.blocks, title: link.title, mode: 'icon' %}<span>{{ link.title }}</span></a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.mobile_promo == 'bottom' -%}
      <div class="es-mobile-menu__promos">{% render 'es-menu-promo', blocks: section.blocks, where: 'mobile', limit: 2, size: 'small' %}</div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ cta_href }}" class="es-button es-button--full es-mobile-menu__cta"{% if cta_external %} target="_blank" rel="noopener"{% endif %}>{% render 'icon', name: section.settings.cta_icon %}<span>{{ section.settings.cta_label }}</span></a>
    {%- endif -%}
    {%- if section.settings.phone != blank -%}
      <a href="tel:{{ phone_href }}" class="es-mobile-menu__phone">{% render 'icon', name: 'phone' %}<span>{{ section.settings.phone }}</span></a>
    {%- endif -%}
    {% render 'social-icons' %}
  </div>
</header>

{% stylesheet %}
.es-header__cta { min-height: 44px; padding: .55em 1.25em; gap: 8px; white-space: nowrap; margin-left: 10px; }
.es-header__cta .es-icon { width: 16px; height: 16px; flex: none; }
.es-header__cta:hover .es-icon { transform: none; }
.es-header__phone { display: inline-flex; align-items: center; border-radius: 999px; width: auto; gap: 8px; padding-inline: 10px; text-decoration: none; font-size: .9rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
.es-header__phone .es-icon { flex: none; }
.es-header__phone--compact .es-header__phone-number { display: none; }
.es-mobile-menu__cta { margin-top: auto; }
.es-mobile-menu__cta .es-icon { width: 18px; height: 18px; }
.es-mobile-menu__phone { display: inline-flex; align-items: center; gap: 10px; font-size: 1.15rem; text-decoration: none; font-variant-numeric: tabular-nums; }
.es-mobile-menu__phone .es-icon { width: 20px; height: 20px; color: var(--c-accent); }
@media (min-width: 1200px) { .es-header__phone--compact .es-header__phone-number { display: inline; } }
@media (max-width: 989px) {
  .es-header__cta { padding: 0; width: 44px; min-width: 44px; margin-left: 4px; border-radius: 50%; justify-content: center; }
  .es-header__cta span { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .es-header__phone .es-header__phone-number { display: none; }
  .es-header__phone { padding-inline: 0; width: 44px; justify-content: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "En-tête",
  "class": "es-header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "select", "id": "layout", "label": "Disposition", "default": "logo-left",
      "options": [
        { "value": "logo-left", "label": "Logo à gauche, menu au centre" },
        { "value": "logo-center", "label": "Logo centré, menu dessous" },
        { "value": "split", "label": "Menu à gauche, logo centré" },
        { "value": "minimal", "label": "Minimal (menu dans le tiroir)" },
        { "value": "menu-right", "label": "Logo à gauche, menu à droite" },
        { "value": "nav-left", "label": "Logo et menu à gauche" },
        { "value": "two-rows", "label": "Deux lignes (menu sur une barre dessous)" }
      ]
    },
    {
      "type": "select", "id": "shape", "label": "Forme", "default": "theme",
      "options": [
        { "value": "theme", "label": "Selon le style du thème" },
        { "value": "floating", "label": "Verre flottant, coins arrondis" },
        { "value": "boxed", "label": "Encadré blanc, à distance des bords" },
        { "value": "pill", "label": "Pilule centrée" },
        { "value": "bar", "label": "Barre classique" }
      ]
    },
    { "type": "select", "id": "icons", "label": "Icônes", "default": "circles", "options": [ { "value": "circles", "label": "Dans des pastilles rondes" }, { "value": "plain", "label": "Simples" } ] },
    { "type": "header", "content": "Sous-menus et méga menu" },
    {
      "type": "select", "id": "mega_menu", "label": "Méga menu", "default": "none",
      "info": "S'ouvre au survol des liens qui ont des sous-liens. « Aucun » : simple liste déroulante.",
      "options": [
        { "value": "none", "label": "Aucun (liste déroulante simple)" },
        { "value": "columns", "label": "Colonnes de liens" },
        { "value": "columns-promo", "label": "Colonnes + encarts promo à droite" },
        { "value": "cards", "label": "Cartes avec images + encarts promo" },
        { "value": "featured", "label": "Grand encart promo à gauche + colonnes" }
      ]
    },
    { "type": "checkbox", "id": "desktop_icons", "label": "Afficher les icônes devant les liens du menu principal", "default": false, "info": "Les icônes se choisissent avec les blocs « Icône ou image d'un lien »." },
    { "type": "header", "content": "Menu sur téléphone (burger)" },
    {
      "type": "select", "id": "mobile_menu", "label": "Disposition du menu", "default": "fullscreen",
      "options": [
        { "value": "fullscreen", "label": "Plein écran, grands titres" },
        { "value": "drawer", "label": "Tiroir à gauche" },
        { "value": "drawer-right", "label": "Tiroir à droite" },
        { "value": "sheet", "label": "Panneau qui monte du bas" },
        { "value": "cards", "label": "Tuiles (grille de cases)" }
      ]
    },
    { "type": "select", "id": "mobile_submenu", "label": "Sous-menus", "default": "accordion", "options": [ { "value": "accordion", "label": "Repliés (s'ouvrent au toucher)" }, { "value": "open", "label": "Toujours ouverts" } ] },
    { "type": "select", "id": "mobile_promo", "label": "Encarts promo dans le menu", "default": "none", "options": [ { "value": "none", "label": "Aucun" }, { "value": "top", "label": "En haut du menu" }, { "value": "bottom", "label": "En bas du menu" } ] },
    { "type": "checkbox", "id": "sticky", "label": "Rester visible au défilement", "default": true },
    { "type": "checkbox", "id": "transparent_on_home", "label": "Transparent au-dessus de la première section de l'accueil", "default": false },
    { "type": "checkbox", "id": "show_search", "label": "Afficher la recherche", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Afficher le panier", "default": true, "info": "Décochez pour un site vitrine ou de services, sans vente en ligne." },
    { "type": "header", "content": "Bouton d'action" },
    { "type": "text", "id": "cta_label", "label": "Texte du bouton", "info": "Ex. « Prendre rendez-vous », « Demander un devis ». Laissez vide pour ne pas l'afficher." },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton", "info": "Vide : appelle le numéro de téléphone ci-dessous." },
    { "type": "select", "id": "cta_icon", "label": "Icône du bouton", "default": "clock", "options": [{ "value": "clock", "label": "Horloge" }, { "value": "phone", "label": "Téléphone" }, { "value": "mail", "label": "E-mail" }, { "value": "chat", "label": "Message" }, { "value": "arrow", "label": "Flèche" }] },
    { "type": "text", "id": "phone", "label": "Téléphone affiché", "info": "Facultatif. Numéro cliquable pour appeler depuis un téléphone." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" }
  ],
  "max_blocks": 24,
  "blocks": [
    {
      "type": "link_extra", "name": "Icône ou image d'un lien",
      "settings": [
        { "type": "text", "id": "link_title", "label": "Titre du lien", "info": "Écrivez exactement le titre du lien ou du sous-lien du menu (ex. « Boutique »)." },
        { "type": "select", "id": "icon", "label": "Icône devant le lien", "default": "none", "options": [{"value": "none", "label": "Aucune"}, {"value": "leaf", "label": "Feuille"}, {"value": "truck", "label": "Camion"}, {"value": "return", "label": "Retour"}, {"value": "sparkle", "label": "Étincelle"}, {"value": "drop", "label": "Goutte"}, {"value": "hand", "label": "Main"}, {"value": "shield", "label": "Bouclier"}, {"value": "star", "label": "Étoile"}, {"value": "bolt", "label": "Éclair"}, {"value": "heart", "label": "Cœur"}, {"value": "globe", "label": "Globe"}, {"value": "clock", "label": "Horloge"}, {"value": "waves", "label": "Vagues"}, {"value": "gift", "label": "Cadeau"}, {"value": "phone", "label": "Téléphone"}, {"value": "mail", "label": "E-mail"}, {"value": "chat", "label": "Message"}, {"value": "check", "label": "Coche"}, {"value": "account", "label": "Compte"}, {"value": "cart", "label": "Panier"}, {"value": "search", "label": "Loupe"}, {"value": "compare", "label": "Comparer"}, {"value": "sound", "label": "Son"}, {"value": "arrow", "label": "Flèche"}] },
        { "type": "image_picker", "id": "image", "label": "Image (cartes du méga menu)" },
        { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" }
      ]
    },
    {
      "type": "promo", "name": "Encart promo du menu",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
        { "type": "text", "id": "eyebrow", "label": "Petit texte au-dessus", "default": "Nouveauté" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Découvrez la collection" },
        { "type": "text", "id": "button_label", "label": "Texte du lien", "default": "Voir" },
        { "type": "url", "id": "link", "label": "Lien" },
        {
          "type": "select", "id": "placement", "label": "Où l'afficher", "default": "both",
          "options": [ { "value": "both", "label": "Méga menu et menu téléphone" }, { "value": "mega", "label": "Méga menu seulement" }, { "value": "mobile", "label": "Menu téléphone seulement" } ]
        },
        { "type": "text", "id": "menu_title", "label": "Seulement sous le lien", "info": "Facultatif. Titre d'un lien du menu principal : l'encart n'apparaît que dans son méga menu." }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
