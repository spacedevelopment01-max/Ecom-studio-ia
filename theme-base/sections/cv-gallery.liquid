{%- comment -%}
  Galerie de mises en situation : grille ou carrousel de visuels avec légende, visionneuse plein écran (boîte de
  dialogue, clavier, Échap). Les visuels gardent leur format réglé ; le produit n'est jamais déformé.
  « Carrousel sur téléphone » (maquettes NOCTIL) : la grille d'ordinateur défile une image à la fois sur téléphone.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign speed = s.animation_speed | default: 'normal'
-%}
<section class="es-section cv-gallery cv-gallery--{{ s.layout }} cv-gallery--{{ s.ratio }}{% if s.mobile_carousel %} cv-gallery--mcarousel{% endif %} cv-anim cv-anim--{{ speed }} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--cols:{{ s.columns }}" data-cv-gallery>
  <div class="es-container">
    {%- if s.heading != blank -%}
      <header class="cv-head"{% render 'cv-reveal', animation: s.animation %}>
        {%- if s.eyebrow != blank -%}<p class="cv-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="es-heading cv-title cv-title--h2">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-head__text">{{ s.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="cv-gallery__track" data-cv-track{% if s.layout == 'carousel' %} tabindex="0" aria-label="{{ s.heading | default: 'conversion.gallery' | escape }}"{% endif %}>
      {%- for block in section.blocks -%}
        <figure class="cv-gallery__item cv-zoomable" data-cv-slide {{ block.shopify_attributes }}{% render 'cv-reveal', animation: s.animation, index: forloop.index0 %}>
          <button type="button" class="cv-gallery__open" data-cv-gallery-open="{{ forloop.index0 }}" aria-label="{{ 'conversion.gallery_open' | t }} {{ block.settings.caption | default: block.settings.image_alt | escape }}">
            {% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.image_alt, role_label: block.settings.media_role, focus_x: block.settings.focus_x, focus_y: block.settings.focus_y %}
          </button>
          {%- if block.settings.caption != blank or s.ai_label != blank -%}
            <figcaption class="cv-gallery__caption">{% if block.settings.caption != blank %}<span>{{ block.settings.caption | escape }}</span>{% endif %}{% if s.ai_label != blank %}<span class="cv-fictional">{{ s.ai_label | escape }}</span>{% endif %}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if s.layout == 'carousel' and section.blocks.size > 1 -%}
      <div class="cv-nav" aria-hidden="false">
        <button type="button" class="cv-arrow" data-cv-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
        <div class="cv-dots" role="tablist">{% for block in section.blocks %}<button type="button" class="cv-dot{% if forloop.first %} is-active{% endif %}" role="tab" data-cv-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}"></button>{% endfor %}</div>
        <button type="button" class="cv-arrow" data-cv-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
    {%- endif -%}
  </div>
  <dialog class="cv-lightbox" data-cv-lightbox aria-label="{{ s.heading | default: 'conversion.gallery' | escape }}">
    <button type="button" class="cv-lightbox__close es-icon-button" data-cv-lightbox-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <button type="button" class="cv-lightbox__prev cv-arrow" data-cv-lightbox-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
    <figure class="cv-lightbox__figure"><img data-cv-lightbox-img alt="" width="1200" height="1200" hidden><figcaption data-cv-lightbox-caption></figcaption></figure>
    <button type="button" class="cv-lightbox__next cv-arrow" data-cv-lightbox-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
  </dialog>
</section>

{% schema %}
{
  "name": "Galerie en situation",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "En situation"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre en accent"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grille"
        },
        {
          "value": "carousel",
          "label": "Carrousel"
        },
        {
          "value": "mosaic",
          "label": "Mosaïque (premier visuel plus grand)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Carrousel sur téléphone",
      "info": "Sur téléphone, les éléments défilent un à un au lieu de s'empiler.",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Format des visuels",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Carré"
        },
        {
          "value": "landscape",
          "label": "Paysage 4:3"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "natural",
          "label": "Naturel"
        }
      ]
    },
    {
      "type": "text",
      "id": "ai_label",
      "label": "Mention sur chaque visuel",
      "info": "Ex. « Image IA — démonstration ». Vide : aucune mention."
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "rise",
      "options": [
        {
          "value": "none",
          "label": "Aucune"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée en fondu"
        },
        {
          "value": "zoom",
          "label": "Léger zoom"
        }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Vitesse",
      "default": "normal",
      "options": [
        {
          "value": "slow",
          "label": "Lente"
        },
        {
          "value": "normal",
          "label": "Normale"
        },
        {
          "value": "fast",
          "label": "Rapide"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en dessous",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Visuel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Visuel"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fichier image fourni avec le thème"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Description du visuel"
        },
        {
          "type": "text",
          "id": "media_role",
          "label": "Rôle du visuel attendu"
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Point focal horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y",
          "label": "Point focal vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Galerie en situation",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
