{%- comment -%}
  FRAISE : « Un petit mot ? » (planches 03 et 06) — grande photo à gauche au bord arrondi, titre, texte, formulaire (nom,
  e-mail, sujet, message, consentement VOLONTAIRE décoché), erreurs par champ ; trois cartes d'aide (FAQ, suivi,
  livraison). Démonstration : envoi simulé et annoncé comme tel ; boutique réelle : formulaire de contact Shopify.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="fg fg-contact" aria-labelledby="fg-contact-t-{{ section.id }}">
  <div class="fg-c">
    {% render 'fg-img', image: s.image, asset: s.image_asset, alt: s.image_alt, pos: s.image_position, zoom: s.image_zoom, pos_mobile: s.image_position_mobile, zoom_mobile: s.image_zoom_mobile, class: 'fg-contact__photo' %}
    <div class="fg-contact__main">
      <h1 class="fg-title fg-contact__title" id="fg-contact-t-{{ section.id }}">{{ s.heading }}<span class="fg-contact__petal" aria-hidden="true">{% render 'fg-art', name: 'petal' %}</span></h1>
      {%- if s.text != blank -%}<p class="fg-contact__lead">{{ s.text | escape | newline_to_br }}</p>{%- endif -%}
      {%- form 'contact', class: 'fg-contact__form', data-fg-contact: s.mode -%}
        <div class="fg-co__grid">
          <label class="fg-field"><span>{{ s.name_label }} <b aria-hidden="true">*</b></span><input type="text" name="contact[name]" autocomplete="name" required placeholder="{{ s.name_ph | escape }}"><span class="fg-field__err" hidden>{{ s.err_required }}</span></label>
          <label class="fg-field"><span>{{ s.email_label }} <b aria-hidden="true">*</b></span><input type="email" name="contact[email]" autocomplete="email" required placeholder="{{ s.email_ph | escape }}"><span class="fg-field__err" hidden>{{ s.err_email }}</span></label>
          <label class="fg-field fg-field--full"><span>{{ s.subject_label }} <b aria-hidden="true">*</b></span><select name="contact[subject]" required><option value="">{{ s.subject_ph }}</option>{%- assign subs = s.subjects | split: ',' -%}{%- for o in subs -%}<option>{{ o | strip }}</option>{%- endfor -%}</select><span class="fg-field__err" hidden>{{ s.err_required }}</span></label>
          <label class="fg-field fg-field--full"><span>{{ s.message_label }} <b aria-hidden="true">*</b></span><textarea name="contact[body]" rows="4" required placeholder="{{ s.message_ph | escape }}"></textarea><span class="fg-field__err" hidden>{{ s.err_required }}</span></label>
          <label class="fg-check fg-field--full fg-contact__consent"><input type="checkbox" name="contact[consent]" required><span>{{ s.consent_label }}</span><span class="fg-field__err" hidden>{{ s.err_consent }}</span></label>
        </div>
        <button type="submit" class="fg-btn fg-btn--red fg-contact__send">{{ s.send_label }}{% render 'fg-icon', name: 'arrow' %}</button>
        <p class="fg-contact__status" role="status" tabindex="-1" hidden data-fg-contact-status data-text="{{ s.demo_text | escape }}"></p>
        {%- if form.posted_successfully? -%}<p class="fg-contact__status" role="status">{{ s.done_text }}</p>{%- endif -%}
      {%- endform -%}
    </div>
    <ul class="fg-contact__cards" role="list">
      {%- for block in section.blocks -%}
        <li class="fg-contact__card" {{ block.shopify_attributes }}>
          <span class="fg-contact__ico">{% render 'fg-icon', name: block.settings.icon %}</span>
          <div><p class="fg-contact__ct">{{ block.settings.title }}</p><p class="fg-contact__cx">{{ block.settings.text | escape | newline_to_br }}</p>{%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.link_label }}{% render 'fg-icon', name: 'arrow' %}</a>{%- endif -%}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Contact FRAISE",
  "class": "fg-contact-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un petit mot ?" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "select", "id": "mode", "label": "Envoi", "default": "shopify", "options": [{ "value": "shopify", "label": "Formulaire de contact Shopify" }, { "value": "demo", "label": "Démonstration (rien n'est envoyé)" }] },
    { "type": "text", "id": "name_label", "label": "Nom", "default": "Nom" },
    { "type": "text", "id": "name_ph", "label": "Exemple de nom", "default": "Votre nom" },
    { "type": "text", "id": "email_label", "label": "E-mail", "default": "E-mail" },
    { "type": "text", "id": "email_ph", "label": "Exemple d'e-mail", "default": "votre@email.com" },
    { "type": "text", "id": "subject_label", "label": "Sujet", "default": "Sujet" },
    { "type": "text", "id": "subject_ph", "label": "Sujet : invitation", "default": "Sélectionnez un sujet" },
    { "type": "text", "id": "subjects", "label": "Sujets (séparés par des virgules)", "default": "Une question sur le produit, Ma commande, Livraison et retours, Autre demande" },
    { "type": "text", "id": "message_label", "label": "Message", "default": "Message" },
    { "type": "text", "id": "message_ph", "label": "Exemple de message", "default": "Votre message…" },
    { "type": "text", "id": "consent_label", "label": "Consentement", "default": "J'accepte que mes informations soient utilisées pour répondre à ma demande." },
    { "type": "text", "id": "send_label", "label": "Bouton", "default": "Envoyer" },
    { "type": "text", "id": "demo_text", "label": "Message de démonstration", "default": "Démonstration : votre message n'a pas été envoyé (aucun envoi réel depuis cette boutique d'exemple)." },
    { "type": "text", "id": "done_text", "label": "Message envoyé (boutique réelle)", "default": "Merci, votre message a bien été envoyé." },
    { "type": "text", "id": "err_required", "label": "Erreur : champ obligatoire", "default": "Ce champ est obligatoire." },
    { "type": "text", "id": "err_email", "label": "Erreur : e-mail", "default": "Saisissez une adresse e-mail valide." },
    { "type": "text", "id": "err_consent", "label": "Erreur : consentement", "default": "Cochez cette case pour que nous puissions vous répondre." },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
    { "type": "text", "id": "image_alt", "label": "Description de la photo" },
    { "type": "text", "id": "image_position", "label": "Cadrage (ordinateur)", "default": "50% 50%" },
    { "type": "range", "id": "image_zoom", "label": "Agrandissement (ordinateur)", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "image_position_mobile", "label": "Cadrage (téléphone)", "default": "50% 50%" },
    { "type": "range", "id": "image_zoom_mobile", "label": "Agrandissement (téléphone)", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 }
  ],
  "blocks": [
    { "type": "card", "name": "Carte d'aide", "settings": [
      { "type": "select", "id": "icon", "label": "Pictogramme", "default": "doc", "options": [{ "value": "doc", "label": "Document" }, { "value": "box", "label": "Colis" }, { "value": "truck", "label": "Camion" }, { "value": "question", "label": "Question" }, { "value": "jar", "label": "Flacon" }] },
      { "type": "text", "id": "title", "label": "Titre" },
      { "type": "textarea", "id": "text", "label": "Texte" },
      { "type": "text", "id": "link_label", "label": "Lien" },
      { "type": "url", "id": "link", "label": "Adresse du lien" }
    ] }
  ],
  "presets": [{ "name": "Contact FRAISE" }]
}
{% endschema %}
