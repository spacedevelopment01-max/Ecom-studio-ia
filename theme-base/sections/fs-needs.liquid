{%- comment -%}
Besoins et situations (services) : la situation du client et la réponse apportée. Cartes, liste, ou questions
  dépliables.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-needs fs-needs--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- if s.layout == 'accordion' -%}
      <div class="fs-acc">
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <details class="fs-acc__item"{% render 'fs-reveal', effect: fx, index: ix %}{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="fs-acc__summary"><span class="fs-commit__icon">{% render 'fs-icon', name: block.settings.icon %}</span><span class="fs-item__title">{{ block.settings.title | escape }}</span><span class="fs-acc__mark" aria-hidden="true"></span></summary>
            <div class="fs-acc__panel"><div class="fs-item__text">{{ block.settings.text }}</div>{% if block.settings.link != blank %}<a class="fs-link" href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'En savoir plus' | escape }}</a>{% endif %}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- else -%}
      <ul class="fs-needs__list fs-needs__list--{{ s.layout }}{% if s.layout == 'cards' %} fs-grid fs-grid--{{ section.blocks.size | at_most: 3 | at_least: 1 }}{% endif %}" role="list">
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-need{% if s.layout == 'cards' %} {{ cards }}{% endif %}"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            <span class="fs-commit__icon">{% render 'fs-icon', name: block.settings.icon %}</span>
            <div class="fs-need__copy">
              {%- if block.settings.tag != blank -%}<span class="fs-chip">{{ block.settings.tag | escape }}</span>{%- endif -%}
              <h3 class="fs-item__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<div class="fs-item__text">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.link != blank -%}<a class="fs-link" href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'En savoir plus' | escape }}</a>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Besoins",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "cards",
          "label": "Cartes"
        },
        {
          "value": "list",
          "label": "Liste"
        },
        {
          "value": "accordion",
          "label": "Questions dépliables"
        },
        {
          "value": "row",
          "label": "Titre et texte côte à côte, besoins en ligne"
        }
      ],
      "default": "cards"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Premier élément ouvert",
      "default": true
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Situation",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "plan", "label": "Plan" },
            { "value": "shelves", "label": "Rangements" },
            { "value": "plant", "label": "Plante" },
            {
              "value": "check",
              "label": "Coche"
            },
            {
              "value": "drop",
              "label": "Eau"
            },
            {
              "value": "sun",
              "label": "Lumière"
            },
            {
              "value": "tool",
              "label": "Outil"
            },
            {
              "value": "leaf",
              "label": "Durable"
            },
            {
              "value": "clock",
              "label": "Durée"
            },
            {
              "value": "heart",
              "label": "Soin"
            },
            {
              "value": "shield",
              "label": "Protection"
            },
            {
              "value": "spark",
              "label": "Éclat"
            },
            {
              "value": "chat",
              "label": "Échange"
            },
            {
              "value": "pin",
              "label": "Lieu"
            },
            {
              "value": "doc",
              "label": "Document"
            },
            {
              "value": "users",
              "label": "Personnes"
            },
            {
              "value": "star",
              "label": "Qualité"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Étiquette"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Situation (ex. Votre toiture fuit)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Notre réponse"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Libellé du lien"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Besoins",
      "settings": {
        "layout": "cards"
      }
    }
  ],
  "max_blocks": 9
}
{% endschema %}
