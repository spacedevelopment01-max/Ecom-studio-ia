{%- comment -%}
  Contenus alternés : rangées image ou vidéo + texte qui changent de côté à chaque bloc,
  apparition au défilement (image qui se dévoile, texte qui monte). Textes par défaut = espaces réservés à compléter.
{%- endcomment -%}
<section class="es-section es-alt color-{{ section.settings.color_scheme }}{% if section.settings.start == 'right' %} es-alt--start-right{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    {%- if section.settings.heading != blank -%}
      <header class="es-section-head es-section-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}
    <div class="es-alt__rows">
      {%- for block in section.blocks -%}
        <div class="es-alt__row" {{ block.shopify_attributes }}>
          <div class="es-alt__media es-media-frame es-media-frame--{{ section.settings.ratio }} es-mbg-box" data-reveal="{{ section.settings.reveal }}" data-mbg-inview>
            {% render 'es-media-bg', image: block.settings.image, asset: block.settings.image_asset, video: block.settings.video, video_url: block.settings.video_url, video_asset: block.settings.video_asset, alt: block.settings.title, sizes: '(min-width: 990px) 50vw, 92vw' %}
          </div>
          <div class="es-alt__body">
            {%- if section.settings.show_numbers -%}<p class="es-alt__num" data-reveal="up" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>{%- endif -%}
            {%- if block.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="es-heading es-h3" data-reveal="up" style="--d: 1">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="es-rte es-muted" data-reveal="up" style="--d: 2">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="es-actions" data-reveal="up" style="--d: 3"><a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="es-button{% if section.settings.button_style == 'secondary' %} es-button--secondary{% endif %}">{{ block.settings.button_label }} {% render 'icon', name: 'arrow' %}</a></div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% render 'es-premium-media' %}

{% stylesheet %}
.es-alt__rows { display: grid; gap: clamp(56px, 9vw, 140px); }
.es-alt__row { display: grid; gap: clamp(24px, 5vw, 96px); align-items: center; }
.es-alt__media { width: 100%; }
.es-alt__media .es-placeholder { position: absolute; inset: 0; min-height: 0; }
.es-alt__body { max-width: 540px; }
.es-alt__body .es-h3 { margin-bottom: .45em; font-size: calc(clamp(1.6rem, 2.6vw, 2.3rem) * var(--heading-scale)); }
.es-alt__body .es-eyebrow { margin-bottom: .9em; }
.es-alt__body .es-rte { font-size: 1.06em; line-height: 1.7; max-width: 46ch; }
.es-alt__body .es-actions { margin-top: 1.6rem; }
.es-alt__num { margin: 0 0 .15em; font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: calc(clamp(3rem, 7vw, 6rem) * var(--heading-scale)); line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(var(--c-text-rgb), .38); }
@media (min-width: 990px) {
  .es-alt__row { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); }
  .es-alt__row:nth-child(even), .es-alt--start-right .es-alt__row:nth-child(odd) { grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); }
  .es-alt__row:nth-child(even) .es-alt__media, .es-alt--start-right .es-alt__row:nth-child(odd) .es-alt__media { order: 2; }
  .es-alt--start-right .es-alt__row:nth-child(even) { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); }
  .es-alt--start-right .es-alt__row:nth-child(even) .es-alt__media { order: 0; }
  .es-alt__row:nth-child(even) .es-alt__body, .es-alt--start-right .es-alt__row:nth-child(odd) .es-alt__body { justify-self: end; }
  .es-alt--start-right .es-alt__row:nth-child(even) .es-alt__body { justify-self: start; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Contenus alternés",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "select", "id": "start", "label": "Première image", "default": "left", "options": [{ "value": "left", "label": "À gauche" }, { "value": "right", "label": "À droite" }] },
    { "type": "select", "id": "ratio", "label": "Format des images", "default": "portrait", "options": [{ "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Carré" }, { "value": "landscape", "label": "Paysage" }] },
    { "type": "select", "id": "reveal", "label": "Apparition des images", "default": "curtain", "options": [{ "value": "curtain", "label": "Rideau" }, { "value": "zoom", "label": "Zoom" }, { "value": "up", "label": "Fondu" }] },
    { "type": "checkbox", "id": "show_numbers", "label": "Numéroter les rangées", "default": true },
    { "type": "select", "id": "button_style", "label": "Style des boutons", "default": "secondary", "options": [{ "value": "primary", "label": "Plein" }, { "value": "secondary", "label": "Contour" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "row", "name": "Rangée", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "video", "id": "video", "label": "Vidéo (hébergée par Shopify)" },
      { "type": "video_url", "id": "video_url", "label": "Vidéo YouTube ou Vimeo", "accept": ["youtube", "vimeo"] },
      { "type": "text", "id": "video_asset", "label": "Vidéo fournie avec le thème (MP4)" },
      { "type": "text", "id": "eyebrow", "label": "Surtitre" },
      { "type": "text", "id": "title", "label": "Titre", "default": "[À compléter : titre de la rangée]" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>[À compléter : un fait réel et vérifiable sur votre produit ou votre marque.]</p>" },
      { "type": "text", "id": "button_label", "label": "Bouton" },
      { "type": "url", "id": "link", "label": "Lien" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Contenus alternés", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
