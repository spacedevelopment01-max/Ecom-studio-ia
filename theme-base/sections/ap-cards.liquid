        { "type": "text", "id": "mobile_badge", "label": "Étiquette sur téléphone" },
        { "type": "textarea", "id": "caption", "label": "Légende" },
        { "type": "textarea", "id": "mobile_caption", "label": "Légende sur téléphone" },
        { "type": "text", "id": "link_label", "label": "Texte du lien", "info": "Vide : toute la carte mène au lien." },
        { "type": "text", "id": "mobile_link_label", "label": "Texte du lien sur téléphone" },
        { "type": "url", "id": "link", "label": "Lien" },
