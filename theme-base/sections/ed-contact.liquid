{% assign s = section.settings %}
<section class="ed-section ed-contact color-{{ s.color_scheme }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-ed-motion="{{ s.motion }}" style="--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;">
<div class="ed-shell ed-contact__grid"><header><p class="ed-kicker">{{ s.label | escape }}</p><h2 class="ed-title">{{ s.heading | escape }}</h2><div class="ed-prose">{{ s.text }}</div>{% if s.media_role != blank or s.image_asset != blank or s.image != blank %}<div class="ed-contact__image">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role %}</div>{% endif %}</header><div data-error-message="{{ 'contact.error' | t | escape }}" data-ed-contact{% if request.host == 'apercu' and shop.es_demo_contact %} data-preview-test="true"{% endif %}>
 {% form 'contact', class: 'ed-form' %}
 {% if form.posted_successfully? %}<p role="status">{{ 'contact.success' | t }}</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
 <label>{{ 'contact.name' | t }}<input name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" maxlength="160" required></label>
 <label>{{ 'contact.email' | t }}<input type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" maxlength="254" required></label>
 <label>{{ s.room_label | escape }}<select name="contact[room]" required><option value="">{{ s.room_placeholder | escape }}</option>{% assign rooms = s.rooms | newline_to_br | split: '<br />' %}{% for room in rooms %}{% assign room_name = room | strip %}{% if room_name != blank %}<option value="{{ room_name | escape }}">{{ room_name | escape }}</option>{% endif %}{% endfor %}</select></label>
 <label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="5" maxlength="4000" required>{{ form.body | escape }}</textarea></label>
 <button type="submit" class="ed-button">{{ s.submit_label | escape }}</button><p role="status" aria-live="polite" data-contact-status></p>
 {% endform %}
 </div></div></section>
{% schema %}
{
  "name": "Premier échange",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre de navigation"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Mouvement",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "reveal",
          "label": "Entrée unique"
        },
        {
          "value": "drift",
          "label": "Déplacement léger"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "label",
      "label": "Repère éditorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du lien"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Destination"
    },
    {
      "type": "text",
      "id": "room_label",
      "label": "Libellé de la pièce",
      "default": "Type de pièce"
    },
    {
      "type": "text",
      "id": "room_placeholder",
      "label": "Choix de la pièce",
      "default": "Choisir une pièce"
    },
    {
      "type": "textarea",
      "id": "rooms",
      "label": "Pièces proposées",
      "default": "Salon\nCuisine\nChambre\nEntrée\nAutre"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Action du formulaire",
      "default": "Demander un premier échange"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fichier du projet"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Rôle du visuel attendu"
    }
  ],
  "presets": [
    {
      "name": "Premier échange"
    }
  ]
}
{% endschema %}
