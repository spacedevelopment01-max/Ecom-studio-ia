{% assign s = section.settings %}
<section class="ed-section ed-scene ed-scene--{{ s.layout }} color-{{ s.color_scheme }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-ed-motion="{{ s.motion }}" style="--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;">
<div class="ed-shell"><div class="ed-scene__media">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y, ratio: s.media_ratio, mobile_ratio: s.mobile_media_ratio, fit: s.image_fit %}{% if s.caption != blank %}<p class="ed-caption">{{ s.caption | escape }}</p>{% endif %}</div><div class="ed-scene__copy"><p class="ed-kicker">{{ s.label | escape }}</p><h2 class="ed-title">{{ s.heading | escape }}</h2><div class="ed-prose">{{ s.text }}</div>{% if s.button_label != blank and s.button_link != blank %}<a class="ed-button" href="{{ s.button_link }}">{{ s.button_label | escape }}<span aria-hidden="true">↗</span></a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Scène et récit",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre de navigation"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Mouvement",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "reveal",
          "label": "Entrée unique"
        },
        {
          "value": "drift",
          "label": "Déplacement léger"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "label",
      "label": "Repère éditorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du lien"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Destination"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fichier du projet"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Rôle du visuel attendu"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Point focal horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Point focal vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Composition de scène",
      "options": [
        {
          "value": "split",
          "label": "Image verticale et texte"
        },
        {
          "value": "panorama",
          "label": "Photographie panoramique"
        },
        {
          "value": "closing",
          "label": "Conclusion illustrée"
        }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Format du visuel",
      "default": "layout",
      "options": [
        {
          "value": "layout",
          "label": "Selon la composition"
        },
        {
          "value": "16/9",
          "label": "Panoramique 16:9"
        },
        {
          "value": "3/2",
          "label": "Paysage 3:2"
        },
        {
          "value": "4/3",
          "label": "Paysage 4:3"
        },
        {
          "value": "1",
          "label": "Carré"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_media_ratio",
      "label": "Format du visuel sur mobile",
      "default": "3/2",
      "options": [
        {
          "value": "16/9",
          "label": "Panoramique 16:9"
        },
        {
          "value": "3/2",
          "label": "Paysage 3:2"
        },
        {
          "value": "4/3",
          "label": "Paysage 4:3"
        },
        {
          "value": "1",
          "label": "Carré"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Cadrage du visuel",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Remplir le cadre"
        },
        {
          "value": "contain",
          "label": "Conserver le visuel entier"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scène et récit"
    }
  ]
}
{% endschema %}
