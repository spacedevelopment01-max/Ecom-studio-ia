{%- comment -%}
Résultats et preuves (boutique spécialisée) : mesures avec leur source, chiffres en grille ou avant / après avec
  curseur. Aucune valeur n'est inventée : chaque mesure porte sa source ; la note de méthode est affichée.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-results fs-results--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- if s.layout == 'before-after' -%}
      <div class="fs-results__pairs">
        {%- for block in section.blocks -%}{%- if block.type == 'pair' -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <figure class="fs-compare" data-fs-compare{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            <div class="fs-compare__stage">
              <div class="fs-compare__layer fs-compare__layer--before">{% render 'ed-media', image: block.settings.image_before, asset: block.settings.image_before_asset, alt: block.settings.label_before, role_label: 'Photo avant' %}</div>
              <div class="fs-compare__layer fs-compare__layer--after" data-fs-compare-after>{% render 'ed-media', image: block.settings.image_after, asset: block.settings.image_after_asset, alt: block.settings.label_after, role_label: 'Photo après' %}</div>
              <span class="fs-compare__tag fs-compare__tag--before">{{ block.settings.label_before | escape }}</span>
              <span class="fs-compare__tag fs-compare__tag--after">{{ block.settings.label_after | escape }}</span>
              <span class="fs-compare__handle" aria-hidden="true"></span>
            </div>
            <label class="fs-compare__control"><span class="visually-hidden">{{ block.settings.label_before | escape }} / {{ block.settings.label_after | escape }}</span><input type="range" min="0" max="100" value="50" data-fs-compare-range></label>
            {%- if block.settings.caption != blank or block.settings.source != blank -%}<figcaption class="fs-caption">{{ block.settings.caption | escape }}{% if block.settings.source != blank %} <span class="fs-source">{{ block.settings.source | escape }}</span>{% endif %}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}{%- endfor -%}
      </div>
    {%- else -%}
      <dl class="fs-results__list fs-results__list--{{ s.layout }}">
        {%- for block in section.blocks -%}{%- if block.type == 'measure' -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <div class="fs-results__item {{ cards }}"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            <dt class="fs-results__value">{{ block.settings.value | escape }}{% if block.settings.unit != blank %}<span class="fs-results__unit">{{ block.settings.unit | escape }}</span>{% endif %}</dt>
            <dd class="fs-results__label">{{ block.settings.label | escape }}{% if block.settings.source != blank %}<span class="fs-source">{{ block.settings.source | escape }}</span>{% endif %}</dd>
          </div>
        {%- endif -%}{%- endfor -%}
      </dl>
    {%- endif -%}
    {%- if s.method != blank -%}<div class="fs-note"{% render 'fs-reveal', effect: fx %}>{{ s.method }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Résultats et preuves",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "measures",
          "label": "Mesures et sources"
        },
        {
          "value": "figures",
          "label": "Chiffres en grille"
        },
        {
          "value": "before-after",
          "label": "Avant / après"
        }
      ],
      "default": "measures"
    },
    {
      "type": "richtext",
      "id": "method",
      "label": "Méthode et sources"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "measure",
      "name": "Mesure",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Valeur"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unité"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Ce qui est mesuré"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source ou méthode"
        }
      ]
    },
    {
      "type": "pair",
      "name": "Avant / après",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_before",
          "label": "Photo avant"
        },
        {
          "type": "text",
          "id": "image_before_asset",
          "label": "Fichier avant"
        },
        {
          "type": "image_picker",
          "id": "image_after",
          "label": "Photo après"
        },
        {
          "type": "text",
          "id": "image_after_asset",
          "label": "Fichier après"
        },
        {
          "type": "text",
          "id": "label_before",
          "label": "Libellé avant",
          "default": "Avant"
        },
        {
          "type": "text",
          "id": "label_after",
          "label": "Libellé après",
          "default": "Après"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source ou conditions"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Résultats et preuves",
      "settings": {
        "layout": "measures"
      }
    }
  ],
  "max_blocks": 8
}
{% endschema %}
