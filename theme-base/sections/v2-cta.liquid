{%- comment -%} Appel final (Theme Engine V2) : band (bande pleine), card (carte centrée), split (titre + coordonnées). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="v2-cta v2-cta--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="es-container">
    <div class="v2-cta__inner">
      <div class="v2-cta__copy">
        {%- if s.eyebrow != blank -%}<p class="v2-eyebrow" data-reveal="up">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="v2-h2 v2-cta__title" data-reveal="up">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<div class="v2-rte v2-lead-sm" data-reveal="up">{{ s.text }}</div>{%- endif -%}
        <div class="v2-actions" data-reveal="up">
          {%- if s.button_label != blank -%}<a class="v2-btn v2-btn--primary" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}<span class="v2-btn__arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></a>{%- endif -%}
          {%- if s.button2_label != blank -%}<a class="v2-btn v2-btn--ghost" href="{{ s.button2_link | default: '#' }}">{{ s.button2_label }}</a>{%- endif -%}
        </div>
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="v2-cta__facts" data-reveal="up">
          {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.value }}</a>{% else %}{{ block.settings.value }}{% endif %}</dd></div>{%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel final V2",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition", "default": "band", "options": [
      { "value": "band", "label": "Bande pleine" }, { "value": "card", "label": "Carte centrée" }, { "value": "split", "label": "Titre et coordonnées" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Parlons de votre projet" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton principal" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_label", "label": "Second bouton" },
    { "type": "url", "id": "button2_link", "label": "Lien du second bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "fact", "name": "Coordonnée", "settings": [
      { "type": "text", "id": "label", "label": "Libellé", "default": "Téléphone" },
      { "type": "text", "id": "value", "label": "Valeur", "default": "[À compléter]" },
      { "type": "url", "id": "link", "label": "Lien (facultatif)" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Appel final V2" }]
}
{% endschema %}
