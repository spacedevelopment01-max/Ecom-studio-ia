{%- comment -%}
  FRAISE : « Vos questions, nos réponses. » (planches 01 et 04) — titre et bouton à gauche, questions dépliables à droite
  sur une bande rose à vagues ; disposition « fiche » : « Questions fréquentes. » en deux colonnes. Les réponses renvoient
  à l'étiquette et aux pages d'aide ; rien d'inventé.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="fg fg-faqt fg-faqt--{{ s.layout }}" aria-labelledby="fg-faqt-t-{{ section.id }}">
  {%- if s.layout == 'home' -%}<svg class="fg-wave fg-wave--top" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 40V22C60 6 120 6 180 18s120 18 180 6 120-20 180-8 120 20 180 8 120-20 180-8 120 20 180 8 120-20 180-8 120 18 180 4V40z" fill="currentColor"/></svg>{%- endif -%}
  <div class="fg-c">
    <div class="fg-faqt__head">
      {%- assign tid = 'fg-faqt-t-' | append: section.id -%}
      {% render 'fg-title', text: s.heading, tag: 'h2', class: 'fg-faqt__title', id: tid %}
      {%- if s.button_label != blank -%}<a class="fg-btn fg-btn--line fg-faqt__btn" href="{{ s.button_link | default: routes.root_url }}">{{ s.button_label }}</a>{%- endif -%}
    </div>
    <div class="fg-faqt__list">
      {%- for block in section.blocks -%}
        <details class="fg-faqt__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span>{% render 'fg-icon', name: 'plus', class: 'fg-faqt__plus' %}{% render 'fg-icon', name: 'chevron', class: 'fg-faqt__chev' %}</summary>
          <div class="fg-faqt__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.layout == 'home' -%}<svg class="fg-wave fg-wave--bottom" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 0V18c60 16 120 16 180 4s120-18 180-6 120 20 180 8 120-20 180-8 120 20 180 8 120-20 180-8 120 18 180 6V0z" fill="currentColor"/></svg>{%- endif -%}
</section>

{% schema %}
{
  "name": "Questions en bref",
  "class": "fg-faqt-section",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposition", "default": "home", "options": [{ "value": "home", "label": "Accueil : titre à gauche, bande rose" }, { "value": "product", "label": "Fiche : deux colonnes" }] },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Vos questions,\n[i]nos réponses.[/i]", "info": "Une ligne par retour à la ligne ; [i]italique[/i], [r]rouge[/r]." },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Réponse" }
    ] }
  ],
  "presets": [{ "name": "Questions en bref" }]
}
{% endschema %}
