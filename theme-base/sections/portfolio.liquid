{%- comment -%}
  Réalisations : galerie de projets légendés, filtrable par catégorie ; un projet avec une image « avant »
  devient une comparaison avant / après (curseur accessible au clavier).
{%- endcomment -%}
{%- liquid
  assign tags = '|'
  for block in section.blocks
    if block.settings.tag != blank
      assign key = '|' | append: block.settings.tag | append: '|'
      unless tags contains key
        assign tags = tags | append: block.settings.tag | append: '|'
      endunless
    endif
  endfor
  assign tag_list = tags | remove_first: '|' | split: '|'
-%}
<section class="es-section es-folio es-folio--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-folio>
  <div class="es-container">
    <header class="es-folio__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="es-rte es-lead" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if tag_list.size > 1 -%}
        <div class="es-folio__filters" role="group" aria-label="{{ 'sections.portfolio.filter' | t }}" data-reveal="up">
          <button type="button" class="es-folio__filter is-active" aria-pressed="true" data-folio-filter="">{{ 'sections.portfolio.all' | t }}</button>
          {%- for t in tag_list -%}<button type="button" class="es-folio__filter" aria-pressed="false" data-folio-filter="{{ t | handleize }}">{{ t }}</button>{%- endfor -%}
        </div>
      {%- endif -%}
    </header>

    <ul class="es-folio__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_before = false
          if block.settings.image_before != blank or block.settings.image_before_asset != blank
            assign has_before = true
          endif
        -%}
        <li class="es-folio__item{% if has_before %} es-folio__item--compare{% endif %}" data-reveal="up" style="--i: {{ forloop.index0 | modulo: 3 }}" data-folio-tag="{{ block.settings.tag | handleize }}" {{ block.shopify_attributes }}>
          <figure class="es-folio__figure">
            <div class="es-folio__media"{% if has_before %} data-compare style="--pos: 50%"{% endif %}>
              {% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, sizes: '(min-width: 990px) 40vw, 100vw', class: 'es-cover es-folio__after' %}
              {%- if has_before -%}
                <div class="es-folio__before">
                  {% render 'es-image', image: block.settings.image_before, asset: block.settings.image_before_asset, alt: block.settings.title, sizes: '(min-width: 990px) 40vw, 100vw', class: 'es-cover' %}
                </div>
                <span class="es-folio__handle" aria-hidden="true"><span>{% render 'icon', name: 'arrow-left' %}{% render 'icon', name: 'arrow' %}</span></span>
                <span class="es-folio__badge es-folio__badge--before">{{ section.settings.label_before }}</span>
                <span class="es-folio__badge es-folio__badge--after">{{ section.settings.label_after }}</span>
                <input class="es-folio__range" type="range" min="0" max="100" value="50" aria-label="{{ 'sections.portfolio.compare' | t }} — {{ block.settings.title | escape }}" data-compare-range>
              {%- endif -%}
            </div>
            <figcaption class="es-folio__caption">
              {%- if block.settings.tag != blank -%}<span class="es-folio__tag">{{ block.settings.tag }}</span>{%- endif -%}
              <span class="es-heading es-h4 es-folio__title">{{ block.settings.title }}</span>
              {%- if block.settings.caption != blank -%}<span class="es-folio__text">{{ block.settings.caption }}</span>{%- endif -%}
              {%- if block.settings.link != blank -%}<a class="es-folio__link" href="{{ block.settings.link }}">{{ 'sections.portfolio.see_project' | t }}<span class="visually-hidden"> — {{ block.settings.title }}</span>{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button_label != blank -%}
      <div class="es-actions es-actions--center"><a class="es-button es-button--secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.es-folio__head { display: grid; gap: 20px 48px; align-items: end; margin-bottom: clamp(26px, 4vw, 52px); }
@media (min-width: 990px) { .es-folio__head { grid-template-columns: minmax(0, 1fr) auto; } }
.es-folio__head .es-heading { margin-bottom: .25em; }
.es-folio__filters { display: flex; flex-wrap: wrap; gap: 8px; }
.es-folio__filter { min-height: 40px; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(var(--c-text-rgb), .18); background: transparent; cursor: pointer; font-size: .88rem; transition: background .3s, color .3s, border-color .3s; }
.es-folio__filter:hover { border-color: var(--c-accent); }
.es-folio__filter.is-active { background: var(--c-text); color: var(--c-bg); border-color: var(--c-text); }
.es-folio__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(16px, 2.2vw, 28px); }
@media (min-width: 750px) { .es-folio__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1100px) { .es-folio--grid .es-folio__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (min-width: 990px) {
  .es-folio--editorial .es-folio__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .es-folio--editorial .es-folio__item { grid-column: span 5; }
  .es-folio--editorial .es-folio__item:nth-child(4n + 1) { grid-column: span 7; }
  .es-folio--editorial .es-folio__item:nth-child(4n + 4) { grid-column: span 7; }
}
.es-folio__item[hidden] { display: none; }
.es-folio__figure { margin: 0; display: grid; gap: 14px; }
.es-folio__media { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-card); overflow: hidden; background: var(--c-surface); isolation: isolate; }
.es-folio--editorial .es-folio__item:nth-child(4n + 1) .es-folio__media, .es-folio--editorial .es-folio__item:nth-child(4n + 4) .es-folio__media { aspect-ratio: 16 / 10; }
.es-folio__media .es-cover, .es-folio__media .es-placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.3s var(--ease-out); }
.es-folio__item:not(.es-folio__item--compare):hover .es-folio__media .es-cover { transform: scale(1.05); }
.es-folio__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); z-index: 1; }
.es-folio__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; z-index: 2; pointer-events: none; box-shadow: 0 0 0 1px rgba(0, 0, 0, .12); }
.es-folio__handle > span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: #fff; color: #111; box-shadow: 0 10px 30px -10px rgba(0, 0, 0, .5); }
.es-folio__handle .es-icon { width: 14px; height: 14px; }
.es-folio__badge { position: absolute; bottom: 14px; z-index: 2; padding: 5px 12px; border-radius: 999px; background: rgba(0, 0, 0, .55); color: #fff; font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); pointer-events: none; }
.es-folio__badge--before { left: 14px; }
.es-folio__badge--after { right: 14px; }
.es-folio__range { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
.es-folio__media:focus-within .es-folio__handle > span { outline: 3px solid var(--c-accent); outline-offset: 2px; }
.es-folio__caption { display: grid; gap: 4px; }
.es-folio__tag { font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; color: var(--c-accent); font-weight: var(--font-body-weight-bold); }
.es-folio__title { margin: 0; font-size: clamp(1.1rem, 1.5vw, 1.35rem); }
.es-folio__text { color: var(--c-muted); font-size: .95rem; }
.es-folio__link { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; width: fit-content; font-weight: var(--font-body-weight-bold); font-size: .92rem; text-decoration: none; border-bottom: 1px solid rgba(var(--c-text-rgb), .22); }
.es-folio__link .es-icon { width: 15px; height: 15px; }
@media (prefers-reduced-motion: reduce) { .es-folio__media .es-cover { transition: none; } }
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.esFolio) return; window.esFolio = true;
  document.addEventListener('input', function (e) {
    var r = e.target; if (!r.matches || !r.matches('[data-compare-range]')) return;
    var box = r.closest('[data-compare]'); if (box) box.style.setProperty('--pos', r.value + '%');
  });
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-folio-filter]'); if (!b) return;
    var root = b.closest('[data-folio]'); if (!root) return;
    var tag = b.getAttribute('data-folio-filter');
    root.querySelectorAll('[data-folio-filter]').forEach(function (x) { var on = x === b; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    root.querySelectorAll('[data-folio-tag]').forEach(function (it) { it.hidden = !!tag && it.getAttribute('data-folio-tag') !== tag; });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Réalisations",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Réalisations" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quelques projets récents" },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "select", "id": "layout", "label": "Mise en page", "default": "grid", "options": [{ "value": "grid", "label": "Grille régulière" }, { "value": "editorial", "label": "Composition éditoriale" }] },
    { "type": "text", "id": "label_before", "label": "Libellé « avant »", "default": "Avant" },
    { "type": "text", "id": "label_after", "label": "Libellé « après »", "default": "Après" },
    { "type": "text", "id": "button_label", "label": "Bouton (facultatif)" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "project", "name": "Projet", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (ou « après »)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "image_picker", "id": "image_before", "label": "Image « avant » (facultatif)", "info": "Ajoutez-la pour afficher une comparaison avant / après." },
      { "type": "text", "id": "image_before_asset", "label": "Image « avant » fournie avec le thème" },
      { "type": "text", "id": "title", "label": "Titre", "default": "[À compléter : nom du projet]" },
      { "type": "text", "id": "caption", "label": "Légende", "default": "[À compléter : ce qui a été réalisé, où, en combien de temps]" },
      { "type": "text", "id": "tag", "label": "Catégorie (filtre)" },
      { "type": "url", "id": "link", "label": "Lien (facultatif)" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Réalisations", "blocks": [{ "type": "project" }, { "type": "project" }, { "type": "project" }] }]
}
{% endschema %}
