{%- comment -%}
  Produit en surplomb (maquette NOCTIL du 23 octobre, planche 01) : le produit détouré (fond transparent) remonte sur le
  bas de la grande photo qui précède, puis l'argument, le prix et l'ajout au panier à côté.
  Le chevauchement n'a lieu que derrière une ouverture ou un bandeau photo pleine largeur (« visuel en fond » de la
  bannière d'achat, grande ouverture) : déplacée ailleurs, la section reste sagement à sa place. Taille du produit et
  hauteur du débordement se règlent séparément sur ordinateur et sur téléphone ; le visuel ne capte aucun clic, si bien
  que les boutons de la photo du dessus restent utilisables. Aucun cadre ni rognage : le produit est montré entier.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign buy = s.buy_product
  assign has_media = false
  if s.image != blank or s.image_asset != blank
    assign has_media = true
  endif
-%}
<section class="es-section cv-rise cv-rise--{{ s.layout | default: 'media-left' }}{% if s.overlap == 'auto' and has_media %} cv-rise--auto{% endif %}{% if s.curve %} cv-rise--curve{% endif %}{% unless has_media %} cv-rise--no-media{% endunless %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--rise-mw:{{ s.media_width }};--rise-mwm:{{ s.mobile_width }};--rise:{{ s.rise }};--rise-m:{{ s.mobile_rise }};">
  <div class="es-container">
    <div class="cv-rise__inner">
      {%- if has_media -%}
      <div class="cv-rise__media">
        {%- if s.decor -%}
        <svg class="cv-rise__decor" viewBox="0 0 400 300" aria-hidden="true" focusable="false"><ellipse class="cv-rise__orbit" cx="200" cy="168" rx="196" ry="56" transform="rotate(-12 200 168)"/><g class="cv-rise__stars"><path d="M60 64l4 12 12 4-12 4-4 12-4-12-12-4 12-4z"/><path d="M352 42l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"/><path d="M28 196l3 8 8 3-8 3-3 8-3-8-8-3 8-3z"/><path d="M372 214l4 11 11 4-11 4-4 11-4-11-11-4 11-4z"/><path d="M74 262l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"/><circle cx="104" cy="104" r="2.4"/><circle cx="318" cy="118" r="2"/><circle cx="46" cy="132" r="1.8"/><circle cx="338" cy="262" r="2.2"/></g></svg>
        {%- endif -%}
        {% render 'es-image', image: s.image, asset: s.image_asset, alt: s.image_alt, class: 'cv-rise__img', loading: s.image_loading, sizes: '(min-width: 990px) 50vw, 90vw' %}
      </div>
      {%- endif -%}
      <div class="cv-rise__copy"{% render 'cv-reveal', animation: s.animation %}>
        {%- if s.eyebrow != blank -%}<p class="cv-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<{{ s.heading_tag | default: 'h2' }} class="es-heading cv-title cv-rise__title">{{ s.heading | escape | newline_to_br }}</{{ s.heading_tag | default: 'h2' }}>{%- endif -%}
        {%- if s.text != blank -%}<div class="es-rte cv-rise__text">{{ s.text }}</div>{%- endif -%}
        <div class="cv-rise__buy">
          {%- if s.price_text != blank or buy != blank -%}
          <div class="cv-rise__price">
            <span class="cv-rise__amount">{% if s.price_text != blank %}{{ s.price_text | escape }}{% else %}{% render 'price', product: buy %}{% endif %}</span>
            {%- if s.price_note != blank -%}<span class="cv-rise__note">{{ s.price_note | escape }}</span>{%- endif -%}
          </div>
          {%- endif -%}
          {%- if buy != blank and buy.variants.size == 1 -%}
            {%- form 'product', buy, class: 'cv-rise__form', data-product-form: '' -%}<input type="hidden" name="id" value="{{ buy.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" name="add" class="es-button cv-button cv-rise__button" data-add-button{% unless buy.available %} disabled{% endunless %}>{{ s.button_label | default: 'products.product.add_to_cart' | t | escape }}{% if s.button_arrow %} {% render 'icon', name: 'arrow' %}{% endif %}</button>{%- endform -%}
          {%- elsif buy != blank -%}
            <a class="es-button cv-button cv-rise__button" href="{{ buy.url }}#acheter">{{ s.button_label | default: 'products.product.choose_options' | t | escape }}{% if s.button_arrow %} {% render 'icon', name: 'arrow' %}{% endif %}</a>
          {%- elsif s.button_label != blank -%}
            <a class="es-button cv-button cv-rise__button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}{% if s.button_arrow %} {% render 'icon', name: 'arrow' %}{% endif %}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produit en surplomb",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Produit détouré", "info": "Image au fond transparent (PNG), produit entier. Il remonte sur la photo du dessus sans aucun cadre." },
    { "type": "text", "id": "image_asset", "label": "Fichier image fourni avec le thème" },
    { "type": "text", "id": "image_alt", "label": "Description du visuel" },
    { "type": "select", "id": "image_loading", "label": "Chargement du visuel", "default": "eager", "options": [ { "value": "eager", "label": "Immédiat (haut de page)" }, { "value": "lazy", "label": "Différé" } ] },
    { "type": "select", "id": "layout", "label": "Disposition", "default": "media-left", "options": [ { "value": "media-left", "label": "Produit à gauche, texte à droite" }, { "value": "media-right", "label": "Texte à gauche, produit à droite" } ] },
    { "type": "select", "id": "overlap", "label": "Débordement sur la section du dessus", "default": "auto", "info": "Seulement derrière une grande photo pleine largeur (bannière « visuel en fond » ou grande ouverture) ; ailleurs, le produit reste dans sa section.", "options": [ { "value": "auto", "label": "Derrière une grande photo" }, { "value": "none", "label": "Jamais" } ] },
    { "type": "range", "id": "media_width", "label": "Taille du produit sur ordinateur", "info": "Part de la largeur de la section.", "min": 30, "max": 60, "step": 1, "unit": "%", "default": 44 },
    { "type": "range", "id": "rise", "label": "Débordement sur ordinateur", "info": "Part du visuel (mesurée sur sa largeur) qui remonte sur la photo du dessus.", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 20 },
    { "type": "range", "id": "mobile_width", "label": "Taille du produit sur téléphone", "info": "Part de la largeur disponible.", "min": 50, "max": 100, "step": 1, "unit": "%", "default": 78 },
    { "type": "range", "id": "mobile_rise", "label": "Débordement sur téléphone", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 26 },
    { "type": "checkbox", "id": "decor", "label": "Orbite et étoiles autour du produit", "default": true },
    { "type": "checkbox", "id": "curve", "label": "Bord arrondi sous la photo (téléphone)", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'imagination commence ici." },
    { "type": "select", "id": "heading_tag", "label": "Niveau du titre", "default": "h2", "options": [ { "value": "h1", "label": "H1 (ouverture de page)" }, { "value": "h2", "label": "H2" } ] },
    { "type": "richtext", "id": "text", "label": "Argument" },
    { "type": "product", "id": "buy_product", "label": "Produit à ajouter au panier", "info": "Son prix s'affiche et le bouton l'ajoute au panier. Un produit à plusieurs variantes mène à sa fiche." },
    { "type": "text", "id": "price_text", "label": "Prix affiché à la place", "info": "Facultatif. Vide : le prix du produit choisi." },
    { "type": "text", "id": "price_note", "label": "Mention sous le prix", "info": "Ex. « Prix de démonstration »." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Ajouter au panier" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton (sans produit choisi)" },
    { "type": "checkbox", "id": "button_arrow", "label": "Flèche dans le bouton", "default": true },
    { "type": "select", "id": "animation", "label": "Animation du texte", "default": "fade", "options": [ { "value": "none", "label": "Aucune" }, { "value": "fade", "label": "Fondu" }, { "value": "rise", "label": "Montée en fondu" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espace au-dessus", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Espace en dessous", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [ { "name": "Produit en surplomb" } ]
}
{% endschema %}
