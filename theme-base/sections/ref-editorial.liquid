{%- assign s = section.settings -%}
<section class="ref-section ref-editorial ref-editorial--{{ s.layout }} color-{{ s.color_scheme }}{% if s.image == blank and s.image_asset == blank %} ref-editorial--text-only{% endif %}" data-reference="editorial" data-ref-motion="{{ s.motion }}" style="--ref-pt: {{ s.padding_top }}px; --ref-pb: {{ s.padding_bottom }}px;">
  <div class="ref-shell ref-editorial__grid">
    {% if s.image != blank or s.image_asset != blank %}<figure class="ref-editorial__media">{% render 'es-image', image: s.image, asset: s.image_asset, alt: s.image_alt, class: 'ref-image', sizes: '(min-width: 990px) 60vw, 100vw' %}{% if s.caption != blank %}<figcaption>{{ s.caption | escape }}</figcaption>{% endif %}</figure>{% endif %}
    <div class="ref-editorial__copy">{% if s.heading != blank %}<h2 class="ref-heading">{{ s.heading | escape }}</h2>{% endif %}{% if s.text != blank %}<div class="ref-prose">{{ s.text }}</div>{% endif %}{%- if s.button_label != blank and s.button_link != blank -%}<a class="ref-button" href="{{ s.button_link }}">{{ s.button_label | escape }}<span aria-hidden="true">↗</span></a>{%- endif -%}</div>
  </div>
</section>
{% schema %}
{
  "name": "Reportage visuel",
  "tag": "div",
  "class": "reference-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Composition",
      "default": "offset",
      "options": [
        {
          "value": "offset",
          "label": "Image et texte en décalage"
        },
        {
          "value": "wide",
          "label": "Panorama et légende"
        },
        {
          "value": "inset",
          "label": "Photo dans la marge"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Votre titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Jeu de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Animation",
      "default": "reveal",
      "options": [
        {
          "value": "none",
          "label": "Sans animation"
        },
        {
          "value": "reveal",
          "label": "Apparition courte"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image du projet (fichier)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Reportage visuel"
    }
  ]
}
{% endschema %}
