{%- comment -%}
  ATELIER NUANCE : informations légales (planche 06). Photo d'accueil, onglets Mentions légales / Confidentialité /
  Conditions de réservation / Cookies (une page par onglet), contenu à compléter avant publication : aucune identité
  d'entreprise inventée.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="an-section an-legal">
  <div class="an-legal__hero" style="--h: {{ s.height }}px;">
    {% render 'an-img', image: s.image, asset: s.image_asset, alt: '', pos: s.image_position, loading: 'eager' %}
    {%- if s.sign != blank -%}<p class="an-legal__sign" aria-hidden="true">{{ s.sign | escape | newline_to_br }}</p>{%- endif -%}
    <div class="an-wrap an-legal__hero-inner">
      <p class="an-legal__hero-title">{{ s.hero_heading }}</p>
      {%- if s.hero_text != blank -%}<p class="an-legal__hero-text">{{ s.hero_text | escape | newline_to_br }}</p>{%- endif -%}
    </div>
  </div>
  <div class="an-wrap">
    <nav class="an-legal__tabs" aria-label="{{ s.hero_heading | escape }}">
      {%- for i in (1..4) -%}
        {%- assign lk = 'tab' | append: i | append: '_label' -%}{%- assign ll = 'tab' | append: i | append: '_link' -%}
        {%- if s[lk] != blank -%}<a href="{{ s[ll] }}"{% if s.current == i %} aria-current="page"{% endif %}>{{ s[lk] }}</a>{%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="an-legal__card">
      <h1 class="an-title an-title--md">{{ s.heading }}</h1>
      {%- if s.body != blank -%}<div class="an-text an-legal__body">{{ s.body }}</div>{%- endif -%}
      {%- if s.notice_title != blank -%}
        <div class="an-legal__notice">
          {% render 'an-icon', name: 'info' %}
          <div><p class="an-legal__notice-title">{{ s.notice_title }}</p>{{ s.notice_text }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page légale du salon",
  "class": "an-legal-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
    { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
    { "type": "range", "id": "height", "label": "Hauteur de la photo", "min": 160, "max": 520, "step": 10, "unit": "px", "default": 340 },
    { "type": "textarea", "id": "sign", "label": "Enseigne décorative sur la photo", "info": "Texte posé sur le mur de la photo (ex. le nom du salon). Vide : rien." },
    { "type": "text", "id": "hero_heading", "label": "Titre sur la photo", "default": "Informations légales" },
    { "type": "textarea", "id": "hero_text", "label": "Texte sur la photo" },
    { "type": "range", "id": "current", "label": "Onglet de cette page", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "text", "id": "tab1_label", "label": "Onglet 1 : texte", "default": "Mentions légales" },
    { "type": "url", "id": "tab1_link", "label": "Onglet 1 : lien" },
    { "type": "text", "id": "tab2_label", "label": "Onglet 2 : texte", "default": "Confidentialité" },
    { "type": "url", "id": "tab2_link", "label": "Onglet 2 : lien" },
    { "type": "text", "id": "tab3_label", "label": "Onglet 3 : texte", "default": "Conditions de réservation" },
    { "type": "url", "id": "tab3_link", "label": "Onglet 3 : lien" },
    { "type": "text", "id": "tab4_label", "label": "Onglet 4 : texte", "default": "Cookies" },
    { "type": "url", "id": "tab4_link", "label": "Onglet 4 : lien" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Mentions légales" },
    { "type": "richtext", "id": "body", "label": "Contenu", "default": "<p>[À renseigner]</p>" },
    { "type": "text", "id": "notice_title", "label": "Titre de l'encadré", "default": "Contenu à compléter avant publication" },
    { "type": "richtext", "id": "notice_text", "label": "Texte de l'encadré" }
  ],
  "presets": [{ "name": "Page légale du salon" }]
}
{% endschema %}
