{%- comment -%}
Entretien et utilisation (e-commerce) : conseils et gestes à éviter. Liste iconée, deux colonnes « à faire / à
  éviter », cartes, ou questions dépliables (clavier : Entrée ou Espace sur l'intitulé).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-care fs-care--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- if s.layout == 'columns' -%}
      <div class="fs-care__cols">
        <div class="fs-care__col {{ cards }}"{% render 'fs-reveal', effect: fx %}>
          <h3 class="fs-care__coltitle"><span class="fs-commit__icon">{% render 'fs-icon', name: 'check' %}</span>{{ s.do_label | default: 'À faire' | escape }}</h3>
          <ul role="list">{%- for block in section.blocks -%}{%- if block.type == 'tip' -%}<li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %}<div class="fs-item__text">{{ block.settings.text }}</div>{% endif %}</li>{%- endif -%}{%- endfor -%}</ul>
        </div>
        <div class="fs-care__col fs-care__col--avoid {{ cards }}"{% render 'fs-reveal', effect: fx, index: 1 %}>
          <h3 class="fs-care__coltitle"><span class="fs-commit__icon">{% render 'fs-icon', name: 'cross' %}</span>{{ s.avoid_label | default: 'À éviter' | escape }}</h3>
          <ul role="list">{%- for block in section.blocks -%}{%- if block.type == 'avoid' -%}<li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %}<div class="fs-item__text">{{ block.settings.text }}</div>{% endif %}</li>{%- endif -%}{%- endfor -%}</ul>
        </div>
      </div>
    {%- elsif s.layout == 'accordion' -%}
      <div class="fs-acc">
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <details class="fs-acc__item"{% render 'fs-reveal', effect: fx, index: ix %}{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="fs-acc__summary"><span class="fs-commit__icon">{% if block.type == 'avoid' %}{% render 'fs-icon', name: 'cross' %}{% else %}{% render 'fs-icon', name: block.settings.icon %}{% endif %}</span><span class="fs-item__title">{{ block.settings.title | escape }}</span><span class="fs-acc__mark" aria-hidden="true"></span></summary>
            <div class="fs-acc__panel fs-item__text">{{ block.settings.text }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- else -%}
      <ul class="fs-care__list fs-care__list--{{ s.layout }}{% if s.layout == 'cards' %} fs-grid fs-grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }}{% endif %}" role="list">
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-care__item{% if s.layout == 'cards' %} {{ cards }}{% endif %}{% if block.type == 'avoid' %} fs-care__item--avoid{% endif %}"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            <span class="fs-commit__icon">{% if block.type == 'avoid' %}{% render 'fs-icon', name: 'cross' %}{% else %}{% render 'fs-icon', name: block.settings.icon %}{% endif %}</span>
            <div>{%- if block.type == 'avoid' -%}<span class="fs-chip fs-chip--muted">{{ s.avoid_label | default: 'À éviter' | escape }}</span>{%- endif -%}<h3 class="fs-item__title">{{ block.settings.title | escape }}</h3>{% if block.settings.text != blank %}<div class="fs-item__text">{{ block.settings.text }}</div>{% endif %}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.note != blank -%}<p class="fs-note">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Entretien",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "list",
          "label": "Liste avec icônes"
        },
        {
          "value": "columns",
          "label": "À faire / à éviter"
        },
        {
          "value": "cards",
          "label": "Cartes"
        },
        {
          "value": "accordion",
          "label": "Questions dépliables"
        }
      ],
      "default": "list"
    },
    {
      "type": "text",
      "id": "do_label",
      "label": "Intitulé des conseils",
      "default": "À faire"
    },
    {
      "type": "text",
      "id": "avoid_label",
      "label": "Intitulé des gestes à éviter",
      "default": "À éviter"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Premier élément ouvert",
      "default": true
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Conseil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "check",
              "label": "Coche"
            },
            {
              "value": "drop",
              "label": "Eau"
            },
            {
              "value": "sun",
              "label": "Lumière"
            },
            {
              "value": "tool",
              "label": "Outil"
            },
            {
              "value": "leaf",
              "label": "Durable"
            },
            {
              "value": "clock",
              "label": "Durée"
            },
            {
              "value": "heart",
              "label": "Soin"
            },
            {
              "value": "shield",
              "label": "Protection"
            },
            {
              "value": "spark",
              "label": "Éclat"
            },
            {
              "value": "chat",
              "label": "Échange"
            },
            {
              "value": "pin",
              "label": "Lieu"
            },
            {
              "value": "doc",
              "label": "Document"
            },
            {
              "value": "users",
              "label": "Personnes"
            },
            {
              "value": "star",
              "label": "Qualité"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    },
    {
      "type": "avoid",
      "name": "À éviter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Entretien",
      "settings": {
        "layout": "list"
      }
    }
  ],
  "max_blocks": 10
}
{% endschema %}
