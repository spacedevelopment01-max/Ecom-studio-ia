{%- comment -%}
  SILLON V2 : « Questions fréquentes » de la fiche (planche 01) — titre et phrase à gauche, trois catégories avec très
  grands numéros en contour, intitulé et flèche, séparées par un filet, chacune vers sa catégorie de la page FAQ.
  Téléphone (planche mobile) : catégories en cartes « 01 Utilisation + », puis titre et questions dépliables.
  Blocs : « Catégorie », « Question (téléphone) ».
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="sv sv-faqlinks">
  <div class="sv-c">
    <div class="sv-faqlinks__inner">
      <div class="sv-faqlinks__head">
        <h2 class="sv-display sv-faqlinks__title">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="sv-faqlinks__text">{{ s.text | escape | newline_to_br }}</p>{%- endif -%}
      </div>
      <ul class="sv-faqlinks__list" role="list">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'category' -%}{%- assign n = n | plus: 1 -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}"><span class="sv-display sv-faqlinks__num" aria-hidden="true">{% if n < 10 %}0{% endif %}{{ n }}</span><span class="sv-faqlinks__label">{{ block.settings.label }}</span>{% render 'sv-icon', name: 'arrow' %}{% render 'sv-icon', name: 'plus', class: 'sv-faqlinks__plus' %}</a></li>
        {%- endif -%}{%- endfor -%}
      </ul>
      {%- comment -%} Questions dépliables (téléphone, planche mobile « La machine ») {%- endcomment -%}
      <div class="sv-faqlinks__qs">
        {%- for block in section.blocks -%}{%- if block.type == 'question' -%}
          <details class="sv-faqlinks__q" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}{% render 'sv-icon', name: 'plus' %}</summary><div>{{ block.settings.answer }}</div></details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Questions en catégories",
  "class": "sv-faqlinks-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "textarea", "id": "text", "label": "Phrase", "default": "Tout ce qu'il faut savoir\navant de partir." }
  ],
  "blocks": [
    { "type": "category", "name": "Catégorie", "settings": [{ "type": "text", "id": "label", "label": "Intitulé", "default": "Utilisation" }, { "type": "url", "id": "link", "label": "Lien" }] },
    { "type": "question", "name": "Question (téléphone)", "settings": [{ "type": "text", "id": "question", "label": "Question", "default": "Votre question ?" }, { "type": "richtext", "id": "answer", "label": "Réponse" }] }
  ],
  "presets": [{ "name": "Questions en catégories" }]
}
{% endschema %}
