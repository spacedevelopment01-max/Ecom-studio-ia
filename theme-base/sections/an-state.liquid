{%- comment -%}
  ATELIER NUANCE : état dans le style des pages de gestion (carte claire sur une photo du salon) : page introuvable,
  et tout autre état rédigé dans l'éditeur (lien expiré, service indisponible…). Les états du parcours de rendez-vous
  (aucun créneau, erreur réseau, créneau pris) sont affichés par la prise de rendez-vous elle-même.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="an-section an-state" data-state="{{ s.state }}">
  {% render 'an-img', image: s.image, asset: s.image_asset, alt: '', pos: s.image_position, loading: 'eager' %}
  <div class="an-wrap an-state__inner">
    <div class="an-state__card">
      {% render 'an-icon', name: 'calendar-x', class: 'an-state__ico' %}
      <h1 class="an-title an-title--md">{{ s.heading }}</h1>
      {%- if s.text != blank -%}<div class="an-state__text">{{ s.text }}</div>{%- endif -%}
      <div class="an-state__btns">
        {%- if s.button_label != blank -%}<a class="an-btn an-btn--terra" href="{{ s.button_link | default: '/' }}">{{ s.button_label }}</a>{%- endif -%}
        {%- if s.button2_label != blank -%}<a class="an-link" href="{{ s.button2_link | default: '/pages/prestations' }}">{{ s.button2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "État du salon",
  "class": "an-state-section",
  "settings": [
    { "type": "select", "id": "state", "label": "État", "default": "not_found", "options": [{ "value": "not_found", "label": "Page introuvable" }, { "value": "expired", "label": "Lien expiré" }, { "value": "unavailable", "label": "Service indisponible" }] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
    { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Page introuvable" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Retour à l'accueil" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "button2_label", "label": "Texte du second lien" },
    { "type": "url", "id": "button2_link", "label": "Second lien" }
  ],
  "presets": [{ "name": "État du salon" }]
}
{% endschema %}
