{%- comment -%}
  Carrousel vidéo premium : grandes vidéos 16:9 ou 9:16, diapositive active agrandie au centre, voisines atténuées.
  Seule la vidéo active est lue (muette, en boucle) ; bouton son et pause ; jamais de lecture automatique
  si le visiteur a demandé moins d'animations.
{%- endcomment -%}
{%- liquid
  assign label_default = 'sections.video_carousel.label' | t
  assign label = section.settings.heading | default: label_default
-%}
<section class="es-section es-vcar es-vcar--{{ section.settings.ratio }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-car data-autoplay="false" aria-roledescription="{{ 'sections.carousel.carousel' | t | escape }}" aria-label="{{ label | strip_html | escape }}">
  <div class="es-container es-vcar__head">
    <div>
      {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="es-muted es-vcar__sub" data-reveal="up">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="es-car__nav">
        <button type="button" class="es-icon-button es-icon-button--outline" data-car-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
        <button type="button" class="es-icon-button es-icon-button--outline" data-car-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
    {%- endif -%}
  </div>
  <div class="es-car__track es-vcar__track" data-car-track tabindex="0" aria-label="{{ label | strip_html | escape }}" data-reveal="up">
    {%- for block in section.blocks -%}
      {%- assign alt = block.settings.title | default: block.settings.caption | default: label -%}
      <figure class="es-car__slide es-vcar__slide" data-car-slide role="group" aria-roledescription="{{ 'sections.carousel.slide' | t | escape }}" aria-label="{{ 'sections.carousel.slide_of' | t: index: forloop.index, count: forloop.length | escape }}" {{ block.shopify_attributes }}>
        <div class="es-vcar__frame es-mbg-box">
          {% render 'es-media-bg', image: block.settings.poster, asset: block.settings.poster_asset, video: block.settings.video, video_url: block.settings.video_url, video_asset: block.settings.video_asset, alt: alt, sizes: '(min-width: 990px) 960px, 88vw' %}
          {%- if block.settings.video != blank or block.settings.video_asset != blank -%}
            <div class="es-vcar__controls">
              {%- if section.settings.show_sound -%}
                <button type="button" class="es-vcar__btn" data-car-sound aria-pressed="false" aria-label="{{ 'general.unmute' | t | escape }}" data-label-on="{{ 'general.mute' | t | escape }}" data-label-off="{{ 'general.unmute' | t | escape }}"><span class="es-vcar__muted">{% render 'icon', name: 'mute' %}</span><span class="es-vcar__unmuted">{% render 'icon', name: 'sound' %}</span></button>
              {%- endif -%}
              <button type="button" class="es-vcar__btn" data-car-play aria-pressed="false" aria-label="{{ 'general.pause' | t | escape }}" data-label-pause="{{ 'general.pause' | t | escape }}" data-label-play="{{ 'general.play' | t | escape }}"><span class="es-car__pause" aria-hidden="true"></span></button>
            </div>
          {%- endif -%}
        </div>
        {%- if block.settings.title != blank or block.settings.caption != blank -%}
          <figcaption class="es-vcar__caption">
            {%- if block.settings.title != blank -%}<b class="es-heading es-h4">{{ block.settings.title }}</b>{%- endif -%}
            {%- if block.settings.caption != blank -%}<span class="es-muted">{{ block.settings.caption }}</span>{%- endif -%}
          </figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="es-container">
      <div class="es-car__dots" role="group" aria-label="{{ 'general.pagination' | t | escape }}">
        {%- for block in section.blocks -%}
          <button type="button" class="es-car__dot" data-car-dot aria-label="{{ 'sections.carousel.go_to' | t: index: forloop.index | escape }}"{% if forloop.first %} aria-current="true"{% endif %}><i></i></button>
        {%- endfor -%}
      </div>
    </div>
    <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-car-status></p>
  {%- endif -%}
</section>
{% render 'es-premium-media' %}

{% stylesheet %}
.es-vcar { --car-w: min(76vw, 1040px); overflow: hidden; }
.es-vcar--portrait { --car-w: min(62vw, 380px); }
.es-vcar__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(24px, 4vw, 48px); }
.es-vcar__head .es-heading { margin-bottom: .2em; }
.es-vcar__sub { margin: 0; max-width: 58ch; }
.es-vcar__slide { transition: transform .8s var(--ease-out), opacity .8s var(--ease-out); }
.es-vcar__frame { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-card); background: #0d0d0d; box-shadow: 0 50px 100px -60px rgba(0,0,0,.75); }
.es-vcar--portrait .es-vcar__frame { aspect-ratio: 9 / 16; }
.es-vcar__frame .es-placeholder { min-height: 0; position: absolute; inset: 0; background: #262626; }
.es-vcar__frame::after { content: ""; position: absolute; inset: auto 0 0; height: 40%; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.45)); pointer-events: none; opacity: 0; transition: opacity .5s; }
.es-vcar__slide.is-active .es-vcar__frame::after { opacity: 1; }
.es-vcar__controls { position: absolute; right: 14px; bottom: 14px; z-index: 2; display: flex; gap: 8px; transition: opacity .4s; }
.es-vcar.is-ready .es-vcar__slide:not(.is-active) .es-vcar__controls { opacity: 0; visibility: hidden; }
.es-vcar__btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); display: grid; place-items: center; background: rgba(0,0,0,.42); color: #fff; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); cursor: pointer; transition: background .3s, transform .3s var(--ease-out); }
.es-vcar__btn:hover { background: rgba(0,0,0,.65); transform: scale(1.06); }
.es-vcar__btn[hidden] { display: none; }
.es-vcar__btn .es-icon { width: 20px; height: 20px; }
.es-vcar__unmuted, .es-vcar__btn[aria-pressed="true"] .es-vcar__muted { display: none; }
.es-vcar__btn[aria-pressed="true"] .es-vcar__unmuted { display: block; }
.es-vcar__caption { display: grid; gap: 4px; justify-items: center; text-align: center; margin-top: 18px; transition: opacity .6s; }
.es-vcar__caption .es-heading { margin: 0; }
.es-vcar.is-ready .es-vcar__slide:not(.is-active) { transform: scale(.84); opacity: .38; cursor: pointer; }
.es-vcar.is-ready .es-vcar__slide:not(.is-active) .es-vcar__caption { opacity: 0; }
.dir-flux .es-vcar__frame { border-radius: 0; }
@media (max-width: 749px) {
  .es-vcar { --car-w: 86vw; }
  .es-vcar--portrait { --car-w: 70vw; }
  .es-vcar__head .es-car__nav { display: none; }
  .es-vcar.is-ready .es-vcar__slide:not(.is-active) { transform: scale(.9); }
}
@media (prefers-reduced-motion: reduce) {
  .es-vcar__slide, .es-vcar__caption { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Carrousel vidéo premium",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "En images" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre mise en valeur" },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "select", "id": "ratio", "label": "Format des vidéos", "default": "landscape", "options": [{ "value": "landscape", "label": "Paysage 16:9" }, { "value": "portrait", "label": "Vertical 9:16" }] },
    { "type": "checkbox", "id": "show_sound", "label": "Afficher le bouton son", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    { "type": "video", "name": "Vidéo", "settings": [
      { "type": "video", "id": "video", "label": "Vidéo (hébergée par Shopify)" },
      { "type": "video_url", "id": "video_url", "label": "Vidéo YouTube ou Vimeo", "accept": ["youtube", "vimeo"] },
      { "type": "text", "id": "video_asset", "label": "Vidéo fournie avec le thème (MP4)" },
      { "type": "image_picker", "id": "poster", "label": "Image d'affiche" },
      { "type": "text", "id": "poster_asset", "label": "Affiche fournie avec le thème" },
      { "type": "text", "id": "title", "label": "Titre" },
      { "type": "text", "id": "caption", "label": "Légende" }
    ] }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Carrousel vidéo premium", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }]
}
{% endschema %}
