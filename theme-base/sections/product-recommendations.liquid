{%- comment -%}
  Recommandations produit en carrousel de cartes.
  Sur une fiche produit : recommandations calculées par Shopify (API Product Recommendations),
  chargées après l'affichage. Ailleurs, ou sans recommandation : produits de la collection de repli.
{%- endcomment -%}
{%- liquid
  assign on_product = false
  if template.name == 'product' and product
    assign on_product = true
  endif
  assign source = 'fallback'
  assign list = section.settings.fallback_collection.products
  if section.settings.fallback_collection == blank
    assign list = collections.all.products
  endif
  if on_product and recommendations.performed and recommendations.products_count > 0
    assign source = 'recommendations'
    assign list = recommendations.products
  endif
  assign total = 0
  for p in list
    if total >= section.settings.limit
      break
    endif
    if on_product and p.id == product.id
      continue
    endif
    assign total = total | plus: 1
  endfor
  assign shown = 0
-%}
{%- comment -%} Aucun autre produit à proposer (boutique d'un seul produit) : pas de titre « Vous aimerez aussi » au-dessus du vide. {%- endcomment -%}
{%- if total > 0 or request.design_mode -%}
<section class="es-section es-recos color-{{ section.settings.color_scheme }}{% if total < 4 %} es-recos--few{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-es-recos{% if on_product and recommendations.performed != true %} data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"{% endif %}>
  <div class="es-container">
    <header class="es-section-head es-recos__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="es-recos__nav" data-reveal="up">
        <button type="button" class="es-icon-button es-icon-button--outline" data-recos-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
        <button type="button" class="es-icon-button es-icon-button--outline" data-recos-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
    </header>
  </div>
  <ul class="es-recos__track es-recos__track--{{ section.settings.card_ratio }}" role="list" data-recos-track data-source="{{ source }}" aria-label="{{ section.settings.heading | escape }}">
    {%- for p in list -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      {%- if on_product and p.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="es-recos__item" style="--i: {{ forloop.index0 | at_most: 5 }}">{% render 'product-card', product_card: p, show_secondary: section.settings.show_secondary, ratio: section.settings.card_ratio %}</li>
    {%- endfor -%}
    {%- if shown == 0 and request.design_mode -%}
      {%- for i in (1..4) -%}<li class="es-recos__item">{% render 'product-card', product_card: blank, ratio: section.settings.card_ratio %}</li>{%- endfor -%}
    {%- endif -%}
  </ul>
  <div class="es-container">
    <div class="es-recos__progress" aria-hidden="true"><i></i></div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.es-recos__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; max-width: none; }
.es-recos__nav { display: flex; gap: 8px; flex: none; }
.es-recos__nav button[disabled] { opacity: .35; cursor: default; }
.es-recos__track { list-style: none; margin: 0; display: flex; gap: clamp(14px, 2vw, 26px); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
  padding: 6px max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter))) 18px; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter))); }
.es-recos__track::-webkit-scrollbar { display: none; }
.es-recos__item { flex: none; width: min(68vw, 300px); scroll-snap-align: start; }
@media (min-width: 990px) { .es-recos__item { width: calc((min(100vw, var(--page-width)) - 2 * var(--gutter) - 3 * 26px) / 4); min-width: 240px; } }
.es-recos__item .es-card__info { padding-top: 14px; }
.es-recos__item .es-card { height: 100%; }
.es-recos .es-price { white-space: nowrap; }
.es-recos__progress { position: relative; height: 2px; margin-top: 10px; background: rgba(var(--c-text-rgb), .12); border-radius: 2px; overflow: hidden; }
.es-recos__progress i { position: absolute; inset: 0 auto 0 0; width: var(--p, 25%); background: var(--c-accent); border-radius: inherit; transition: width .3s var(--ease-out); }
/* Peu de produits : rangée centrée sans rogner la première carte quand elle défile (marges automatiques). */
.es-recos--few .es-recos__item:first-child { margin-left: auto; }
.es-recos--few .es-recos__item:last-child { margin-right: auto; }
@media (min-width: 990px) { .es-recos--few .es-recos__head { flex-direction: column; align-items: center; text-align: center; } }
@media (min-width: 990px) { .es-recos--few .es-recos__item { width: min(360px, 30vw); } }
.es-recos.is-static .es-recos__nav, .es-recos.is-static .es-recos__progress { display: none; }
@media (max-width: 749px) { .es-recos__nav { display: none; } }
{% endstylesheet %}

{% javascript %}
(function () {
  function bind(s) {
    var track = s.querySelector('[data-recos-track]'); if (!track) return;
    var bar = s.querySelector('.es-recos__progress');
    var prev = s.querySelector('[data-recos-prev]'), next = s.querySelector('[data-recos-next]');
    function step() { var it = track.querySelector('.es-recos__item'); return it ? (it.getBoundingClientRect().width + 20) * (window.innerWidth > 989 ? 2 : 1) : track.clientWidth * .8; }
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      s.classList.toggle('is-static', max < 4);
      if (bar) bar.style.setProperty('--p', (max > 4 ? Math.max(12, 100 * track.clientWidth / track.scrollWidth) + (100 - Math.max(12, 100 * track.clientWidth / track.scrollWidth)) * track.scrollLeft / max : 100) + '%');
      if (prev) prev.disabled = track.scrollLeft < 4;
      if (next) next.disabled = track.scrollLeft > max - 4;
    }
    if (!s._esRecos) {
      s._esRecos = true;
      prev && prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next && next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      window.addEventListener('resize', function () { requestAnimationFrame(update); });
    }
    track.addEventListener('scroll', function () { requestAnimationFrame(update); }, { passive: true });
    update();
  }
  function load(s) {
    var url = s.getAttribute('data-url'); if (!url || s._esRecosLoaded) return; s._esRecosLoaded = true;
    fetch(url).then(function (r) { return r.text(); }).then(function (html) {
      var tmp = document.createElement('div'); tmp.innerHTML = html;
      var fresh = tmp.querySelector('[data-recos-track][data-source="recommendations"]');
      var cur = s.querySelector('[data-recos-track]');
      if (!fresh || !cur || !fresh.children.length) return;
      cur.innerHTML = fresh.innerHTML; cur.setAttribute('data-source', 'recommendations');
      cur.querySelectorAll('[data-reveal]').forEach(function (el) { el.classList.add('is-in'); });
      bind(s);
    }).catch(function () {});
  }
  function init(root) {
    (root || document).querySelectorAll('[data-es-recos]').forEach(function (s) {
      bind(s);
      if (!('IntersectionObserver' in window)) return load(s);
      var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); load(s); } }, { rootMargin: '0px 0px 400px 0px' });
      io.observe(s);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); }); else init();
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Recommandations produit",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Sur une fiche produit, Shopify choisit automatiquement les produits à recommander. Ailleurs, ou tant que Shopify n'a pas de recommandation, les produits de la collection de repli s'affichent." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Sélectionnés pour vous" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" },
    { "type": "select", "id": "intent", "label": "Type de recommandation", "default": "related", "options": [{ "value": "related", "label": "Produits similaires" }, { "value": "complementary", "label": "Produits complémentaires" }], "info": "Les produits complémentaires se règlent dans l'application Search & Discovery de Shopify." },
    { "type": "collection", "id": "fallback_collection", "label": "Collection de repli", "info": "Sans choix, tous les produits de la boutique." },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 8 },
    { "type": "select", "id": "card_ratio", "label": "Format des images", "default": "portrait", "options": [{ "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Carré" }] },
    { "type": "checkbox", "id": "show_secondary", "label": "Deuxième image au survol", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "presets": [{ "name": "Recommandations produit" }]
}
{% endschema %}
