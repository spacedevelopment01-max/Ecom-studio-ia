{%- comment -%}
  PARENTHÈSE : galeries.
  - strip : bande de photos de largeurs variées (première séance, planche 01) ;
  - mosaic : grande photo et trois petites (« Un espace propice à la détente », cabinet, planche 05), avec titre et
    texte centrés au-dessus.
  Chaque photo s'ouvre dans une visionneuse accessible (Échap, flèches, retour du focus). Blocs : « Photo ».
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="pa-section pa-gallery pa-gallery--{{ s.layout }}" data-pa-lightbox-root>
  <div class="{% if s.layout == 'strip' %}pa-gallery__full{% else %}pa-wrap{% endif %}">
    {%- if s.heading != blank -%}
      <div class="pa-gallery__head">
        <h2 class="pa-title pa-title--md">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<div class="pa-gallery__lead">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="pa-gallery__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="pa-gallery__item" {{ block.shopify_attributes }}>
          <button type="button" class="pa-gallery__open" data-pa-open data-title="{{ b.alt | escape }}">
            {% render 'pa-img', image: b.image, asset: b.image_asset, alt: b.alt, pos: b.image_position, class: 'pa-gallery__img' %}
            <span class="visually-hidden">{{ s.open_label }} : {{ b.alt }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <div class="pa-lightbox" role="dialog" aria-modal="true" aria-label="{{ s.viewer_label | escape }}" data-pa-lightbox hidden>
    <div class="pa-lightbox__panel">
      <button type="button" class="pa-lightbox__close" data-pa-lb-close aria-label="{{ s.close_label | escape }}">{% render 'pa-icon', name: 'close' %}</button>
      <figure><img alt="" data-pa-lb-img width="1600" height="1067"><figcaption data-pa-lb-title></figcaption></figure>
      <button type="button" class="pa-lightbox__nav pa-lightbox__nav--prev" data-pa-lb-prev aria-label="{{ s.prev_label | escape }}">{% render 'pa-icon', name: 'prev' %}</button>
      <button type="button" class="pa-lightbox__nav pa-lightbox__nav--next" data-pa-lb-next aria-label="{{ s.next_label | escape }}">{% render 'pa-icon', name: 'next' %}</button>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Galerie du cabinet",
  "class": "pa-gallery-section",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposition", "default": "mosaic", "options": [{ "value": "strip", "label": "Bande de photos" }, { "value": "mosaic", "label": "Mosaïque (une grande, trois petites)" }] },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "open_label", "label": "Ouvrir une photo (lecteurs d'écran)", "default": "Agrandir" },
    { "type": "text", "id": "viewer_label", "label": "Nom de la visionneuse", "default": "Photos du cabinet" },
    { "type": "text", "id": "close_label", "label": "Bouton fermer", "default": "Fermer" },
    { "type": "text", "id": "prev_label", "label": "Bouton précédent (lecteurs d'écran)", "default": "Photo précédente" },
    { "type": "text", "id": "next_label", "label": "Bouton suivant (lecteurs d'écran)", "default": "Photo suivante" }
  ],
  "blocks": [
    {
      "type": "photo", "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Photo fournie avec le thème" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "alt", "label": "Description (texte alternatif)" }
      ]
    }
  ],
  "presets": [{ "name": "Galerie du cabinet" }]
}
{% endschema %}
