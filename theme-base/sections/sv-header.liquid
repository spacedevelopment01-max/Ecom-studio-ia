{%- comment -%}
  SILLON V2 : en-tête flottant en capsule ivoire (planches 01 à 03) — nom de marque, menu, petit bouton sombre
  « Découvrir », panier cuivre séparé (nombre d'articles). Téléphone : capsule « logo + menu » et panier ; menu plein
  écran sombre sur un paysage, grands liens condensés, chemin cuivre et mots-étapes.
  Porte aussi les réglages communs du thème : couleurs, polices des étiquettes et de la signature, mention de
  démonstration, mode de commande (démonstration ou paiement Shopify), bandeau cookies.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]
  assign label_font = s.label_font
  assign thin_font = s.thin_font
-%}
{%- assign label_bold = label_font | font_modify: 'weight', 'bold' -%}
{%- assign cond_500 = thin_font | font_modify: 'weight', '500' -%}
{%- assign cond_700 = thin_font | font_modify: 'weight', '700' -%}
<style>
  {{ label_font | font_face: font_display: 'swap' }}
  {%- if label_bold -%}{{ label_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {{ thin_font | font_face: font_display: 'swap' }}
  {%- if cond_500 -%}{{ cond_500 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if cond_700 -%}{{ cond_700 | font_face: font_display: 'swap' }}{%- endif -%}
  body.dir-sillon, .sv, .sv-header, .sv-footer, .sv-menu, .sv-cookies, .sv-lightbox, .sv-buybar {
    --sv-cream: {{ s.color_cream }};
    --sv-sand: {{ s.color_sand }};
    --sv-ink: {{ s.color_ink }};
    --sv-night: {{ s.color_night }};
    --sv-copper: {{ s.color_copper }};
    --sv-sage: {{ s.color_sage }};
    --sv-ivory: {{ s.color_ivory }};
    --sv-mono: {{ label_font.family }}, {{ label_font.fallback_families }};
    --sv-thin: {{ thin_font.family }}, {{ thin_font.fallback_families }};
    --sv-thin-weight: {{ thin_font.weight }};
    --sv-cond: {{ thin_font.family }}, {{ thin_font.fallback_families }};
  }
</style>
{{ 'sillon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sillon.js' | asset_url }}" defer="defer"></script>
<script type="application/json" id="sv-config">
  {
    "checkout": {{ s.checkout_mode | json }},
    "checkoutPage": {{ s.checkout_page | json }},
    "demo": {% if s.demo_mode %}true{% else %}false{% endif %},
    "cartUrl": {{ routes.cart_url | json }},
    "money": {{ shop.money_format | json }},
    "texts": {
      "added": {{ s.added_label | json }},
      "removed": {{ s.removed_label | json }},
      "error": {{ s.error_label | json }}
    }
  }
</script>

<header class="sv-header" data-sv-header>
  <div class="sv-header__inner">
    <div class="sv-header__bar">
      <a class="sv-header__brand" href="{{ routes.root_url }}">{{ s.wordmark | default: shop.name }}</a>
      {%- if menu.links.size > 0 -%}
        <nav class="sv-header__nav" aria-label="{{ s.nav_label | escape }}">
          <ul role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}"{% if link.active or link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- if s.cta_label != blank -%}<a class="sv-header__cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a>{%- endif -%}
      <button type="button" class="sv-header__burger" aria-controls="sv-menu" aria-expanded="false" data-sv-menu-open>
        <span class="visually-hidden">{{ s.menu_open_label }}</span>{% render 'sv-icon', name: 'menu' %}
      </button>
    </div>
    <a class="sv-header__cart" href="{{ routes.cart_url }}" aria-label="{{ s.cart_label | escape }}">
      {% render 'sv-icon', name: 'cart' %}
      <span class="sv-header__count" data-sv-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div class="sv-menu" id="sv-menu" role="dialog" aria-modal="true" aria-label="{{ s.menu_label | escape }}" hidden data-sv-menu>
  {% render 'sv-img', image: s.menu_image, asset: s.menu_image_asset, alt: '', pos: s.menu_image_position, class: 'sv-menu__bg', loading: 'lazy' %}
  <button type="button" class="sv-menu__close" data-sv-menu-close><span class="visually-hidden">{{ s.menu_close_label }}</span>{% render 'sv-icon', name: 'close' %}</button>
  <nav class="sv-menu__nav" aria-label="{{ s.nav_label | escape }}">
    <ul role="list">
      {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
    </ul>
  </nav>
  {% render 'sv-route', d: 'M30 395C60 330 20 300 70 270S180 250 160 190 250 120 280 60 300 10 330 0', vb: '0 0 340 400', dots: '30,395 70,270 160,190 280,60', class: 'sv-menu__route', width: 2 %}
  {%- if s.menu_words != blank -%}<p class="sv-menu__words">{{ s.menu_words | escape | newline_to_br }}</p>{%- endif -%}
</div>

{%- if s.show_cookies -%}
  <div class="sv-cookies" role="dialog" aria-modal="false" aria-labelledby="sv-cookies-title-{{ section.id }}" hidden data-sv-cookies>
    <h2 class="sv-cookies__title" id="sv-cookies-title-{{ section.id }}">{{ s.cookies_title }}</h2>
    <p>{{ s.cookies_text }}{% if s.cookies_link != blank %} <a href="{{ s.cookies_link }}">{{ s.cookies_more }}</a>{% endif %}</p>
    <div class="sv-cookies__prefs" hidden>
      <label class="sv-check"><input type="checkbox" checked disabled><span>{{ s.cookies_needed }}</span></label>
      <label class="sv-check"><input type="checkbox" data-sv-cookies-stats><span>{{ s.cookies_stats }}</span></label>
    </div>
    <div class="sv-cookies__actions">
      <button type="button" class="sv-btn sv-btn--copper sv-btn--sm" data-sv-cookies-accept>{{ s.cookies_accept }}</button>
      <button type="button" class="sv-btn sv-btn--line sv-btn--sm" data-sv-cookies-refuse>{{ s.cookies_refuse }}</button>
      <button type="button" class="sv-btn sv-btn--link sv-btn--sm" aria-expanded="false" data-sv-cookies-custom>{{ s.cookies_custom }}</button>
      <button type="button" class="sv-btn sv-btn--dark sv-btn--sm" data-sv-cookies-save hidden>{{ s.cookies_save }}</button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "En-tête SILLON",
  "class": "sv-header-section",
  "settings": [
    { "type": "header", "content": "En-tête flottant" },
    { "type": "text", "id": "wordmark", "label": "Nom affiché", "info": "Vide : le nom de la boutique." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "nav_label", "label": "Nom du menu (lecteurs d'écran)", "default": "Navigation principale" },
    { "type": "text", "id": "cta_label", "label": "Bouton sombre", "default": "Découvrir" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "text", "id": "cart_label", "label": "Nom du panier (lecteurs d'écran)", "default": "Panier" },
    { "type": "header", "content": "Menu du téléphone" },
    { "type": "text", "id": "menu_label", "label": "Nom du menu plein écran", "default": "Menu" },
    { "type": "text", "id": "menu_open_label", "label": "Bouton d'ouverture", "default": "Ouvrir le menu" },
    { "type": "text", "id": "menu_close_label", "label": "Bouton de fermeture", "default": "Fermer le menu" },
    { "type": "image_picker", "id": "menu_image", "label": "Photo de fond" },
    { "type": "text", "id": "menu_image_asset", "label": "Photo de fond (fichier du thème)" },
    { "type": "text", "id": "menu_image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
    { "type": "textarea", "id": "menu_words", "label": "Mots-étapes", "default": "Explorer\nDéguster\nS'évader" },
    { "type": "header", "content": "Couleurs du thème" },
    { "type": "color", "id": "color_cream", "label": "Crème minérale", "default": "#EEE7D9" },
    { "type": "color", "id": "color_sand", "label": "Sable des cartes", "default": "#E2D8C7" },
    { "type": "color", "id": "color_ink", "label": "Brun des textes", "default": "#211D15" },
    { "type": "color", "id": "color_night", "label": "Brun espresso des blocs", "default": "#1E1913" },
    { "type": "color", "id": "color_copper", "label": "Cuivre", "default": "#B35D30" },
    { "type": "color", "id": "color_sage", "label": "Vert grisé", "default": "#6A6C5C" },
    { "type": "color", "id": "color_ivory", "label": "Ivoire sur fond sombre", "default": "#F1E9DC" },
    { "type": "header", "content": "Polices" },
    { "type": "font_picker", "id": "label_font", "label": "Étiquettes à chasse fixe", "default": "space_mono_n4" },
    { "type": "font_picker", "id": "thin_font", "label": "Condensée (signature fine du pied sombre, questions et libellés)", "default": "oswald_n2" },
    { "type": "header", "content": "Commande" },
    { "type": "checkbox", "id": "demo_mode", "label": "Boutique de démonstration", "default": false, "info": "Commande, suivi et formulaires simulés et annoncés comme tels ; aucun paiement ni envoi." },
    { "type": "select", "id": "checkout_mode", "label": "Bouton « Passer commande »", "default": "shopify", "options": [{ "value": "shopify", "label": "Paiement Shopify" }, { "value": "demo", "label": "Page de commande de démonstration" }] },
    { "type": "url", "id": "checkout_page", "label": "Page de commande de démonstration" },
    { "type": "text", "id": "added_label", "label": "Message « ajouté au panier »", "default": "Ajouté au panier." },
    { "type": "text", "id": "removed_label", "label": "Message « retiré du panier »", "default": "Article retiré du panier." },
    { "type": "text", "id": "error_label", "label": "Message d'erreur", "default": "Une erreur est survenue. Réessayez." },
    { "type": "header", "content": "Cookies" },
    { "type": "checkbox", "id": "show_cookies", "label": "Bandeau cookies", "default": true },
    { "type": "text", "id": "cookies_title", "label": "Titre", "default": "Vos préférences de cookies" },
    { "type": "textarea", "id": "cookies_text", "label": "Texte", "default": "Les cookies nécessaires font fonctionner le site. La mesure d'audience est facultative et ne démarre qu'avec votre accord." },
    { "type": "url", "id": "cookies_link", "label": "Lien « En savoir plus »" },
    { "type": "text", "id": "cookies_more", "label": "Texte du lien", "default": "En savoir plus" },
    { "type": "text", "id": "cookies_needed", "label": "Cookies nécessaires", "default": "Cookies nécessaires au fonctionnement" },
    { "type": "text", "id": "cookies_stats", "label": "Cookies facultatifs", "default": "Mesure d'audience (facultatif)" },
    { "type": "text", "id": "cookies_accept", "label": "Accepter", "default": "Tout accepter" },
    { "type": "text", "id": "cookies_refuse", "label": "Refuser", "default": "Tout refuser" },
    { "type": "text", "id": "cookies_custom", "label": "Personnaliser", "default": "Personnaliser" },
    { "type": "text", "id": "cookies_save", "label": "Enregistrer", "default": "Enregistrer mes choix" }
  ],
  "presets": [{ "name": "En-tête SILLON" }]
}
{% endschema %}
