<section class="es-section es-contact color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container es-contact__grid">
    <header class="es-contact__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="es-rte es-contact__text" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.email != blank or section.settings.hours != blank or section.settings.response != blank -%}
        <ul class="es-contact__details" role="list" data-reveal="up" style="--d: 1">
          {%- if section.settings.email != blank -%}<li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ section.settings.email | strip | split: ' ' | first }}">{{ section.settings.email }}</a></li>{%- endif -%}
          {%- if section.settings.hours != blank -%}<li>{% render 'icon', name: 'clock' %}<span>{{ section.settings.hours }}</span></li>{%- endif -%}
          {%- if section.settings.response != blank -%}<li>{% render 'icon', name: 'chat' %}<span>{{ section.settings.response }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </header>
    {%- form 'contact', id: 'ContactForm', class: 'es-form es-contact__form' -%}
      {%- if form.posted_successfully? -%}<p class="es-form-success" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="es-form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="es-form__row">
        <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
        <label>{{ 'contact.email' | t }} *<input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
      </div>
      <label>{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
      <label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="6" class="es-textarea">{{ form.body }}</textarea></label>
      <button type="submit" class="es-button">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>


{% stylesheet %}
.es-contact__intro .es-heading { margin-bottom: 14px; }
.es-contact__text { color: var(--c-muted); font-size: 1.05rem; max-width: 42ch; }
.es-contact__details { list-style: none; margin: 28px 0 0; padding: 22px 0 0; display: grid; gap: 14px; border-top: 1px solid var(--c-border); }
.es-contact__details li { display: flex; align-items: center; gap: 12px; font-size: .98rem; }
.es-contact__details .es-icon { width: 20px; height: 20px; flex: none; color: var(--c-accent); }
.es-contact__details a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }
.es-contact__form { padding: clamp(22px, 3.4vw, 40px); border-radius: var(--radius-card); background: var(--c-surface); border: 1px solid var(--c-border); }
.es-contact__form label { font-weight: var(--font-body-weight-bold); }
.es-contact__form input:not([type=checkbox]), .es-contact__form .es-textarea { width: 100%; font-weight: 400; }
.es-contact__form .es-button { justify-self: start; min-width: 200px; }
@media (max-width: 749px) { .es-contact__form .es-button { justify-self: stretch; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nous répondons à chaque message.</p>" },
    { "type": "header", "content": "Coordonnées" },
    { "type": "text", "id": "email", "label": "Adresse e-mail affichée", "info": "Facultatif. Laissez vide pour ne rien afficher." },
    { "type": "text", "id": "hours", "label": "Horaires", "info": "Facultatif. Ex. : du lundi au vendredi, 9 h – 18 h." },
    { "type": "text", "id": "response", "label": "Délai de réponse", "info": "Facultatif. Indiquez uniquement un délai que vous tenez réellement." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
