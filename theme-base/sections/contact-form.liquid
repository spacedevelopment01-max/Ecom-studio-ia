<section class="es-section es-contact color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container es-contact__grid">
    <header>
      <h2 class="es-heading es-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="es-rte es-muted">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    {%- form 'contact', id: 'ContactForm', class: 'es-form' -%}
      {%- if form.posted_successfully? -%}<p class="es-form-success" role="status">{{ 'contact.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="es-form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="es-form__row">
        <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
        <label>{{ 'contact.email' | t }} *<input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
      </div>
      <label>{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
      <label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="6" class="es-textarea">{{ form.body }}</textarea></label>
      <button type="submit" class="es-button">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nous répondons à chaque message.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
