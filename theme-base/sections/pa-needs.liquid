{%- comment -%}
  PARENTHÈSE : cartes de besoins (accueil, planche 02) : photo, titre, texte, « En savoir plus ». Ordinateur : trois
  cartes ; téléphone : lignes avec vignette et flèche. Chaque carte mène à sa page.
  Blocs : « Besoin ».
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="pa-section pa-needs">
  <div class="pa-wrap">
    {%- if s.heading != blank -%}<h2 class="pa-title pa-title--md">{{ s.heading }}</h2>{%- endif -%}
    <ul class="pa-needs__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="pa-needs__item" {{ block.shopify_attributes }}>
          <a class="pa-needs__card" href="{{ b.link | default: '/pages/seances' }}">
            {% render 'pa-img', image: b.image, asset: b.image_asset, alt: b.image_alt, pos: b.image_position, class: 'pa-needs__img' %}
            <span class="pa-needs__body">
              <span class="pa-needs__title">{{ b.title | escape | newline_to_br }}</span>
              {%- if b.text != blank -%}<span class="pa-needs__text">{{ b.text }}</span>{%- endif -%}
              {%- if b.link_label != blank -%}<span class="pa-link">{{ b.link_label }}{% render 'pa-icon', name: 'arrow' %}</span>{%- endif -%}
            </span>
            <span class="pa-needs__arrow" aria-hidden="true">{% render 'pa-icon', name: 'arrow' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Besoins en cartes",
  "class": "pa-needs-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (facultatif)" }
  ],
  "blocks": [
    {
      "type": "need", "name": "Besoin",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Photo fournie avec le thème" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de la photo" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "textarea", "id": "title", "label": "Titre", "default": "Faire une pause" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "En savoir plus" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Besoins en cartes" }]
}
{% endschema %}
