<section class="es-section es-password color-scheme-1" style="--pt: 120px; --pb: 120px;">
  <div class="es-container es-center">
    <p class="es-header__wordmark">{{ shop.name }}</p>
    <h1 class="es-heading es-h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="es-muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'es-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="es-inline-field"><input type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}" aria-label="{{ 'newsletter.label' | t }}"><button class="es-button" type="submit">{{ 'newsletter.button' | t }}</button></div>
      {%- if form.posted_successfully? -%}<p class="es-form-success">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details class="es-password__login"><summary>{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="es-inline-field"><input type="password" name="password" aria-label="{{ 'password.label' | t }}" placeholder="{{ 'password.label' | t }}"><button class="es-button" type="submit">{{ 'password.enter' | t }}</button></div>
        {%- if form.errors -%}<p class="es-form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Page protégée", "settings": [ { "type": "text", "id": "heading", "label": "Titre", "default": "Bientôt en ligne" } ] }
{% endschema %}
