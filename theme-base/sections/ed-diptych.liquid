{% assign s = section.settings %}
<section class="ed-section ed-diptych ed-diptych--{{ s.layout }} color-{{ s.color_scheme }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-ed-motion="{{ s.motion }}" style="--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;">
<div class="ed-shell"><header class="ed-section-head"><p class="ed-kicker">{{ s.label | escape }}</p><h2 class="ed-title">{{ s.heading | escape }}</h2><div class="ed-prose">{{ s.text }}</div></header><div class="ed-diptych__grid">{% for block in section.blocks %}{% if block.settings.image == blank and block.settings.image_asset == blank %}{% continue %}{% endif %}<figure class="ed-diptych__frame ed-ratio--{{ block.settings.ratio }}" {{ block.shopify_attributes }}>{% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.image_alt, role_label: block.settings.media_role, focus_x: block.settings.focus_x, focus_y: block.settings.focus_y, mobile_focus_x: block.settings.mobile_focus_x, mobile_focus_y: block.settings.mobile_focus_y %}<figcaption>{% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}<div class="ed-prose">{{ block.settings.text }}</div>{% if block.settings.link != blank %}<a class="ed-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}<span aria-hidden="true">↗</span></a>{% endif %}</figcaption></figure>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Diptyque éditorial",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre de navigation"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Mouvement",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "reveal",
          "label": "Entrée unique"
        },
        {
          "value": "drift",
          "label": "Déplacement léger"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "label",
      "label": "Repère éditorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du lien"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Destination"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Composition",
      "default": "pair",
      "options": [
        {
          "value": "pair",
          "label": "Diptyque"
        },
        {
          "value": "side",
          "label": "Côte à côte (deux colonnes, aussi sur téléphone)"
        },
        {
          "value": "index",
          "label": "Index d’inspirations"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diptyque éditorial",
      "blocks": [
        {
          "type": "frame"
        },
        {
          "type": "frame"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Photographie légendée",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fichier du projet"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Description de l’image"
        },
        {
          "type": "text",
          "id": "media_role",
          "label": "Rôle du visuel attendu"
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Point focal horizontal",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y",
          "label": "Point focal vertical",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_focus_x",
          "label": "Point focal horizontal (mobile)",
          "info": "Vide : même cadrage que sur ordinateur.",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_focus_y",
          "label": "Point focal vertical (mobile)",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de la photographie"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte de la légende"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien de la photographie"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Libellé du lien"
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Proportion",
          "options": [
            {
              "value": "landscape",
              "label": "Paysage"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "square",
              "label": "Carré"
            }
          ],
          "default": "landscape"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
