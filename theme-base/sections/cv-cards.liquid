{%- comment -%}
  Cartes de détails : titre en deux temps, texte, puis cartes bordées (visuel à gauche, titre et texte à droite).
  Trois cartes côte à côte sur ordinateur, empilées sur mobile.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="es-section cv-cards cv-cards--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;">
  <div class="es-container">
    {%- if s.heading != blank or s.text != blank -%}
      <header class="cv-head">
        <h2 class="es-heading cv-title cv-title--h2" data-reveal="up">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-head__text" data-reveal="up">{{ s.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="cv-cards__grid" style="--n:{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <article class="cv-card" data-reveal="up" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="cv-card__media">{% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, role_label: block.settings.media_role, focus_x: block.settings.focus_x, focus_y: block.settings.focus_y %}</div>
          <div class="cv-card__copy">
            <h3 class="es-heading cv-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="es-rte cv-card__text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cartes de détails",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trois détails" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre en accent" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "select", "id": "layout", "label": "Disposition", "default": "rows", "options": [ { "value": "rows", "label": "Visuel à gauche, texte à droite" }, { "value": "columns", "label": "Visuel au-dessus du texte" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espace au-dessus", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espace en dessous", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "card", "name": "Carte", "settings": [
      { "type": "image_picker", "id": "image", "label": "Visuel" },
      { "type": "text", "id": "image_asset", "label": "Fichier image fourni avec le thème" },
      { "type": "text", "id": "media_role", "label": "Rôle du visuel attendu" },
      { "type": "range", "id": "focus_x", "label": "Point focal horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "focus_y", "label": "Point focal vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "text", "id": "title", "label": "Titre", "default": "Un détail" },
      { "type": "richtext", "id": "text", "label": "Texte" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Cartes de détails", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] } ]
}
{% endschema %}
