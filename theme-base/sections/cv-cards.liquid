{%- comment -%}
  Cartes de détails : titre en deux temps, texte, puis cartes bordées (visuel à gauche, titre et texte à droite).
  Trois cartes côte à côte sur ordinateur, empilées sur mobile. « Texte sur la photo » (maquettes TRAVERSE) : grandes
  photos, titre et phrase posés en bas à gauche ; « Visuel au-dessus » accepte un lien sous chaque carte (carnet).
  « Photos à pastille » (maquettes MUSEAU CLUB) : titre et texte à gauche, photos arrondies et leur pastille-lien ;
  légendes numérotées en option.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="es-section cv-anim cv-anim--{{ section.settings.animation_speed | default: 'normal' }} cv-cards cv-cards--{{ s.layout }}{% if s.numbered %} cv-cards--numbered{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;">
  <div class="es-container">
    {%- if s.heading != blank or s.text != blank -%}
      <header class="cv-head">
        <h2 class="es-heading cv-title cv-title--h2"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-head__text"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="cv-cards__grid" style="--n:{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <article class="cv-card"{% render 'cv-reveal', animation: section.settings.animation %} style="--i:{{ forloop.index0 }};{% if block.settings.image_zoom > 100 %}--cv-zoom:{{ block.settings.image_zoom | divided_by: 100.0 }};{% endif %}" {{ block.shopify_attributes }}>
          <div class="cv-card__media">{% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, role_label: block.settings.media_role, focus_x: block.settings.focus_x, focus_y: block.settings.focus_y %}</div>
          <div class="cv-card__copy">
            {%- if s.layout == 'pills' -%}
            {%- if block.settings.link != blank -%}<a class="cv-card__pill cv-card__cover" href="{{ block.settings.link }}">{{ block.settings.title | escape }} {% render 'icon', name: 'arrow' %}</a>{%- else -%}<span class="cv-card__pill">{{ block.settings.title | escape }}</span>{%- endif -%}
            {%- else -%}
            <h3 class="es-heading cv-card__title">{% if block.settings.link != blank and s.layout == 'overlay' %}<a class="cv-card__cover" href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
            {%- if block.settings.text != blank -%}<div class="es-rte cv-card__text">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank and s.layout != 'overlay' -%}<a class="cv-card__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cartes de détails",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Trois détails"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre en accent"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "default": "rows",
      "options": [
        {
          "value": "rows",
          "label": "Visuel à gauche, texte à droite"
        },
        {
          "value": "columns",
          "label": "Visuel au-dessus du texte"
        },
        {
          "value": "overlay",
          "label": "Texte sur la photo"
        },
        {
          "value": "pills",
          "label": "Photos à pastille, texte à gauche"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "numbered",
      "label": "Numéroter les légendes",
      "default": false
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "rise",
      "options": [
        {
          "value": "none",
          "label": "Aucune"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée en fondu"
        },
        {
          "value": "zoom",
          "label": "Léger zoom"
        }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Vitesse",
      "default": "normal",
      "options": [
        {
          "value": "slow",
          "label": "Lente"
        },
        {
          "value": "normal",
          "label": "Normale"
        },
        {
          "value": "fast",
          "label": "Rapide"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en dessous",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Visuel"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fichier image fourni avec le thème"
        },
        {
          "type": "text",
          "id": "media_role",
          "label": "Rôle du visuel attendu"
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Point focal horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y",
          "label": "Point focal vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "image_zoom",
          "label": "Agrandissement du visuel",
          "info": "Au-delà de 100 %, la photo est agrandie autour du point focal.",
          "min": 100,
          "max": 250,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Un détail"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien de la carte"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texte du lien",
          "info": "Ex. « Lire l'article ». Avec « Texte sur la photo », toute la carte devient le lien."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Cartes de détails",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
