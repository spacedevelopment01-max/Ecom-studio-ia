{%- comment -%}
  PHASE : appels à l'action des planches 01 à 10.
  - band : grand bandeau jaune (sur-titre, titre, bouton bleu nuit, traits de circuit et note) — accueil ;
  - slim : bandeau jaune sur une ligne (titre, bouton, note) — réalisations, projet, entreprise, questions ;
  - soft : cadre gris clair et bouton jaune (« Un doute ? ») — prestations ;
  - au téléphone : bandeau, bouton à droite, cadre gris, bloc jaune compact ou lien jaune (« Votre projet / Décrire mon
    projet → », toute la surface est cliquable).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign lay = s.layout
-%}
<section class="ph ph-cta ph-cta--{{ lay }} ph-cta--m-{{ s.layout_mobile }}{% if s.show == 'desktop' %} ph-only-d{% elsif s.show == 'mobile' %} ph-only-m{% endif %}" style="--ph-ts: {{ s.title_size }}; --ph-ch: {{ s.height }}; --ph-cw: {{ s.copy_width }}; --ph-ts-m: {{ s.title_size_mobile }}; --ph-pad-t: {{ s.pad_top }}; --ph-pad-b: {{ s.pad_bottom }}; --ph-pad-t-m: {{ s.pad_top_mobile }}; --ph-pad-b-m: {{ s.pad_bottom_mobile }};">
  <div class="ph-c">
    <div class="ph-cta__box">
      <div class="ph-cta__copy">
        {%- if s.eyebrow != blank or s.eyebrow_mobile != blank -%}<p class="ph-eyebrow ph-cta__eyebrow{% if s.eyebrow == blank %} ph-only-m{% endif %}"><span{% if s.eyebrow_mobile != blank %} class="ph-txt-d"{% endif %}>{{ s.eyebrow }}</span>{%- if s.eyebrow_mobile != blank -%}<span class="ph-txt-m">{{ s.eyebrow_mobile }}</span>{%- endif -%}</p>{%- endif -%}
        {% render 'ph-title', text: s.heading, tag: 'h2', class: 'ph-cta__title' %}
        {%- if s.heading_mobile != blank -%}{% render 'ph-title', text: s.heading_mobile, tag: 'p', class: 'ph-cta__title ph-cta__title--m' %}{%- endif -%}
        {%- if s.text != blank -%}<div class="ph-cta__text">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if s.button_label != blank -%}
        <a class="ph-btn {% if lay == 'soft' %}ph-btn--yellow{% else %}ph-btn--navy{% endif %} ph-cta__btn" href="{{ s.button_link | default: routes.root_url }}">{%- if s.button_icon != blank -%}{% render 'ph-icon', name: s.button_icon, class: 'ph-cta__btn-ico', stroke: 1.8 %}{%- endif -%}<span class="ph-txt-d">{{ s.button_label }}</span>{%- if s.button_label_mobile != blank -%}<span class="ph-txt-m">{{ s.button_label_mobile }}</span>{%- endif -%}{% render 'ph-icon', name: 'fleche-droite', stroke: 2.4 %}</a>
      {%- endif -%}
      {%- if s.circuit != 'none' or s.note != blank -%}
        <div class="ph-cta__deco ph-cta__deco--{{ s.circuit }}" aria-hidden="true">
          {%- if s.circuit != 'none' -%}{% render 'ph-art', name: s.circuit %}{%- endif -%}
          {%- if s.note != blank -%}<p class="ph-note ph-cta__note">{{ s.note | newline_to_br }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel à l'action PHASE",
  "class": "ph-section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposition (ordinateur)", "default": "band", "options": [
      { "value": "band", "label": "Grand bandeau jaune" },
      { "value": "slim", "label": "Bandeau jaune sur une ligne" },
      { "value": "soft", "label": "Cadre gris clair, bouton jaune" }
    ] },
    { "type": "select", "id": "layout_mobile", "label": "Disposition (téléphone)", "default": "band", "options": [
      { "value": "band", "label": "Bandeau jaune, bouton pleine largeur" },
      { "value": "inline", "label": "Bandeau jaune, bouton à droite du titre" },
      { "value": "soft", "label": "Cadre gris clair" },
      { "value": "box", "label": "Bloc jaune compact" },
      { "value": "link", "label": "Lien jaune (sur-titre et bouton en grand)" }
    ] },
    { "type": "select", "id": "show", "label": "Affichage", "default": "all", "options": [{ "value": "all", "label": "Ordinateur et téléphone" }, { "value": "desktop", "label": "Ordinateur seulement" }, { "value": "mobile", "label": "Téléphone seulement" }] },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "eyebrow_mobile", "label": "Sur-titre au téléphone (facultatif)" },
    { "type": "textarea", "id": "heading", "label": "Titre", "info": "Une ligne par retour à la ligne." },
    { "type": "textarea", "id": "heading_mobile", "label": "Titre au téléphone (facultatif)" },
    { "type": "range", "id": "title_size", "label": "Taille du titre (repère 1440 px)", "min": 24, "max": 120, "step": 1, "default": 62 },
    { "type": "range", "id": "title_size_mobile", "label": "Taille du titre (téléphone, repère 390 px)", "min": 16, "max": 60, "step": 0.5, "default": 30 },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Demander un devis" },
    { "type": "text", "id": "button_label_mobile", "label": "Bouton au téléphone (facultatif)" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "button_icon", "label": "Pictogramme du bouton (nom, facultatif)" },
    { "type": "select", "id": "circuit", "label": "Trait de circuit", "default": "cta", "options": [
      { "value": "none", "label": "Aucun" },
      { "value": "cta", "label": "Deux traits et pastilles" },
      { "value": "cta-slim", "label": "Trait en crochet" },
      { "value": "cta-diag", "label": "Trait en diagonale" }
    ] },
    { "type": "textarea", "id": "note", "label": "Note à chasse fixe" },
    { "type": "number", "id": "height", "label": "Hauteur du bandeau sur une ligne (repère 1440 px)", "default": 186 },
    { "type": "number", "id": "copy_width", "label": "Largeur du texte du bandeau sur une ligne (repère 1440 px)", "default": 700 },
    { "type": "range", "id": "pad_top", "label": "Marge haute (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pad_top_mobile", "label": "Marge haute (téléphone)", "min": 0, "max": 100, "step": 1, "default": 0 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Marge basse (téléphone)", "min": 0, "max": 100, "step": 1, "default": 0 }
  ],
  "presets": [{ "name": "Appel à l'action PHASE" }]
}
{% endschema %}
