{%- comment -%}
Ambiance et lookbook (e-commerce) : une scène et des repères numérotés qui identifient chaque produit (nom, prix,
  lien) ; ou la scène avec la liste des produits à côté. Repères accessibles au clavier, Échap ferme la fiche ouverte.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-lookbook fs-lookbook--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link, tag: s.heading_tag -%}
    <div class="fs-look__grid">
      <figure class="fs-look__scene" data-fs-hotspots>
        <div class="fs-look__media"{% render 'fs-reveal', effect: 'curtain' %}>{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y %}</div>
        {%- for block in section.blocks -%}
          {%- assign p = all_products[block.settings.product] | default: block.settings.product -%}
          <div class="fs-look__marker" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%" {{ block.shopify_attributes }}>
            <button type="button" class="fs-look__dot" aria-expanded="false" aria-controls="fs-look-{{ section.id }}-{{ forloop.index }}" data-fs-hotspot>{{ forloop.index }}<span class="visually-hidden"> {{ block.settings.title | default: p.title | escape }}</span></button>
            <div class="fs-look__card" id="fs-look-{{ section.id }}-{{ forloop.index }}" hidden>
              <strong class="fs-item__title">{{ block.settings.title | default: p.title | escape }}</strong>
              {%- if block.settings.price_text != blank -%}<span class="fs-meta">{{ block.settings.price_text | escape }}</span>{%- elsif p.price -%}<span class="fs-meta">{{ p.price | money }}</span>{%- endif -%}
              {%- assign href = block.settings.link | default: p.url -%}{%- if href != blank -%}<a class="fs-link" href="{{ href }}">{{ s.link_label | default: 'Voir le produit' | escape }}</a>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </figure>
      {%- if s.layout == 'detail' -%}
        <div class="fs-look__details">
          {%- for block in section.blocks -%}
            <details class="fs-look__detail"{% render 'fs-reveal', effect: fx %}><summary><span class="fs-look__n" aria-hidden="true">{{ forloop.index }}</span><span class="fs-item__title">{{ block.settings.title | escape }}</span><span class="fs-look__plus" aria-hidden="true"></span></summary>{%- if block.settings.text != blank -%}<div class="fs-item__text">{{ block.settings.text }}</div>{%- endif -%}</details>
          {%- endfor -%}
          {%- if s.note != blank -%}<p class="fs-note">{{ s.note | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.layout == 'side' -%}
        <ol class="fs-look__list" role="list">
          {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
            {%- assign p = all_products[block.settings.product] | default: block.settings.product -%}
            {%- assign href = block.settings.link | default: p.url -%}
            <li class="fs-look__item"{% render 'fs-reveal', effect: fx, index: ix %}><span class="fs-look__n" aria-hidden="true">{{ forloop.index }}</span><span><strong class="fs-item__title">{{ block.settings.title | default: p.title | escape }}</strong>{% if block.settings.price_text != blank %}<span class="fs-meta">{{ block.settings.price_text | escape }}</span>{% elsif p.price %}<span class="fs-meta">{{ p.price | money }}</span>{% endif %}</span>{% if href != blank %}<a class="fs-link" href="{{ href }}">{{ s.link_label | default: 'Voir le produit' | escape }}</a>{% endif %}</li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre",
      "options": [
        {
          "value": "h1",
          "label": "Titre de page"
        },
        {
          "value": "h2",
          "label": "Titre de section"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "markers",
          "label": "Scène et repères produits"
        },
        {
          "value": "side",
          "label": "Scène et liste des produits"
        },
        {
          "value": "detail",
          "label": "Repères numérotés et détails dépliables"
        }
      ],
      "default": "markers"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Mention sous les détails",
      "info": "Disposition « Repères et détails » : ex. « Données techniques à renseigner pour le produit réel. »"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fichier du projet"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Média attendu (aperçu du studio)"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Point focal horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Point focal vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé des liens",
      "default": "Voir le produit"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "marker",
      "name": "Repère produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nom (vide : celui du produit)"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Prix affiché (vide : celui du produit)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (vide : la fiche)"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Position horizontale",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Position verticale",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Détail (disposition « Repères et détails »)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "settings": {
        "layout": "markers"
      }
    }
  ],
  "max_blocks": 8
}
{% endschema %}
