{%- comment -%}
  Recommandations de professionnels réels, cités avec leur accord écrit.
  Rien n'est inventé : blocs en espaces réservés à compléter ; le badge « vérifié » n'apparaît
  que si le marchand le coche, après vérification de l'identité et de l'accord du professionnel.
{%- endcomment -%}
<section class="es-section es-xp es-ambient es-ambient--left color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-xp>
  <div class="es-container">
    <header class="es-section-head es-xp__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow es-xp__eyebrow" data-reveal="up">{% render 'es-glyph', name: 'verified', class: 'es-xp__eyebrow-icon' %}<span>{{ section.settings.eyebrow }}</span></p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="es-rte es-lead" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="es-xp__nav" data-reveal="up">
          <button type="button" class="es-icon-button es-icon-button--outline" data-xp-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" class="es-icon-button es-icon-button--outline" data-xp-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      {%- endif -%}
    </header>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="es-xp__track" data-xp-track role="list">
      {%- for block in section.blocks -%}
        <li class="es-xp__item" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <figure class="es-xp__card es-glow">
            <div class="es-xp__top">
              <span class="es-xp__mark" aria-hidden="true">&ldquo;</span>
              {%- if block.settings.verified -%}
                <span class="es-xp__badge">{% render 'es-glyph', name: 'verified' %}{{ 'sections.experts.verified' | t }}</span>
              {%- endif -%}
            </div>
            <blockquote class="es-xp__quote">{{ block.settings.quote }}</blockquote>
            {%- liquid
              assign xp_parts = block.settings.name | split: ' · '
              assign xp_name = xp_parts.first | strip
            -%}
            <figcaption class="es-xp__who">
              <span class="es-xp__avatar">
                {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
                  {% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.name, sizes: '72px', class: 'es-cover', width: 144, height: 144 %}
                {%- elsif xp_name != blank and xp_name contains '[' -%}
                  <span class="es-xp__silhouette" role="img" aria-label="{{ 'sections.experts.photo_placeholder' | t | escape }}">{% render 'es-glyph', name: 'user' %}</span>
                {%- elsif xp_name != blank -%}
                  {%- assign xp_words = xp_name | split: ' ' -%}
                  <span class="es-xp__silhouette es-xp__initials" aria-hidden="true">{{ xp_words.first | slice: 0 | upcase }}{% if xp_words.size > 1 %}{{ xp_words.last | slice: 0 | upcase }}{% endif %}</span>
                {%- else -%}
                  <span class="es-xp__silhouette" role="img" aria-label="{{ 'sections.experts.photo_placeholder' | t | escape }}">{% render 'es-glyph', name: 'user' %}</span>
                {%- endif -%}
              </span>
              <span class="es-xp__id">
                <b class="es-xp__name">{{ xp_name }}{% if xp_parts.size > 1 %} <span class="es-xp__tag">{{ xp_parts.last }}</span>{% endif %}</b>
                {%- if block.settings.profession != blank -%}<span class="es-xp__job">{{ block.settings.profession }}</span>{%- endif -%}
              </span>
            </figcaption>
            {%- if block.settings.proof_url != blank -%}
              <a class="es-xp__proof" href="{{ block.settings.proof_url }}" target="_blank" rel="noopener">{% render 'es-glyph', name: 'link' %}<span>{% if block.settings.proof_label != blank %}{{ block.settings.proof_label }}{% else %}{{ 'sections.experts.proof' | t }}{% endif %}</span></a>
            {%- elsif block.settings.proof_label != blank -%}
              <span class="es-xp__proof es-xp__proof--pending">{% render 'es-glyph', name: 'link' %}<span>{{ block.settings.proof_label }}</span></span>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
    <div class="es-container">
      <div class="es-xp__foot">
        {%- if section.blocks.size > 1 -%}<div class="es-xp__progress" aria-hidden="true"><i data-xp-bar></i></div>{%- endif -%}
        {%- if section.settings.disclosure != blank -%}<p class="es-xp__disclosure es-small es-muted">{% render 'es-glyph', name: 'info' %}<span>{{ section.settings.disclosure }}</span></p>{%- endif -%}
      </div>
    </div>
  {%- elsif request.design_mode -%}
    <div class="es-container"><p class="es-reviews__hint">{{ 'sections.experts.hint' | t }}</p></div>
  {%- endif -%}
</section>

{% stylesheet %}
.es-xp__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; max-width: none; }
.es-xp__head > div:first-child { max-width: 760px; }
.es-xp__eyebrow { display: inline-flex; align-items: center; gap: .6em; }
.es-xp__eyebrow-icon { width: 18px; height: 18px; }
.es-xp__nav { display: flex; gap: 8px; flex: none; }
.es-xp__track { list-style: none; margin: 0; display: flex; gap: clamp(14px, 2vw, 24px); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  padding: 8px max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter))) 24px; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--page-width)) / 2 + var(--gutter))); }
.es-xp__track::-webkit-scrollbar { display: none; }
.es-xp__item { flex: none; width: min(84vw, 400px); scroll-snap-align: start; display: flex; }
.es-xp__card { margin: 0; width: 100%; display: flex; flex-direction: column; gap: 22px; padding: clamp(26px, 3vw, 38px); border-radius: var(--radius-card);
  background: linear-gradient(180deg, rgba(var(--c-text-rgb), .05), rgba(var(--c-text-rgb), .015)); border: 1px solid rgba(var(--c-text-rgb), .1);
  box-shadow: 0 30px 60px -48px rgba(0,0,0,.55); transition: transform .6s var(--ease-out), border-color .4s, box-shadow .6s var(--ease-out); }
.es-xp__card:hover { transform: translateY(-6px); border-color: rgba(var(--c-accent-rgb), .35); box-shadow: 0 40px 80px -48px rgba(var(--c-accent-rgb), calc(var(--glow) * .9)); }
.es-xp__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; min-height: 40px; }
.es-xp__mark { font-family: var(--font-accent); font-size: 4.6rem; line-height: .8; color: var(--c-accent); opacity: .85; height: 40px; }
.es-xp__badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px 6px 8px; border-radius: 999px; font-size: .72rem; font-weight: var(--font-body-weight-bold); letter-spacing: .04em;
  color: var(--c-accent); background: rgba(var(--c-accent-rgb), .1); border: 1px solid rgba(var(--c-accent-rgb), .3); }
.es-xp__badge .es-icon { width: 16px; height: 16px; }
.es-xp__quote { margin: 0; flex: 1; font-family: var(--font-heading); font-size: clamp(1.12rem, 1.6vw, 1.32rem); line-height: 1.45; letter-spacing: -.005em; text-wrap: pretty; }
.es-xp__who { display: flex; align-items: center; gap: 14px; padding-top: 22px; border-top: 1px solid rgba(var(--c-text-rgb), .1); }
.es-xp__avatar { position: relative; width: 60px; height: 60px; flex: none; border-radius: 50%; overflow: hidden; background: var(--c-surface);
  box-shadow: 0 0 0 2px var(--c-bg), 0 0 0 3.5px rgba(var(--c-accent-rgb), .55); }
.es-xp__avatar img { width: 100%; height: 100%; object-fit: cover; }
.es-xp__silhouette { display: grid; place-items: center; width: 100%; height: 100%; color: var(--c-muted); background: linear-gradient(145deg, rgba(var(--c-accent-rgb), .14), rgba(var(--c-text-rgb), .05)); }
.es-xp__silhouette .es-icon { width: 28px; height: 28px; }
.es-xp__initials { font-family: var(--font-heading); font-size: 1.2rem; letter-spacing: .02em; color: var(--c-accent); }
.es-xp__tag { display: inline-block; margin-left: 4px; padding: 2px 8px; border-radius: 99px; background: rgba(var(--c-text-rgb), .08); color: var(--c-muted); font-size: .68rem; font-weight: var(--font-body-weight-bold); letter-spacing: .08em; text-transform: uppercase; vertical-align: 2px; }
.es-xp__id { display: grid; gap: 2px; min-width: 0; }
.es-xp__name { font-weight: var(--font-body-weight-bold); line-height: 1.3; }
.es-xp__job { font-size: .88rem; color: var(--c-muted); line-height: 1.35; }
.es-xp__proof { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font-size: .8rem; font-weight: var(--font-body-weight-bold); letter-spacing: .06em; text-transform: uppercase; color: var(--c-accent); text-decoration: none; }
.es-xp__proof .es-icon { width: 16px; height: 16px; transition: transform .4s var(--ease-out); }
a.es-xp__proof:hover .es-icon { transform: translate(2px, -2px); }
.es-xp__proof--pending { color: var(--c-muted); }
.es-xp__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; margin-top: 8px; }
.es-xp__progress { position: relative; flex: 1 1 200px; max-width: 320px; height: 2px; background: rgba(var(--c-text-rgb), .12); border-radius: 2px; overflow: hidden; }
.es-xp__progress i { position: absolute; inset: 0 auto 0 0; width: var(--p, 30%); background: var(--c-accent); border-radius: inherit; transition: width .3s var(--ease-out); }
.es-xp__disclosure { display: flex; align-items: flex-start; gap: 8px; margin: 0; max-width: 62ch; }
.es-xp__disclosure .es-icon { width: 16px; height: 16px; margin-top: 2px; }
@media (max-width: 749px) {
  .es-xp__nav { display: none; }
  .es-xp__item { width: 84vw; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    (root || document).querySelectorAll('[data-xp]').forEach(function (s) {
      if (s._esXp) return; s._esXp = true;
      var track = s.querySelector('[data-xp-track]'); if (!track) return;
      var bar = s.querySelector('[data-xp-bar]');
      function step() { var it = track.querySelector('.es-xp__item'); return it ? it.getBoundingClientRect().width + 20 : track.clientWidth * .8; }
      var prev = s.querySelector('[data-xp-prev]'), next = s.querySelector('[data-xp-next]');
      prev && prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next && next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      function update() {
        var max = track.scrollWidth - track.clientWidth;
        if (bar) bar.parentNode.style.setProperty('--p', (max > 4 ? 18 + 82 * track.scrollLeft / max : 100) + '%');
        if (prev) prev.disabled = track.scrollLeft < 4;
        if (next) next.disabled = track.scrollLeft > max - 4;
      }
      track.addEventListener('scroll', function () { requestAnimationFrame(update); }, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); }); else init();
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Professionnels vérifiés",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Uniquement des professionnels réels qui ont donné leur accord écrit pour être cités (nom, photo, propos). Conservez la preuve de cet accord." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Recommandé par des professionnels" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils en parlent" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre mise en valeur", "default": "en connaissance de cause." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>[À compléter : présentez en une phrase les professionnels qui recommandent votre produit et dans quel cadre.]</p>" },
    { "type": "text", "id": "disclosure", "label": "Mention de transparence", "default": "[À compléter : cadre de ces recommandations, par exemple « partenariat rémunéré » ou « sans contrepartie ».]", "info": "Obligatoire si le professionnel est rémunéré ou reçoit le produit gratuitement." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "expert", "name": "Professionnel", "settings": [
      { "type": "paragraph", "content": "Recopiez exactement les propos validés par le professionnel. N'utilisez jamais un nom, une photo ou un titre sans son accord." },
      { "type": "image_picker", "id": "image", "label": "Photo (avec accord)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "name", "label": "Nom du professionnel", "default": "[À compléter : prénom et nom]" },
      { "type": "text", "id": "profession", "label": "Profession", "default": "[À compléter : profession et spécialité]" },
      { "type": "textarea", "id": "quote", "label": "Citation", "default": "[À compléter : citation exacte, relue et validée par le professionnel.]" },
      { "type": "text", "id": "proof_label", "label": "Texte du lien vers la preuve", "default": "Voir la source" },
      { "type": "url", "id": "proof_url", "label": "Lien vers la preuve", "info": "Article, vidéo, profil professionnel public… Sans lien, le texte s'affiche sans être cliquable." },
      { "type": "checkbox", "id": "verified", "label": "Afficher le badge « Professionnel vérifié »", "default": false, "info": "À cocher seulement si vous avez vérifié l'identité, la qualification et l'accord écrit de ce professionnel." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Professionnels vérifiés", "blocks": [{ "type": "expert" }, { "type": "expert" }, { "type": "expert" }] }]
}
{% endschema %}
