{%- comment -%} Questions (Theme Engine V2) : titre à gauche (collant sur ordinateur), accordéons à droite ; ou centré. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="v2-faq v2-faq--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="es-container v2-faq__grid">
    <header class="v2-head v2-faq__head">
      {%- if s.eyebrow != blank -%}<p class="v2-eyebrow" data-reveal="up">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}{%- assign htag = s.heading_tag | default: 'h2' -%}<{{ htag }} class="v2-h2" data-reveal="up">{{ s.heading }}</{{ htag }}>{%- endif -%}
      {%- if s.text != blank -%}<div class="v2-intro" data-reveal="up">{{ s.text }}</div>{%- endif -%}
    </header>
    {%- if s.layout == 'columns' -%}
    {%- comment -%} Une colonne par bloc « Thème » ; les questions qui suivent un thème s'y rangent (celles placées avant le
      premier thème forment une première colonne sans titre). {%- endcomment -%}
    {%- liquid
      assign lead = 0
      for block in section.blocks
        if block.type == 'topic'
          break
        endif
        assign lead = lead | plus: 1
      endfor
    -%}
    <div class="v2-faq__cols">
      {%- if lead > 0 -%}
      <div class="v2-faq__col">
        <div class="v2-faq__list">
          {%- for block in section.blocks limit: lead -%}
          <details class="v2-faq__item" {{ block.shopify_attributes }}><summary><span>{{ block.settings.question }}</span><span class="v2-faq__plus" aria-hidden="true"></span></summary><div class="v2-rte">{{ block.settings.answer }}</div></details>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
      {%- for topic in section.blocks -%}
        {%- if topic.type != 'topic' -%}{%- continue -%}{%- endif -%}
        {%- assign tix = forloop.index0 -%}
      <div class="v2-faq__col" {{ topic.shopify_attributes }}>
        {%- if topic.settings.image != blank or topic.settings.image_asset != blank -%}<div class="v2-faq__col-media">{% render 'ed-media', image: topic.settings.image, asset: topic.settings.image_asset, alt: topic.settings.image_alt %}</div>{%- endif -%}
        <h3 class="v2-faq__col-title">{{ topic.settings.title | escape }}</h3>
        {%- if topic.settings.text != blank -%}<p class="v2-faq__col-text">{{ topic.settings.text | escape }}</p>{%- endif -%}
        <div class="v2-faq__list">
          {%- assign inside = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'topic' -%}
              {%- if forloop.index0 == tix -%}{%- assign inside = true -%}{%- else -%}{%- assign inside = false -%}{%- endif -%}
            {%- elsif inside -%}
          <details class="v2-faq__item" {{ block.shopify_attributes }}><summary><span>{{ block.settings.question }}</span><span class="v2-faq__plus" aria-hidden="true"></span></summary><div class="v2-rte">{{ block.settings.answer }}</div></details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
    {%- else -%}
    <div class="v2-faq__list">
      {%- for block in section.blocks -%}{%- if block.type == 'topic' -%}{%- continue -%}{%- endif -%}
        <details class="v2-faq__item" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span class="v2-faq__plus" aria-hidden="true"></span></summary>
          <div class="v2-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Questions fréquentes",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Composition",
      "default": "side",
      "options": [
        {
          "value": "side",
          "label": "Titre à côté"
        },
        {
          "value": "center",
          "label": "Centrée"
        },
        {
          "value": "columns",
          "label": "Thèmes en colonnes (photo, titre, questions)"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre",
      "options": [
        {
          "value": "h2",
          "label": "Titre de section (H2)"
        },
        {
          "value": "h1",
          "label": "Titre principal de la page (H1)"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Marge haute",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Marge basse",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Votre question ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>[À compléter]</p>"
        }
      ]
    },
    {
      "type": "topic",
      "name": "Thème (colonne)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image (fichier du thème)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texte alternatif"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Choisir"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Questions fréquentes",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
