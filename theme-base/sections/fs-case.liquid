{%- comment -%}
Étude de cas (services) : la demande, les contraintes, la réponse et le résultat d'un projet réel. Image fixe pendant
  le récit, quatre colonnes, ou récit empilé. Le résultat n'est écrit que s'il est mesuré par la marque.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-case fs-case--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- if s.client_type != blank or s.location != blank or s.year != blank -%}
      <dl class="fs-case__facts"{% render 'fs-reveal', effect: fx %}>
        {%- if s.client_type != blank -%}<div><dt>{{ s.label_client | default: 'Client' | escape }}</dt><dd>{{ s.client_type | escape }}</dd></div>{%- endif -%}
        {%- if s.location != blank -%}<div><dt>{{ s.label_location | default: 'Lieu' | escape }}</dt><dd>{{ s.location | escape }}</dd></div>{%- endif -%}
        {%- if s.year != blank -%}<div><dt>{{ s.label_year | default: 'Année' | escape }}</dt><dd>{{ s.year | escape }}</dd></div>{%- endif -%}
      </dl>
    {%- endif -%}
    {%- if s.layout == 'detail' -%}
    {%- comment -%} Détail de projet (maquette Atelier Rive) : le besoin et la réponse à gauche, la galerie de détails à droite,
      puis la navigation vers le projet précédent et le suivant. {%- endcomment -%}
    <div class="fs-case__detail">
      <div class="fs-case__story">
        {%- for block in section.blocks -%}{%- if block.type != 'part' -%}{%- continue -%}{%- endif -%}
          <div class="fs-case__part" {{ block.shopify_attributes }}>
            <h3 class="fs-case__part-title"><span class="fs-case__label">{% case block.settings.kind %}{% when 'request' %}{{ s.label_request | default: 'La demande' | escape }}{% when 'constraints' %}{{ s.label_constraints | default: 'Les contraintes' | escape }}{% when 'answer' %}{{ s.label_answer | default: 'Notre réponse' | escape }}{% else %}{{ s.label_result | default: 'Le résultat' | escape }}{% endcase %}</span>{% if block.settings.title != blank %} {{ block.settings.title | escape }}{% endif %}</h3>
            <div class="fs-item__text">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
      <ul class="fs-case__gallery" role="list">
        {%- for block in section.blocks -%}{%- if block.type != 'photo' -%}{%- continue -%}{%- endif -%}
          <li class="fs-case__photo" {{ block.shopify_attributes }}><figure>{% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.image_alt %}{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}</figure></li>
        {%- endfor -%}
      </ul>
    </div>
    {%- if s.prev_link != blank or s.next_link != blank -%}
      <nav class="fs-case__nav" aria-label="{{ s.nav_label | default: 'Autres projets' | escape }}">
        {%- if s.prev_link != blank -%}<a class="fs-case__prev" href="{{ s.prev_link }}"><span>← {{ s.prev_label | default: 'Projet précédent' | escape }}</span>{% if s.prev_title != blank %}<small>{{ s.prev_title | escape }}</small>{% endif %}</a>{%- else -%}<span></span>{%- endif -%}
        {%- if s.next_link != blank -%}<a class="fs-case__next" href="{{ s.next_link }}"><span>{{ s.next_label | default: 'Projet suivant' | escape }} →</span>{% if s.next_title != blank %}<small>{{ s.next_title | escape }}</small>{% endif %}</a>{%- endif -%}
      </nav>
    {%- endif -%}
    {%- else -%}
    <div class="fs-case__body">
      {%- if s.layout != 'columns' -%}
        <div class="fs-case__visual"{% if s.layout == 'sticky' %} data-fs-sticky-visual{% endif %}>
          <div class="fs-making__frame">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role %}</div>
          {%- if s.layout == 'sticky' -%}{%- for block in section.blocks -%}{%- if block.settings.image != blank or block.settings.image_asset != blank -%}<div class="fs-making__frame fs-making__frame--step" data-fs-step-visual="{{ forloop.index0 }}">{% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title %}</div>{%- endif -%}{%- endfor -%}{%- endif -%}
        </div>
      {%- endif -%}
      <ol class="fs-case__parts{% if s.layout == 'columns' %} fs-grid fs-grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }}{% endif %}" role="list"{% if s.layout == 'sticky' %} data-fs-sticky-steps{% endif %}>
        {%- for block in section.blocks -%}{%- if block.type != 'part' -%}{%- continue -%}{%- endif -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-case__part{% if s.layout == 'columns' %} {{ cards }}{% endif %}" data-fs-step="{{ forloop.index0 }}"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            <span class="fs-chip">{% case block.settings.kind %}{% when 'request' %}{{ s.label_request | default: 'La demande' | escape }}{% when 'constraints' %}{{ s.label_constraints | default: 'Les contraintes' | escape }}{% when 'answer' %}{{ s.label_answer | default: 'Notre réponse' | escape }}{% else %}{{ s.label_result | default: 'Le résultat' | escape }}{% endcase %}</span>
            {%- if block.settings.title != blank -%}<h3 class="fs-item__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            <div class="fs-item__text">{{ block.settings.text }}</div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- endif -%}
  </div>
</section>

