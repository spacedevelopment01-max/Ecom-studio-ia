{%- comment -%}
  À propos : surtitre, grand titre, image, « Pourquoi nous existons », « Notre engagement » et valeurs en cartes.
  Textes de départ : espaces réservés honnêtes ou textes de la marque, à compléter par le marchand.
{%- endcomment -%}
{%- assign values = section.blocks | where: 'type', 'value' -%}
<section class="es-section es-about color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    <header class="es-about__head">
      {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="es-heading es-about__title" data-reveal="words">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>{%- endif -%}
    </header>

    <div class="es-about__intro">
      <figure class="es-about__media" data-reveal="curtain">
        <div class="es-about__img" data-parallax="0.06">
          {% render 'es-image', image: section.settings.image, asset: section.settings.image_asset, alt: section.settings.heading, sizes: '(min-width: 990px) 55vw, 100vw', class: 'es-cover' %}
        </div>
        {%- if section.settings.image_caption != blank -%}<figcaption class="es-about__caption">{{ section.settings.image_caption }}</figcaption>{%- endif -%}
      </figure>
      <div class="es-about__story">
        {%- if section.settings.lead != blank -%}<div class="es-rte es-about__lead" data-reveal="up">{{ section.settings.lead }}</div>{%- endif -%}
        <div class="es-about__pillars">
          {%- if section.settings.why_text != blank -%}
            <div class="es-about__pillar" data-reveal="up" style="--d: 1">
              <p class="es-about__kicker"><span>01</span>{{ section.settings.why_title }}</p>
              <div class="es-rte">{{ section.settings.why_text }}</div>
            </div>
          {%- endif -%}
          {%- if section.settings.commit_text != blank -%}
            <div class="es-about__pillar" data-reveal="up" style="--d: 2">
              <p class="es-about__kicker"><span>02</span>{{ section.settings.commit_title }}</p>
              <div class="es-rte">{{ section.settings.commit_text }}</div>
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.signature != blank -%}<p class="es-signature es-about__sign" data-reveal="up" style="--d: 3">{{ section.settings.signature }}</p>{%- endif -%}
      </div>
    </div>

    {%- if values.size > 0 -%}
      <div class="es-about__values">
        {%- if section.settings.values_title != blank -%}<h3 class="es-heading es-h3 es-about__values-title" data-reveal="up">{{ section.settings.values_title }}</h3>{%- endif -%}
        <ul class="es-about__cards" role="list" style="--count: {{ values.size }};">
          {%- for block in values -%}
            <li class="es-about__card" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <span class="es-about__icon">
                {%- if block.settings.icon == 'none' -%}<b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b>{%- else -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
              </span>
              <h4 class="es-about__card-title">{{ block.settings.title }}</h4>
              {%- if block.settings.text != blank -%}<div class="es-rte es-about__card-text">{{ block.settings.text }}</div>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="es-actions es-actions--center es-about__cta" data-reveal="up"><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="es-button">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a></div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.es-about__head { max-width: 980px; margin-bottom: clamp(32px, 5vw, 72px); }
.es-about__title { font-size: calc(clamp(2.5rem, 7vw, 6.2rem) * var(--heading-scale, 1)); line-height: .98; letter-spacing: -.03em; margin: 0; }
.es-about__intro { display: grid; gap: clamp(28px, 5vw, 80px); align-items: start; }
@media (min-width: 990px) { .es-about__intro { grid-template-columns: 1.08fr 1fr; } }
.es-about__media { margin: 0; position: relative; }
.es-about__img { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius-card, 16px); background: var(--c-surface); }
@media (min-width: 990px) { .es-about__media { position: sticky; top: calc(var(--header-h, 72px) + 24px); } }
.es-about__caption { margin-top: 12px; font-size: .8rem; color: var(--c-muted); letter-spacing: .04em; }
.es-about__story { display: grid; gap: clamp(28px, 4vw, 48px); padding-top: clamp(0px, 2vw, 24px); }
.es-about__lead { font-family: var(--font-heading); font-size: calc(clamp(1.35rem, 2.3vw, 1.9rem) * var(--heading-scale, 1)); line-height: 1.32; letter-spacing: -.01em; }
.es-about__pillars { display: grid; gap: clamp(22px, 3vw, 36px); }
.es-about__pillar { padding-top: 22px; border-top: 1px solid var(--c-border); }
.es-about__kicker { display: flex; align-items: baseline; gap: 14px; margin: 0 0 12px; font-weight: var(--font-body-weight-bold); font-size: 1.05rem; }
.es-about__kicker span { font-size: .72rem; letter-spacing: .2em; color: var(--c-accent); }
.es-about__pillar .es-rte { color: color-mix(in srgb, var(--c-text) 80%, var(--c-bg)); line-height: 1.7; }
.es-about__sign { margin: 0; }
.es-about__values { margin-top: clamp(56px, 8vw, 120px); }
.es-about__values-title { margin-bottom: clamp(20px, 3vw, 36px); }
.es-about__cards { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(14px, 2vw, 24px); grid-template-columns: 1fr; }
@media (min-width: 750px) { .es-about__cards { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 990px) { .es-about__cards { grid-template-columns: repeat(min(var(--count), 4), 1fr); } }
.es-about__card { position: relative; padding: clamp(22px, 2.6vw, 34px); border-radius: var(--radius-card, 16px); background: var(--c-surface); border: 1px solid rgba(var(--c-text-rgb), .06); overflow: hidden; transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
.es-about__card::before { content: ""; position: absolute; inset: auto -30% -60% auto; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(var(--c-accent-rgb), .18), transparent); transition: transform .8s var(--ease-out); pointer-events: none; }
.es-about__card:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -40px rgba(0,0,0,.45); }
.es-about__card:hover::before { transform: scale(1.4); }
.es-about__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--c-bg); color: var(--c-accent); margin-bottom: 22px; }
.es-about__icon b { font-family: var(--font-heading); font-size: 1.05rem; }
.es-about__card-title { margin: 0 0 8px; font-family: var(--font-heading); font-size: 1.2rem; line-height: 1.25; font-weight: var(--font-heading-weight); }
.es-about__card-text { color: var(--c-muted); font-size: .95rem; line-height: 1.6; }
.es-about__cta { margin-top: clamp(36px, 5vw, 64px); }
@media (prefers-reduced-motion: reduce) { .es-about__card, .es-about__card::before { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "À propos",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "À propos" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Notre histoire," },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre mise en valeur", "default": "en quelques mots." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
    { "type": "text", "id": "image_caption", "label": "Légende de l'image" },
    { "type": "richtext", "id": "lead", "label": "Introduction", "default": "<p>[À compléter : qui vous êtes, ce que vous faites et pour qui.]</p>" },
    { "type": "text", "id": "why_title", "label": "Titre de la première partie", "default": "Pourquoi nous existons" },
    { "type": "richtext", "id": "why_text", "label": "Texte de la première partie", "default": "<p>[À compléter : la raison d'être de la marque, le besoin auquel elle répond.]</p>" },
    { "type": "text", "id": "commit_title", "label": "Titre de la seconde partie", "default": "Notre engagement" },
    { "type": "richtext", "id": "commit_text", "label": "Texte de la seconde partie", "default": "<p>[À compléter : un engagement réel et vérifiable.]</p>", "info": "N'annoncez que des engagements que vous tenez réellement." },
    { "type": "text", "id": "signature", "label": "Signature", "info": "Ex. le prénom du fondateur ou de la fondatrice." },
    { "type": "text", "id": "values_title", "label": "Titre des valeurs", "default": "Ce qui nous guide" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la boutique" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 112 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 112 }
  ],
  "blocks": [
    { "type": "value", "name": "Valeur", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "sparkle", "options": [
        { "value": "none", "label": "Numéro" }, { "value": "sparkle", "label": "Éclat" }, { "value": "leaf", "label": "Feuille" }, { "value": "drop", "label": "Goutte" },
        { "value": "hand", "label": "Main" }, { "value": "shield", "label": "Bouclier" }, { "value": "truck", "label": "Livraison" }, { "value": "check", "label": "Coche" },
        { "value": "star", "label": "Étoile" }, { "value": "bolt", "label": "Éclair" }, { "value": "heart", "label": "Cœur" }, { "value": "globe", "label": "Globe" }, { "value": "clock", "label": "Horloge" }, { "value": "waves", "label": "Vagues" }, { "value": "gift", "label": "Cadeau" }
      ] },
      { "type": "text", "id": "title", "label": "Titre", "default": "[À compléter : valeur]" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>[À compléter : ce que cette valeur change concrètement.]</p>" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "À propos", "blocks": [
    { "type": "value", "settings": { "icon": "heart" } },
    { "type": "value", "settings": { "icon": "leaf" } },
    { "type": "value", "settings": { "icon": "hand" } }
  ] }]
}
{% endschema %}
