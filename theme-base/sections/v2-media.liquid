{%- comment -%} Médias (Theme Engine V2) : bento (mosaïque de tailles différentes) ou rail (défilement horizontal au toucher). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="v2-media v2-media--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="es-container">
    <header class="v2-head">
      {%- if s.eyebrow != blank -%}<p class="v2-eyebrow" data-reveal="up">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="v2-h2" data-reveal="up">{{ s.heading }}</h2>{%- endif -%}
    </header>
    <div class="v2-media__grid" tabindex="0" aria-label="{{ s.heading | escape }}">
      {%- for block in section.blocks -%}
        <figure class="v2-media__tile" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.caption, class: 'v2-cover', sizes: '(min-width: 990px) 50vw, 85vw' %}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Médias V2",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition", "default": "bento", "options": [
      { "value": "bento", "label": "Mosaïque" }, { "value": "rail", "label": "Défilement horizontal" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "En images" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "caption", "label": "Légende" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Médias V2", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
