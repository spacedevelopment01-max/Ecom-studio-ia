{%- comment -%} Étapes (Theme Engine V2) : line (frise horizontale), stack (colonne numérotée), cards. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="v2-steps v2-steps--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --n: {{ section.blocks.size }};">
  <div class="es-container">
    <header class="v2-head">
      {%- if s.eyebrow != blank -%}<p class="v2-eyebrow" data-reveal="up">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="v2-h2" data-reveal="up">{{ s.heading }}</h2>{%- endif -%}
    </header>
    <ol class="v2-steps__list">
      {%- for block in section.blocks -%}
        <li class="v2-steps__item" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="v2-steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="v2-h3">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<div class="v2-rte">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Étapes V2",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition", "default": "line", "options": [
      { "value": "line", "label": "Frise" }, { "value": "stack", "label": "Colonne numérotée" }, { "value": "cards", "label": "Cartes" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Comment ça se passe" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "step", "name": "Étape", "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
      { "type": "richtext", "id": "text", "label": "Texte" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Étapes V2", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
