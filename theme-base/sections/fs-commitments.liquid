{%- comment -%}
Engagements (e-commerce : engagements de la marque ; services : engagements de service) et garanties et livraison
  (boutique spécialisée) : éléments iconés avec leur preuve (lien vers le document qui les établit). Grille, liste
  numérotée, ou image et liste.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-commitments fs-commitments--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    <div class="fs-commit__body{% if s.layout == 'split' %} fs-split{% endif %}">
      {%- if s.layout == 'split' -%}<div class="fs-split__media"{% render 'fs-reveal', effect: 'curtain' %}>{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role %}</div>{%- endif -%}
      <ol class="fs-commit__list fs-commit__list--{{ s.layout }}{% if s.layout == 'grid' %} fs-grid fs-grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }}{% endif %}" role="list">
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-commit__item{% if s.layout == 'grid' %} {{ cards }}{% endif %}"{% render 'fs-reveal', effect: fx, index: ix %} {{ block.shopify_attributes }}>
            {%- if s.layout == 'list' -%}<span class="fs-commit__num" aria-hidden="true">{{ forloop.index }}</span>{%- else -%}<span class="fs-commit__icon">{% render 'fs-icon', name: block.settings.icon %}</span>{%- endif -%}
            <div>
              {%- if s.layout == 'aside' or s.layout == 'strip' -%}{%- assign go = true -%}{%- else -%}{%- assign go = false -%}{%- endif -%}{%- if go and block.settings.proof_link != blank -%}<h3 class="fs-item__title"><a class="fs-commit__go" href="{{ block.settings.proof_link }}">{{ block.settings.title | escape }}<span aria-hidden="true"> →</span></a></h3>{%- else -%}<h3 class="fs-item__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="fs-item__text">{{ block.settings.text }}</div>{%- endif -%}
              {%- if go and block.settings.proof_link != blank -%}{%- elsif block.settings.proof_label != blank and block.settings.proof_link != blank -%}<a class="fs-link" href="{{ block.settings.proof_link }}">{{ block.settings.proof_label | escape }}</a>{%- elsif block.settings.proof_label != blank -%}<span class="fs-meta">{{ block.settings.proof_label | escape }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if s.note != blank -%}<p class="fs-note">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
