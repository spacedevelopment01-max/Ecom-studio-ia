{%- comment -%}
Références, clients et partenaires (services) : chaque nom porte son rôle (client, partenaire, prescripteur,
  fournisseur). Mur de logos, liste, ou défilement continu (arrêté au survol, au focus et avec « réduire les
  animations » ; la copie de défilement est masquée aux lecteurs d'écran). Seules des relations réelles sont citées.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-references fs-references--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- capture items -%}
      {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
        <li class="fs-ref{% if s.layout == 'wall' %} {{ cards }}{% endif %}"{% if s.layout != 'marquee' %}{% render 'fs-reveal', effect: fx, index: ix %}{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="fs-ref__link" href="{{ block.settings.link }}">{%- endif -%}
          {%- if block.settings.logo != blank or block.settings.logo_asset != blank -%}<span class="fs-ref__logo">{% render 'ed-media', image: block.settings.logo, asset: block.settings.logo_asset, alt: block.settings.title %}</span>{%- else -%}<span class="fs-ref__name">{{ block.settings.title | escape }}</span>{%- endif -%}
          {%- if s.layout == 'list' -%}<span class="fs-ref__copy"><strong class="fs-item__title">{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %}<span class="fs-item__text">{{ block.settings.text | escape }}</span>{% endif %}</span>{%- endif -%}
          {%- if s.show_role -%}<span class="fs-meta">{% case block.settings.role %}{% when 'partner' %}{{ s.label_partner | default: 'Partenaire' | escape }}{% when 'prescriber' %}{{ s.label_prescriber | default: 'Prescripteur' | escape }}{% when 'supplier' %}{{ s.label_supplier | default: 'Fournisseur' | escape }}{% else %}{{ s.label_client | default: 'Client' | escape }}{% endcase %}</span>{%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if s.layout == 'marquee' -%}
      <div class="fs-refs__marquee" data-fs-marquee{% render 'fs-reveal', effect: fx %}>
        <ul class="fs-refs__track" role="list">{{ items }}</ul>
        <ul class="fs-refs__track" role="list" aria-hidden="true">{{ items | replace: 'href=', 'tabindex="-1" href=' }}</ul>
      </div>
    {%- else -%}
      <ul class="fs-refs__list fs-refs__list--{{ s.layout }}{% if s.layout == 'wall' %} fs-grid fs-grid--{{ section.blocks.size | at_most: 5 | at_least: 2 }}{% endif %}" role="list">{{ items }}</ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Références",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "wall",
          "label": "Mur de logos"
        },
        {
          "value": "list",
          "label": "Liste"
        },
        {
          "value": "marquee",
          "label": "Défilement continu"
        }
      ],
      "default": "wall"
    },
    {
      "type": "checkbox",
      "id": "show_role",
      "label": "Afficher le rôle",
      "default": true
    },
    {
      "type": "text",
      "id": "label_client",
      "label": "Intitulé : client",
      "default": "Client"
    },
    {
      "type": "text",
      "id": "label_partner",
      "label": "Intitulé : partenaire",
      "default": "Partenaire"
    },
    {
      "type": "text",
      "id": "label_prescriber",
      "label": "Intitulé : prescripteur",
      "default": "Prescripteur"
    },
    {
      "type": "text",
      "id": "label_supplier",
      "label": "Intitulé : fournisseur",
      "default": "Fournisseur"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "reference",
      "name": "Référence",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nom"
        },
        {
          "type": "select",
          "id": "role",
          "label": "Rôle",
          "options": [
            {
              "value": "client",
              "label": "Client"
            },
            {
              "value": "partner",
              "label": "Partenaire"
            },
            {
              "value": "prescriber",
              "label": "Prescripteur"
            },
            {
              "value": "supplier",
              "label": "Fournisseur"
            }
          ],
          "default": "client"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Précision (ex. chantier réalisé)"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "logo_asset",
          "label": "Fichier du projet"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Références",
      "settings": {
        "layout": "wall"
      }
    }
  ],
  "max_blocks": 16
}
{% endschema %}
