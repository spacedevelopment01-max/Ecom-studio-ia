{%- comment -%}
  Inscription newsletter avec image ou vidéo (à côté ou en fond). Formulaire client Shopify réel
  (contact[tags] = newsletter), case de consentement facultative et mentions réglables.
{%- endcomment -%}
{%- liquid
  assign form_id = 'NewsletterMedia-' | append: section.id
  assign has_video = false
  if section.settings.video != blank or section.settings.video_asset != blank
    assign has_video = true
  endif
-%}
<section class="es-section es-nlm es-nlm--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --ov: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="es-container">
    <div class="es-nlm__card">
      <div class="es-nlm__media" data-reveal="zoom">
        {%- if has_video -%}
          {% render 'es-video', video: section.settings.video, asset: section.settings.video_asset, poster: section.settings.image, poster_asset: section.settings.image_asset, class: 'es-cover', autoplay: true, alt: section.settings.heading %}
        {%- else -%}
          {% render 'es-image', image: section.settings.image, asset: section.settings.image_asset, alt: section.settings.image.alt, sizes: '(min-width: 990px) 50vw, 100vw', class: 'es-cover' %}
        {%- endif -%}
        {%- if section.settings.media_badge != blank -%}<span class="es-nlm__badge">{{ section.settings.media_badge }}</span>{%- endif -%}
      </div>
      <div class="es-nlm__content">
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="es-rte es-nlm__text" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank -%}
          <ul class="es-nlm__perks" role="list" data-reveal="up">
            {%- if section.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings.perk_1 }}</span></li>{%- endif -%}
            {%- if section.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings.perk_2 }}</span></li>{%- endif -%}
            {%- if section.settings.perk_3 != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings.perk_3 }}</span></li>{%- endif -%}
          </ul>
        {%- endif -%}
        {%- form 'customer', id: form_id, class: 'es-nlm__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="es-nlm__field" data-reveal="up">
            <label class="visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.label' | t }}</label>
            <span class="es-nlm__icon" aria-hidden="true">{% render 'icon', name: 'mail' %}</span>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}>
            <button type="submit" class="es-button">{%- if section.settings.button_label != blank -%}{{ section.settings.button_label }}{%- else -%}{{ 'newsletter.button' | t }}{%- endif -%}</button>
          </div>
          {%- if section.settings.consent_checkbox -%}
            <label class="es-nlm__consent" for="{{ form_id }}-consent">
              <input type="checkbox" id="{{ form_id }}-consent" required>
              <span>{{ section.settings.consent_label }}</span>
            </label>
          {%- endif -%}
          {%- if form.posted_successfully? -%}<p class="es-form-success es-nlm__status" role="status">{% render 'icon', name: 'check' %}{{ 'newsletter.success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="es-form-error es-nlm__status" id="{{ form_id }}-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
        {%- if section.settings.legal != blank -%}<div class="es-nlm__legal">{{ section.settings.legal }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.es-nlm__card { position: relative; display: grid; overflow: hidden; border-radius: calc(var(--radius-card) * 1.4); background: var(--c-surface, rgba(var(--c-text-rgb), .04)); border: 1px solid var(--c-border); }
.es-nlm__media { position: relative; min-height: 260px; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-surface); }
.es-nlm__media .es-cover, .es-nlm__media .es-placeholder { position: absolute; inset: 0; min-height: 0; }
.es-nlm__badge { position: absolute; left: 16px; bottom: 16px; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, .9); color: #111; font-size: .74rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
.es-nlm__content { padding: clamp(28px, 5vw, 64px); align-self: center; }
.es-nlm__content .es-heading { margin-bottom: .35em; }
.es-nlm__text { color: color-mix(in srgb, currentColor 80%, transparent); max-width: 52ch; }
.es-nlm__perks { list-style: none; margin: 1.2rem 0 0; padding: 0; display: grid; gap: 8px; }
.es-nlm__perks li { display: flex; gap: 10px; align-items: flex-start; font-size: .95rem; }
.es-nlm__perks .es-icon { width: 18px; height: 18px; margin-top: 3px; color: var(--c-accent); }
.es-nlm__form { margin-top: 1.6rem; }
.es-nlm__field { position: relative; display: flex; gap: 8px; padding: 6px; border-radius: var(--radius-button); background: var(--c-bg); border: 1.5px solid rgba(var(--c-text-rgb), .16); box-shadow: 0 18px 40px -30px rgba(0, 0, 0, .45); transition: border-color .3s, box-shadow .3s; }
.es-nlm__field:focus-within { border-color: var(--c-accent); box-shadow: 0 0 0 4px rgba(var(--c-accent-rgb), .18); }
.es-nlm__icon { display: grid; place-items: center; padding-left: 10px; color: var(--c-muted); }
.es-nlm__icon .es-icon { width: 20px; height: 20px; }
.es-nlm__field input { flex: 1; min-width: 0; min-height: 48px; border: 0; background: transparent; padding: 0 8px; color: var(--c-text); }
.es-nlm__field input:focus { outline: none; }
.es-nlm__field .es-button { min-height: 48px; flex: none; }
@media (max-width: 520px) { .es-nlm__field { flex-wrap: wrap; } .es-nlm__field input { flex-basis: calc(100% - 50px); } .es-nlm__field .es-button { width: 100%; } }
.es-nlm__consent { display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; font-size: .86rem; cursor: pointer; }
.es-nlm__consent input { width: 18px; height: 18px; margin: 2px 0 0; flex: none; accent-color: var(--c-accent); }
.es-nlm__status { display: flex; gap: 8px; align-items: center; margin: 12px 0 0; font-size: .92rem; }
.es-nlm__status .es-icon { width: 18px; height: 18px; }
.es-nlm__legal { margin-top: 14px; font-size: .78rem; line-height: 1.5; color: var(--c-muted); }
.es-nlm__legal p { margin: 0; }
.es-nlm__legal a { color: inherit; text-underline-offset: 2px; }
@media (min-width: 990px) {
  .es-nlm--left .es-nlm__card, .es-nlm--right .es-nlm__card { grid-template-columns: 1fr 1fr; min-height: 520px; }
  .es-nlm--left .es-nlm__media, .es-nlm--right .es-nlm__media { aspect-ratio: auto; min-height: 100%; }
  .es-nlm--right .es-nlm__media { order: 2; }
}
/* Média en fond */
.es-nlm--background .es-nlm__card { min-height: clamp(460px, 62vw, 640px); place-items: center; border: 0; color: #fff; }
.es-nlm--background .es-nlm__media { position: absolute; inset: 0; aspect-ratio: auto; min-height: 0; }
.es-nlm--background .es-nlm__media::after { content: ""; position: absolute; inset: 0; background: radial-gradient(120% 90% at 50% 60%, rgba(0, 0, 0, calc(var(--ov) * .8)), rgba(0, 0, 0, var(--ov))); }
.es-nlm--background .es-nlm__badge { display: none; }
.es-nlm--background .es-nlm__content { position: relative; z-index: 1; max-width: 640px; text-align: center; }
.es-nlm--background .es-nlm__text { margin-inline: auto; }
.es-nlm--background .es-eyebrow, .es-nlm--background .es-nlm__legal { color: rgba(255, 255, 255, .82); }
.es-nlm--background .es-nlm__perks { justify-items: center; }
.es-nlm--background .es-nlm__perks .es-icon { color: currentColor; }
.es-nlm--background .es-nlm__field { background: rgba(255, 255, 255, .14); border-color: rgba(255, 255, 255, .4); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
.es-nlm--background .es-nlm__field input { color: #fff; }
.es-nlm--background .es-nlm__field input::placeholder, .es-nlm--background .es-nlm__icon { color: rgba(255, 255, 255, .8); }
.es-nlm--background .es-nlm__consent { justify-content: center; text-align: left; }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter avec média",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposition", "default": "left", "options": [{ "value": "left", "label": "Média à gauche" }, { "value": "right", "label": "Média à droite" }, { "value": "background", "label": "Média en fond" }] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
    { "type": "video", "id": "video", "label": "Vidéo (hébergée par Shopify)", "info": "Remplace l'image, lue en boucle sans le son." },
    { "type": "text", "id": "video_asset", "label": "Vidéo fournie avec le thème" },
    { "type": "range", "id": "overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Assombrissement du média en fond", "default": 45 },
    { "type": "text", "id": "media_badge", "label": "Pastille sur le média (facultatif)" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Restons en contact" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nouveautés, coulisses et conseils, directement dans votre boîte mail.</p>" },
    { "type": "text", "id": "perk_1", "label": "Avantage 1 (facultatif)", "info": "Uniquement des avantages réels (ex. « Accès en avant-première aux lancements »)." },
    { "type": "text", "id": "perk_2", "label": "Avantage 2 (facultatif)" },
    { "type": "text", "id": "perk_3", "label": "Avantage 3 (facultatif)" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "S'inscrire" },
    { "type": "header", "content": "Consentement" },
    { "type": "checkbox", "id": "consent_checkbox", "label": "Case de consentement obligatoire", "default": true },
    { "type": "text", "id": "consent_label", "label": "Texte de la case", "default": "J'accepte de recevoir la newsletter par e-mail." },
    { "type": "richtext", "id": "legal", "label": "Mentions", "default": "<p>Désinscription possible à tout moment grâce au lien présent dans chaque e-mail. [À compléter : lien vers votre politique de confidentialité]</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "presets": [{ "name": "Newsletter avec média" }]
}
{% endschema %}
