{%- comment -%}
  ATELIER NUANCE (issue #177) : réglages du salon, communs à toutes les pages. Charge la feuille de style et les scripts
  du thème, porte la SOURCE UNIQUE des prestations (nom, catégorie, durée, prix, longueurs) et de l'équipe (compétences,
  jours de travail), les horaires, fermetures et règles de rendez-vous, le mode « démonstration » ou « service réel »,
  la barre fixe « Prendre rendez-vous » du téléphone et le bandeau des cookies.
  Le service réel (API du studio) relit ces mêmes réglages dans le thème enregistré : jamais ceux du navigateur.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign live = false
  if s.booking_mode == 'live' and s.service_url contains 'https://'
    assign live = true
  endif
  assign services = section.blocks | where: 'type', 'service'
  assign members = section.blocks | where: 'type', 'member'
-%}
{{ 'atelier-nuance.css' | asset_url | stylesheet_tag }}
<script src="{{ 'atelier-nuance-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'atelier-nuance.js' | asset_url }}" defer="defer"></script>
<style>
  body.dir-atelier-nuance, .an-section, .an-bookbar, .an-cookies, .an-dialog {
    --an-choco: {{ s.color_choco }};
    --an-peach: {{ s.color_peach }};
    --an-terra: {{ s.color_terra }};
    --an-ivory: {{ s.color_ivory }};
  }
</style>
<script type="application/json" id="an-config">
  {
    "mode": {% if live %}"live"{% else %}"demo"{% endif %},
    "api": {% if live %}{{ s.service_url | json }}{% else %}""{% endif %},
    "salon": {{ shop.name | json }},
    "address": {{ s.address | json }},
    "demoNote": {{ s.demo_note | json }},
    "timezone": {{ s.timezone | default: 'Europe/Paris' | json }},
    "hours": { "0": {{ s.hours_sun | json }}, "1": {{ s.hours_mon | json }}, "2": {{ s.hours_tue | json }}, "3": {{ s.hours_wed | json }}, "4": {{ s.hours_thu | json }}, "5": {{ s.hours_fri | json }}, "6": {{ s.hours_sat | json }} },
    "closures": {{ s.closures | json }},
    "step": {% if s.slot_step != blank %}{{ s.slot_step | json }}{% else %}null{% endif %},
    "horizonDays": {% if s.horizon_days != blank %}{{ s.horizon_days | json }}{% else %}null{% endif %},
    "leadMinutes": {% if s.lead_minutes != blank %}{{ s.lead_minutes | json }}{% else %}null{% endif %},
    "cancelHours": {% if s.cancel_hours != blank %}{{ s.cancel_hours | json }}{% else %}null{% endif %},
    "cancelTerms": {{ s.cancel_terms | json }},
    "services": [
      {%- for b in services -%}
        {%- assign bs = b.settings -%}
        { "id": {{ bs.service_id | json }}, "name": {{ bs.name | json }}, "category": {{ bs.category | json }}, "short": {{ bs.short | json }}, "duration": {% if bs.duration != blank %}{{ bs.duration | json }}{% else %}null{% endif %}, "price": {% if bs.price != blank %}{{ bs.price | json }}{% else %}null{% endif %}, "priceFrom": {{ bs.price_from | json }}, "url": {{ bs.page | json }},
          "lengths": { "short": { "price": {% if bs.short_price != blank %}{{ bs.short_price | json }}{% else %}null{% endif %}, "duration": {% if bs.short_duration != blank %}{{ bs.short_duration | json }}{% else %}null{% endif %} }, "mid": { "price": {% if bs.mid_price != blank %}{{ bs.mid_price | json }}{% else %}null{% endif %}, "duration": {% if bs.mid_duration != blank %}{{ bs.mid_duration | json }}{% else %}null{% endif %} }, "long": { "price": {% if bs.long_price != blank %}{{ bs.long_price | json }}{% else %}null{% endif %}, "duration": {% if bs.long_duration != blank %}{{ bs.long_duration | json }}{% else %}null{% endif %} } } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "staff": [
      {%- for b in members -%}
        {%- assign bs = b.settings -%}
        { "id": {{ bs.member_id | json }}, "name": {{ bs.name | json }}, "initial": {{ bs.initial | json }}, "title": {{ bs.title | json }}, "skills": {{ bs.skills | json }}, "days": {{ bs.days | json }}, "hours": {{ bs.hours | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- comment -%} Adresses des pages du parcours : de vrais liens (réécrits par l'aperçu et les exports), lus par le script. {%- endcomment -%}
<div hidden data-an-pages>
  <a data-page="book" href="{{ s.page_book | default: '/pages/prendre-rendez-vous' }}" tabindex="-1" aria-hidden="true"></a>
  <a data-page="account" href="{{ s.page_account | default: '/pages/mon-espace' }}" tabindex="-1" aria-hidden="true"></a>
  <a data-page="move" href="{{ s.page_move | default: '/pages/deplacer-mon-rendez-vous' }}" tabindex="-1" aria-hidden="true"></a>
  <a data-page="lookup" href="{{ s.page_lookup | default: '/pages/retrouver-mon-rendez-vous' }}" tabindex="-1" aria-hidden="true"></a>
  <a data-page="services" href="{{ s.page_services | default: '/pages/prestations' }}" tabindex="-1" aria-hidden="true"></a>
  <a data-page="contact" href="{{ s.page_contact | default: '/pages/contact' }}" tabindex="-1" aria-hidden="true"></a>
  <a data-page="terms" href="{{ s.page_terms | default: '/pages/conditions-de-reservation' }}" tabindex="-1" aria-hidden="true"></a>
  {%- for b in services -%}{%- if b.settings.page != blank -%}<a data-page="service:{{ b.settings.service_id }}" href="{{ b.settings.page }}" tabindex="-1" aria-hidden="true"></a>{%- endif -%}{%- endfor -%}
</div>
{%- if s.show_bookbar and s.booking_label != blank -%}
  <div class="an-bookbar" data-an-bookbar>
    <a href="{{ s.booking_link | default: '/pages/prendre-rendez-vous' }}">{% render 'an-icon', name: 'calendar' %}<span>{{ s.booking_label }}</span></a>
  </div>
{%- endif -%}
{%- if s.show_cookies -%}
  <div class="an-cookies" role="dialog" aria-modal="false" aria-labelledby="an-cookies-title-{{ section.id }}" data-an-cookies hidden>
    <div class="an-cookies__text">
      <h2 id="an-cookies-title-{{ section.id }}">{{ s.cookies_title }}</h2>
      <p>{{ s.cookies_text }}</p>
      {%- if s.cookies_link != blank -%}<a class="an-cookies__more" href="{{ s.cookies_link }}">{{ s.cookies_link_label }}</a>{%- endif -%}
    </div>
    <div class="an-cookies__actions">
      <button type="button" class="an-btn an-btn--dark an-btn--sm" data-an-cookies-accept>{{ s.cookies_accept }}</button>
      <button type="button" class="an-btn an-btn--line an-btn--sm" data-an-cookies-refuse>{{ s.cookies_refuse }}</button>
      <button type="button" class="an-cookies__toggle" aria-expanded="false" aria-controls="an-cookies-prefs-{{ section.id }}" data-an-cookies-custom>{{ s.cookies_custom }}</button>
    </div>
    <div class="an-cookies__prefs" id="an-cookies-prefs-{{ section.id }}" hidden>
      <label class="an-check"><input type="checkbox" checked disabled> <span>{{ s.cookies_needed }}</span></label>
      <label class="an-check"><input type="checkbox" data-an-cookies-stats> <span>{{ s.cookies_stats }}</span></label>
      <button type="button" class="an-btn an-btn--line an-btn--sm" data-an-cookies-save>{{ s.cookies_save }}</button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Réglages du salon",
  "class": "an-salon-section",
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Couleurs du salon" },
    { "type": "color", "id": "color_choco", "label": "Chocolat (aplats et pied de page)", "default": "#2E211C" },
    { "type": "color", "id": "color_peach", "label": "Pêche (boutons principaux)", "default": "#F2C3A7" },
    { "type": "color", "id": "color_terra", "label": "Terracotta (boutons de réservation)", "default": "#A45B40" },
    { "type": "color", "id": "color_ivory", "label": "Ivoire (fond)", "default": "#F8F3ED" },
    { "type": "header", "content": "Coordonnées et rendez-vous" },
    { "type": "textarea", "id": "address", "label": "Adresse du salon", "info": "Affichée sur la confirmation et dans le fichier d'agenda. Vide : « [À renseigner] »." },
    { "type": "text", "id": "booking_label", "label": "Texte du bouton de rendez-vous", "default": "Prendre rendez-vous" },
    { "type": "url", "id": "booking_link", "label": "Page de prise de rendez-vous" },
    { "type": "checkbox", "id": "show_bookbar", "label": "Barre « Prendre rendez-vous » fixe sur téléphone", "default": true },
    { "type": "text", "id": "demo_note", "label": "Mention des tarifs de démonstration", "default": "Tarifs et disponibilités de démonstration.", "info": "Videz-la quand vos tarifs et disponibilités sont réels." },
    {
      "type": "select", "id": "booking_mode", "label": "Fonctionnement des rendez-vous", "default": "demo",
      "options": [
        { "value": "demo", "label": "Démonstration (simulation, rien n'est enregistré)" },
        { "value": "live", "label": "Service réel du studio" }
      ],
      "info": "Le service réel enregistre les rendez-vous sur le studio : il demande l'adresse du service ci-dessous (https)."
    },
    { "type": "text", "id": "service_url", "label": "Adresse du service de rendez-vous", "info": "https://<adresse du studio>/api/public/salon/<identifiant du projet>" },
    { "type": "text", "id": "site_url", "label": "Adresse publique du site", "info": "Utilisée dans les liens envoyés par e-mail (https)." },
    { "type": "text", "id": "notify_email", "label": "E-mail qui reçoit les rendez-vous et messages" },
    { "type": "header", "content": "Horaires d'ouverture" },
    { "type": "paragraph", "content": "Une plage par période, ex. « 09:00-12:30, 13:30-19:00 ». Vide : salon fermé ce jour-là." },
    { "type": "text", "id": "hours_mon", "label": "Lundi" },
    { "type": "text", "id": "hours_tue", "label": "Mardi" },
    { "type": "text", "id": "hours_wed", "label": "Mercredi" },
    { "type": "text", "id": "hours_thu", "label": "Jeudi" },
    { "type": "text", "id": "hours_fri", "label": "Vendredi" },
    { "type": "text", "id": "hours_sat", "label": "Samedi" },
    { "type": "text", "id": "hours_sun", "label": "Dimanche" },
    { "type": "textarea", "id": "closures", "label": "Jours de fermeture", "info": "Dates AAAA-MM-JJ séparées par des virgules ; une période : 2026-12-24..2026-12-26." },
    { "type": "text", "id": "timezone", "label": "Fuseau horaire du salon", "default": "Europe/Paris" },
    { "type": "range", "id": "slot_step", "label": "Écart entre deux heures de début", "min": 10, "max": 60, "step": 5, "unit": "min", "default": 30 },
    { "type": "range", "id": "horizon_days", "label": "Réservation possible jusqu'à", "min": 7, "max": 180, "step": 1, "unit": "j", "default": 90 },
    { "type": "range", "id": "lead_minutes", "label": "Délai minimal avant un rendez-vous", "min": 0, "max": 1440, "step": 30, "unit": "min", "default": 120 },
    { "type": "range", "id": "cancel_hours", "label": "Déplacement ou annulation en ligne jusqu'à", "min": 0, "max": 72, "step": 1, "unit": "h", "default": 0, "info": "Nombre d'heures avant le rendez-vous. 0 : jusqu'à l'heure du rendez-vous." },
    { "type": "textarea", "id": "cancel_terms", "label": "Conditions d'annulation affichées", "info": "Vide : « Les conditions d'annulation et de modification sont à préciser avant publication. »" },
    { "type": "header", "content": "Pages du parcours" },
    { "type": "url", "id": "page_book", "label": "Prendre rendez-vous" },
    { "type": "url", "id": "page_account", "label": "Mon espace" },
    { "type": "url", "id": "page_move", "label": "Déplacer mon rendez-vous" },
    { "type": "url", "id": "page_lookup", "label": "Retrouver mon rendez-vous" },
    { "type": "url", "id": "page_services", "label": "Prestations et tarifs" },
    { "type": "url", "id": "page_contact", "label": "Contact" },
    { "type": "url", "id": "page_terms", "label": "Conditions de réservation" },
    { "type": "header", "content": "Cookies" },
    { "type": "checkbox", "id": "show_cookies", "label": "Bandeau de consentement aux cookies", "default": true, "info": "Les traceurs facultatifs ne sont jamais activés avant l'accord du visiteur." },
    { "type": "text", "id": "cookies_title", "label": "Titre du bandeau", "default": "Ce site utilise des cookies" },
    { "type": "textarea", "id": "cookies_text", "label": "Texte du bandeau", "default": "Nous utilisons des cookies pour améliorer votre expérience de navigation. Vous pouvez accepter ou refuser leur utilisation. Vous pouvez modifier votre choix à tout moment." },
    { "type": "url", "id": "cookies_link", "label": "Page « En savoir plus »" },
    { "type": "text", "id": "cookies_link_label", "label": "Texte du lien", "default": "En savoir plus" },
    { "type": "text", "id": "cookies_accept", "label": "Bouton accepter", "default": "Accepter" },
    { "type": "text", "id": "cookies_refuse", "label": "Bouton refuser", "default": "Refuser" },
    { "type": "text", "id": "cookies_custom", "label": "Lien de paramétrage", "default": "Paramètres (optionnels)" },
    { "type": "text", "id": "cookies_needed", "label": "Catégorie nécessaire", "default": "Cookies nécessaires au fonctionnement du site" },
    { "type": "text", "id": "cookies_stats", "label": "Catégorie facultative", "default": "Mesure d'audience (facultatif)" },
    { "type": "text", "id": "cookies_save", "label": "Bouton d'enregistrement", "default": "Enregistrer mes choix" }
  ],
  "blocks": [
    {
      "type": "service", "name": "Prestation",
      "settings": [
        { "type": "text", "id": "service_id", "label": "Identifiant", "info": "Court et sans espace (ex. coupe-brushing). Le même identifiant relie la prestation à ses affichages." },
        { "type": "text", "id": "name", "label": "Nom", "default": "Prestation" },
        {
          "type": "select", "id": "category", "label": "Catégorie", "default": "coupe",
          "options": [
            { "value": "coupe", "label": "Coupe" },
            { "value": "couleur", "label": "Couleur" },
            { "value": "coiffage", "label": "Coiffage" },
            { "value": "soin", "label": "Soins" }
          ]
        },
        { "type": "text", "id": "short", "label": "Description courte (prise de rendez-vous)" },
        { "type": "number", "id": "duration", "label": "Durée (minutes)" },
        { "type": "number", "id": "price", "label": "Prix (€)" },
        { "type": "checkbox", "id": "price_from", "label": "Prix « à partir de »", "default": false },
        { "type": "url", "id": "page", "label": "Fiche de la prestation" },
        { "type": "header", "content": "Selon la longueur (facultatif)" },
        { "type": "paragraph", "content": "Vide : même prix et même durée pour toutes les longueurs." },
        { "type": "number", "id": "short_price", "label": "Cheveux courts : prix (€)" },
        { "type": "number", "id": "short_duration", "label": "Cheveux courts : durée (minutes)" },
        { "type": "number", "id": "mid_price", "label": "Cheveux mi-longs : prix (€)" },
        { "type": "number", "id": "mid_duration", "label": "Cheveux mi-longs : durée (minutes)" },
        { "type": "number", "id": "long_price", "label": "Cheveux longs : prix (€)" },
        { "type": "number", "id": "long_duration", "label": "Cheveux longs : durée (minutes)" }
      ]
    },
    {
      "type": "member", "name": "Membre de l'équipe",
      "settings": [
        { "type": "text", "id": "member_id", "label": "Identifiant", "info": "Court et sans espace (ex. camille)." },
        { "type": "text", "id": "name", "label": "Prénom", "default": "Prénom" },
        { "type": "text", "id": "initial", "label": "Initiale affichée" },
        { "type": "text", "id": "title", "label": "Spécialité" },
        { "type": "text", "id": "skills", "label": "Compétences", "info": "Identifiants de prestations ou catégories (coupe, couleur, coiffage, soin), séparés par des virgules. Vide : toutes." },
        { "type": "text", "id": "days", "label": "Jours de travail", "info": "0 = dimanche … 6 = samedi, séparés par des virgules. Vide : tous les jours d'ouverture." },
        { "type": "text", "id": "hours", "label": "Horaires propres (facultatif)", "info": "Ex. « 10:00-18:00 ». Vide : horaires du salon." }
      ]
    }
  ],
  "presets": [{ "name": "Réglages du salon" }]
}
{% endschema %}
