{%- comment -%}
  PHASE : photo seule, pleine largeur, avec légende (« Projet illustratif ») — page Tableau au téléphone (planche 07).
  Hauteurs réglables sur ordinateur et au téléphone ; sans photo, la section n'affiche rien.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
{%- if s.image != blank or s.image_asset != blank -%}
<section class="ph ph-media ph-pad{% if s.show == 'desktop' %} ph-only-d{% elsif s.show == 'mobile' %} ph-only-m{% endif %}" style="--ph-mh: {{ s.height }}; --ph-mh-m: {{ s.height_mobile }}; --ph-pad-t: {{ s.pad_top }}; --ph-pad-b: {{ s.pad_bottom }}; --ph-pad-t-m: {{ s.pad_top_mobile }}; --ph-pad-b-m: {{ s.pad_bottom_mobile }};">
  <div class="ph-c">
    <figure class="ph-media__fig">
      {% render 'ph-img', image: s.image, asset: s.image_asset, alt: s.image_alt, pos: s.image_position, zoom: s.image_zoom, pos_mobile: s.image_position_mobile, zoom_mobile: s.image_zoom_mobile, class: 'ph-media__img', sizes: '100vw' %}
      {%- if s.caption != blank -%}<figcaption class="ph-cap ph-media__cap">{{ s.caption }}</figcaption>{%- endif -%}
    </figure>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Photo PHASE",
  "class": "ph-section",
  "settings": [
    { "type": "select", "id": "show", "label": "Affichage", "default": "all", "options": [{ "value": "all", "label": "Ordinateur et téléphone" }, { "value": "desktop", "label": "Ordinateur seulement" }, { "value": "mobile", "label": "Téléphone seulement" }] },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "text", "id": "image_position", "label": "Cadrage (ordinateur)", "default": "50% 50%" },
    { "type": "range", "id": "image_zoom", "label": "Agrandissement (ordinateur)", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "image_position_mobile", "label": "Cadrage (téléphone)" },
    { "type": "range", "id": "image_zoom_mobile", "label": "Agrandissement (téléphone)", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "caption", "label": "Légende sur la photo", "default": "Projet illustratif" },
    { "type": "range", "id": "height", "label": "Hauteur (repère 1440 px)", "min": 200, "max": 900, "step": 10, "default": 520 },
    { "type": "range", "id": "height_mobile", "label": "Hauteur au téléphone (repère 390 px)", "min": 120, "max": 600, "step": 2, "default": 262 },
    { "type": "range", "id": "pad_top", "label": "Marge haute (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pad_top_mobile", "label": "Marge haute (téléphone)", "min": 0, "max": 100, "step": 1, "default": 0 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Marge basse (téléphone)", "min": 0, "max": 100, "step": 1, "default": 0 }
  ],
  "presets": [{ "name": "Photo PHASE" }]
}
{% endschema %}
