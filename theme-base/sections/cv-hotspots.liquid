{%- comment -%}
  Grande image avec points interactifs : chaque point (position en % de l'image) ouvre une bulle titre + texte.
  Accessible : les points sont des boutons (clavier, Échap), et la liste des détails est aussi rendue sous l'image
  (lisible sans JavaScript ni survol). Aucun contenu inventé : tout vient des blocs.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign speed = s.animation_speed | default: 'normal'
-%}
<section class="es-section cv-hotspots cv-hotspots--{{ s.layout }} cv-anim cv-anim--{{ speed }} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;" data-cv-hotspots>
  <div class="es-container cv-hotspots__inner">
    {%- if s.heading != blank -%}
      <header class="cv-head"{% render 'cv-reveal', animation: s.animation %}>
        {%- if s.eyebrow != blank -%}<p class="cv-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- assign tag = s.heading_tag | default: 'h2' -%}
        <{{ tag }} class="es-heading cv-title cv-title--h2">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</{{ tag }}>
        {%- if s.text != blank -%}<div class="es-rte cv-head__text">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}<p class="cv-hotspots__cta"><a class="es-button" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }} {% render 'icon', name: 'arrow' %}</a></p>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="cv-hotspots__stage cv-hotspots__stage--{{ s.ratio }}"{% render 'cv-reveal', animation: s.animation %}>
      <div class="cv-hotspots__media">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y %}</div>
      {%- for block in section.blocks -%}
        <div class="cv-hotspot" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%;--d:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <button type="button" class="cv-hotspot__dot" aria-expanded="false" aria-controls="Hotspot-{{ section.id }}-{{ forloop.index }}" data-cv-hotspot><span class="visually-hidden">{{ 'conversion.hotspot_open' | t }} {{ block.settings.title | escape }}</span><span class="cv-hotspot__num" aria-hidden="true">{{ forloop.index }}</span></button>
          <div class="cv-hotspot__card" id="Hotspot-{{ section.id }}-{{ forloop.index }}" role="group" hidden>
            <p class="cv-hotspot__title">{{ block.settings.title | escape }}</p>
            {%- if block.settings.text != blank -%}<div class="es-rte cv-hotspot__text">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link != blank -%}<a class="cv-hotspot__link" href="{{ block.settings.link }}">{{ s.link_label | default: block.settings.title | escape }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
            <button type="button" class="cv-hotspot__close es-icon-button" data-cv-hotspot-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.show_list and section.blocks.size > 0 -%}
      <ol class="cv-hotspots__list" aria-label="{{ 'conversion.hotspot_list' | t }}">
        {%- for block in section.blocks -%}
          <li class="cv-hotspots__item"{% render 'cv-reveal', animation: s.animation, index: forloop.index0 %}><span class="cv-hotspots__badge" aria-hidden="true">{{ forloop.index }}</span><div><p class="cv-hotspot__title">{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</p>{% if block.settings.text != blank %}<div class="es-rte cv-hotspot__text">{{ block.settings.text }}</div>{% endif %}</div></li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    {%- if s.demo_note != blank -%}<p class="cv-fictional-note"><span class="cv-fictional">{{ s.demo_note | escape }}</span></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Points interactifs",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le produit en détail" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre en accent" },
    { "type": "select", "id": "heading_tag", "label": "Niveau du titre", "default": "h2", "options": [ { "value": "h1", "label": "Titre de la page (h1)" }, { "value": "h2", "label": "Titre de section (h2)" } ], "info": "Un seul titre de page par page : à choisir pour la section d'ouverture." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "info": "Vide : aucun bouton." },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "image_asset", "label": "Fichier image fourni avec le thème" },
    { "type": "text", "id": "image_alt", "label": "Description du visuel" },
    { "type": "text", "id": "media_role", "label": "Rôle du visuel attendu" },
    { "type": "range", "id": "focus_x", "label": "Point focal horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y", "label": "Point focal vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "select", "id": "ratio", "label": "Format du visuel", "default": "square", "options": [ { "value": "square", "label": "Carré" }, { "value": "landscape", "label": "Paysage 4:3" }, { "value": "wide", "label": "Large 16:9" }, { "value": "portrait", "label": "Portrait 4:5" } ] },
    { "type": "select", "id": "layout", "label": "Disposition", "default": "stacked", "options": [ { "value": "stacked", "label": "Titre, visuel, puis liste" }, { "value": "side", "label": "Visuel et liste côte à côte sur ordinateur" } ] },
    { "type": "checkbox", "id": "show_list", "label": "Afficher la liste des détails sous le visuel", "default": true, "info": "Lisible sans survol ni JavaScript." },
    { "type": "text", "id": "link_label", "label": "Libellé du lien d'un point", "info": "Affiché dans la bulle d'un point qui a un lien. Vide : le titre du point." },
    { "type": "text", "id": "demo_note", "label": "Mention de démonstration", "info": "Ex. « Détails de démonstration ». Vide : aucune mention." },
    { "type": "select", "id": "animation", "label": "Animation", "default": "rise", "options": [ { "value": "none", "label": "Aucune" }, { "value": "fade", "label": "Fondu" }, { "value": "rise", "label": "Montée en fondu" }, { "value": "zoom", "label": "Léger zoom" } ] },
    { "type": "select", "id": "animation_speed", "label": "Vitesse", "default": "normal", "options": [ { "value": "slow", "label": "Lente" }, { "value": "normal", "label": "Normale" }, { "value": "fast", "label": "Rapide" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espace au-dessus", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espace en dessous", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "hotspot", "name": "Point", "settings": [
      { "type": "range", "id": "x", "label": "Position horizontale", "min": 2, "max": 98, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "y", "label": "Position verticale", "min": 2, "max": 98, "step": 1, "unit": "%", "default": 50 },
      { "type": "text", "id": "title", "label": "Titre", "default": "Un détail" },
      { "type": "richtext", "id": "text", "label": "Texte" },
      { "type": "url", "id": "link", "label": "Lien du point", "info": "Ex. la fiche du produit montré. Vide : aucun lien." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Points interactifs", "blocks": [ { "type": "hotspot", "settings": { "x": 30, "y": 35 } }, { "type": "hotspot", "settings": { "x": 65, "y": 55 } }, { "type": "hotspot", "settings": { "x": 50, "y": 80 } } ] } ]
}
{% endschema %}
