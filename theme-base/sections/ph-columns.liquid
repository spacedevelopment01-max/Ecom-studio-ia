{%- comment -%}
  PHASE : textes en colonnes numérotées (planches 03 et 08 : « 01 Le besoin », « 02 La réponse envisagée ») — numéro dans
  une pastille grise, sur-titre, titre et texte ; deux colonnes à l'ordinateur, empilées au téléphone.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<section class="ph ph-columns ph-pad ph-bg--{{ s.background }}{% if s.compact_mobile %} m-compact{% endif %}" style="--ph-cols: {{ section.blocks.size | at_least: 1 }}; --ph-pad-t: {{ s.pad_top }}; --ph-pad-b: {{ s.pad_bottom }}; --ph-pad-t-m: {{ s.pad_top_mobile }}; --ph-pad-b-m: {{ s.pad_bottom_mobile }};">
  <div class="ph-c">
    <div class="ph-columns__grid">
      {%- for b in section.blocks -%}
        {%- assign c = b.settings -%}
        <article class="ph-columns__col" {{ b.shopify_attributes }}>
          {%- if c.number != blank -%}<span class="ph-columns__num">{{ c.number }}</span>{%- endif -%}
          <div class="ph-columns__copy">
            {%- if c.eyebrow != blank -%}<p class="ph-columns__eyebrow">{{ c.eyebrow }}</p>{%- endif -%}
            {% render 'ph-title', text: c.title, tag: 'h2', class: 'ph-columns__title' %}
            {%- if c.text != blank -%}<div class="ph-columns__text{% if c.text_mobile != blank %} ph-txt-d{% endif %}">{{ c.text }}</div>{%- endif -%}
            {%- if c.text_mobile != blank -%}<div class="ph-columns__text ph-txt-m">{{ c.text_mobile }}</div>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Textes en colonnes numérotées",
  "class": "ph-section",
  "settings": [
    { "type": "checkbox", "id": "compact_mobile", "label": "Au téléphone : sur-titre et texte seulement (sans numéro ni titre)", "default": false },
    { "type": "select", "id": "background", "label": "Fond", "default": "white", "options": [{ "value": "white", "label": "Blanc" }, { "value": "soft", "label": "Gris clair" }] },
    { "type": "range", "id": "pad_top", "label": "Marge haute (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 30 },
    { "type": "range", "id": "pad_bottom", "label": "Marge basse (repère 1440 px)", "min": 0, "max": 200, "step": 2, "default": 30 },
    { "type": "range", "id": "pad_top_mobile", "label": "Marge haute (téléphone)", "min": 0, "max": 100, "step": 1, "default": 16 },
    { "type": "range", "id": "pad_bottom_mobile", "label": "Marge basse (téléphone)", "min": 0, "max": 100, "step": 1, "default": 16 }
  ],
  "blocks": [
    { "type": "column", "name": "Colonne", "settings": [
      { "type": "text", "id": "number", "label": "Numéro", "default": "01" },
      { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
      { "type": "textarea", "id": "title", "label": "Titre" },
      { "type": "richtext", "id": "text", "label": "Texte" },
      { "type": "richtext", "id": "text_mobile", "label": "Texte au téléphone (facultatif)" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Textes en colonnes numérotées" }]
}
{% endschema %}
