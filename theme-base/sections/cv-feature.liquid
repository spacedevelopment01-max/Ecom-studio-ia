{%- comment -%}
  Visuel et argumentaire : image du produit, titre en deux temps, texte, pastilles cochées ou carte de points détaillés
  (icône, titre, texte), bouton et ligne de garantie. Mobile : visuel puis texte ; ordinateur : deux colonnes ou empilé.
  « Essentiels » (maquettes TRAVERSE) : produit, titre, bouton et rangée d'icônes, puis une grille de gros plans légendés.
  « Gros plan et détails numérotés » (maquettes MUSEAU CLUB) : texte, grand gros plan du produit, puis les détails en
  médaillons ronds ou carrés, numérotés ou non ; sans grand visuel, le texte est suivi des seuls détails.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign pills = section.blocks | where: 'type', 'pill'
  assign points = section.blocks | where: 'type', 'point'
  assign details = section.blocks | where: 'type', 'detail'
-%}
<section class="es-section cv-anim cv-anim--{{ section.settings.animation_speed | default: 'normal' }} cv-feature cv-feature--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;">
  <div class="es-container cv-feature__inner">
    {%- if s.heading != blank and s.layout == 'stacked' -%}
      <header class="cv-head">
        <h2 class="es-heading cv-title cv-title--h2"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.heading | escape | newline_to_br }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-head__text"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    {%- unless s.layout == 'numbered' and s.image == blank and s.image_asset == blank and s.media_role == blank -%}
    <div class="cv-feature__media cv-zoom-box"{% if s.image_zoom > 100 %} style="--cv-zoom:{{ s.image_zoom | divided_by: 100.0 }}"{% endif %}{% render 'cv-reveal', animation: section.settings.animation %}>{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y %}</div>
    {%- endunless -%}
    <div class="cv-feature__copy">
      {%- if s.eyebrow != blank -%}<p class="cv-eyebrow"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank and s.layout != 'stacked' -%}
        <h2 class="es-heading cv-title cv-title--h2 cv-title--left"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.heading | escape | newline_to_br }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-feature__text"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.text }}</div>{%- endif -%}
      {%- endif -%}
      {%- if pills.size > 0 -%}
        <ul class="cv-pills" role="list"{% render 'cv-reveal', animation: section.settings.animation %}>
          {%- for block in pills -%}<li class="cv-pill" {{ block.shopify_attributes }}><span class="cv-check cv-check--inverse" aria-hidden="true">{% render 'icon', name: 'check' %}</span>{{ block.settings.text | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if points.size > 0 -%}
        <ul class="cv-points" role="list"{% render 'cv-reveal', animation: section.settings.animation %}>
          {%- for block in points -%}
            <li class="cv-point" {{ block.shopify_attributes }}>
              <span class="cv-point__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</span>
              <div><h3 class="cv-point__title">{{ block.settings.title | escape }}</h3>{% if block.settings.text != blank %}<div class="es-rte cv-point__text">{{ block.settings.text }}</div>{% endif %}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank -%}<a class="es-button es-button--full cv-button" href="{{ s.button_link | default: routes.all_products_collection_url }}"{% render 'cv-reveal', animation: section.settings.animation %}>{{ s.button_label | escape }}{% if s.button_arrow %} {% render 'icon', name: 'arrow' %}{% endif %}</a>{%- endif -%}
      {%- if s.guarantee_text != blank -%}<p class="cv-guarantee-line"{% render 'cv-reveal', animation: section.settings.animation %}>{% render 'icon', name: 'shield' %}<span>{{ s.guarantee_text | escape }}</span></p>{%- endif -%}
    </div>
    {%- if details.size > 0 -%}
      <ul class="cv-feature__details cv-feature__details--{{ s.detail_shape | default: 'square' }}{% if s.detail_numbers %} cv-feature__details--numbers{% endif %}" role="list" style="--n:{{ details.size }}"{% render 'cv-reveal', animation: section.settings.animation %}>
        {%- for block in details -%}
          <li class="cv-feature__detail cv-zoom-box" {{ block.shopify_attributes }}{% if block.settings.image_zoom > 100 %} style="--cv-zoom:{{ block.settings.image_zoom | divided_by: 100.0 }}"{% endif %}>
            {%- if s.detail_numbers -%}<span class="cv-feature__num" aria-hidden="true">{{ forloop.index }}</span>{%- endif -%}
            {% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.image_alt, role_label: block.settings.media_role, focus_x: block.settings.focus_x, focus_y: block.settings.focus_y %}
            {%- if block.settings.caption != blank -%}<p class="cv-feature__caption">{{ block.settings.caption | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

