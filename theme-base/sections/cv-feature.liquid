{%- comment -%}
  Visuel et argumentaire : image du produit, titre en deux temps, texte, pastilles cochées ou carte de points détaillés
  (icône, titre, texte), bouton et ligne de garantie. Mobile : visuel puis texte ; ordinateur : deux colonnes ou empilé.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign pills = section.blocks | where: 'type', 'pill'
  assign points = section.blocks | where: 'type', 'point'
-%}
<section class="es-section cv-feature cv-feature--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;">
  <div class="es-container cv-feature__inner">
    {%- if s.heading != blank and s.layout == 'stacked' -%}
      <header class="cv-head">
        <h2 class="es-heading cv-title cv-title--h2" data-reveal="up">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-head__text" data-reveal="up">{{ s.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="cv-feature__media" data-reveal="up">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y %}</div>
    <div class="cv-feature__copy">
      {%- if s.heading != blank and s.layout != 'stacked' -%}
        <h2 class="es-heading cv-title cv-title--h2 cv-title--left" data-reveal="up">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>
        {%- if s.text != blank -%}<div class="es-rte cv-feature__text" data-reveal="up">{{ s.text }}</div>{%- endif -%}
      {%- endif -%}
      {%- if pills.size > 0 -%}
        <ul class="cv-pills" role="list" data-reveal="up">
          {%- for block in pills -%}<li class="cv-pill" {{ block.shopify_attributes }}><span class="cv-check cv-check--inverse" aria-hidden="true">{% render 'icon', name: 'check' %}</span>{{ block.settings.text | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if points.size > 0 -%}
        <ul class="cv-points" role="list" data-reveal="up">
          {%- for block in points -%}
            <li class="cv-point" {{ block.shopify_attributes }}>
              <span class="cv-point__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</span>
              <div><h3 class="cv-point__title">{{ block.settings.title | escape }}</h3>{% if block.settings.text != blank %}<div class="es-rte cv-point__text">{{ block.settings.text }}</div>{% endif %}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank -%}<a class="es-button es-button--full cv-button" href="{{ s.button_link | default: routes.all_products_collection_url }}" data-reveal="up">{{ s.button_label | escape }}</a>{%- endif -%}
      {%- if s.guarantee_text != blank -%}<p class="cv-guarantee-line" data-reveal="up">{% render 'icon', name: 'shield' %}<span>{{ s.guarantee_text | escape }}</span></p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visuel et argumentaire",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "image_asset", "label": "Fichier image fourni avec le thème" },
    { "type": "text", "id": "image_alt", "label": "Description du visuel" },
    { "type": "text", "id": "media_role", "label": "Rôle du visuel attendu" },
    { "type": "range", "id": "focus_x", "label": "Point focal horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y", "label": "Point focal vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "select", "id": "layout", "label": "Disposition sur ordinateur", "default": "image-left", "options": [ { "value": "image-left", "label": "Visuel à gauche" }, { "value": "image-right", "label": "Visuel à droite" }, { "value": "stacked", "label": "Titre, visuel, puis points" } ] },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi ce produit" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre en accent" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "guarantee_text", "label": "Ligne de garantie", "info": "Uniquement une politique réelle, ou un exemple identifié." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Espace au-dessus", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espace en dessous", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "pill", "name": "Pastille cochée", "settings": [ { "type": "text", "id": "text", "label": "Texte", "default": "Un point fort" } ] },
    { "type": "point", "name": "Point détaillé", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "check", "options": [ { "value": "check", "label": "Coche" }, { "value": "clock", "label": "Horloge" }, { "value": "sparkle", "label": "Étincelle" }, { "value": "heart", "label": "Cœur" }, { "value": "shield", "label": "Bouclier" }, { "value": "bolt", "label": "Éclair" }, { "value": "sound", "label": "Son" }, { "value": "leaf", "label": "Feuille" }, { "value": "drop", "label": "Goutte" }, { "value": "hand", "label": "Main" } ] },
      { "type": "text", "id": "title", "label": "Titre", "default": "Un point détaillé" },
      { "type": "richtext", "id": "text", "label": "Texte" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Visuel et argumentaire", "blocks": [ { "type": "pill" }, { "type": "pill" }, { "type": "pill" } ] } ]
}
{% endschema %}
