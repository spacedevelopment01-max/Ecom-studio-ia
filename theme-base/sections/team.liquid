{%- comment -%}
  Équipe : portraits, rôles et courte présentation. Sans photo, un monogramme aux initiales remplace le portrait.
  Diplômes, certifications et années d'expérience : uniquement ceux fournis par le marchand.
{%- endcomment -%}
{%- liquid
  assign count = section.blocks | size
  assign cols = section.settings.columns
  if count < cols
    assign cols = count | at_least: 1
  endif
-%}
<section class="es-section es-team es-team--{{ section.settings.style }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --cols: {{ cols }};">
  <div class="es-container">
    <header class="es-team__head">
      {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="es-rte es-lead" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <ul class="es-team__grid{% if count == 1 %} es-team__grid--solo{% endif %}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign words = block.settings.name | split: ' '
          assign i1 = words[0] | slice: 0
          assign i2 = words[1] | slice: 0
          assign initials = i1 | append: i2 | upcase
          if i1 == '['
            assign initials = ''
          endif
        -%}
        <li class="es-team__member" data-reveal="up" style="--i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <div class="es-team__photo">
            {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
              {% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.name, sizes: '(min-width: 990px) 25vw, 50vw', class: 'es-cover' %}
            {%- else -%}
              <span class="es-team__monogram" aria-hidden="true">{%- if initials != blank -%}{{ initials }}{%- else -%}{% render 'icon', name: 'account' %}{%- endif -%}</span>
            {%- endif -%}
          </div>
          <div class="es-team__body">
            <h3 class="es-heading es-h4 es-team__name">{{ block.settings.name }}</h3>
            {%- if block.settings.role != blank -%}<p class="es-team__role">{{ block.settings.role }}</p>{%- endif -%}
            {%- if block.settings.bio != blank -%}<div class="es-rte es-team__bio">{{ block.settings.bio }}</div>{%- endif -%}
            {%- if block.settings.link != blank -%}<a class="es-team__link" href="{{ block.settings.link }}"{% if block.settings.link contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.link_label | default: block.settings.link }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.es-team__head { max-width: 720px; margin-bottom: clamp(28px, 4.4vw, 56px); }
.es-team--portraits .es-team__head { text-align: center; margin-inline: auto; }
.es-team--portraits .es-team__head .es-lead { margin-inline: auto; }
.es-team__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(18px, 2.4vw, 32px); grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
@media (min-width: 990px) { .es-team__grid { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
.es-team__grid--solo { max-width: 860px; }
.es-team--portraits .es-team__grid, .es-team--cards .es-team__grid { max-width: calc(var(--cols) * 360px); margin-inline: auto; }
.es-team__member { display: grid; gap: 16px; align-content: start; }
.es-team__photo { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-card); overflow: hidden; background: linear-gradient(150deg, color-mix(in srgb, var(--c-accent) 26%, var(--c-surface)), var(--c-surface)); }
.es-team__photo .es-cover, .es-team__photo .es-placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out), filter .8s; }
.es-team__member:hover .es-team__photo .es-cover { transform: scale(1.04); }
.es-team__monogram { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-heading); font-size: clamp(2.6rem, 6vw, 4.4rem); letter-spacing: .04em; color: color-mix(in srgb, var(--c-text) 70%, transparent); }
.es-team__monogram .es-icon { width: 30%; height: 30%; opacity: .55; }
.es-team__name { margin: 0; }
.es-team__role { margin: 4px 0 0; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: var(--font-body-weight-bold); color: var(--c-accent); }
.es-team__bio { margin-top: 10px; color: color-mix(in srgb, var(--c-text) 76%, var(--c-bg)); font-size: .97rem; }
.es-team__link { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-weight: var(--font-body-weight-bold); font-size: .92rem; text-decoration: none; border-bottom: 1px solid rgba(var(--c-text-rgb), .22); }
.es-team__link .es-icon { width: 15px; height: 15px; }
/* Portraits ronds centrés */
.es-team--portraits .es-team__member { justify-items: center; text-align: center; }
.es-team--portraits .es-team__photo { width: min(220px, 70%); aspect-ratio: 1; border-radius: 50%; box-shadow: 0 0 0 6px var(--c-bg), 0 0 0 7px rgba(var(--c-accent-rgb), .45); }
/* Cartes : portrait et texte dans une carte */
.es-team--cards .es-team__member { padding: 12px 12px 24px; border-radius: calc(var(--radius-card) + 6px); background: var(--c-surface); border: 1px solid rgba(var(--c-text-rgb), .08); }
.es-team--cards .es-team__body { padding: 0 12px; }
.es-team__grid--solo .es-team__member { grid-template-columns: minmax(0, 300px) minmax(0, 1fr); align-items: center; gap: clamp(20px, 4vw, 48px); text-align: left; justify-items: start; }
@media (max-width: 749px) { .es-team__grid--solo .es-team__member { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .es-team__photo .es-cover { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Équipe",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "L'équipe" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les personnes qui vous accueillent" },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "select", "id": "style", "label": "Style", "default": "cards", "options": [{ "value": "cards", "label": "Cartes" }, { "value": "portraits", "label": "Portraits ronds" }, { "value": "plain", "label": "Épuré" }] },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Colonnes", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "member", "name": "Membre", "settings": [
      { "type": "image_picker", "id": "image", "label": "Portrait" },
      { "type": "text", "id": "image_asset", "label": "Portrait fourni avec le thème" },
      { "type": "text", "id": "name", "label": "Prénom et nom", "default": "[À compléter : prénom et nom]" },
      { "type": "text", "id": "role", "label": "Rôle", "default": "[À compléter : rôle]" },
      { "type": "richtext", "id": "bio", "label": "Présentation", "default": "<p>[À compléter : parcours et spécialités, uniquement les diplômes et certifications réels.]</p>" },
      { "type": "text", "id": "link_label", "label": "Texte du lien (facultatif)" },
      { "type": "url", "id": "link", "label": "Lien (facultatif)" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Équipe", "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }] }]
}
{% endschema %}
