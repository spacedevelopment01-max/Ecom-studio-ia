{%- comment -%}
  Exemple de commande (MUSEAU CLUB, planche 05 du 23 octobre) : page « Finaliser ma commande » et page de confirmation
  d'une boutique de démonstration. Rien n'est envoyé ni payé : les champs sont désactivés, aucune donnée de carte n'est
  demandée et le récapitulatif est fixe (blocs « ligne »). Sur une vraie boutique, la commande et sa confirmation sont
  des pages de Shopify : cette section sert seulement à montrer le parcours dans l'aperçu.
  SOUPLE (planche 04 du 23 octobre) : « Commande en étapes » testable avec des données fictives (Contact → Adresse →
  Livraison → Paiement), champs vérifiés, retour sans perte, récapitulatif lu dans le vrai panier ; aucune carte n'est
  demandée et rien n'est envoyé (les données restent dans l'onglet, le temps de la démonstration). La confirmation
  reprend la commande d'exemple saisie, sinon les lignes fixes de la section.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign layout = s.layout | default: 'checkout'
  assign subtotal = 0
  assign count = 0
  for block in section.blocks
    assign line_product = all_products[block.settings.product] | default: block.settings.product
    if line_product.title != blank
      assign line_qty = block.settings.quantity | default: 1
      assign line_total = line_product.price | times: line_qty
      assign subtotal = subtotal | plus: line_total
      assign count = count | plus: line_qty
    endif
  endfor
-%}
{%- capture summary -%}
  <aside class="es-order__summary" aria-label="{{ s.summary_title | escape }}">
    <h2 class="es-order__summary-title">{{ s.summary_title | escape }}{% if count > 0 %} <span>({{ count }} {% if count > 1 %}{{ s.items_label | default: 'articles' | escape }}{% else %}{{ s.item_label | default: 'article' | escape }}{% endif %})</span>{% endif %}</h2>
    <ul class="es-order__lines" role="list" data-order-lines>
      {%- for block in section.blocks -%}
        {%- assign line_product = all_products[block.settings.product] | default: block.settings.product -%}
        {%- if line_product.title != blank -%}
          {%- assign line_qty = block.settings.quantity | default: 1 -%}
          <li class="es-order__line" {{ block.shopify_attributes }}>
            <span class="es-order__thumb">{%- if line_product.featured_media -%}{{ line_product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: line_product.title }}{%- endif -%}</span>
            <span class="es-order__line-info"><strong>{{ line_product.title | escape }}</strong>{%- if block.settings.variant_label != blank -%}<span>{{ block.settings.variant_label | escape | newline_to_br }}</span>{%- endif -%}</span>
            <span class="es-order__qty">{{ line_qty }}</span>
            <span class="es-order__price">{% if settings.price_trim_zeros %}{{ line_product.price | times: line_qty | money_without_trailing_zeros }}{% else %}{{ line_product.price | times: line_qty | money }}{% endif %}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <dl class="es-order__totals">
      <div><dt>{{ s.subtotal_label | escape }}</dt><dd data-order-subtotal>{% if settings.price_trim_zeros %}{{ subtotal | money_without_trailing_zeros }}{% else %}{{ subtotal | money }}{% endif %}</dd></div>
      {%- if s.shipping_label != blank -%}<div><dt>{{ s.shipping_label | escape }}</dt><dd>{{ s.shipping_value | escape }}</dd></div>{%- endif -%}
    </dl>
    {%- if s.total_note != blank -%}<p class="es-order__note">{{ s.total_note | escape }}</p>{%- endif -%}
  </aside>
{%- endcapture -%}
<section class="es-section es-order es-order--{{ layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="es-container">
    {%- if layout == 'steps' -%}
      {%- comment -%} Commande en étapes (démonstration testable) : voir family.js, « Commande d'exemple en étapes ». {%- endcomment -%}
      <header class="es-order__head">
        {%- if s.eyebrow != blank -%}<p class="es-order__pill">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="es-heading es-order__title">{{ s.heading | escape | newline_to_br }}</h1>
        {%- if s.text != blank -%}<div class="es-rte es-order__text">{{ s.text }}</div>{%- endif -%}
      </header>
      <div class="es-order__steps-wrap" data-order-steps data-confirm="{{ s.button_link | default: routes.root_url }}" data-shop="{{ shop.name | handleize }}" data-money="{{ shop.money_format | escape }}" data-empty-text="{{ s.empty_text | escape }}" data-ship-value="{{ s.shipping_value | escape }}">
        <ol class="es-order__stepper" role="list">
          {%- assign step_titles = s.contact_title | append: '|' | append: s.address_title | append: '|' | append: s.shipping_title | append: '|' | append: s.payment_title | split: '|' -%}
          {%- for t in step_titles -%}<li class="es-order__stepper-item{% if forloop.first %} is-current{% endif %}" data-step-dot="{{ forloop.index }}"{% if forloop.first %} aria-current="step"{% endif %}><span class="es-order__stepper-n">{{ forloop.index }}</span><span class="es-order__stepper-label">{{ t | escape }}</span></li>{%- endfor -%}
        </ol>
        <div class="es-order__grid">
          <form class="es-order__form es-order__form--steps" action="#" novalidate aria-describedby="OrderDemo-{{ section.id }}" data-order-form>
            <p class="es-order__demo" id="OrderDemo-{{ section.id }}">{{ s.demo_notice | escape }}</p>
            <p class="es-order__empty" data-order-empty hidden>{{ s.empty_text | escape }} <a href="{{ routes.all_products_collection_url }}">{{ s.empty_link_label | escape }}</a></p>
            <fieldset class="es-order__step" data-step="1">
              <legend>{{ s.contact_info_title | default: s.contact_title | escape }}</legend>
              <label class="es-order__field es-order__field--full"><span>{{ s.email_label | escape }} *</span><input type="email" name="email" autocomplete="email" placeholder="{{ s.email_placeholder | escape }}" required data-msg="{{ s.email_error | escape }}"><small class="es-order__error" data-error hidden></small></label>
              <label class="es-order__optin"><input type="checkbox" name="newsletter"><span>{{ s.newsletter_label | escape }}</span></label>
            </fieldset>
            <fieldset class="es-order__step" data-step="2" hidden>
              <legend>{{ s.address_title | escape }}</legend>
              <label class="es-order__field"><span>{{ s.first_name_label | escape }} *</span><input type="text" name="first_name" autocomplete="given-name" required data-msg="{{ s.required_error | escape }}"><small class="es-order__error" data-error hidden></small></label>
              <label class="es-order__field"><span>{{ s.last_name_label | escape }} *</span><input type="text" name="last_name" autocomplete="family-name" required data-msg="{{ s.required_error | escape }}"><small class="es-order__error" data-error hidden></small></label>
              <label class="es-order__field es-order__field--full"><span>{{ s.address_label | escape }} *</span><input type="text" name="address" autocomplete="address-line1" placeholder="{{ s.address_placeholder | escape }}" required data-msg="{{ s.required_error | escape }}"><small class="es-order__error" data-error hidden></small></label>
              <label class="es-order__field"><span>{{ s.zip_label | escape }} *</span><input type="text" name="zip" autocomplete="postal-code" inputmode="numeric" required pattern="[0-9A-Za-z \-]{3,10}" data-msg="{{ s.zip_error | escape }}"><small class="es-order__error" data-error hidden></small></label>
              <label class="es-order__field"><span>{{ s.city_label | escape }} *</span><input type="text" name="city" autocomplete="address-level2" required data-msg="{{ s.required_error | escape }}"><small class="es-order__error" data-error hidden></small></label>
              <label class="es-order__field es-order__field--full"><span>{{ s.country_label | escape }}</span><input type="text" name="country" autocomplete="country-name" value="{{ s.country_value | escape }}"></label>
            </fieldset>
            <fieldset class="es-order__step" data-step="3" hidden>
              <legend>{{ s.shipping_title | escape }}</legend>
              <label class="es-order__option es-order__option--choice"><input type="radio" name="shipping" value="standard" checked required data-msg="{{ s.required_error | escape }}">{% render 'icon', name: 'truck' %}<span><strong>{{ s.shipping_option_label | escape }}</strong> {{ s.shipping_value | escape }}</span></label>
              <small class="es-order__error" data-error hidden></small>
            </fieldset>
            <fieldset class="es-order__step" data-step="4" hidden>
              <legend>{{ s.payment_title | escape }}</legend>
              <p class="es-order__option es-order__option--muted">{% render 'icon', name: 'shield' %}<span>{{ s.payment_text | escape }}</span></p>
              <dl class="es-order__review" data-order-review></dl>
            </fieldset>
            <div class="es-order__actions">
              <button type="button" class="es-button es-button--secondary es-order__back" data-step-back hidden>{% render 'icon', name: 'arrow-left' %}<span>{{ s.back_label | escape }}</span></button>
              <button type="submit" class="es-button es-order__next" data-step-next><span data-next-label="{{ s.next_label | escape }}" data-last-label="{{ s.submit_label | escape }}">{{ s.next_label | escape }}</span>{% render 'icon', name: 'arrow' %}</button>
            </div>
            <p class="es-order__status" role="status" aria-live="polite" data-order-status></p>
          </form>
          <div class="es-order__side">
            <aside class="es-order__summary" aria-label="{{ s.summary_title | escape }}" data-order-summary>
              <h2 class="es-order__summary-title">{{ s.summary_title | escape }} <span data-order-count></span></h2>
              <ul class="es-order__lines" role="list" data-order-lines></ul>
              <dl class="es-order__totals">
                <div><dt>{{ s.subtotal_label | escape }}</dt><dd data-order-subtotal>—</dd></div>
                {%- if s.shipping_label != blank -%}<div><dt>{{ s.shipping_label | escape }}</dt><dd>{{ s.shipping_value | escape }}</dd></div>{%- endif -%}
                {%- if s.total_label != blank -%}<div class="es-order__total"><dt>{{ s.total_label | escape }}</dt><dd data-order-total>—</dd></div>{%- endif -%}
              </dl>
              {%- if s.total_note != blank -%}<p class="es-order__note">{{ s.total_note | escape }}</p>{%- endif -%}
            </aside>
            {%- if s.button_note != blank -%}<p class="es-order__note">{{ s.button_note | escape }}</p>{%- endif -%}
          </div>
        </div>
      </div>
    {%- elsif layout == 'confirmation' -%}
      <div class="es-order__confirm"{% if s.use_last_order %} data-order-confirm data-shop="{{ shop.name | handleize }}" data-money="{{ shop.money_format | escape }}"{% endif %}>
        <div class="es-order__confirm-copy">
          {%- if s.eyebrow != blank -%}<p class="es-order__pill">{{ s.eyebrow | escape }}</p>{%- endif -%}
          <span class="es-order__check" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
          <h1 class="es-heading es-order__title">{{ s.heading | escape | newline_to_br }}</h1>
          {%- if s.text != blank -%}<div class="es-rte es-order__text">{{ s.text }}</div>{%- endif -%}
          {%- if s.order_number != blank -%}
            <dl class="es-order__meta">
              <div><dt>{{ s.order_number_label | escape }}</dt><dd>{{ s.order_number | escape }}</dd></div>
              {%- if s.order_date_label != blank -%}<div><dt>{{ s.order_date_label | escape }}</dt><dd data-order-today>{{ s.order_date_fallback | escape }}</dd></div>{%- endif -%}
            </dl>
            {%- if s.meta_note != blank -%}<p class="es-order__meta-note">{{ s.meta_note | escape }}</p>{%- endif -%}
          {%- endif -%}
          {%- if s.button_label != blank -%}<a class="es-button es-order__button" href="{{ s.button_link | default: routes.root_url }}">{{ s.button_label | escape }}</a>{%- endif -%}
          {%- if s.secondary_label != blank -%}<a class="es-order__secondary" href="{{ s.secondary_link | default: routes.all_products_collection_url }}">{{ s.secondary_label | escape }}</a>{%- endif -%}
        </div>
        {%- if s.image != blank or s.image_asset != blank -%}<div class="es-order__photo">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, focus_x: s.focus_x, focus_y: s.focus_y %}</div>{%- endif -%}
        {{ summary }}
      </div>
    {%- else -%}
      <header class="es-order__head">
        {%- if s.eyebrow != blank -%}<p class="es-order__pill">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="es-heading es-order__title">{{ s.heading | escape | newline_to_br }}</h1>
        {%- if s.text != blank -%}<div class="es-rte es-order__text">{{ s.text }}</div>{%- endif -%}
      </header>
      <div class="es-order__grid">
        <form class="es-order__form" action="#" onsubmit="return false" aria-describedby="OrderDemo-{{ section.id }}">
          <p class="es-order__demo" id="OrderDemo-{{ section.id }}">{{ s.demo_notice | escape }}</p>
          <fieldset class="es-order__step" disabled>
            <legend>{{ s.contact_title | escape }}</legend>
            <label class="es-order__field es-order__field--full"><span>{{ s.email_label | escape }}</span><input type="email" autocomplete="off" placeholder="{{ s.email_placeholder | escape }}"></label>
          </fieldset>
          <fieldset class="es-order__step" disabled>
            <legend>{{ s.address_title | escape }}</legend>
            <label class="es-order__field"><span>{{ s.first_name_label | escape }}</span><input type="text" autocomplete="off"></label>
            <label class="es-order__field"><span>{{ s.last_name_label | escape }}</span><input type="text" autocomplete="off"></label>
            <label class="es-order__field es-order__field--full"><span>{{ s.address_label | escape }}</span><input type="text" autocomplete="off" placeholder="{{ s.address_placeholder | escape }}"></label>
            <label class="es-order__field"><span>{{ s.zip_label | escape }}</span><input type="text" autocomplete="off"></label>
            <label class="es-order__field"><span>{{ s.city_label | escape }}</span><input type="text" autocomplete="off"></label>
            <label class="es-order__field es-order__field--full"><span>{{ s.country_label | escape }}</span><input type="text" autocomplete="off" value="{{ s.country_value | escape }}"></label>
          </fieldset>
          <fieldset class="es-order__step" disabled>
            <legend>{{ s.shipping_title | escape }}</legend>
            <p class="es-order__option">{% render 'icon', name: 'truck' %}<span><strong>{{ s.shipping_label | escape }}</strong> {{ s.shipping_value | escape }}</span></p>
          </fieldset>
          <fieldset class="es-order__step" disabled>
            <legend>{{ s.payment_title | escape }}</legend>
            <p class="es-order__option es-order__option--muted">{% render 'icon', name: 'shield' %}<span>{{ s.payment_text | escape }}</span></p>
          </fieldset>
        </form>
        <div class="es-order__side">
          {{ summary }}
          {%- if s.button_label != blank -%}<a class="es-button es-order__button" href="{{ s.button_link | default: routes.root_url }}">{{ s.button_label | escape }}</a>{%- endif -%}
          {%- if s.button_note != blank -%}<p class="es-order__note">{{ s.button_note | escape }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

