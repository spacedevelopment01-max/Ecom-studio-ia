    { "type": "text", "id": "order_date_label", "label": "Libellé de la date", "default": "Date de commande" },
    { "type": "text", "id": "order_date_fallback", "label": "Date affichée sans script", "default": "Date de la démonstration" },
    { "type": "text", "id": "meta_note", "label": "Phrase sous le numéro" },
    { "type": "text", "id": "secondary_label", "label": "Lien secondaire" },
    { "type": "url", "id": "secondary_link", "label": "Destination du lien secondaire" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (confirmation)"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Photo (fichier du thème)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif de la photo"
