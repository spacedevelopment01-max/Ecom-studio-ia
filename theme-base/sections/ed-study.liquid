{% assign s = section.settings %}
<section class="ed-section ed-study color-{{ s.color_scheme }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-ed-motion="{{ s.motion }}" style="--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;">
<div class="ed-shell"><header class="ed-section-head"><p class="ed-kicker">{{ s.label | escape }}</p><h2 class="ed-title">{{ s.heading | escape }}</h2><div class="ed-prose">{{ s.text }}</div></header><div class="ed-study__views"{% if s.aligned %} data-ed-comparison{% endif %}>
 <figure>{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: 50, focus_y: 50 %}<figcaption>{{ s.first_label | escape }}</figcaption></figure>
 <figure>{% render 'ed-media', image: s.second_image, asset: s.second_asset, alt: s.second_alt, role_label: s.second_role, focus_x: 50, focus_y: 50 %}<figcaption>{{ s.second_label | escape }}</figcaption></figure>
 {% if s.aligned %}<p class="ed-study__labels" aria-hidden="true"><span>{{ s.first_label | escape }}</span><span>{{ s.second_label | escape }}</span></p><label class="ed-study__control">{{ s.control_label | escape }}<input type="range" min="0" max="100" value="50" aria-label="{{ s.control_label | escape }}" data-ed-range></label>{% endif %}
</div></div></section>
{% schema %}
{
  "name": "Étude d’intention",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancre de navigation"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "motion",
      "label": "Mouvement",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "reveal",
          "label": "Entrée unique"
        },
        {
          "value": "drift",
          "label": "Déplacement léger"
        }
      ],
      "default": "reveal"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "label",
      "label": "Repère éditorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du lien"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Destination"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fichier du projet"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Rôle du visuel attendu"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Point focal horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Point focal vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "second_image",
      "label": "Deuxième image"
    },
    {
      "type": "text",
      "id": "second_asset",
      "label": "Deuxième fichier du projet"
    },
    {
      "type": "text",
      "id": "second_alt",
      "label": "Description de la deuxième image"
    },
    {
      "type": "text",
      "id": "second_role",
      "label": "Rôle de la deuxième image"
    },
    {
      "type": "text",
      "id": "first_label",
      "label": "Légende de départ"
    },
    {
      "type": "text",
      "id": "second_label",
      "label": "Légende de proposition"
    },
    {
      "type": "checkbox",
      "id": "aligned",
      "label": "Vues précisément alignées",
      "default": false
    },
    {
      "type": "text",
      "id": "control_label",
      "label": "Libellé du comparateur",
      "default": "Comparer les vues"
    }
  ],
  "presets": [
    {
      "name": "Étude d’intention"
    }
  ]
}
{% endschema %}
