<section class="es-section es-collection color-{{ section.settings.color_scheme }}" style="--pt: 48px; --pb: 96px;">
  <div class="es-container">
    {%- if section.settings.show_header != false -%}
    <header class="es-collection__head">
      <h1 class="es-heading es-h1" data-reveal="lines">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="es-rte es-muted es-lead">{{ collection.description }}</div>{%- endif -%}
    </header>
    {%- endif -%}
    {%- paginate collection.products by section.settings.per_page -%}
      {%- if section.settings.show_count != false or section.settings.enable_filters or section.settings.enable_sorting -%}<div class="es-collection__bar">
      {%- if section.settings.show_count != false -%}<p class="es-small es-muted es-collection__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>{%- endif -%}
      <form class="es-filters" data-filters action="{{ collection.url }}" method="get">
        {%- if section.settings.enable_filters -%}
          {%- for filter in collection.filters -%}
            <details class="es-filter">
              <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
              <div class="es-filter__panel">
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="es-filter__price">
                      <label>{{ 'collections.from' | t }} <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0" placeholder="0"></label>
                      <label>{{ 'collections.to' | t }} <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"></label>
                    </div>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label class="es-check"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> {{ value.label }} <span class="es-muted">({{ value.count }})</span></label>
                    {%- endfor -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.enable_sorting -%}
          <label class="es-sort">{{ 'collections.sort_by' | t }}
            <select name="sort_by" class="es-select" data-autosubmit>
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        <noscript><button type="submit" class="es-button es-button--small">{{ 'collections.apply' | t }}</button></noscript>
      </form>
      </div>{%- endif -%}
      {%- if section.settings.type_chips -%}
        {%- assign chip_types = '' -%}
        {%- for product in collection.products -%}{%- if product.type != blank -%}{%- assign chip_key = '|' | append: product.type | append: '|' -%}{%- unless chip_types contains chip_key -%}{%- assign chip_types = chip_types | append: chip_key -%}{%- endunless -%}{%- endif -%}{%- endfor -%}
        {%- assign chip_list = chip_types | split: '|' -%}
        {%- if chip_list.size > 1 -%}
        <div class="es-collection__chips" role="group" aria-label="{{ collection.title | escape }}" data-chip-filters>
          <button type="button" class="fs-chip-filter is-active" aria-pressed="true" data-chip-filter="">{{ section.settings.chips_all_label | default: 'Tous' | escape }}{% if section.settings.chip_counts %} <span class="fs-chip-filter__count">({{ collection.products.size }})</span>{% endif %}</button>
          {%- for t in chip_list -%}{%- if t != blank -%}{%- assign chip_n = collection.products | where: 'type', t | size -%}<button type="button" class="fs-chip-filter" aria-pressed="false" data-chip-filter="{{ t | handleize }}">{{ t | escape }}{% if section.settings.chip_counts %} <span class="fs-chip-filter__count">({{ chip_n }})</span>{% endif %}</button>{%- endif -%}{%- endfor -%}
        </div>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.client_sort -%}
        {%- comment -%} Tri dans la page (SOUPLE) : réordonne les cartes sans recharger ; marche aussi dans l'aperçu statique. {%- endcomment -%}
        <label class="es-sort es-collection__sort">{{ section.settings.sort_label | default: 'Trier par' | escape }}
          <select class="es-select" data-client-sort aria-controls="CollectionGrid-{{ section.id }}">
            <option value="">{{ section.settings.sort_default_label | default: 'Nos choix' | escape }}</option>
            <option value="price-asc">{{ section.settings.sort_price_asc_label | default: 'Prix croissant' | escape }}</option>
            <option value="price-desc">{{ section.settings.sort_price_desc_label | default: 'Prix décroissant' | escape }}</option>
            <option value="title">{{ section.settings.sort_title_label | default: 'Nom, de A à Z' | escape }}</option>
          </select>
        </label>
      {%- endif -%}
      {%- assign wrap_items = false -%}{%- if section.settings.type_chips or section.settings.client_sort -%}{%- assign wrap_items = true -%}{%- endif -%}
      <div class="es-product-grid" id="CollectionGrid-{{ section.id }}" style="--cols: {{ section.settings.columns }}" data-sort-list>
        {%- for product in collection.products -%}
          {%- if wrap_items -%}<div class="es-collection__item"{% if section.settings.type_chips %} data-chip-item="{{ product.type | handleize }}"{% endif %} data-sort-item data-sort-index="{{ forloop.index }}" data-sort-price="{{ product.price | default: 0 }}" data-sort-title="{{ product.title | escape }}">{%- endif -%}
          {% render 'product-card', product_card: product, show_secondary: true, ratio: section.settings.card_ratio, show_vendor: section.settings.card_vendor, button_label: section.settings.card_button_label, quick_add: section.settings.quick_add %}
          {%- if wrap_items -%}</div>{%- endif -%}
        {%- else -%}
          <p class="es-empty">{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if section.settings.type_chips -%}<div class="es-collection__none" data-chip-empty hidden><p>{{ section.settings.no_result_text | default: 'Aucun produit ne correspond à ce filtre.' | escape }}</p><button type="button" class="es-button es-button--secondary" data-chip-filter="">{{ section.settings.no_result_button | default: 'Voir tous les produits' | escape }}</button></div>{%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Produits par page",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Colonnes",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Filtres",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Tri",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "type_chips",
      "label": "Pastilles de filtre par type de produit",
      "info": "« Tous », puis un bouton par type de produit de la collection (filtrage dans la page).",
      "default": false
    },
    {
      "type": "text",
      "id": "chips_all_label",
      "label": "Libellé de la pastille « Tous »",
      "default": "Tous"
    },
    {
      "type": "checkbox",
      "id": "chip_counts",
      "label": "Nombre de produits dans chaque pastille",
      "info": "Calculé à partir des produits de la collection : « Tous (4) », « Tapis (1) »…",
      "default": false
    },
    {
      "type": "text",
      "id": "no_result_text",
      "label": "Message quand aucun produit ne correspond",
      "default": "Aucun produit ne correspond à ce filtre."
    },
    {
      "type": "text",
      "id": "no_result_button",
      "label": "Bouton pour tout afficher",
      "default": "Voir tous les produits"
    },
    {
      "type": "checkbox",
      "id": "client_sort",
      "label": "Tri dans la page (sans rechargement)",
      "info": "Nos choix, prix croissant ou décroissant, nom. Indépendant du tri de la plateforme.",
      "default": false
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Libellé du tri",
      "default": "Trier par"
    },
    {
      "type": "text",
      "id": "sort_default_label",
      "label": "Ordre de la collection",
      "default": "Nos choix"
    },
    {
      "type": "text",
      "id": "sort_price_asc_label",
      "label": "Prix croissant",
      "default": "Prix croissant"
    },
    {
      "type": "text",
      "id": "sort_price_desc_label",
      "label": "Prix décroissant",
      "default": "Prix décroissant"
    },
    {
      "type": "text",
      "id": "sort_title_label",
      "label": "Nom",
      "default": "Nom, de A à Z"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Titre et description de la collection",
      "info": "Décochez quand un bandeau au-dessus porte déjà le titre de la page (H1).",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Nombre de produits",
      "default": true
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Format des photos des cartes",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Carré"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "card_vendor",
      "label": "Marque au-dessus du nom",
      "default": false
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "Bouton sous chaque carte",
      "info": "Ex. « Voir le produit ». Vide : pas de bouton."
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Ajout au panier depuis la carte",
      "default": "none",
      "options": [
        { "value": "none", "label": "Aucun (lien vers la fiche)" },
        { "value": "icon", "label": "Bouton rond « panier »" },
        { "value": "plus", "label": "Bouton rond « + »" },
        { "value": "button", "label": "Bouton texte (libellé du bouton de carte)" }
      ],
      "info": "Ajoute vraiment le produit quand il n'a qu'une variante ; sinon le bouton mène à sa fiche pour choisir."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
