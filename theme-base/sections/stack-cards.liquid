{%- comment -%} Cartes qui s'empilent au défilement (position collante). {%- endcomment -%}
<section class="es-section es-stack color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2 es-stack__heading" data-reveal="words">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif %}</h2>{%- endif -%}
    <div class="es-stack__list">
      {%- for block in section.blocks -%}
        <article class="es-stack__card" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="es-stack__media es-media-frame">{% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, sizes: '(min-width: 990px) 560px, 90vw', class: 'es-cover' %}</div>
          <div class="es-stack__body">
            {%- if block.settings.eyebrow != blank -%}<p class="es-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h3 class="es-heading es-h3">{{ block.settings.title }}</h3>
            <div class="es-rte es-muted">{{ block.settings.text }}</div>
            {%- if block.settings.button_label != blank -%}<div class="es-actions"><a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="es-button">{{ block.settings.button_label }} {% render 'icon', name: 'arrow' %}</a></div>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.es-stack .es-stack__body .es-eyebrow { margin-bottom: .8rem; color: var(--c-accent); }
.es-stack .es-stack__body .es-h3 { margin-bottom: .45em; }
.es-stack .es-stack__body .es-rte { font-size: max(1rem, 15px); line-height: 1.65; max-width: 46ch; }
.es-stack .es-stack__media { border-radius: calc(var(--radius-card) * .8); overflow: hidden; }
{% endstylesheet %}

{% schema %}
{
  "name": "Cartes empilées",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "text", "id": "heading_accent", "label": "Fin du titre mise en valeur" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "card", "name": "Carte", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "eyebrow", "label": "Surtitre" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Un détail qui compte" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un fait vérifiable sur le produit.</p>" },
      { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir" },
      { "type": "url", "id": "link", "label": "Lien" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Cartes empilées", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
