<section class="es-section es-clist color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2 es-section-head" data-reveal="lines">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="es-clist__grid" style="--cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{{ c.url | default: routes.collections_url }}" class="es-clist__item" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="es-media-frame es-media-frame--square">
            {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
              {% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: c.title, sizes: '(min-width: 990px) 30vw, 50vw', class: 'es-cover' %}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'es-cover', alt: c.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'es-placeholder__svg' }}
            {%- endif -%}
          </div>
          <span class="es-clist__title">{{ block.settings.title | default: c.title | default: 'Collection' }} {% render 'icon', name: 'arrow' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liste de collections",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Explorer" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Colonnes", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Titre (facultatif)" },
      { "type": "image_picker", "id": "image", "label": "Image (facultatif)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Liste de collections", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
