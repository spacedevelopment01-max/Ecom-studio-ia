{%- comment -%}
  PARENTHÈSE : liste des ateliers collectifs (planche 03) : filtres par date et par thème qui filtrent vraiment, remise à
  zéro, état « aucun atelier » ; cartes (photo, titre, étiquettes, texte, date, durée, tarif, « Voir l'atelier »).
  Date, heure, durée, tarif et places viennent des « Réglages du cabinet » (identifiant de l'atelier) : la carte et la
  fiche lisent la même donnée ; un atelier complet ou passé est signalé.
  Blocs : « Atelier ».
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="pa-section pa-workshops" data-pa-workshops>
  <div class="pa-wrap">
    <form class="pa-workshops__filters" data-pa-ws-filters>
      <label class="pa-field pa-field--select"><span>{{ s.date_label }}</span>
        <select data-pa-ws-date><option value="">{{ s.date_all }}</option></select>
      </label>
      <label class="pa-field pa-field--select"><span>{{ s.theme_label }}</span>
        <select data-pa-ws-theme>
          <option value="">{{ s.theme_all }}</option>
          {%- assign themes = '' -%}
          {%- for block in section.blocks -%}{%- unless themes contains block.settings.theme -%}{%- assign themes = themes | append: block.settings.theme | append: ',' -%}<option value="{{ block.settings.theme }}">{{ block.settings.theme_label | default: block.settings.theme }}</option>{%- endunless -%}{%- endfor -%}
        </select>
      </label>
      <button type="button" class="pa-link pa-link--plain pa-workshops__reset" data-pa-ws-reset hidden>{{ s.reset_label }}</button>
    </form>
    <p class="pa-workshops__count visually-hidden" role="status" aria-live="polite" data-pa-ws-count></p>
    <ul class="pa-workshops__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="pa-ws" data-pa-atelier="{{ b.atelier_id | escape }}" data-theme="{{ b.theme }}" {{ block.shopify_attributes }}>
          {% render 'pa-img', image: b.image, asset: b.image_asset, alt: b.image_alt, pos: b.image_position, class: 'pa-ws__img' %}
          <div class="pa-ws__body">
            <h2 class="pa-ws__title">{{ b.title }}</h2>
            {%- assign tags = b.tags | split: ',' -%}
            <ul class="pa-tags" role="list">{%- for t in tags -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}<li>{{ tt }}</li>{%- endif -%}{%- endfor -%}</ul>
            {%- if b.text != blank -%}<p class="pa-ws__text">{{ b.text | escape | newline_to_br }}</p>{%- endif -%}
            <div class="pa-ws__foot">
              <ul class="pa-meta" role="list">
                <li>{% render 'pa-icon', name: 'calendar' %}<span data-pa-f="when-abbr">{{ b.when }}</span></li>
                <li>{% render 'pa-icon', name: 'clock' %}<span data-pa-f="duration">{{ b.duration }}</span></li>
                <li>{% render 'pa-icon', name: 'tag' %}<span data-pa-f="price">{{ b.price }}</span></li>
              </ul>
              <p class="pa-ws__state" data-pa-f="state" hidden></p>
              <a class="pa-btn pa-btn--forest pa-btn--sm" href="{{ b.link }}">{{ s.button_label }}{% render 'pa-icon', name: 'arrow' %}</a>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    <div class="pa-workshops__empty" data-pa-ws-empty hidden>
      <p><strong>{{ s.empty_title }}</strong>{{ s.empty_text }}</p>
      <button type="button" class="pa-btn pa-btn--line pa-btn--sm" data-pa-ws-reset>{{ s.reset_label }}</button>
    </div>
    {%- if s.demo_note != blank -%}<p class="pa-note" data-pa-demo-note>{{ s.demo_note }}</p>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Liste des ateliers",
  "class": "pa-workshops-section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "date_label", "label": "Filtre par date : libellé", "default": "Filtrer par date" },
    { "type": "text", "id": "date_all", "label": "Filtre par date : toutes", "default": "Toutes les dates" },
    { "type": "text", "id": "theme_label", "label": "Filtre par thème : libellé", "default": "Filtrer par thème" },
    { "type": "text", "id": "theme_all", "label": "Filtre par thème : tous", "default": "Tous les thèmes" },
    { "type": "text", "id": "reset_label", "label": "Bouton de remise à zéro", "default": "Réinitialiser les filtres" },
    { "type": "text", "id": "button_label", "label": "Bouton des cartes", "default": "Voir l'atelier" },
    { "type": "text", "id": "empty_title", "label": "Sans résultat : titre", "default": "Aucun atelier ne correspond à ces filtres." },
    { "type": "text", "id": "empty_text", "label": "Sans résultat : texte", "default": " Essayez une autre date ou un autre thème." },
    { "type": "text", "id": "demo_note", "label": "Mention des dates d'exemple", "default": "Dates, tarifs et places de démonstration." }
  ],
  "blocks": [
    {
      "type": "workshop", "name": "Atelier",
      "settings": [
        { "type": "text", "id": "atelier_id", "label": "Identifiant de l'atelier", "info": "Le même que dans les « Réglages du cabinet »." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Photo fournie avec le thème" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de la photo" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Une pause dans la semaine" },
        { "type": "text", "id": "tags", "label": "Étiquettes (séparées par des virgules)" },
        { "type": "text", "id": "theme", "label": "Thème (filtre) : identifiant", "default": "relaxation" },
        { "type": "text", "id": "theme_label", "label": "Thème (filtre) : nom", "default": "Relaxation" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "when", "label": "Date affichée sans script" },
        { "type": "text", "id": "duration", "label": "Durée affichée sans script" },
        { "type": "text", "id": "price", "label": "Tarif affiché sans script" },
        { "type": "url", "id": "link", "label": "Page de l'atelier" }
      ]
    }
  ],
  "presets": [{ "name": "Liste des ateliers" }]
}
{% endschema %}
