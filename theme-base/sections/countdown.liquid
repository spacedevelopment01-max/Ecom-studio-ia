{%- comment -%}
  Compte à rebours jusqu'à une date et une heure fixes, réglées par le marchand (fuseau horaire de la boutique).
  Jamais de fausse urgence : la date ne se réinitialise pas, rien n'est calculé à partir de la visite.
  À l'échéance : la section disparaît ou affiche le message choisi (côté serveur et dans le navigateur).
{%- endcomment -%}
{%- liquid
  assign end_str = section.settings.end_date | strip
  assign end_time = section.settings.end_time | strip | default: '00:00'
  assign end_ts = 0
  if end_str != blank
    assign end_full = end_str | append: ' ' | append: end_time
    assign end_ts = end_full | date: '%s' | plus: 0
  endif
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign expired = false
  if end_ts > 0 and end_ts <= now_ts
    assign expired = true
  endif
  assign hide = false
  if expired and section.settings.on_end == 'hide'
    assign hide = true
  endif
-%}
{%- unless hide and request.design_mode == false -%}
<section class="es-section es-cdown es-cdown--{{ section.settings.style }} color-{{ section.settings.color_scheme }}{% if expired %} is-ended{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-countdown data-end="{{ end_ts }}" data-on-end="{{ section.settings.on_end }}">
  <div class="es-container es-cdown__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2 es-cdown__heading" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="es-rte es-cdown__text" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
    <div class="es-cdown__timer{% if end_ts == 0 %} is-unset{% endif %}" data-countdown-timer role="timer" aria-label="{{ 'sections.countdown.label' | t | escape }}" data-reveal="up"{% if expired %} hidden{% endif %}>
      {%- assign units = 'days,hours,minutes,seconds' | split: ',' -%}
      {%- for u in units -%}
        {%- assign key = 'sections.countdown.' | append: u -%}
        <div class="es-cdown__unit"><span class="es-cdown__num" data-cd="{{ u }}">00</span><span class="es-cdown__lab">{{ key | t }}</span></div>
        {%- unless forloop.last -%}<span class="es-cdown__sep" aria-hidden="true">:</span>{%- endunless -%}
      {%- endfor -%}
    </div>
    {%- if end_ts > 0 -%}
      <p class="es-cdown__ended es-heading es-h3" data-countdown-ended{% unless expired %} hidden{% endunless %}>{{ section.settings.end_message }}</p>
    {%- else -%}
      <p class="es-cdown__missing">{{ 'sections.countdown.missing_date' | t }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="es-actions es-actions--center" data-reveal="up"><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="es-button">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a></div>
    {%- endif -%}
  </div>
</section>
{%- endunless -%}

{% stylesheet %}
.es-cdown__inner { text-align: center; max-width: 980px; }
.es-cdown__text { max-width: 58ch; margin: 0 auto; color: var(--c-muted); }
.es-cdown__timer { display: flex; justify-content: center; align-items: flex-start; gap: clamp(6px, 1.6vw, 18px); margin-top: clamp(26px, 4vw, 44px); }
.es-cdown__timer[hidden] { display: none; }
.es-cdown__unit { display: grid; gap: 12px; justify-items: center; min-width: clamp(64px, 15vw, 140px); }
.es-cdown__num { display: block; font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: calc(clamp(2.3rem, 7.4vw, 5.4rem) * var(--heading-scale)); line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
.es-cdown--cards .es-cdown__num { width: 100%; padding: .3em .18em; border-radius: var(--radius-card); background: linear-gradient(180deg, rgba(var(--c-text-rgb), .09), rgba(var(--c-text-rgb), .04)); border: 1px solid rgba(var(--c-text-rgb), .12); box-shadow: 0 30px 60px -40px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.12); position: relative; overflow: hidden; }
.es-cdown--cards .es-cdown__num::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(var(--c-text-rgb), .1); }
.es-cdown__lab { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--c-muted); }
.es-cdown__sep { font-family: var(--font-heading); font-size: calc(clamp(1.8rem, 5vw, 3.6rem) * var(--heading-scale)); line-height: 1; padding-top: .3em; opacity: .3; }
.es-cdown--cards .es-cdown__sep { padding-top: .55em; }
.es-cdown__timer.is-unset .es-cdown__num { opacity: .55; }
.es-cdown__num.is-tick { animation: es-cd-tick .55s var(--ease-out); }
@keyframes es-cd-tick { from { transform: translateY(-.18em); opacity: .25; } to { transform: none; opacity: 1; } }
.es-cdown.is-ended .es-cdown__heading { display: none; }
.es-cdown__ended { margin: clamp(22px, 3vw, 36px) 0 0; }
.es-cdown__missing { display: inline-block; margin: 18px 0 0; padding: 8px 16px; border: 1px dashed var(--c-border); border-radius: 99px; font-size: .85rem; color: var(--c-muted); }
@media (max-width: 749px) {
  .es-cdown__sep { display: none; }
  .es-cdown__timer { gap: 8px; }
  .es-cdown__unit { min-width: 0; flex: 1; max-width: 88px; }
}
@media (prefers-reduced-motion: reduce) { .es-cdown__num.is-tick { animation: none; } }
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.__esCountdown) { window.__esCountdown(document); return; }
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var UNITS = ['days', 'hours', 'minutes', 'seconds'];
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function init(root) {
    Array.prototype.forEach.call((root || document).querySelectorAll('[data-countdown]'), function (s) {
      if (s._esCd) return; s._esCd = true;
      // Date fixe réglée par le marchand (secondes depuis 1970, fuseau de la boutique) : jamais recalculée à partir de la visite.
      var end = (parseInt(s.getAttribute('data-end'), 10) || 0) * 1000;
      if (!end) return;
      var timer = s.querySelector('[data-countdown-timer]'), ended = s.querySelector('[data-countdown-ended]');
      var els = {}; UNITS.forEach(function (k) { els[k] = s.querySelector('[data-cd="' + k + '"]'); });
      var h = 0;
      function tick() {
        var ms = end - Date.now();
        if (ms <= 0) {
          clearInterval(h);
          s.classList.add('is-ended');
          if (timer) timer.hidden = true;
          if (s.getAttribute('data-on-end') === 'hide' && !(window.Shopify && window.Shopify.designMode)) s.hidden = true;
          else if (ended) ended.hidden = false;
          return;
        }
        var t = Math.floor(ms / 1000);
        var v = { days: Math.floor(t / 86400), hours: Math.floor(t % 86400 / 3600), minutes: Math.floor(t % 3600 / 60), seconds: t % 60 };
        UNITS.forEach(function (k) {
          var el = els[k], txt = pad(v[k]);
          if (!el || el.textContent === txt) return;
          el.textContent = txt;
          if (!reduce) { el.classList.remove('is-tick'); void el.offsetWidth; el.classList.add('is-tick'); }
        });
      }
      tick();
      h = setInterval(tick, 1000);
    });
  }
  window.__esCountdown = init;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); }); else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Compte à rebours",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Pas de fausse urgence : indiquez la date réelle de fin de votre offre ou de votre lancement. Le compteur ne se réinitialise jamais." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'offre se termine dans" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>[À compléter : l'offre réelle, ses conditions et sa date de fin.]</p>" },
    { "type": "text", "id": "end_date", "label": "Date de fin (AAAA-MM-JJ)", "info": "Exemple : 2026-12-24. Heure du fuseau horaire de votre boutique." },
    { "type": "text", "id": "end_time", "label": "Heure de fin (HH:MM)", "default": "23:59" },
    { "type": "select", "id": "on_end", "label": "À l'échéance", "default": "message", "options": [{ "value": "message", "label": "Afficher un message" }, { "value": "hide", "label": "Masquer la section" }] },
    { "type": "text", "id": "end_message", "label": "Message de fin", "default": "Cette offre est terminée." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "style", "label": "Style", "default": "cards", "options": [{ "value": "cards", "label": "Cartes" }, { "value": "minimal", "label": "Minimal" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "presets": [{ "name": "Compte à rebours" }]
}
{% endschema %}
