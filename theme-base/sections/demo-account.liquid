{%- comment -%}
  Espace client d'une boutique de démonstration (MUSEAU CLUB, planche 08 du 23 octobre) : connexion, création de compte,
  mot de passe oublié, accueil du compte, détail d'une commande, adresses et informations personnelles, reliés entre
  eux dans la même charte. Rien n'est envoyé : les champs sont désactivés et la commande est un exemple (blocs
  « ligne »). Sur une vraie boutique, ces écrans sont ceux des comptes clients de Shopify (modèles « customers/* » du
  thème pour les comptes classiques ; les nouveaux comptes clients sont des pages de Shopify, hors thème).
  NOCTIL (planche 06 du 23 octobre) : entrée « Aperçu » dans le menu (avec un pictogramme par entrée, menu aussi sur le
  détail de commande) et cartes libres (blocs « Carte ») : mise en avant, facture d'exemple, aide.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign layout = s.layout | default: 'login'
  assign subtotal = 0
  for block in section.blocks
    if block.type != 'line'
      continue
    endif
    assign lp = all_products[block.settings.product] | default: block.settings.product
    if lp.title != blank
      assign lq = block.settings.quantity | default: 1
      assign lt = lp.price | times: lq
      assign subtotal = subtotal | plus: lt
    endif
  endfor
-%}
{%- capture lines -%}
  <ul class="es-acct__lines" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type != 'line' -%}{%- continue -%}{%- endif -%}
      {%- assign lp = all_products[block.settings.product] | default: block.settings.product -%}
      {%- if lp.title != blank -%}
        {%- assign lq = block.settings.quantity | default: 1 -%}
        <li class="es-acct__line" {{ block.shopify_attributes }}>
          <span class="es-acct__thumb">{%- if lp.featured_media -%}{{ lp.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: lp.title }}{%- endif -%}</span>
          <span class="es-acct__line-info"><strong>{{ lp.title | escape }}</strong><span>{{ s.quantity_label | escape }} {{ lq }}</span></span>
          <span class="es-acct__price">{% if settings.price_trim_zeros %}{{ lp.price | times: lq | money_without_trailing_zeros }}{% else %}{{ lp.price | times: lq | money }}{% endif %}{%- if s.price_note != blank -%}<small>{{ s.price_note | escape }}</small>{%- endif -%}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
  <dl class="es-acct__totals">
    <div><dt>{{ s.subtotal_label | escape }}</dt><dd>{% if settings.price_trim_zeros %}{{ subtotal | money_without_trailing_zeros }}{% else %}{{ subtotal | money }}{% endif %}</dd></div>
    <div><dt>{{ s.shipping_label | escape }}</dt><dd>{{ s.unknown_value | escape }}</dd></div>
  </dl>
{%- endcapture -%}
{%- capture cards_before -%}{%- for block in section.blocks -%}{%- if block.type == 'card' and block.settings.style == 'promo' -%}{% render 'demo-account-card', block: block %}{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- capture cards_after -%}{%- for block in section.blocks -%}{%- if block.type == 'card' and block.settings.style != 'promo' -%}{% render 'demo-account-card', block: block %}{%- endif -%}{%- endfor -%}{%- endcapture -%}
<section class="es-section es-acct es-acct--{{ layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="es-container">
    {%- case layout -%}
      {%- when 'login', 'register', 'recover' -%}
        <div class="es-acct__auth">
          <div class="es-acct__auth-copy">
            <h1 class="es-heading es-acct__title">{{ s.heading | escape | newline_to_br }}</h1>
            {%- if s.text != blank -%}<div class="es-rte es-acct__text">{{ s.text }}</div>{%- endif -%}
            <form class="es-acct__card" action="#" onsubmit="return false" aria-describedby="AcctDemo-{{ section.id }}">
              <p class="es-acct__demo" id="AcctDemo-{{ section.id }}">{{ s.demo_note | escape }}</p>
              <fieldset class="es-acct__fields" disabled>
                <legend class="visually-hidden">{{ s.heading | escape }}</legend>
                {%- if layout == 'register' -%}
                  <label class="es-acct__field"><span>{{ 'customer.register.first_name' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field"><span>{{ 'customer.register.last_name' | t }}</span><input type="text" autocomplete="off"></label>
                {%- endif -%}
                <label class="es-acct__field"><span>{{ s.email_label | escape }}</span><input type="email" autocomplete="off" placeholder="{{ s.email_placeholder | escape }}"></label>
                {%- unless layout == 'recover' -%}<label class="es-acct__field"><span>{{ 'customer.login.password' | t }}</span><input type="password" autocomplete="off"></label>{%- endunless -%}
              </fieldset>
              {%- if layout == 'login' and s.recover_link != blank -%}<p class="es-acct__aside"><a href="{{ s.recover_link }}">{{ 'customer.login.forgot' | t }}</a></p>{%- endif -%}
              {%- if s.button_label != blank -%}<a class="es-button es-acct__primary" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>{%- endif -%}
              {%- if s.secondary_label != blank -%}
                {%- if layout == 'login' -%}<p class="es-acct__or"><span>{{ 'customer.login.or' | t }}</span></p>{%- endif -%}
                <a class="es-button es-button--secondary es-acct__secondary" href="{{ s.secondary_link | default: '#' }}">{{ s.secondary_label | escape }}</a>
              {%- endif -%}
            </form>
          </div>
          {%- if s.image != blank or s.image_asset != blank -%}<div class="es-acct__photo">{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, focus_x: s.focus_x, focus_y: s.focus_y %}</div>{%- endif -%}
        </div>
      {%- when 'order' -%}
        {%- if s.overview_label != blank -%}<div class="es-acct__grid">{% render 'demo-account-menu', s: s, layout: layout %}<div class="es-acct__main">{%- endif -%}
        {%- if s.back_label != blank -%}<p class="es-acct__back"><a href="{{ s.account_link | default: '#' }}">{% render 'icon', name: 'arrow-left' %} {{ s.back_label | escape }}</a></p>{%- endif -%}
        <header class="es-acct__head es-acct__head--order">
          <h1 class="es-heading es-acct__title">{{ s.heading | escape }}</h1>
          {%- if s.pill != blank -%}<span class="es-acct__pill">{{ s.pill | escape }}</span>{%- endif -%}
          {%- if s.text != blank -%}<div class="es-rte es-acct__text">{{ s.text }}</div>{%- endif -%}
        </header>
        <p class="es-acct__notice">{% render 'icon', name: 'cart' %}<span><strong>{{ s.notice_title | escape }}</strong> {{ s.demo_note | escape }}</span></p>
        <div class="es-acct__card">
          <h2 class="es-acct__card-title">{{ s.lines_title | escape }}</h2>
          {{ lines }}
        </div>
        <div class="es-acct__duo">
          <div class="es-acct__card"><h2 class="es-acct__card-title">{{ 'customer.orders.shipping' | t }}</h2><p>{{ s.unknown_value | escape }}</p></div>
          <div class="es-acct__card"><h2 class="es-acct__card-title">{{ s.payment_title | escape }}</h2><p>{{ s.unknown_value | escape }}</p></div>
        </div>
        {{ cards_before }}{{ cards_after }}
        {%- if s.overview_label != blank -%}</div></div>{%- endif -%}
      {%- else -%}
        <header class="es-acct__head">
          <h1 class="es-heading es-acct__title">{{ s.heading | escape | newline_to_br }}</h1>
          {%- if s.text != blank -%}<div class="es-rte es-acct__text">{{ s.text }}</div>{%- endif -%}
        </header>
        <div class="es-acct__grid">
          {% render 'demo-account-menu', s: s, layout: layout %}
          <div class="es-acct__main">
            <p class="es-acct__demo">{{ s.demo_note | escape }}</p>
            {{ cards_before }}
            {%- if layout == 'account' -%}
              <h2 class="es-heading es-acct__subtitle">{{ s.orders_label | escape }}</h2>
              <a class="es-acct__card es-acct__order" href="{{ s.order_link | default: '#' }}">
                <span class="es-acct__order-head"><strong>{{ s.order_title | escape }}</strong>{%- if s.pill != blank -%}<span class="es-acct__pill">{{ s.pill | escape }}</span>{%- endif -%}{% render 'icon', name: 'arrow' %}</span>
                {{ lines }}
              </a>
              {%- if s.empty_text != blank -%}<p class="es-acct__empty">{{ s.empty_text | escape }}</p>{%- endif -%}
            {%- elsif layout == 'addresses' -%}
              <h2 class="es-heading es-acct__subtitle">{{ 'customer.addresses.title' | t }}</h2>
              <div class="es-acct__card"><p>{{ s.empty_text | escape }}</p>
                <fieldset class="es-acct__fields es-acct__fields--two" disabled>
                  <legend>{{ 'customer.orders.shipping' | t }}</legend>
                  <label class="es-acct__field"><span>{{ 'customer.register.first_name' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field"><span>{{ 'customer.register.last_name' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field es-acct__field--full"><span>{{ 'customer.addresses.address1' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field"><span>{{ 'customer.addresses.zip' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field"><span>{{ 'customer.addresses.city' | t }}</span><input type="text" autocomplete="off"></label>
                </fieldset>
              </div>
            {%- else -%}
              <h2 class="es-heading es-acct__subtitle">{{ s.infos_label | escape }}</h2>
              <div class="es-acct__card">
                <fieldset class="es-acct__fields es-acct__fields--two" disabled>
                  <legend class="visually-hidden">{{ s.infos_label | escape }}</legend>
                  <label class="es-acct__field"><span>{{ 'customer.register.first_name' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field"><span>{{ 'customer.register.last_name' | t }}</span><input type="text" autocomplete="off"></label>
                  <label class="es-acct__field es-acct__field--full"><span>{{ s.email_label | escape }}</span><input type="email" autocomplete="off" placeholder="{{ s.email_placeholder | escape }}"></label>
                </fieldset>
              </div>
            {%- endif -%}
            {{ cards_after }}
          </div>
        </div>
    {%- endcase -%}
  </div>
</section>

