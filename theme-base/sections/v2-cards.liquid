{%- comment -%}
  Cartes illustrées (Theme Engine V2) : collections, produits, catégories ou prestations, chacune avec sa photo.
  below (légende sous la photo), overlay (texte posé sur la photo), numbered (01 — titre, texte, lien), tiles (aplats
  de couleur avec le produit au centre). Une carte sans photo n'est jamais affichée avec un cadre vide.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="v2-cards v2-cards--{{ s.layout }} color-{{ s.color_scheme }}" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --cols: {{ s.columns }};">
  <div class="es-container">
    {%- if s.heading != blank or s.eyebrow != blank or s.intro != blank -%}
      <header class="v2-head v2-cards__head">
        <div>
          {%- if s.eyebrow != blank -%}<p class="v2-eyebrow" data-reveal="up">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="v2-h2" data-reveal="up">{{ s.heading }}</h2>{%- endif -%}
        </div>
        {%- if s.intro != blank -%}<div class="v2-intro" data-reveal="up" style="--d: 1">{{ s.intro }}</div>{%- endif -%}
        {%- if s.link_label != blank -%}<a class="v2-link v2-cards__all" href="{{ s.link | default: '#' }}" data-reveal="up">{{ s.link_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </header>
    {%- endif -%}
    <ul class="v2-cards__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="v2-cards__item" data-reveal="up" style="--i: {{ forloop.index0 }};{% if b.tile_color != blank %} --tile: {{ b.tile_color }};{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a class="v2-cards__link" href="{{ b.link }}" aria-label="{{ b.title | escape }}"></a>{%- endif -%}
          {%- if b.image != blank or b.image_asset != blank -%}
            <div class="v2-cards__media">{% render 'es-image', image: b.image, asset: b.image_asset, alt: b.title, class: s.fit, sizes: '(min-width: 990px) 33vw, 90vw' %}</div>
          {%- endif -%}
          <div class="v2-cards__body">
            {%- if s.layout == 'numbered' -%}<span class="v2-cards__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{%- endif -%}
            <div class="v2-cards__text">
              {%- if b.kicker != blank -%}<p class="v2-cards__kicker">{{ b.kicker }}</p>{%- endif -%}
              <h3 class="v2-h3">{{ b.title }}</h3>
              {%- if b.text != blank -%}<div class="v2-cards__desc">{{ b.text }}</div>{%- endif -%}
              {%- if b.link_label != blank -%}<span class="v2-cards__cta">{{ b.link_label }}{% render 'icon', name: 'arrow' %}</span>{%- endif -%}
            </div>
            {%- if s.layout == 'overlay' and b.link != blank -%}<span class="v2-cards__round" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Cartes illustrées",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition", "default": "below", "options": [
      { "value": "below", "label": "Légende sous la photo" },
      { "value": "overlay", "label": "Texte sur la photo" },
      { "value": "numbered", "label": "Numérotées (01, 02, 03)" },
      { "value": "tiles", "label": "Aplats de couleur" }
    ] },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Colonnes (ordinateur)", "default": 3 },
    { "type": "select", "id": "fit", "label": "Cadrage des photos", "default": "v2-cover", "options": [
      { "value": "v2-cover", "label": "Remplir le cadre" },
      { "value": "v2-contain", "label": "Image entière" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Notre sélection" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "link_label", "label": "Lien « tout voir »" },
    { "type": "url", "id": "link", "label": "Adresse du lien « tout voir »" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "card", "name": "Carte", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "kicker", "label": "Surtitre de la carte" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Titre de la carte" },
      { "type": "richtext", "id": "text", "label": "Texte" },
      { "type": "text", "id": "link_label", "label": "Libellé du lien" },
      { "type": "url", "id": "link", "label": "Lien" },
      { "type": "color", "id": "tile_color", "label": "Couleur de l'aplat", "info": "Composition « Aplats de couleur »." }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Cartes illustrées", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
