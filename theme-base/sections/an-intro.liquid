{%- comment -%}
  ATELIER NUANCE : présentation « Plus qu'un salon, une expérience sur mesure », texte, filet et trois cartes photo
  (Un cadre apaisant, Des détails qui comptent, Une approche personnalisée) — Le salon, planche 03.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="an-section an-intro">
  <div class="an-wrap">
    <div class="an-intro__head">
      {%- if s.heading != blank -%}<h2 class="an-title an-title--lg">{{ s.heading | escape | newline_to_br }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="an-text">{{ s.text }}</div>{%- endif -%}
      {%- if s.rule -%}<hr class="an-rule">{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="an-intro__cards" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="an-intro__card" {{ block.shopify_attributes }}>
            {% render 'an-img', image: b.image, asset: b.image_asset, alt: b.image_alt, pos: b.image_position %}
            <h3 class="an-intro__card-title">{{ b.heading }}</h3>
            {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Présentation du salon",
  "class": "an-intro-section",
  "max_blocks": 4,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Plus qu'un salon,\nune expérience sur mesure" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "rule", "label": "Filet sous le texte", "default": true }
  ],
  "blocks": [
    {
      "type": "card", "name": "Carte",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif de l'image" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Un cadre apaisant" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Présentation du salon" }]
}
{% endschema %}
