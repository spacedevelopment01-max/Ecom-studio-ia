{%- comment -%}
  SILLON V2 : « Carnet d'échappées » (planche 02) — ouverture vert grisé à courbes de niveau, très grand titre, phrase à
  chasse fixe et filtres en capsules (Tout / catégories) qui filtrent vraiment ; grille asymétrique de cinq articles
  (vedette en L, colonne de droite, rangée de trois), numéros cuivre, titres condensés, flèches en cercle ; état vide.
  Blocs : « Article ».
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="sv sv-journal" data-sv-journal>
  <div class="sv-c">
    <div class="sv-journal__head">
      <span class="sv-topo sv-topo--field sv-journal__topo" aria-hidden="true"></span>
      <h1 class="sv-display sv-journal__title">{{ s.heading | escape | newline_to_br }}</h1>
      {%- if s.text != blank -%}<p class="sv-mono sv-journal__phrase">{{ s.text | escape | newline_to_br }}</p>{%- endif -%}
      <div class="sv-journal__filters" role="group" aria-label="{{ s.filters_label | escape }}">
        <button type="button" class="sv-pill is-active" aria-pressed="true" data-sv-filter="">{{ s.all_label }}</button>
        {%- assign cats = s.categories | split: ',' -%}
        {%- for c in cats -%}{%- assign cc = c | strip -%}{%- if cc != blank -%}<button type="button" class="sv-pill" aria-pressed="false" data-sv-filter="{{ cc | handleize }}">{{ cc }}</button>{%- endif -%}{%- endfor -%}
      </div>
    </div>
    <ul class="sv-journal__grid" role="list" data-sv-grid>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="sv-entry sv-entry--{{ forloop.index }}" data-cat="{{ b.category | handleize }}" {{ block.shopify_attributes }}>
          <a class="sv-entry__media" href="{{ b.link | default: '#' }}" tabindex="-1" aria-hidden="true">{% render 'sv-img', image: b.image, asset: b.image_asset, alt: '', pos: b.image_position, zoom: b.image_zoom, pos_mobile: b.image_position_mobile, zoom_mobile: b.image_zoom_mobile %}</a>
          <div class="sv-entry__body">
            <span class="sv-display sv-entry__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h2 class="sv-display sv-entry__title"><a href="{{ b.link | default: '#' }}">{{ b.title | escape | newline_to_br }}</a></h2>
            {%- if b.text != blank -%}<p class="sv-mono sv-entry__text">{{ b.text | escape | newline_to_br }}</p>{%- endif -%}
            <a class="sv-circle sv-circle--dark-line sv-entry__arrow" href="{{ b.link | default: '#' }}" tabindex="-1" aria-hidden="true">{% render 'sv-icon', name: 'arrow' %}</a>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    <p class="sv-journal__empty" data-sv-empty hidden>{{ s.empty_label }}</p>
    <p class="visually-hidden" role="status" aria-live="polite" data-sv-count-status></p>
  </div>
</section>

{% schema %}
{
  "name": "Carnet d'échappées",
  "class": "sv-journal-section",
  "max_blocks": 12,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "Carnet\nd'échappées." },
    { "type": "textarea", "id": "text", "label": "Phrase à chasse fixe", "default": "Des lieux,\ndes histoires,\net toujours\nun bon café." },
    { "type": "text", "id": "categories", "label": "Catégories (séparées par des virgules)", "default": "Sur la route, Le café, Entretien" },
    { "type": "text", "id": "all_label", "label": "Filtre « tout »", "default": "Tout" },
    { "type": "text", "id": "filters_label", "label": "Nom des filtres (lecteurs d'écran)", "default": "Filtrer les articles" },
    { "type": "text", "id": "empty_label", "label": "Aucun article", "default": "Aucun article dans cette catégorie pour le moment." }
  ],
  "blocks": [
    {
      "type": "entry", "name": "Article",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
        { "type": "text", "id": "image_position", "label": "Cadrage", "default": "50% 50%" },
        { "type": "text", "id": "image_position_mobile", "label": "Cadrage au téléphone", "info": "Vide : le même cadrage." },
        { "type": "range", "id": "image_zoom_mobile", "label": "Agrandissement au téléphone", "min": 100, "max": 300, "step": 2, "unit": "%", "default": 100 },
        { "type": "range", "id": "image_zoom", "label": "Agrandissement", "min": 100, "max": 200, "step": 2, "unit": "%", "default": 100 },
        { "type": "textarea", "id": "title", "label": "Titre", "default": "Le café en van" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "category", "label": "Catégorie (une de la liste)", "default": "Sur la route" },
        { "type": "url", "id": "link", "label": "Page de l'article" }
      ]
    }
  ],
  "presets": [{ "name": "Carnet d'échappées" }]
}
{% endschema %}
