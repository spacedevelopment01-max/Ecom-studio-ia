{%- comment -%}
  Page panier. Mêmes réglages globaux « Panier » que le panier latéral (titre et compteur, bandeau, réservation marquée
  « Démonstration fictive », code de réduction appliqué au paiement, économies, total avec nombre d'articles, libellé et
  cadenas du bouton, logos de paiement confirmés, protection des expéditions visuelle, invitation à se connecter).
{%- endcomment -%}
{%- liquid
  assign cart_title = settings.cart_heading
  if cart_title == blank
    assign cart_title = 'cart.title' | t
  endif
  assign empty_title = settings.cart_empty_title
  if empty_title == blank
    assign empty_title = 'cart.empty' | t
  endif
  assign checkout_label = settings.cart_checkout_label
  if checkout_label == blank
    assign checkout_label = 'cart.checkout' | t
  endif
  assign original_total = 0
  for item in cart.items
    assign ref = item.variant.compare_at_price | default: 0
    if ref < item.variant.price
      assign ref = item.variant.price
    endif
    assign line_ref = ref | times: item.quantity
    assign original_total = original_total | plus: line_ref
  endfor
  assign savings = original_total | minus: cart.total_price
  assign preview = false
  if request.host == 'apercu'
    assign preview = true
  endif
-%}
{%- liquid
  assign cart_scheme = section.settings.color_scheme
  if settings.cart_color_scheme != blank and settings.cart_color_scheme != 'scheme-1'
    assign cart_scheme = settings.cart_color_scheme
  endif
-%}
<section class="es-section es-cart color-{{ cart_scheme }}" style="--pt: 48px; --pb: 96px;" data-cart-page>
  <div class="es-container">
    <h1 class="es-heading es-h1 es-cart__title">{{ cart_title }}{% if settings.cart_show_count and cart.item_count > 0 %} <span class="es-drawer__count" aria-label="{{ 'cart.items_badge' | t: count: cart.item_count }}">{{ cart.item_count }}</span>{% endif %}</h1>
    {%- if section.settings.intro != blank and cart.item_count > 0 -%}<p class="es-cart__intro es-muted">{{ section.settings.intro | escape }}</p>{%- endif -%}
    {%- if cart.item_count == 0 -%}
      <div class="es-cart__empty{% if section.settings.empty_image != blank or section.settings.empty_image_asset != blank %} es-cart__empty--media{% endif %}">
        {%- if section.settings.empty_image != blank or section.settings.empty_image_asset != blank -%}<div class="es-cart__empty-media">{% render 'ed-media', image: section.settings.empty_image, asset: section.settings.empty_image_asset, alt: '' %}</div>{%- endif -%}
        <p class="es-lead es-cart__empty-title">{{ section.settings.empty_heading | default: empty_title }}</p>
        {%- if section.settings.empty_text != blank -%}<p class="es-cart__empty-text es-muted">{{ section.settings.empty_text | escape }}</p>{%- endif -%}
        <a href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}" class="es-button">{% if section.settings.empty_button_label != blank %}{{ section.settings.empty_button_label | escape }}{% else %}{{ 'cart.continue' | t }}{% endif %}</a>
        {%- if settings.cart_show_login and shop.customer_accounts_enabled -%}
          <p class="es-drawer__login"><span>{{ 'cart.have_account' | t }}</span><br><a href="{{ routes.account_login_url }}">{{ 'cart.login' | t }}</a> {{ 'cart.login_faster' | t }}</p>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- if settings.cart_reservation -%}
        <p class="es-drawer__band es-drawer__band--reserve" data-cart-reserve data-minutes="{{ settings.cart_reservation_minutes | default: 10 }}" data-template="{{ 'cart.reserved' | t: time: '%' | escape }}">
          <span data-cart-reserve-text>{{ 'cart.reserved' | t: time: settings.cart_reservation_minutes | append: ' min' }}</span>
          <small class="es-drawer__fictional">{{ 'cart.demo_fictional' | t }}</small>
        </p>
      {%- endif -%}
      {%- if settings.cart_promo_text != blank -%}<p class="es-drawer__band es-drawer__band--promo">{{ settings.cart_promo_text | escape }}</p>{%- endif -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="es-cart__grid">
        <ul role="list" class="es-line-items es-line-items--page">
          {%- for item in cart.items -%}
            {%- liquid
              assign item_ref = item.variant.compare_at_price | default: 0
              if item_ref < item.variant.price
                assign item_ref = item.variant.price
              endif
              assign item_original = item_ref | times: item.quantity
              assign item_saving = item_original | minus: item.final_line_price
            -%}
            <li class="es-line-item" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="es-line-item__media">{%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}</a>
              <div class="es-line-item__info">
                <a href="{{ item.url }}" class="es-line-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="es-muted es-small">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="es-small">{{ item.final_price | money }}</p>
                <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'products.product.quantity' | t }}</label>
                <input class="es-qty-input" id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-cart-qty="{{ item.key }}"{% if item.properties._es_gift %} disabled{% endif %}>
                {% if item.properties._es_gift %}<input type="hidden" name="updates[]" value="{{ item.quantity }}">{% endif %}
              </div>
              <div class="es-line-item__total">{% if item_saving > 0 %}<s class="es-line-item__compare"><span class="visually-hidden">{{ 'cart.compare_price' | t }} </span>{{ item_original | money }}</s> {% endif %}{{ item.final_line_price | money }}{% if item_saving > 0 and settings.cart_show_savings %}<span class="es-line-item__saving">{{ 'purchase.save' | t }} {{ item_saving | money }}</span>{% endif %}</div>
              {% unless item.properties._es_gift %}<a href="{{ item.url_to_remove }}" class="es-line-item__remove es-link-button">{{ 'cart.remove' | t }}</a>{% else %}<span class="es-small">{{ 'purchase.gift' | t }}</span>{% endunless %}
            </li>
          {%- endfor -%}
        </ul>
        <aside class="es-cart__summary">
          {%- if settings.cart_show_note -%}
            <label for="CartNote" class="es-small">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" name="note" class="es-textarea">{{ cart.note }}</textarea>
          {%- endif -%}
          {%- if settings.cart_protection -%}
            <div class="es-drawer__protect" data-cart-protect>
              <span class="es-drawer__protect-icon" aria-hidden="true">{% render 'icon', name: 'shield' %}</span>
              <div class="es-drawer__protect-copy">
                <strong>{{ settings.cart_protection_title | escape }}</strong>
                <p class="es-small">{{ settings.cart_protection_text | escape }}</p>
                <p class="es-small es-drawer__protect-note" data-cart-protect-note hidden>{{ 'cart.protection_demo' | t }}</p>
              </div>
              <button type="button" class="es-switch" role="switch" aria-checked="false" data-cart-protect-toggle aria-label="{{ settings.cart_protection_title | escape }}"><span class="es-switch__knob"></span></button>
            </div>
          {%- endif -%}
          {%- if settings.cart_discount_code -%}
            <div class="es-drawer__discount" data-cart-discount data-preview="{{ preview }}" data-discount-url="{{ routes.root_url }}discount">
              <label class="visually-hidden" for="CartPageDiscount">{{ 'cart.discount_label' | t }}</label>
              <input id="CartPageDiscount" type="text" autocomplete="off" placeholder="{{ 'cart.discount_label' | t }}" data-cart-discount-input>
              <button type="button" class="es-button es-button--secondary es-button--small" data-cart-discount-apply>{{ 'cart.discount_apply' | t }}</button>
              <p class="es-small es-muted es-drawer__discount-note" data-cart-discount-note hidden>{% if preview %}{{ 'cart.discount_demo' | t }}{% else %}{{ 'cart.discount_redirect' | t }}{% endif %}</p>
            </div>
          {%- endif -%}
          {%- if settings.cart_show_savings and savings > 0 -%}
            <div class="es-drawer__row es-drawer__savings"><span>{{ 'cart.savings' | t }}</span><strong class="es-drawer__savings-tag">{% render 'icon', name: 'gift' %}−{{ savings | money }}</strong></div>
          {%- endif -%}
          <div class="es-drawer__total es-drawer__row"><span>{% if settings.cart_total_count %}{{ 'cart.total_items' | t: count: cart.item_count }}{% else %}{{ 'cart.subtotal' | t }}{% endif %}</span><strong>{% if settings.cart_show_savings and savings > 0 %}<s class="es-drawer__compare">{{ original_total | money }}</s> {% endif %}{{ cart.total_price | money }}</strong></div>
          <p class="es-muted es-small">{{ 'cart.taxes_and_shipping' | t }}</p>
          <button type="submit" name="update" class="es-button es-button--secondary es-button--full">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="es-button es-button--full es-drawer__checkout">{% if settings.cart_checkout_lock %}<svg class="es-icon es-icon--lock" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>{% endif %}<span>{{ checkout_label }}</span></button>
          {%- if additional_checkout_buttons -%}<div class="es-cart__extra">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
          {%- if settings.cart_reassurance != blank -%}<p class="es-small es-center es-drawer__guarantee">{% render 'icon', name: 'shield' %}<span>{{ settings.cart_reassurance }}</span></p>{%- endif -%}
          {%- if settings.cart_show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <ul class="es-drawer__payments" role="list" aria-label="{{ 'cart.payment_methods' | t }}">
              {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'es-payment-icon' }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Textes de la page panier"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Phrase sous le titre",
      "info": "Ex. « Vérifiez votre sélection avant de passer commande. »"
    },
    {
      "type": "header",
      "content": "Panier vide"
    },
    {
      "type": "image_picker",
      "id": "empty_image",
      "label": "Image du panier vide"
    },
    {
      "type": "text",
      "id": "empty_image_asset",
      "label": "Image du panier vide (fichier du thème)"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Titre du panier vide",
      "info": "Vide : le titre du panier vide des réglages du thème."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Texte du panier vide"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Bouton du panier vide",
      "info": "Vide : « Continuer mes achats »."
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Destination du bouton du panier vide"
    }
  ]
}
{% endschema %}
