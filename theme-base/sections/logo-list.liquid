{%- comment -%}
  Logos et partenaires : uniquement des logos fournis par le marchand (partenaires réels, avec autorisation).
  Bloc sans logo : espace réservé visuel, jamais de logo inventé.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
  if layout == 'marquee'
    assign copies = 4
  else
    assign copies = 1
  endif
-%}
<section class="es-section es-logos es-logos--{{ layout }}{% if section.settings.grayscale %} es-logos--mono{% endif %}{% if section.settings.tiles %} es-logos--tiles{% endif %} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --logo-h: {{ section.settings.logo_height }}px; --cols: {{ section.settings.columns }}; --dur: {{ section.settings.speed }}s;" data-logo-list>
  <div class="es-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <header class="es-logos__head">
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h3" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="es-rte es-muted" data-reveal="up">{{ section.settings.text }}</div>{%- endif -%}
      </header>
    {%- endif -%}
  </div>
  <div class="{% if layout == 'marquee' %}es-logos__marquee{% else %}es-container{% endif %}" data-reveal="up">
    <div class="es-logos__viewport"><div class="es-logos__rail" style="--copies: {{ copies }};">
      {%- for n in (1..copies) -%}
        <ul class="es-logos__list" role="list"{% if n > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              assign name = block.settings.name | strip
              assign has_logo = false
              if block.settings.image != blank or block.settings.image_asset != blank
                assign has_logo = true
              endif
            -%}
            <li class="es-logos__item{% unless has_logo %} is-empty{% endunless %}" style="--i: {{ forloop.index0 }}"{% if n == 1 %} {{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.link != blank -%}<a class="es-logos__link" href="{{ block.settings.link }}"{% if section.settings.new_tab %} target="_blank" rel="noopener"{% endif %}{% if n > 1 %} tabindex="-1"{% endif %} aria-label="{{ name | default: block.settings.image.alt | escape }}">{%- endif -%}
              {%- if has_logo -%}
                {% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: name, sizes: '240px', class: 'es-logos__img', width: 480, height: 240 %}
              {%- elsif name != blank -%}
                <span class="es-logos__wordmark">{{ name }}</span>
              {%- else -%}
                <span class="es-logos__ph">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="m3.5 15 4.5-4 3.5 3 3-2.5 6 4.5"/><circle cx="15.5" cy="9.5" r="1.4"/></svg>
                  <span>{{ 'sections.logo_list.placeholder' | t }}</span>
                </span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div></div>
    {%- if layout == 'marquee' and section.blocks.size > 0 -%}
      <button type="button" class="es-logos__toggle" data-logos-toggle aria-pressed="false" aria-label="{{ 'general.pause' | t | escape }}" data-label-pause="{{ 'general.pause' | t | escape }}" data-label-play="{{ 'general.play' | t | escape }}">
        <svg class="es-logos__i-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/></svg>
        <svg class="es-logos__i-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
      </button>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.es-logos__head { text-align: center; max-width: 720px; margin: 0 auto clamp(24px, 3.5vw, 44px); }
.es-logos__head .es-heading { margin-bottom: .35em; }
.es-logos__list { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: clamp(14px, 3vw, 40px); }
.es-logos__item { flex: none; display: grid; place-items: center; min-height: calc(var(--logo-h) + 36px); min-width: calc(var(--logo-h) * 2.6); padding: 14px 18px; border-radius: var(--radius-card, 16px); transition: background .4s, transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
.es-logos__link { display: grid; place-items: center; width: 100%; height: 100%; text-decoration: none; color: inherit; border-radius: inherit; }
.es-logos__img { height: var(--logo-h); width: auto; max-width: min(200px, 100%); object-fit: contain; transition: filter .5s var(--ease-out), opacity .5s var(--ease-out), transform .5s var(--ease-out); }
.es-logos__wordmark { font-family: var(--font-heading); font-size: calc(var(--logo-h) * .5); letter-spacing: .04em; white-space: nowrap; transition: opacity .4s; }
.es-logos__ph { display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; min-height: var(--logo-h); border: 1.5px dashed rgba(var(--c-text-rgb), .28); border-radius: 12px; color: var(--c-muted); font-size: .82rem; letter-spacing: .02em; white-space: nowrap; background: repeating-linear-gradient(135deg, transparent 0 10px, rgba(var(--c-text-rgb), .025) 10px 20px); }
.es-logos--mono .es-logos__img { filter: grayscale(1) contrast(1.05); opacity: .62; }
.es-logos--mono .es-logos__wordmark { opacity: .62; }
.es-logos__item:hover .es-logos__img, .es-logos__item:focus-within .es-logos__img { filter: none; opacity: 1; transform: scale(1.04); }
.es-logos__item:hover .es-logos__wordmark, .es-logos__item:focus-within .es-logos__wordmark { opacity: 1; }
.es-logos--tiles .es-logos__item { background: rgba(var(--c-text-rgb), .035); border: 1px solid var(--c-border); }
.es-logos--tiles .es-logos__item:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -26px rgba(var(--c-text-rgb), .45); }
/* Grille */
.es-logos--grid .es-logos__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
@media (min-width: 750px) { .es-logos--grid .es-logos__list { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 16px; } }
.es-logos--grid .es-logos__item, .es-logos--row .es-logos__item { min-width: 0; }
.es-logos--grid .es-logos__ph { white-space: normal; text-align: center; justify-content: center; }
/* Rangée centrée */
.es-logos--row .es-logos__list { flex-wrap: wrap; justify-content: center; }
/* Défilement continu */
.es-logos__marquee { position: relative; padding-bottom: 46px; }
.es-logos--marquee .es-logos__viewport { overflow: hidden; padding-block: 6px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); }
.es-logos--marquee .es-logos__rail { display: flex; width: max-content; animation: es-logos-run var(--dur, 40s) linear infinite; }
.es-logos--marquee .es-logos__list { padding-right: clamp(14px, 3vw, 40px); }
.es-logos--marquee:hover .es-logos__rail, .es-logos--marquee:focus-within .es-logos__rail, .es-logos.is-paused .es-logos__rail { animation-play-state: paused; }
@keyframes es-logos-run { to { transform: translateX(calc(-100% / var(--copies, 4))); } }
.es-logos__toggle { position: absolute; right: max(var(--gutter), 12px); bottom: 4px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--c-border); background: var(--c-bg); color: var(--c-text); cursor: pointer; opacity: .55; transition: opacity .3s; z-index: 2; }
.es-logos__toggle:hover, .es-logos__toggle:focus-visible { opacity: 1; }
.es-logos__i-play, .es-logos.is-paused .es-logos__i-pause { display: none; }
.es-logos.is-paused .es-logos__i-play { display: block; }
@media (prefers-reduced-motion: reduce) {
  .es-logos--marquee .es-logos__rail { animation: none; width: auto; justify-content: center; flex-wrap: wrap; padding-inline: var(--gutter); }
  .es-logos--marquee .es-logos__list { flex-wrap: wrap; justify-content: center; padding: 0; }
  .es-logos--marquee .es-logos__list[aria-hidden] { display: none; }
  .es-logos__toggle { display: none; }
  .es-logos__marquee { padding-bottom: 0; }
  .es-logos--marquee .es-logos__viewport { -webkit-mask-image: none; mask-image: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.esLogoList) return; window.esLogoList = true;
  function init(root) {
    Array.prototype.forEach.call((root || document).querySelectorAll('[data-logo-list]'), function (s) {
      if (s._es) return; s._es = true;
      var b = s.querySelector('[data-logos-toggle]'); if (!b) return;
      b.addEventListener('click', function () {
        var paused = s.classList.toggle('is-paused');
        b.setAttribute('aria-pressed', String(paused));
        b.setAttribute('aria-label', b.getAttribute(paused ? 'data-label-play' : 'data-label-pause'));
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); }); else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Logos et partenaires",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "N'affichez que de vrais partenaires, marques distribuées ou médias, avec leur autorisation d'utiliser leur logo." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos partenaires" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "select", "id": "layout", "label": "Présentation", "default": "marquee", "options": [{ "value": "marquee", "label": "Bande en défilement continu" }, { "value": "grid", "label": "Grille" }, { "value": "row", "label": "Rangée centrée" }] },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Colonnes de la grille (ordinateur)", "default": 5 },
    { "type": "range", "id": "logo_height", "min": 24, "max": 96, "step": 4, "unit": "px", "label": "Hauteur des logos", "default": 44 },
    { "type": "range", "id": "speed", "min": 15, "max": 90, "step": 5, "unit": "s", "label": "Durée d'un tour de défilement", "default": 40 },
    { "type": "checkbox", "id": "grayscale", "label": "Logos en niveaux de gris, couleur au survol", "default": true },
    { "type": "checkbox", "id": "tiles", "label": "Logos dans des cartes", "default": true },
    { "type": "checkbox", "id": "new_tab", "label": "Ouvrir les liens dans un nouvel onglet", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 64 }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "paragraph", "content": "Logo d'un partenaire réel, utilisé avec son accord. Sans logo, un espace réservé s'affiche." },
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" },
      { "type": "text", "id": "name", "label": "Nom du partenaire", "info": "Sert de texte alternatif, ou s'affiche à la place du logo s'il n'y en a pas." },
      { "type": "url", "id": "link", "label": "Lien (facultatif)" }
    ] }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Logos et partenaires", "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] }]
}
{% endschema %}
