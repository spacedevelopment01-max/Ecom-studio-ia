{%- comment -%}
  Avis clients saisis par le marchand (citations réelles uniquement). Sans avis, la section n'affiche rien
  sur la boutique ; un rappel apparaît seulement dans l'éditeur.
{%- endcomment -%}
<section class="es-section es-testi color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    {%- if section.blocks.size > 0 -%}
      <header class="es-section-head es-section-head--center es-testi__head">
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
      </header>
      <div class="es-testi__track" data-reveal-stagger style="--n: {{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <figure class="es-testi__card" data-reveal="up" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- assign stars = block.settings.rating | plus: 0 -%}
            {%- if stars > 0 -%}<p class="es-testi__stars" aria-label="{{ 'products.product.rating_of' | t: rating: stars, max: 5 | escape }}">{%- for i in (1..5) -%}<span{% if i > stars %} class="is-off"{% endif %}>★</span>{%- endfor -%}</p>{%- endif -%}
            <span class="es-testi__mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="es-testi__quote">{{ block.settings.quote }}</blockquote>
            {%- assign author_first = block.settings.author | strip | slice: 0 -%}
            <figcaption class="es-testi__who">
              {%- if block.settings.image != blank or block.settings.image_asset != blank -%}<span class="es-testi__avatar">{% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.author, sizes: '48px', class: 'es-cover' %}</span>{%- elsif block.settings.author != blank and author_first != '[' -%}<span class="es-testi__avatar es-testi__avatar--initial" aria-hidden="true">{{ block.settings.author | strip | slice: 0 | upcase }}</span>{%- endif -%}
              {%- assign who = block.settings.author | split: ' · ' -%}<span><b>{{ who.first }}{% if who.size > 1 %} <span class="es-testi__tag">{{ who.last }}</span>{% endif %}</b>{%- if block.settings.detail != blank -%}<small>{{ block.settings.detail }}</small>{%- endif -%}</span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="es-reviews__hint">{{ 'sections.reviews.testimonials_hint' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.es-testi__head { max-width: 720px; }
.es-testi__track { gap: clamp(14px, 1.8vw, 24px); padding-bottom: 12px; scrollbar-width: none; }
.es-testi__track::-webkit-scrollbar { display: none; }
@media (min-width: 990px) { .es-testi__track { grid-auto-flow: row; grid-template-columns: repeat(min(var(--n, 3), 3), minmax(0, 1fr)); overflow: visible; } }
.es-testi__card { position: relative; gap: 18px; padding: clamp(26px, 2.8vw, 36px); background: linear-gradient(180deg, rgba(var(--c-text-rgb), .045), rgba(var(--c-text-rgb), .015)); border-color: rgba(var(--c-text-rgb), .1); box-shadow: 0 30px 60px -50px rgba(0,0,0,.5); transition: transform .6s var(--ease-out), border-color .4s; }
.es-testi__card:hover { transform: translateY(-4px); border-color: rgba(var(--c-accent-rgb), .35); }
.es-testi__mark { position: absolute; top: clamp(14px, 2vw, 22px); right: clamp(20px, 2.4vw, 30px); font-family: var(--font-accent, var(--font-heading)); font-size: 4.4rem; line-height: 1; color: var(--c-accent); opacity: .22; pointer-events: none; }
.es-testi__stars { font-size: 1.05rem; letter-spacing: 3px; line-height: 1; }
.es-testi__quote { font-size: clamp(1.1rem, 1.5vw, 1.28rem); line-height: 1.45; letter-spacing: -.005em; text-wrap: pretty; }
.es-testi__who { padding-top: 18px; border-top: 1px solid rgba(var(--c-text-rgb), .1); font-size: .95rem; line-height: 1.35; }
.es-testi__who small { font-size: .86rem; margin-top: 2px; }
.es-testi__tag { display: inline-block; margin-left: 4px; padding: 2px 8px; border-radius: 99px; background: rgba(var(--c-text-rgb), .08); color: var(--c-muted); font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; vertical-align: 2px; }
.es-testi__avatar--initial { display: grid; place-items: center; background: rgba(var(--c-accent-rgb), .14); color: var(--c-accent); font-weight: var(--font-body-weight-bold); font-size: 1.05rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Avis clients premium",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Ils en parlent" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'avis de nos clients" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    { "type": "review", "name": "Avis", "settings": [
      { "type": "paragraph", "content": "Uniquement de vrais avis, recopiés avec l'accord du client." },
      { "type": "textarea", "id": "quote", "label": "Avis" },
      { "type": "text", "id": "author", "label": "Prénom du client" },
      { "type": "text", "id": "detail", "label": "Précision (ville, produit acheté…)" },
      { "type": "select", "id": "rating", "label": "Note", "default": "0", "options": [{ "value": "0", "label": "Sans note" }, { "value": "5", "label": "5 / 5" }, { "value": "4", "label": "4 / 5" }, { "value": "3", "label": "3 / 5" }, { "value": "2", "label": "2 / 5" }, { "value": "1", "label": "1 / 5" }] },
      { "type": "image_picker", "id": "image", "label": "Photo (avec accord)" },
      { "type": "text", "id": "image_asset", "label": "Image fournie avec le thème" }
    ] },
    { "type": "@app" }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Avis clients premium" }]
}
{% endschema %}
