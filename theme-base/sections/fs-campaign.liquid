{%- comment -%}
Campagne et offre du moment (e-commerce) : une mise en avant datée avec ses conditions écrites. Image et texte,
  texte sur l'image, ou carte. Pas de compte à rebours : la période est un texte que la marque renseigne et retire.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-campaign fs-campaign--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: '', button_link: '', tag: s.heading_tag -%}
    <div class="fs-camp fs-camp--{{ s.layout }}">
      <div class="fs-camp__media"{% render 'fs-reveal', effect: 'curtain' %}>{% render 'ed-media', image: s.image, asset: s.image_asset, alt: s.image_alt, role_label: s.media_role, focus_x: s.focus_x, focus_y: s.focus_y %}</div>
      <div class="fs-camp__copy{% if s.layout == 'card' %} {{ cards }}{% endif %}"{% render 'fs-reveal', effect: fx, index: 1 %}>
        {%- if s.label != blank -%}<span class="fs-chip">{{ s.label | escape }}</span>{%- endif -%}
        {%- if s.offer_title != blank -%}<p class="fs-camp__title">{{ s.offer_title | escape }}</p>{%- endif -%}
        {%- if s.offer_text != blank -%}<div class="fs-item__text">{{ s.offer_text }}</div>{%- endif -%}
        {%- if s.period_text != blank -%}<p class="fs-camp__period"><span class="fs-commit__icon">{% render 'fs-icon', name: 'clock' %}</span>{{ s.period_text | escape }}</p>{%- endif -%}
        <p class="fs-camp__actions">{% render 'fs-button', prof: prof, label: s.cta_label, link: s.cta_link %}{% render 'fs-button', prof: prof, label: s.cta2_label, link: s.cta2_link, secondary: true %}</p>
        {%- if s.conditions != blank -%}<p class="fs-camp__conditions fs-meta">{{ s.conditions | escape }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campagne",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre",
      "options": [
        {
          "value": "h1",
          "label": "Titre de page"
        },
        {
          "value": "h2",
          "label": "Titre de section"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "split",
          "label": "Image et texte"
        },
        {
          "value": "background",
          "label": "Texte sur l'image"
        },
        {
          "value": "card",
          "label": "Carte sur l'image"
        }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Étiquette (ex. Collection d'été)"
    },
    {
      "type": "text",
      "id": "offer_title",
      "label": "Titre de l'offre"
    },
    {
      "type": "richtext",
      "id": "offer_text",
      "label": "Texte de l'offre"
    },
    {
      "type": "text",
      "id": "period_text",
      "label": "Période (texte, ex. Du 2 au 16 juin)"
    },
    {
      "type": "text",
      "id": "conditions",
      "label": "Conditions de l'offre"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bouton principal"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton principal"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Bouton secondaire"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Lien du bouton secondaire"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fichier du projet"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l’image"
    },
    {
      "type": "text",
      "id": "media_role",
      "label": "Média attendu (aperçu du studio)"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Point focal horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Point focal vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Campagne",
      "settings": {
        "layout": "split"
      }
    }
  ]
}
{% endschema %}
