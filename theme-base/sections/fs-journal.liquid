{%- comment -%}
Journal (e-commerce) / actualités et conseils (services) : les derniers articles d'un blog, ou des articles choisis à
  la main (blocs). Mise en page éditoriale (un article en avant), grille, ou liste.
  MUSEAU CLUB (maquettes du 23 octobre) : rangée de petites cartes (vignette, titre, lien), filtres en pastilles tirés
  des catégories des articles, catégorie en pastille sur la photo.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign prof = 'es'
  if settings.conversion_profile != blank and settings.conversion_profile != 'none'
    assign prof = 'cv'
  elsif settings.editorial_profile != blank and settings.editorial_profile != 'none'
    assign prof = 'ed'
  endif
  assign fx = s.effect
  assign cards = 'fs-card'
-%}
<section id="fs-{{ section.id }}" class="fs fs-journal fs-journal--{{ s.layout | default: 'base' }} fs--{{ prof }}{% if prof == 'ed' %} ed-section{% else %} es-section{% endif %}{% if s.background != blank and s.background != 'scheme' %} fs--{{ s.background }}{% endif %}{% if s.hover %} fs--hover{% endif %} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--ed-pt:{{ s.padding_top }}px;--ed-pb:{{ s.padding_bottom }}px;--fs-angle:{{ s.gradient_angle | default: 165 }}deg;"{% if fx == 'none' %} data-ed-motion="none"{% endif %} >
  <div class="{% if prof == 'ed' %}ed-shell{% else %}es-container{% endif %} fs__inner">
    {%- render 'fs-head', prof: prof, eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, align: s.align, effect: fx, button_label: s.button_label, button_link: s.button_link -%}
    {%- assign limit = s.limit | default: 3 -%}
    {%- if s.filters and section.blocks.size > 0 -%}
      {%- assign tag_list = section.blocks | map: 'settings' | map: 'tag' | uniq | compact -%}
      <div class="fs-journal__filters" role="group" aria-label="{{ s.filters_label | default: s.heading | escape }}" data-chip-filters>
        <button type="button" class="fs-chip-filter is-active" aria-pressed="true" data-chip-filter="">{{ s.all_label | default: 'Tous' | escape }}</button>
        {%- for t in tag_list -%}{%- if t != blank -%}<button type="button" class="fs-chip-filter" aria-pressed="false" data-chip-filter="{{ t | handleize }}">{{ t | escape }}</button>{%- endif -%}{%- endfor -%}
      </div>
    {%- endif -%}
    {%- capture items -%}
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-post{% if s.layout != 'list' %} {{ cards }}{% endif %}{% if s.layout == 'editorial' and forloop.first %} fs-post--lead{% endif %}"{% render 'fs-reveal', effect: fx, index: ix %} data-chip-item="{{ block.settings.tag | handleize }}" {{ block.shopify_attributes }}>
            <a class="fs-post__link" href="{{ block.settings.link | default: '#' }}">
              {%- if s.layout != 'list' or block.settings.image != blank or block.settings.image_asset != blank -%}<span class="fs-post__media">{% render 'ed-media', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, role_label: 'Image de l’article' %}{% if s.tag_on_image and block.settings.tag != blank %}<span class="fs-post__tag">{{ block.settings.tag | escape }}</span>{% endif %}</span>{%- endif -%}
              <span class="fs-post__copy">{% if s.tag_on_image == false and block.settings.tag != blank or block.settings.date_text != blank and s.show_date %}<span class="fs-meta">{{ block.settings.tag | escape }}{% if block.settings.tag != blank and block.settings.date_text != blank and s.show_date %} · {% endif %}{% if s.show_date %}{{ block.settings.date_text | escape }}{% endif %}</span>{% endif %}<span class="fs-item__title">{{ block.settings.title | escape }}</span>{% if s.show_excerpt and block.settings.text != blank %}<span class="fs-item__text">{{ block.settings.text | strip_html | truncate: 160 }}</span>{% endif %}<span class="fs-link">{{ s.link_label | default: 'Lire' | escape }}</span></span>
            </a>
          </li>
        {%- endfor -%}
      {%- elsif s.blog != blank -%}
        {%- assign b = blogs[s.blog] | default: s.blog -%}
        {%- for article in b.articles limit: limit -%}{%- if s.stagger -%}{%- assign ix = forloop.index0 -%}{%- else -%}{%- assign ix = '' -%}{%- endif -%}
          <li class="fs-post{% if s.layout != 'list' %} {{ cards }}{% endif %}{% if s.layout == 'editorial' and forloop.first %} fs-post--lead{% endif %}"{% render 'fs-reveal', effect: fx, index: ix %}>
            <a class="fs-post__link" href="{{ article.url }}">
              {%- if article.image -%}<span class="fs-post__media"><img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="900" height="600"></span>{%- endif -%}
              <span class="fs-post__copy">{% if s.show_date %}<span class="fs-meta">{{ article.published_at | date: '%d/%m/%Y' }}</span>{% endif %}<span class="fs-item__title">{{ article.title | escape }}</span>{% if s.show_excerpt %}<span class="fs-item__text">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</span>{% endif %}<span class="fs-link">{{ s.link_label | default: 'Lire' | escape }}</span></span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if items != blank -%}
      <ul class="fs-journal__list fs-journal__list--{{ s.layout }}{% if s.layout == 'grid' %} fs-grid fs-grid--3{% endif %}" role="list">{{ items }}</ul>
    {%- elsif request.host == 'apercu' -%}
      <div class="ed-media ed-media--pending fs-pending"><p>{{ 'editorial.pending_media' | t }}</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Repère"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre mise en valeur"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "editorial",
          "label": "Un article en avant"
        },
        {
          "value": "grid",
          "label": "Grille"
        },
        {
          "value": "list",
          "label": "Liste"
        },
        {
          "value": "row",
          "label": "Rangée de petites cartes"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "checkbox",
      "id": "filters",
      "label": "Filtres par catégorie",
      "info": "Pastilles tirées des catégories des articles choisis.",
      "default": false
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Libellé « tous »",
      "default": "Tous"
    },
    {
      "type": "checkbox",
      "id": "tag_on_image",
      "label": "Catégorie en pastille sur la photo",
      "default": false
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog (si aucun article n'est choisi)"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre d'articles",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Afficher la date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Afficher le résumé",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé des liens",
      "default": "Lire"
    },
    {
      "type": "header",
      "content": "Effets et fond"
    },
    {
      "type": "select",
      "id": "effect",
      "label": "Effet d'apparition",
      "options": [
        {
          "value": "none",
          "label": "Aucun"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "curtain",
          "label": "Révélation des images"
        }
      ],
      "default": "rise"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "Apparition décalée des éléments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover",
      "label": "Survol léger des cartes",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        {
          "value": "scheme",
          "label": "Couleur du schéma"
        },
        {
          "value": "gradient-soft",
          "label": "Dégradé léger"
        },
        {
          "value": "gradient-strong",
          "label": "Dégradé marqué"
        }
      ],
      "default": "scheme"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Angle du dégradé",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "°",
      "default": 165
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Résumé"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Rubrique"
        },
        {
          "type": "text",
          "id": "date_text",
          "label": "Date"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fichier du projet"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien de l'article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal",
      "settings": {
        "layout": "editorial"
      }
    }
  ],
  "max_blocks": 9
}
{% endschema %}
