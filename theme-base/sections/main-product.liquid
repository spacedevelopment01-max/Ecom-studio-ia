{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
-%}
<section class="es-section es-product es-product--{{ section.settings.gallery_layout }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-main-product>
  <div class="es-container es-product__grid">
    <div class="es-product__gallery" data-gallery>
      <div class="es-product__track" data-gallery-track tabindex="0" aria-label="{{ 'products.product.media' | t }}">
        {%- for media in product.media -%}
          <figure class="es-product__slide es-media-frame" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- else -%}{%- assign media_loading = 'lazy' -%}{%- endif -%}
                {{ media | image_url: width: 1800 | image_tag: loading: media_loading, sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1500, 1800', alt: media.alt, class: 'es-product__img' }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, playsinline: true, class: 'es-product__img' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'es-product__img' }}
              {%- else -%}
                {{ media | media_tag: class: 'es-product__img' }}
            {%- endcase -%}
          </figure>
        {%- else -%}
          <figure class="es-product__slide es-media-frame">{{ 'product-1' | placeholder_svg_tag: 'es-placeholder__svg' }}</figure>
        {%- endfor -%}
      </div>
      {%- if media_count > 1 -%}
        <div class="es-product__thumbs" role="list">
          {%- for media in product.media -%}
            <button type="button" class="es-product__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-go="{{ forloop.index0 }}" aria-label="{{ 'products.product.media_n' | t: n: forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="es-product__info">
      <div class="es-product__sticky">
        {%- for block in section.blocks -%}
          {%- comment -%} Bloc réservé à la fiche d'un produit précis (texte rédigé pour lui). {%- endcomment -%}
          {%- if block.settings.product_handle != blank and block.settings.product_handle != product.handle -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.hide_for_handle != blank and block.settings.hide_for_handle == product.handle -%}{%- continue -%}{%- endif -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'eyebrow' -%}
              <p class="es-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.vendor }}</p>
            {%- when 'title' -%}
              <h1 class="es-heading es-h2 es-product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- when 'price' -%}
              <div class="es-product__price" {{ block.shopify_attributes }} data-price-wrap>{% render 'price', product: product, use_variant: true %}
                <p class="es-small es-muted">{{ 'products.product.taxes_included' | t }}</p>
              </div>
            {%- when 'text' -%}
              <div class="es-rte es-product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }} id="MainBuy">{% render 'product-buy', product: product, section_id: section.id, show_quantity: block.settings.show_quantity, show_dynamic_checkout: block.settings.show_dynamic_checkout, picker: block.settings.picker, price_in_button: block.settings.price_in_button %}</div>
            {%- when 'description' -%}
              <div class="es-rte es-product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- when 'highlights' -%}
              <ul class="es-highlights{% if block.settings.columns == 2 %} es-highlights--2{% endif %}" role="list" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- assign hl_icon = block.settings.icon | default: 'check' -%}
                {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: hl_icon %}<span>{{ l }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- when 'collapsible' -%}
              <details class="es-accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary><span>{{ block.settings.heading }}</span>{% render 'icon', name: 'plus' %}</summary>
                <div class="es-rte es-accordion__body">{{ block.settings.content }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div>
              </details>
            {%- when 'badges' -%}
              <ul class="es-pills" role="list" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- assign key = 'badge' | append: i -%}
                  {%- if block.settings[key] != blank -%}<li class="es-pill">{{ block.settings[key] }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'rating' -%}
              {%- comment -%} Note réelle uniquement : métachamps standard « reviews » remplis par l'application d'avis. {%- endcomment -%}
              {%- assign r = product.metafields.reviews.rating.value -%}
              {%- if r != blank -%}
                {%- assign pct = r.rating | times: 100.0 | divided_by: r.scale_max | round -%}
                <a href="#{{ block.settings.anchor | default: 'avis' }}" class="es-rating" {{ block.shopify_attributes }}>
                  <span class="es-stars" style="--pct: {{ pct }}%" aria-hidden="true"></span>
                  <span>{{ r.rating | round: 1 }}</span>
                  {%- if product.metafields.reviews.rating_count != blank -%}<span class="es-muted">({{ 'products.product.reviews_count' | t: count: product.metafields.reviews.rating_count }})</span>{%- endif -%}
                  <span class="visually-hidden">{{ 'products.product.rating_of' | t: rating: r.rating, max: r.scale_max }}</span>
                </a>
              {%- endif -%}
            {%- when 'bundles' -%}
              {%- assign bv = product.selected_or_first_available_variant -%}
              {%- assign dt = block.settings.default_tier | plus: 0 -%}
              <div class="es-bundles es-bundles--{{ block.settings.layout | default: 'cards' }}" data-bundles data-section="{{ section.id }}" data-units="{{ block.settings.units_per_pack }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<p class="es-bundles__heading"><span>{{ block.settings.heading }}</span></p>{%- endif -%}
                {%- if block.settings.subheading != blank -%}<p class="es-bundles__sub">{{ block.settings.subheading }}</p>{%- endif -%}
                <div class="es-bundles__grid" role="radiogroup" aria-label="{%- if block.settings.heading != blank -%}{{ block.settings.heading | escape }}{%- else -%}{{ 'products.product.quantity' | t | escape }}{%- endif -%}">
                  {%- for i in (1..3) -%}
                    {%- assign kq = 'qty' | append: i -%}{%- assign kd = 'discount' | append: i -%}{%- assign kl = 'label' | append: i -%}{%- assign kt = 'tag' | append: i -%}{%- assign ks = 'sub' | append: i -%}{%- assign kc = 'chip' | append: i -%}
                    {%- assign q = block.settings[kq] -%}
                    {%- if q > 0 -%}
                      {%- assign d = block.settings[kd] | default: 0 -%}
                      {%- assign full = bv.price | times: q -%}
                      {%- assign keep = 100 | minus: d -%}
                      {%- assign total = full | times: keep | divided_by: 100 -%}
                      <button type="button" role="radio" class="es-bundle{% if block.settings[kt] != blank %} has-tag{% endif %}" data-qty="{{ q }}" data-discount="{{ d }}" aria-checked="{% if dt == i %}true{% else %}false{% endif %}">
                        {%- if block.settings[kt] != blank -%}<span class="es-bundle__tag">{{ block.settings[kt] }}</span>{%- endif -%}
                        <span class="es-bundle__radio" aria-hidden="true"></span>
                        <span class="es-bundle__main">
                          <span class="es-bundle__label">{{ block.settings[kl] | default: q }}{%- if block.settings[kc] != blank -%} <span class="es-bundle__chip">{{ block.settings[kc] }}</span>{%- endif -%}</span>
                          {%- if block.settings[ks] != blank -%}<span class="es-bundle__sub">{{ block.settings[ks] }}</span>{%- endif -%}
                        </span>
                        {%- if block.settings.units_per_pack > 0 and block.settings.unit_label != blank -%}
                          {%- assign units = block.settings.units_per_pack | times: q -%}
                          <span class="es-bundle__unit"><span data-bundle-unit>{{ total | divided_by: units | money }}</span>/{{ block.settings.unit_label }}</span>
                        {%- endif -%}
                        <span class="es-bundle__prices"><span class="es-bundle__price" data-bundle-price>{{ total | money }}</span>
                        {%- if d > 0 -%}<s class="es-bundle__compare es-muted" data-bundle-compare>{{ full | money }}</s>{%- endif -%}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- when 'subscription' -%}
              {%- comment -%} Abonnements réels : plans de vente Shopify (application d'abonnement). Sans plan, rien ne s'affiche. {%- endcomment -%}
              {%- if product.selling_plan_groups.size > 0 -%}
                {%- assign sv = product.selected_or_first_available_variant -%}
                <fieldset class="es-subscribe" data-subscribe data-section="{{ section.id }}" {{ block.shopify_attributes }}>
                  <legend class="es-subscribe__title">{{ block.settings.heading }}</legend>
                  {%- unless product.requires_selling_plan -%}
                    <label class="es-subscribe__opt"><input type="radio" name="es-plan-{{ section.id }}" value="" checked><span>{{ block.settings.one_time_label }}</span><span>{{ sv.price | money }}</span></label>
                  {%- endunless -%}
                  {%- for group in product.selling_plan_groups -%}
                    {%- for plan in group.selling_plans -%}
                      {%- assign plan_price = sv.price -%}
                      {%- for alloc in sv.selling_plan_allocations -%}{%- if alloc.selling_plan.id == plan.id -%}{%- assign plan_price = alloc.price -%}{%- endif -%}{%- endfor -%}
                      <label class="es-subscribe__opt"><input type="radio" name="es-plan-{{ section.id }}" value="{{ plan.id }}"{% if product.requires_selling_plan and forloop.first %} checked{% endif %}><span>{{ plan.name }}</span><span>{{ plan_price | money }}</span></label>
                    {%- endfor -%}
                  {%- endfor -%}
                  {%- if block.settings.text != blank -%}<div class="es-rte es-small es-subscribe__text">{{ block.settings.text }}</div>{%- endif -%}
                </fieldset>
              {%- endif -%}
            {%- when 'siblings' -%}
              {%- assign sib = block.settings.collection -%}
              {%- if sib != blank and sib.products.size > 1 -%}
                <div class="es-siblings" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<p class="es-siblings__heading">{{ block.settings.heading }}</p>{%- endif -%}
                  <div class="es-siblings__row">
                    {%- for p in sib.products limit: 8 -%}
                      <a href="{{ p.url }}" class="es-sibling{% if p.handle == product.handle %} is-current{% endif %}"{% if p.handle == product.handle %} aria-current="page"{% endif %}>
                        {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: width: 56, height: 56, alt: '' }}{%- endif -%}
                        <span>{{ p.title }}</span>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- when 'callout' -%}
              {%- if block.settings.text != blank -%}
                <div class="es-callout" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<div class="es-rte">{{ block.settings.text }}</div></div>
              {%- endif -%}
            {%- when 'promo' -%}
              {%- if block.settings.heading != blank -%}
                <a class="es-promo" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank or block.settings.image_asset != blank -%}{% render 'es-image', image: block.settings.image, asset: block.settings.image_asset, alt: '', sizes: '(min-width: 990px) 40vw, 90vw', class: 'es-promo__bg' %}{%- endif -%}
                  <span class="es-promo__heading">{{ block.settings.heading }}</span>
                  {%- if block.settings.button != blank -%}<span class="es-promo__button">{{ block.settings.button }}</span>{%- endif -%}
                </a>
              {%- endif -%}
            {%- when 'benefits' -%}
              <ul class="es-benefits" role="list" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- assign kt = 'title' | append: i -%}{%- assign kx = 'text' | append: i -%}{%- assign ke = 'emoji' | append: i -%}
                  {%- if block.settings[kt] != blank -%}
                    <li><span class="es-benefits__icon" aria-hidden="true">{{ block.settings[ke] }}</span><div><p class="es-benefits__title">{{ block.settings[kt] }}</p>{%- if block.settings[kx] != blank -%}<p class="es-benefits__text">{{ block.settings[kx] }}</p>{%- endif -%}</div></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'delivery' -%}
              {%- if block.settings.max_days > 0 -%}
                <div class="es-eta" data-eta data-min="{{ block.settings.min_days }}" data-max="{{ block.settings.max_days }}" data-business="{{ block.settings.business_days }}" {{ block.shopify_attributes }}>
                  <div class="es-eta__step">{% render 'icon', name: 'clock' %}<div><span class="es-small es-muted">{{ 'products.product.eta.ordered' | t }}</span><strong>{{ 'products.product.eta.today' | t }}</strong></div></div>
                  {% render 'icon', name: 'arrow' %}
                  <div class="es-eta__step">{% render 'icon', name: 'truck' %}<div><span class="es-small es-muted">{{ block.settings.label }}</span><strong data-eta-range>{{ 'products.product.eta.within' | t: count: block.settings.max_days }}</strong></div></div>
                </div>
              {%- endif -%}
            {%- when 'reassurance' -%}
              <ul class="es-reassure es-reassure--{{ block.settings.layout | default: 'list' }}" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.item1 != blank -%}<li>{% render 'icon', name: block.settings.icon1 %}<span>{{ block.settings.item1 }}</span></li>{%- endif -%}
                {%- if block.settings.item2 != blank -%}<li>{% render 'icon', name: block.settings.icon2 %}<span>{{ block.settings.item2 }}</span></li>{%- endif -%}
                {%- if block.settings.item3 != blank -%}<li>{% render 'icon', name: block.settings.icon3 %}<span>{{ block.settings.item3 }}</span></li>{%- endif -%}
              </ul>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="es-sticky-buy color-{{ section.settings.color_scheme }}" data-sticky-buy hidden>
      <div class="es-container es-sticky-buy__inner">
        <div class="es-sticky-buy__product">
          {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          <div>
            <p class="es-sticky-buy__title">{{ product.title }}</p>
            <p class="es-sticky-buy__meta"><span data-sticky-meta>{% unless product.has_only_default_variant %}{{ product.selected_or_first_available_variant.title }}{% endunless %}</span> <strong data-sticky-total>{{ product.selected_or_first_available_variant.price | money }}</strong></p>
          </div>
        </div>
        <button type="button" class="es-button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
      "description": {{ product.description | strip_html | json }},
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          { "@type": "Offer", "sku": {{ variant.sku | json }}, "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}", "price": {{ variant.price | divided_by: 100.00 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "url": {{ request.origin | append: variant.url | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Produit",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "gallery_layout", "label": "Galerie", "default": "stack", "options": [
      { "value": "stack", "label": "Images empilées" },
      { "value": "carousel", "label": "Carrousel avec miniatures" },
      { "value": "grid", "label": "Grille deux colonnes" }
    ] },
    { "type": "checkbox", "id": "sticky_bar", "label": "Barre d'achat qui suit le défilement", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "eyebrow", "name": "Surtitre", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Texte", "info": "Vide : nom du fabricant." } ] },
    { "type": "title", "name": "Titre", "limit": 1, "settings": [] },
    { "type": "price", "name": "Prix", "limit": 1, "settings": [] },
    { "type": "text", "name": "Texte", "settings": [ { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une phrase d'accroche.</p>" }, { "type": "text", "id": "product_handle", "label": "Réservé au produit (handle)", "info": "Vide : affiché sur toutes les fiches. Sinon, seulement sur la fiche de ce produit." } ] },
    { "type": "buy_buttons", "name": "Boutons d'achat", "limit": 1, "settings": [
      { "type": "select", "id": "picker", "label": "Sélecteur de variantes", "default": "buttons", "options": [ { "value": "buttons", "label": "Boutons" }, { "value": "dropdown", "label": "Liste déroulante" } ] },
      { "type": "checkbox", "id": "show_quantity", "label": "Sélecteur de quantité", "default": true },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Boutons de paiement accéléré", "default": true },
      { "type": "checkbox", "id": "price_in_button", "label": "Prix dans le bouton d'ajout", "default": false }
    ] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [ { "type": "text", "id": "hide_for_handle", "label": "Masquée sur la fiche du produit (handle)", "info": "Utile quand l'accroche de ce produit reprend déjà sa description." } ] },
    { "type": "highlights", "name": "Points forts", "settings": [ { "type": "textarea", "id": "items", "label": "Un point par ligne", "info": "Uniquement des caractéristiques vérifiées.", "default": "Premier point fort\nDeuxième point fort" }, { "type": "select", "id": "icon", "label": "Pictogramme", "default": "check", "options": [ { "value": "check", "label": "Coche" }, { "value": "sparkle", "label": "Étincelle" }, { "value": "leaf", "label": "Feuille" }, { "value": "heart", "label": "Cœur" }, { "value": "star", "label": "Étoile" }, { "value": "bolt", "label": "Éclair" } ] }, { "type": "range", "id": "columns", "min": 1, "max": 2, "step": 1, "label": "Colonnes", "default": 1 }, { "type": "text", "id": "product_handle", "label": "Réservé au produit (handle)", "info": "Vide : affiché sur toutes les fiches. Sinon, seulement sur la fiche de ce produit." } ] },
    { "type": "collapsible", "name": "Onglet repliable", "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Détails" },
      { "type": "richtext", "id": "content", "label": "Contenu" },
      { "type": "page", "id": "page", "label": "Contenu d'une page" },
      { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false },
      { "type": "text", "id": "product_handle", "label": "Réservé au produit (handle)", "info": "Vide : affiché sur toutes les fiches. Sinon, seulement sur la fiche de ce produit." }
    ] },
    { "type": "badges", "name": "Pastilles", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Engagements vérifiés uniquement (origine, label, matière…)." },
      { "type": "text", "id": "badge1", "label": "Pastille 1" },
      { "type": "text", "id": "badge2", "label": "Pastille 2" },
      { "type": "text", "id": "badge3", "label": "Pastille 3" },
      { "type": "text", "id": "badge4", "label": "Pastille 4" }
    ] },
    { "type": "rating", "name": "Note des avis", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Affiche la note réelle fournie par votre application d'avis (métachamps reviews.rating et reviews.rating_count). Sans avis, rien ne s'affiche." },
      { "type": "text", "id": "anchor", "label": "Ancre de la section des avis", "default": "avis" }
    ] },
    { "type": "bundles", "name": "Lots (compose ton panier)", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Le bloc affiche les remises ; créez la remise automatique correspondante dans Shopify (Réductions › Remise sur quantité) pour qu'elle s'applique au paiement." },
      { "type": "select", "id": "layout", "label": "Présentation", "default": "cards", "options": [ { "value": "cards", "label": "Cartes côte à côte" }, { "value": "rows", "label": "Lignes empilées" } ] },
      { "type": "text", "id": "heading", "label": "Titre", "default": "Compose ton panier" },
      { "type": "text", "id": "subheading", "label": "Sous-titre" },
      { "type": "number", "id": "units_per_pack", "label": "Unités par article (ex. 30 tasses par sachet)", "default": 0 },
      { "type": "text", "id": "unit_label", "label": "Nom de l'unité (ex. tasse)" },
      { "type": "select", "id": "default_tier", "label": "Lot sélectionné par défaut", "default": "1", "options": [ { "value": "1", "label": "Lot 1" }, { "value": "2", "label": "Lot 2" }, { "value": "3", "label": "Lot 3" } ] },
      { "type": "header", "content": "Lot 1" },
      { "type": "range", "id": "qty1", "min": 0, "max": 12, "step": 1, "label": "Quantité (0 = masqué)", "default": 1 },
      { "type": "text", "id": "label1", "label": "Libellé", "default": "1 article" },
      { "type": "range", "id": "discount1", "min": 0, "max": 50, "step": 1, "unit": "%", "label": "Remise", "default": 0 },
      { "type": "text", "id": "chip1", "label": "Pastille (ex. 100 gélules)" },
      { "type": "text", "id": "sub1", "label": "Sous-ligne (ex. dont 50 offertes)" },
      { "type": "text", "id": "tag1", "label": "Étiquette (ex. -5 %, Livraison offerte)" },
      { "type": "header", "content": "Lot 2" },
