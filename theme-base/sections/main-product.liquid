{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
-%}
<section class="es-section es-product es-product--{{ section.settings.gallery_layout }} color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-main-product>
  <div class="es-container es-product__grid">
    <div class="es-product__gallery" data-gallery>
      <div class="es-product__track" data-gallery-track tabindex="0" aria-label="{{ 'products.product.media' | t }}">
        {%- for media in product.media -%}
          <figure class="es-product__slide es-media-frame" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- else -%}{%- assign media_loading = 'lazy' -%}{%- endif -%}
                {{ media | image_url: width: 1800 | image_tag: loading: media_loading, sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1500, 1800', alt: media.alt, class: 'es-product__img' }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, playsinline: true, class: 'es-product__img' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'es-product__img' }}
              {%- else -%}
                {{ media | media_tag: class: 'es-product__img' }}
            {%- endcase -%}
          </figure>
        {%- else -%}
          <figure class="es-product__slide es-media-frame">{{ 'product-1' | placeholder_svg_tag: 'es-placeholder__svg' }}</figure>
        {%- endfor -%}
      </div>
      {%- if media_count > 1 -%}
        <div class="es-product__thumbs" role="list">
          {%- for media in product.media -%}
            <button type="button" class="es-product__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-go="{{ forloop.index0 }}" aria-label="{{ 'products.product.media_n' | t: n: forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="es-product__info">
      <div class="es-product__sticky">
        {%- for block in section.blocks -%}
          {%- comment -%} Bloc réservé à la fiche d'un produit précis (texte rédigé pour lui). {%- endcomment -%}
          {%- if block.settings.product_handle != blank and block.settings.product_handle != product.handle -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.hide_for_handle != blank and block.settings.hide_for_handle == product.handle -%}{%- continue -%}{%- endif -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'eyebrow' -%}
              <p class="es-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.vendor }}</p>
            {%- when 'title' -%}
              <h1 class="es-heading es-h2 es-product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- when 'price' -%}
              <div class="es-product__price" {{ block.shopify_attributes }} data-price-wrap>{% render 'price', product: product, use_variant: true %}
                <p class="es-small es-muted">{{ 'products.product.taxes_included' | t }}</p>
              </div>
            {%- when 'text' -%}
              <div class="es-rte es-product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }} id="MainBuy">{% render 'product-buy', product: product, section_id: section.id, show_quantity: block.settings.show_quantity, show_dynamic_checkout: block.settings.show_dynamic_checkout, picker: block.settings.picker %}</div>
            {%- when 'description' -%}
              <div class="es-rte es-product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- when 'highlights' -%}
              <ul class="es-highlights" role="list" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ l }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- when 'collapsible' -%}
              <details class="es-accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary><span>{{ block.settings.heading }}</span>{% render 'icon', name: 'plus' %}</summary>
                <div class="es-rte es-accordion__body">{{ block.settings.content }}{% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}</div>
              </details>
            {%- when 'reassurance' -%}
              <ul class="es-reassure" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.item1 != blank -%}<li>{% render 'icon', name: block.settings.icon1 %}<span>{{ block.settings.item1 }}</span></li>{%- endif -%}
                {%- if block.settings.item2 != blank -%}<li>{% render 'icon', name: block.settings.icon2 %}<span>{{ block.settings.item2 }}</span></li>{%- endif -%}
                {%- if block.settings.item3 != blank -%}<li>{% render 'icon', name: block.settings.icon3 %}<span>{{ block.settings.item3 }}</span></li>{%- endif -%}
              </ul>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="es-sticky-buy color-{{ section.settings.color_scheme }}" data-sticky-buy hidden>
      <div class="es-container es-sticky-buy__inner">
        <div class="es-sticky-buy__product">
          {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          <div><p class="es-sticky-buy__title">{{ product.title }}</p>{% render 'price', product: product, use_variant: true %}</div>
        </div>
        <button type="button" class="es-button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
      "description": {{ product.description | strip_html | json }},
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          { "@type": "Offer", "sku": {{ variant.sku | json }}, "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}", "price": {{ variant.price | divided_by: 100.00 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "url": {{ request.origin | append: variant.url | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Produit",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "select", "id": "gallery_layout", "label": "Galerie", "default": "stack", "options": [
      { "value": "stack", "label": "Images empilées" },
      { "value": "carousel", "label": "Carrousel avec miniatures" },
      { "value": "grid", "label": "Grille deux colonnes" }
    ] },
    { "type": "checkbox", "id": "sticky_bar", "label": "Barre d'achat qui suit le défilement", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "eyebrow", "name": "Surtitre", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Texte", "info": "Vide : nom du fabricant." } ] },
    { "type": "title", "name": "Titre", "limit": 1, "settings": [] },
    { "type": "price", "name": "Prix", "limit": 1, "settings": [] },
    { "type": "text", "name": "Texte", "settings": [ { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une phrase d'accroche.</p>" }, { "type": "text", "id": "product_handle", "label": "Réservé au produit (handle)", "info": "Vide : affiché sur toutes les fiches. Sinon, seulement sur la fiche de ce produit." } ] },
    { "type": "buy_buttons", "name": "Boutons d'achat", "limit": 1, "settings": [
      { "type": "select", "id": "picker", "label": "Sélecteur de variantes", "default": "buttons", "options": [ { "value": "buttons", "label": "Boutons" }, { "value": "dropdown", "label": "Liste déroulante" } ] },
      { "type": "checkbox", "id": "show_quantity", "label": "Sélecteur de quantité", "default": true },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Boutons de paiement accéléré", "default": true }
    ] },
    { "type": "description", "name": "Description", "limit": 1, "settings": [ { "type": "text", "id": "hide_for_handle", "label": "Masquée sur la fiche du produit (handle)", "info": "Utile quand l'accroche de ce produit reprend déjà sa description." } ] },
    { "type": "highlights", "name": "Points forts", "settings": [ { "type": "textarea", "id": "items", "label": "Un point par ligne", "info": "Uniquement des caractéristiques vérifiées.", "default": "Premier point fort\nDeuxième point fort" }, { "type": "text", "id": "product_handle", "label": "Réservé au produit (handle)", "info": "Vide : affiché sur toutes les fiches. Sinon, seulement sur la fiche de ce produit." } ] },
    { "type": "collapsible", "name": "Onglet repliable", "settings": [
      { "type": "text", "id": "heading", "label": "Titre", "default": "Détails" },
      { "type": "richtext", "id": "content", "label": "Contenu" },
      { "type": "page", "id": "page", "label": "Contenu d'une page" },
      { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false },
      { "type": "text", "id": "product_handle", "label": "Réservé au produit (handle)", "info": "Vide : affiché sur toutes les fiches. Sinon, seulement sur la fiche de ce produit." }
    ] },
    { "type": "reassurance", "name": "Réassurance", "limit": 1, "settings": [
      { "type": "text", "id": "item1", "label": "Élément 1", "info": "N'affichez que des engagements réels." },
      { "type": "select", "id": "icon1", "label": "Icône 1", "default": "truck", "options": [ { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "shield", "label": "Protection" }, { "value": "leaf", "label": "Nature" }, { "value": "check", "label": "Coche" } ] },
      { "type": "text", "id": "item2", "label": "Élément 2" },
      { "type": "select", "id": "icon2", "label": "Icône 2", "default": "return", "options": [ { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "shield", "label": "Protection" }, { "value": "leaf", "label": "Nature" }, { "value": "check", "label": "Coche" } ] },
      { "type": "text", "id": "item3", "label": "Élément 3" },
      { "type": "select", "id": "icon3", "label": "Icône 3", "default": "shield", "options": [ { "value": "truck", "label": "Livraison" }, { "value": "return", "label": "Retour" }, { "value": "shield", "label": "Protection" }, { "value": "leaf", "label": "Nature" }, { "value": "check", "label": "Coche" } ] }
    ] }
  ]
}
{% endschema %}
