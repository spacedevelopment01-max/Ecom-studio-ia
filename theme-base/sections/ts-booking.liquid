{%- comment -%}
  TABLE SAISON : réservation en trois étapes (personnes et date, horaire, coordonnées), créneau devenu indisponible et
  confirmation. Les règles (services, heures, fermetures, capacité, fuseau horaire) viennent de la section « Réglages du
  restaurant » ; le calendrier interdit les dates passées et fermées. En démonstration, tout est simulé et annoncé
  comme tel ; avec le service réel, la disponibilité est vérifiée par le studio au moment de confirmer.
  Les étapes ont leur adresse (#etape-1, #etape-2, #etape-3, #indisponible, #confirmation) : précédent / suivant du
  navigateur et retours gardent les choix déjà faits.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ts-section ts-booking" data-ts-booking data-step="1">
  <h1 class="ts-visually-hidden" data-ts-h1>{{ s.title_step1 | newline_to_br | replace: '<br />', ' ' }}</h1>
  <p class="ts-sim" data-ts-sim hidden>{{ s.demo_banner }}</p>
  {%- assign heroes = 'step1,step2,step3,unavailable,confirm' | split: ',' -%}
  {%- for h in heroes -%}
    {%- liquid
      assign img_key = 'image_' | append: h
      assign title_key = 'title_' | append: h
      assign text_key = 'text_' | append: h
      assign layout = 'booking'
      if h == 'confirm'
        assign layout = 'center'
      endif
    -%}
    <div class="ts-hero ts-hero--{{ layout }}" data-ts-hero="{{ h }}"{% unless forloop.first %} hidden{% endunless %} style="--ts-hero-h: {% if h == 'confirm' %}340{% else %}300{% endif %}px; --ts-hero-h-mobile: 200px;">
      {%- if s[img_key] != blank -%}<div class="ts-hero__media">{% render 'ts-img', asset: s[img_key], alt: '', pos: '50% 50%', loading: 'eager' %}</div>{%- endif -%}
      <div class="ts-hero__shade" aria-hidden="true"></div>
      <div class="ts-wrap ts-hero__inner">
        <div class="ts-hero__content">
          <p class="ts-title" aria-hidden="true">{{ s[title_key] | newline_to_br }}</p>
          <p class="ts-hero__text">{{ s[text_key] }}</p>
        </div>
      </div>
    </div>
  {%- endfor -%}

  <div class="ts-wrap">
    <noscript><p class="ts-status ts-status--warn" style="margin-top:20px">{{ s.noscript }}</p></noscript>

    {%- comment -%} Étape 1 : personnes et date {%- endcomment -%}
    <div class="ts-booking__card ts-pane" data-ts-pane="1" tabindex="-1" aria-labelledby="ts-b1-{{ section.id }}">
      <div class="ts-booking__head"><h2 class="ts-title" id="ts-b1-{{ section.id }}">{{ s.step1_heading }}</h2><span class="ts-step-count">{{ s.step_of | replace: '[n]', '1' }}</span></div>
      <div class="ts-booking__grid">
        <div>
          <p class="ts-label" id="ts-party-label-{{ section.id }}">{{ s.party_label }}</p>
          <div class="ts-party" role="group" aria-labelledby="ts-party-label-{{ section.id }}" data-ts-party></div>
          <div class="ts-stepper" data-ts-stepper>
            <button type="button" data-ts-less aria-label="{{ s.less_label | escape }}">{% render 'ts-icon', name: 'minus' %}</button>
            <output aria-live="polite" data-ts-party-out></output>
            <button type="button" data-ts-more aria-label="{{ s.more_label | escape }}">{% render 'ts-icon', name: 'plus' %}</button>
          </div>
          <div class="ts-cal__head">
            <p class="ts-cal__month" aria-live="polite" data-ts-month></p>
            <div class="ts-cal__nav">
              <button type="button" data-ts-prev-month aria-label="{{ s.prev_month | escape }}">{% render 'ts-icon', name: 'prev' %}</button>
              <button type="button" data-ts-next-month aria-label="{{ s.next_month | escape }}">{% render 'ts-icon', name: 'next' %}</button>
            </div>
          </div>
          <table class="ts-cal" role="grid" data-ts-cal><thead><tr></tr></thead><tbody></tbody></table>
          <p class="ts-error" role="alert" hidden data-ts-error="1"></p>
        </div>
        <div class="ts-booking__aside">
          <div class="ts-recap">
            <p class="ts-recap__title">{{ s.selection_label }}</p>
            <ul>
              <li>{% render 'ts-icon', name: 'user' %}<span data-ts-out="party"></span></li>
              <li>{% render 'ts-icon', name: 'calendar' %}<span data-ts-out="date"></span></li>
            </ul>
          </div>
          {% render 'ts-img', asset: s.aside_step1, alt: '', pos: '50% 50%' %}
          <button type="button" class="ts-btn ts-btn--block" data-ts-next="2">{{ s.continue_label }} {% render 'ts-icon', name: 'arrow' %}</button>
        </div>
      </div>
    </div>

    {%- comment -%} Étape 2 : horaire {%- endcomment -%}
    <div class="ts-booking__card ts-pane" data-ts-pane="2" tabindex="-1" hidden aria-labelledby="ts-b2-{{ section.id }}">
      <div class="ts-booking__head"><h2 class="ts-title" id="ts-b2-{{ section.id }}">{{ s.step2_heading }}</h2><span class="ts-step-count">{{ s.step_of | replace: '[n]', '2' }}</span></div>
      <div class="ts-summary-bar">
        <span>{% render 'ts-icon', name: 'users' %}<span data-ts-out="party"></span></span>
        <span>{% render 'ts-icon', name: 'calendar' %}<span data-ts-out="date"></span></span>
        <button type="button" data-ts-goto="1">{{ s.edit_label }}</button>
      </div>
      <div data-ts-services></div>
      <p class="ts-error" role="alert" hidden data-ts-error="2"></p>
      <div class="ts-booking__foot">
        <button type="button" class="ts-back" data-ts-goto="1">{% render 'ts-icon', name: 'arrow-left' %}{{ s.back_label }}</button>
        <button type="button" class="ts-btn" data-ts-next="3">{{ s.continue_label }} {% render 'ts-icon', name: 'arrow' %}</button>
      </div>
    </div>

    {%- comment -%} Étape 3 : coordonnées {%- endcomment -%}
    <form class="ts-booking__card ts-pane" data-ts-pane="3" tabindex="-1" hidden aria-labelledby="ts-b3-{{ section.id }}" novalidate data-ts-contact-form>
      <div class="ts-booking__head"><h2 class="ts-title" id="ts-b3-{{ section.id }}">{{ s.step3_heading }}</h2><span class="ts-step-count">{{ s.step_of | replace: '[n]', '3' }}</span></div>
      <div class="ts-booking__grid">
        <div class="ts-form">
          <div class="ts-form__row">
            <label class="ts-field"><span>{{ s.first_name }} <span class="ts-req" aria-hidden="true">*</span></span><input class="ts-input" name="firstName" required autocomplete="given-name" placeholder="{{ s.first_name_ph | escape }}"><span class="ts-error" hidden></span></label>
            <label class="ts-field"><span>{{ s.last_name }} <span class="ts-req" aria-hidden="true">*</span></span><input class="ts-input" name="lastName" required autocomplete="family-name" placeholder="{{ s.last_name_ph | escape }}"><span class="ts-error" hidden></span></label>
          </div>
          <label class="ts-field"><span>{{ s.email_label }} <span class="ts-req" aria-hidden="true">*</span></span><input class="ts-input" type="email" name="email" required autocomplete="email" placeholder="{{ s.email_ph | escape }}"><span class="ts-error" hidden></span></label>
          <label class="ts-field"><span>{{ s.phone_label }}</span><input class="ts-input" type="tel" name="phone" autocomplete="tel" placeholder="{{ s.phone_ph | escape }}"><span class="ts-error" hidden></span></label>
          <label class="ts-field"><span>{{ s.note_label }} <span class="ts-opt">{{ s.optional }}</span></span><textarea class="ts-input" name="note" rows="3" maxlength="600" placeholder="{{ s.note_ph | escape }}"></textarea></label>
          <label class="ts-check"><input type="checkbox" name="newsletter"> <span>{{ s.newsletter_label }} <span class="ts-opt">{{ s.optional }}</span></span></label>
          <label class="ts-check"><input type="checkbox" name="terms" required> <span>{{ s.terms_before }} <a href="{{ s.terms_link | default: '/pages/conditions-de-reservation' }}" target="_blank">{{ s.terms_link_label }}</a> {{ s.terms_after }} <span class="ts-req" aria-hidden="true">*</span></span></label>
          <span class="ts-error" hidden data-ts-terms-error></span>
        </div>
        <div class="ts-booking__aside">
          <div class="ts-recap">
            <p class="ts-recap__title">{{ s.recap_label }}</p>
            <ul>
              <li>{% render 'ts-icon', name: 'users' %}<span data-ts-out="party"></span></li>
              <li>{% render 'ts-icon', name: 'calendar' %}<span data-ts-out="date"></span></li>
              <li>{% render 'ts-icon', name: 'clock' %}<span data-ts-out="time"></span><button type="button" class="ts-recap__edit ts-linkbtn" style="margin:0 0 0 auto" data-ts-goto="2">{{ s.edit_label }}</button></li>
            </ul>
          </div>
          {% render 'ts-img', asset: s.aside_step3, alt: '', pos: '50% 50%' %}
          <p class="ts-notice" data-ts-demo-note hidden>{{ s.demo_note }}</p>
        </div>
      </div>
      <p class="ts-status ts-status--err" role="alert" hidden data-ts-error="3"></p>
      <div class="ts-booking__foot">
        <button type="button" class="ts-back" data-ts-goto="2">{% render 'ts-icon', name: 'arrow-left' %}{{ s.back_label }}</button>
        <button type="submit" class="ts-btn" data-ts-confirm>{{ s.confirm_label }}</button>
      </div>
    </form>

    {%- comment -%} Créneau devenu indisponible {%- endcomment -%}
    <div class="ts-booking__card ts-pane" data-ts-pane="unavailable" tabindex="-1" hidden>
      <div class="ts-summary-bar">
        <span>{% render 'ts-icon', name: 'users' %}<span data-ts-out="party"></span></span>
        <span>{% render 'ts-icon', name: 'calendar' %}<span data-ts-out="date"></span></span>
        <button type="button" data-ts-goto="1">{{ s.edit_label }}</button>
      </div>
      <div class="ts-alert" role="alert">
        {% render 'ts-icon', name: 'clock' %}
        <strong>{{ s.unavailable_heading }}</strong>
        <p data-ts-unavailable-text>{{ s.unavailable_text }}</p>
      </div>
      <h2 class="ts-label" style="font: 400 17px/1.3 var(--ts-serif); margin: 0 0 12px" data-ts-alt-title></h2>
      <div class="ts-slots" data-ts-alternatives></div>
      <p class="ts-slots__empty" hidden data-ts-no-alt>{{ s.no_alternative }}</p>
      <div class="ts-booking__foot">
        <button type="button" class="ts-back" data-ts-goto="2">{% render 'ts-icon', name: 'arrow-left' %}{{ s.back_label }}</button>
        <button type="button" class="ts-btn" data-ts-continue-alt>{{ s.continue_label }} {% render 'ts-icon', name: 'arrow' %}</button>
      </div>
    </div>

    {%- comment -%} Confirmation {%- endcomment -%}
    <div class="ts-confirm ts-pane" data-ts-pane="confirm" tabindex="-1" hidden>
      <div>
        <div class="ts-confirm__head">
          <span class="ts-confirm__check">{% render 'ts-icon', name: 'check' %}</span>
          <h2 class="ts-title">{{ s.confirm_heading }}</h2>
          <p data-ts-confirm-note></p>
        </div>
        <div class="ts-confirm__facts">
          <div class="ts-number"><span>{{ s.number_label }}</span><strong data-ts-out="number"></strong></div>
          <ul class="ts-facts">
            <li>{% render 'ts-icon', name: 'users' %}<span data-ts-out="party"></span></li>
            <li>{% render 'ts-icon', name: 'clock' %}<span data-ts-out="when"></span></li>
            <li>{% render 'ts-icon', name: 'mail' %}<span data-ts-out="email-state"></span></li>
          </ul>
        </div>
        <div class="ts-confirm__actions">
          <button type="button" class="ts-btn ts-btn--ghost" data-ts-ics>{% render 'ts-icon', name: 'calendar' %}{{ s.calendar_label }}</button>
          <a class="ts-btn ts-btn--ghost" href="{{ s.manage_link | default: '/pages/ma-reservation' }}" data-ts-manage-link>{% render 'ts-icon', name: 'calendar' %}{{ s.manage_label }}</a>
        </div>
      </div>
      <div class="ts-confirm__media">{% render 'ts-img', asset: s.aside_confirm, alt: '', pos: '50% 50%' %}</div>
      <div class="ts-place">
        {% render 'ts-icon', name: 'pin' %}
        <div><strong style="font-weight:400">{{ shop.name }}</strong><br><span data-ts-out="address"></span></div>
        <a class="ts-btn ts-btn--line" href="{{ s.map_link | default: '/pages/contact' }}">{{ s.map_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Réservation de table",
  "class": "ts-booking-section",
  "settings": [
    { "type": "text", "id": "demo_banner", "label": "Bandeau de démonstration", "default": "Démonstration : aucune réservation réelle" },
    { "type": "textarea", "id": "demo_note", "label": "Mention de démonstration", "default": "Exemple de restaurant — tarifs et disponibilités de démonstration. Simulation — aucune réservation réelle." },
    { "type": "text", "id": "noscript", "label": "Message sans JavaScript", "default": "La réservation en ligne a besoin de JavaScript. Vous pouvez aussi nous contacter par téléphone ou par e-mail." },
    { "type": "header", "content": "Ouvertures" },
    { "type": "text", "id": "image_step1", "label": "Photo de l'étape 1" },
    { "type": "textarea", "id": "title_step1", "label": "Titre de l'étape 1", "default": "Réserver\nune table" },
    { "type": "text", "id": "text_step1", "label": "Texte de l'étape 1", "default": "Une cuisine de saison, dans une atmosphère chaleureuse et conviviale." },
    { "type": "text", "id": "image_step2", "label": "Photo de l'étape 2" },
    { "type": "textarea", "id": "title_step2", "label": "Titre de l'étape 2", "default": "Réserver\nune table" },
    { "type": "text", "id": "text_step2", "label": "Texte de l'étape 2", "default": "Des produits de saison, des instants précieux." },
    { "type": "text", "id": "image_step3", "label": "Photo de l'étape 3" },
    { "type": "textarea", "id": "title_step3", "label": "Titre de l'étape 3", "default": "Réserver\nune table" },
    { "type": "text", "id": "text_step3", "label": "Texte de l'étape 3", "default": "Quelques informations pour finaliser votre réservation." },
    { "type": "text", "id": "image_unavailable", "label": "Photo du créneau indisponible" },
    { "type": "textarea", "id": "title_unavailable", "label": "Titre du créneau indisponible", "default": "Cet horaire\nn'est plus disponible" },
    { "type": "text", "id": "text_unavailable", "label": "Texte du créneau indisponible", "default": "Ce créneau est désormais complet. Voici d'autres horaires encore disponibles." },
    { "type": "text", "id": "image_confirm", "label": "Photo de la confirmation" },
    { "type": "textarea", "id": "title_confirm", "label": "Titre de la confirmation", "default": "Votre table vous attend" },
    { "type": "text", "id": "text_confirm", "label": "Texte de la confirmation", "default": "Merci pour votre réservation. Nous avons hâte de vous accueillir." },
    { "type": "header", "content": "Étapes" },
    { "type": "text", "id": "step_of", "label": "Compteur d'étapes", "default": "Étape [n] sur 3" },
    { "type": "text", "id": "step1_heading", "label": "Titre de l'étape 1 (formulaire)", "default": "1. Nombre de personnes et date" },
    { "type": "text", "id": "party_label", "label": "Libellé du nombre de personnes", "default": "Nombre de personnes" },
    { "type": "text", "id": "less_label", "label": "Bouton une personne de moins", "default": "Une personne de moins" },
    { "type": "text", "id": "more_label", "label": "Bouton une personne de plus", "default": "Une personne de plus" },
    { "type": "text", "id": "prev_month", "label": "Bouton mois précédent", "default": "Mois précédent" },
    { "type": "text", "id": "next_month", "label": "Bouton mois suivant", "default": "Mois suivant" },
    { "type": "text", "id": "selection_label", "label": "Titre de la sélection", "default": "Votre sélection" },
    { "type": "text", "id": "aside_step1", "label": "Photo à côté de l'étape 1" },
    { "type": "text", "id": "continue_label", "label": "Bouton continuer", "default": "Continuer" },
    { "type": "text", "id": "step2_heading", "label": "Titre de l'étape 2 (formulaire)", "default": "2. Choisissez votre horaire" },
    { "type": "text", "id": "edit_label", "label": "Lien modifier", "default": "Modifier" },
    { "type": "text", "id": "back_label", "label": "Bouton retour", "default": "Retour" },
    { "type": "text", "id": "step3_heading", "label": "Titre de l'étape 3 (formulaire)", "default": "3. Vos coordonnées" },
    { "type": "text", "id": "first_name", "label": "Libellé du prénom", "default": "Prénom" },
    { "type": "text", "id": "first_name_ph", "label": "Exemple de prénom", "default": "Ex. Camille" },
    { "type": "text", "id": "last_name", "label": "Libellé du nom", "default": "Nom" },
    { "type": "text", "id": "last_name_ph", "label": "Exemple de nom", "default": "Ex. Dupont" },
    { "type": "text", "id": "email_label", "label": "Libellé de l'e-mail", "default": "E-mail" },
    { "type": "text", "id": "email_ph", "label": "Exemple d'e-mail", "default": "Ex. camille.dupont@mail.fr" },
    { "type": "text", "id": "phone_label", "label": "Libellé du téléphone", "default": "Téléphone" },
    { "type": "text", "id": "phone_ph", "label": "Exemple de téléphone", "default": "Ex. 06 12 34 56 78 (optionnel)" },
    { "type": "text", "id": "note_label", "label": "Libellé de la remarque", "default": "Une remarque ?" },
    { "type": "text", "id": "note_ph", "label": "Exemple de remarque", "default": "Ex. Allergie alimentaire, occasion spéciale…" },
    { "type": "text", "id": "optional", "label": "Mention facultatif", "default": "(optionnel)" },
    { "type": "text", "id": "newsletter_label", "label": "Case lettre d'information", "default": "Je souhaite recevoir la lettre d'information du restaurant" },
    { "type": "text", "id": "terms_before", "label": "Conditions : début", "default": "J'accepte les" },
    { "type": "text", "id": "terms_link_label", "label": "Conditions : lien", "default": "conditions de réservation" },
    { "type": "text", "id": "terms_after", "label": "Conditions : fin", "default": "du restaurant" },
    { "type": "url", "id": "terms_link", "label": "Page des conditions" },
    { "type": "text", "id": "recap_label", "label": "Titre du récapitulatif", "default": "Récapitulatif" },
    { "type": "text", "id": "aside_step3", "label": "Photo à côté de l'étape 3" },
    { "type": "text", "id": "confirm_label", "label": "Bouton confirmer", "default": "Confirmer la réservation" },
    { "type": "header", "content": "Indisponible et confirmation" },
    { "type": "text", "id": "unavailable_heading", "label": "Titre de l'alerte", "default": "Cet horaire n'est plus disponible" },
    { "type": "textarea", "id": "unavailable_text", "label": "Texte de l'alerte", "default": "Le créneau que vous avez sélectionné vient d'être réservé par un autre convive. Nous vous proposons ces alternatives :" },
    { "type": "text", "id": "no_alternative", "label": "Aucune alternative", "default": "Plus aucun horaire ce jour-là : choisissez une autre date." },
    { "type": "text", "id": "confirm_heading", "label": "Titre de la réservation confirmée", "default": "Réservation confirmée" },
    { "type": "text", "id": "number_label", "label": "Libellé du numéro", "default": "Numéro de réservation" },
    { "type": "text", "id": "calendar_label", "label": "Bouton agenda", "default": "Ajouter au calendrier" },
    { "type": "text", "id": "manage_label", "label": "Bouton gérer", "default": "Gérer ma réservation" },
    { "type": "url", "id": "manage_link", "label": "Page Ma réservation" },
    { "type": "text", "id": "aside_confirm", "label": "Photo de la confirmation (encadré)" },
    { "type": "text", "id": "map_label", "label": "Bouton du plan", "default": "Voir le plan" },
    { "type": "url", "id": "map_link", "label": "Lien du plan" }
  ],
  "presets": [{ "name": "Réservation de table" }]
}
{% endschema %}
