{%- comment -%}
  Expérience jour / nuit : une même scène qui bascule entre deux ambiances (image ou vidéo « jour » et « nuit »,
  textes associés). Interrupteur animé ; bascule optionnelle au défilement (scène fixée pendant le passage).
  Moins d'animations demandé : pas de bascule au défilement, changement instantané à l'interrupteur.
{%- endcomment -%}
{%- assign uid = 'es-dn-' | append: section.id -%}
<section class="es-dn es-dn--{{ section.settings.height }}{% if section.settings.scroll_switch %} es-dn--scroll{% endif %}{% if section.settings.stars %} es-dn--stars{% endif %} color-{{ section.settings.color_scheme }}" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --tint: {{ section.settings.night_tint | divided_by: 100.0 }};" data-es-day-night>
  <div class="es-dn__track" data-dn-track>
    <div class="es-dn__stage">
      <div class="es-dn__layer es-dn__layer--day" data-dn-layer="day">
        {% render 'es-section-media', image: section.settings.day_image, asset: section.settings.day_image_asset, video: section.settings.day_video, video_asset: section.settings.day_video_asset, alt: section.settings.day_title, sizes: '100vw' %}
      </div>
      <div class="es-dn__layer es-dn__layer--night" data-dn-layer="night">
        {% render 'es-section-media', image: section.settings.night_image, asset: section.settings.night_image_asset, video: section.settings.night_video, video_asset: section.settings.night_video_asset, alt: section.settings.night_title, sizes: '100vw' %}
        <span class="es-dn__tint" aria-hidden="true"></span>
        {%- if section.settings.stars -%}<span class="es-dn__starfield" aria-hidden="true"></span>{%- endif -%}
      </div>
      <span class="es-dn__veil" aria-hidden="true"></span>
      <span class="es-dn__glow" aria-hidden="true"></span>

      <div class="es-dn__content es-container">
        <header class="es-dn__head">
          {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow es-dn__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="es-heading es-dn__title">{{ section.settings.heading }}</h2>{%- endif -%}
        </header>
        <div class="es-dn__bottom">
          <div class="es-dn__switch-row">
            <span class="es-dn__label es-dn__label--day" aria-hidden="true">{{ section.settings.day_label }}</span>
            <button type="button" class="es-dn__switch" role="switch" aria-checked="false" aria-label="{{ section.settings.night_label | escape }}" aria-describedby="{{ uid }}-texts" data-dn-switch>
              <span class="es-dn__knob" aria-hidden="true">
                <svg class="es-dn__sun" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
                <svg class="es-dn__moon" viewBox="0 0 24 24" focusable="false"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z" fill="currentColor"/></svg>
              </span>
            </button>
            <span class="es-dn__label es-dn__label--night" aria-hidden="true">{{ section.settings.night_label }}</span>
          </div>
          <div class="es-dn__texts" id="{{ uid }}-texts" aria-live="polite">
            <div class="es-dn__text es-dn__text--day" data-dn-text="day">
              {%- if section.settings.day_title != blank -%}<h3 class="es-heading es-h3">{{ section.settings.day_title }}</h3>{%- endif -%}
              {%- if section.settings.day_text != blank -%}<div class="es-rte">{{ section.settings.day_text }}</div>{%- endif -%}
            </div>
            <div class="es-dn__text es-dn__text--night" data-dn-text="night" hidden>
              {%- if section.settings.night_title != blank -%}<h3 class="es-heading es-h3">{{ section.settings.night_title }}</h3>{%- endif -%}
              {%- if section.settings.night_text != blank -%}<div class="es-rte">{{ section.settings.night_text }}</div>{%- endif -%}
            </div>
          </div>
          {%- if section.settings.button_label != blank -%}
            <div class="es-actions es-dn__actions"><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="es-button">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
@property --night { syntax: '<number>'; inherits: true; initial-value: 0; }
.es-dn { --night: 0; position: relative; color: #fff; background: #0d1020; transition: --night 1.4s cubic-bezier(.65,0,.35,1); }
.es-dn.is-scrolling { transition: --night .2s linear; }
.es-dn__track { position: relative; }
.es-dn__stage { position: relative; overflow: hidden; isolation: isolate; display: grid; min-height: clamp(560px, 86svh, 960px); }
.es-dn--screen .es-dn__stage { min-height: 100svh; }
.es-dn--scroll .es-dn__track { height: 220svh; }
.es-dn--scroll .es-dn__stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
.es-dn__layer { position: absolute; inset: 0; }
.es-dn__layer > img, .es-dn__layer > video, .es-dn__layer > .es-placeholder { position: absolute; inset: 0; }
.es-dn__layer--day { transform: scale(calc(1 + var(--night) * .04)); }
.es-dn__layer--night { opacity: var(--night); transform: scale(calc(1.04 - var(--night) * .04)); }
.es-dn__layer .es-smedia__video { opacity: 0; transition: opacity .8s ease; }
.es-dn__layer .es-smedia__video.is-playing, .es-dn__layer .es-smedia__video:only-child { opacity: 1; }
.es-dn__tint { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(4, 10, 46, calc(var(--tint) + .2)), rgba(16, 10, 48, calc(var(--tint) + .05))); mix-blend-mode: multiply; }
.es-dn__starfield { position: absolute; inset: 0 0 45% 0; opacity: calc(var(--night) * .9); background-image:
  radial-gradient(1.5px 1.5px at 12% 18%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 27% 8%, #fff 50%, transparent 51%),
  radial-gradient(1.2px 1.2px at 41% 26%, #fff 50%, transparent 51%), radial-gradient(1.6px 1.6px at 58% 12%, #fff 50%, transparent 51%),
  radial-gradient(1px 1px at 69% 30%, #fff 50%, transparent 51%), radial-gradient(1.4px 1.4px at 83% 16%, #fff 50%, transparent 51%),
  radial-gradient(1px 1px at 92% 6%, #fff 50%, transparent 51%), radial-gradient(1.2px 1.2px at 6% 36%, #fff 50%, transparent 51%),
  radial-gradient(1px 1px at 35% 40%, #fff 50%, transparent 51%), radial-gradient(1.3px 1.3px at 77% 42%, #fff 50%, transparent 51%);
  -webkit-mask-image: linear-gradient(180deg, #000, transparent); mask-image: linear-gradient(180deg, #000, transparent); }
.es-dn--stars .es-dn__starfield { animation: es-dn-twinkle 4s ease-in-out infinite alternate; }
@keyframes es-dn-twinkle { from { filter: brightness(.7); } to { filter: brightness(1.3); } }
.es-dn__veil { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0, calc(var(--overlay) * .8)) 0%, rgba(0,0,0,0) 34%, rgba(0,0,0,0) 48%, rgba(0,0,0, calc(var(--overlay) + .3)) 100%); }
.es-dn__glow { position: absolute; width: 60vmax; height: 60vmax; right: -18vmax; top: -24vmax; border-radius: 50%; pointer-events: none;
  background: radial-gradient(closest-side, rgba(255, 214, 140, .45), rgba(255, 214, 140, 0)); opacity: calc(1 - var(--night)); mix-blend-mode: screen; }
.es-dn__content { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; padding-block: clamp(56px, 10vh, 110px) clamp(40px, 8vh, 80px); min-height: 100%; }
.es-dn__eyebrow { color: inherit; opacity: .85; }
.es-dn__title { color: inherit; font-size: calc(clamp(2.4rem, 6.4vw, 5.6rem) * var(--heading-scale)); line-height: 1; max-width: 14ch; margin: 0; }
.es-dn__bottom { display: grid; gap: 22px; max-width: 560px; }
.es-dn__switch-row { display: flex; align-items: center; gap: 14px; font-weight: var(--font-body-weight-bold); font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; }
.es-dn__label { transition: opacity .4s; }
.es-dn__label--day { opacity: calc(1 - var(--night) * .55); }
.es-dn__label--night { opacity: calc(.45 + var(--night) * .55); }
.es-dn__switch { position: relative; width: 88px; height: 44px; flex: none; border-radius: 99px; border: 1px solid rgba(255,255,255,.45); padding: 0; cursor: pointer; overflow: hidden;
  background: linear-gradient(135deg, #8fd0ff, #ffd98a); box-shadow: inset 0 2px 8px rgba(0,0,0,.18), 0 10px 30px -12px rgba(0,0,0,.6); }
.es-dn__switch::before { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, #0b1236, #2b2363); opacity: var(--night); }
.es-dn__switch::after { content: ""; position: absolute; inset: 0; opacity: var(--night); background-image: radial-gradient(1px 1px at 22% 30%, #fff 50%, transparent 51%), radial-gradient(1.4px 1.4px at 36% 70%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 48% 40%, #fff 50%, transparent 51%); }
.es-dn__knob { position: absolute; z-index: 1; top: 4px; left: 4px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
  background: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.25); transform: translateX(calc(var(--night) * 44px)) rotate(calc(var(--night) * 360deg)); }
.es-dn__knob svg { position: absolute; width: 20px; height: 20px; }
.es-dn__sun { color: #f2a300; opacity: calc(1 - var(--night)); }
.es-dn__moon { color: #3b3f8f; opacity: var(--night); }
.es-dn__switch:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
.es-dn__texts { display: grid; }
.es-dn__text { grid-area: 1 / 1; transition: opacity .6s var(--ease-out), transform .7s var(--ease-out); }
.es-dn__text[hidden] { display: block; visibility: hidden; opacity: 0; transform: translateY(14px); }
.es-dn__text .es-h3 { color: inherit; margin-bottom: .35em; }
.es-dn__text .es-rte { opacity: .9; font-size: 1.05em; }
.es-dn__actions { margin-top: 0; }
@media (max-width: 749px) {
  .es-dn__switch { width: 76px; height: 40px; }
  .es-dn__knob { width: 30px; height: 30px; transform: translateX(calc(var(--night) * 36px)) rotate(calc(var(--night) * 360deg)); }
}
@media (prefers-reduced-motion: reduce) {
  .es-dn, .es-dn.is-scrolling { transition: none; }
  .es-dn--scroll .es-dn__track { height: auto; }
  .es-dn--scroll .es-dn__stage { position: relative; height: auto; min-height: clamp(560px, 86svh, 960px); }
  .es-dn__layer--day, .es-dn__layer--night { transform: none; }
  .es-dn__text { transition: none; }
  .es-dn--stars .es-dn__starfield { animation: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.EsDayNight) return;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || (window.themeSettings && window.themeSettings.motion === false);
  function init(root) {
    if (!root || root._esDn) return;
    root._esDn = true;
    var sw = root.querySelector('[data-dn-switch]');
    var track = root.querySelector('[data-dn-track]');
    var texts = { day: root.querySelector('[data-dn-text="day"]'), night: root.querySelector('[data-dn-text="night"]') };
    var layers = { day: root.querySelector('[data-dn-layer="day"]'), night: root.querySelector('[data-dn-layer="night"]') };
    var scrollMode = root.classList.contains('es-dn--scroll') && !reduce;
    var night = false, visible = false;
    function playVideos() {
      ['day', 'night'].forEach(function (k) {
        Array.prototype.forEach.call(layers[k].querySelectorAll('video'), function (v) {
          if (!reduce && visible && (k === 'night') === night) { var p = v.play(); v.classList.add('is-playing'); if (p && p.catch) p.catch(function () { v.classList.remove('is-playing'); }); }
          else v.pause();
        });
      });
    }
    function setState(isNight) {
      if (isNight === night) return;
      night = isNight;
      sw.setAttribute('aria-checked', night ? 'true' : 'false');
      texts.day.hidden = night; texts.night.hidden = !night;
      root.classList.toggle('is-night', night);
      playVideos();
    }
    function setNight(v) { root.style.setProperty('--night', v.toFixed(3)); }
    function onScroll() {
      var r = track.getBoundingClientRect(), vh = window.innerHeight;
      var span = Math.max(1, r.height - vh);
      var p = Math.min(1, Math.max(0, -r.top / span));
      var t = Math.min(1, Math.max(0, (p - .3) / .4));
      var eased = t * t * (3 - 2 * t);
      setNight(eased);
      setState(eased > .5);
    }
    sw.addEventListener('click', function () {
      if (scrollMode) {
        var r = track.getBoundingClientRect(), vh = window.innerHeight;
        var top = window.scrollY + r.top + (r.height - vh) * (night ? .1 : .82);
        window.scrollTo({ top: top, behavior: 'smooth' });
        return;
      }
      setState(!night);
      setNight(night ? 1 : 0);
    });
    if (scrollMode) {
      root.classList.add('is-scrolling');
      var ticking = false;
      window.addEventListener('scroll', function () { if (ticking) return; ticking = true; requestAnimationFrame(function () { onScroll(); ticking = false; }); }, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }
    if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { visible = es[0].isIntersecting; playVideos(); }, { threshold: 0.05 }).observe(root);
  }
  function initAll(ctx) { Array.prototype.forEach.call((ctx || document).querySelectorAll('[data-es-day-night]'), init); }
  window.EsDayNight = { init: initAll };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { initAll(); }); else initAll();
  document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Expérience jour / nuit",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le matin comme le soir" },
    { "type": "text", "id": "day_label", "label": "Libellé « jour » de l'interrupteur", "default": "Jour" },
    { "type": "text", "id": "night_label", "label": "Libellé « nuit » de l'interrupteur", "default": "Nuit" },
    { "type": "checkbox", "id": "scroll_switch", "label": "Bascule au défilement", "default": true, "info": "La scène reste à l'écran et passe du jour à la nuit pendant le défilement. Désactivée si le visiteur a demandé moins d'animations." },
    { "type": "header", "content": "Jour" },
    { "type": "image_picker", "id": "day_image", "label": "Image (ou affiche de la vidéo)" },
    { "type": "text", "id": "day_image_asset", "label": "Image fournie avec le thème" },
    { "type": "video", "id": "day_video", "label": "Vidéo (hébergée par Shopify)" },
    { "type": "text", "id": "day_video_asset", "label": "Vidéo fournie avec le thème (MP4)" },
    { "type": "text", "id": "day_title", "label": "Titre", "default": "Au réveil" },
    { "type": "richtext", "id": "day_text", "label": "Texte", "default": "<p>[À compléter : comment votre produit s'utilise le matin.]</p>" },
    { "type": "header", "content": "Nuit" },
    { "type": "image_picker", "id": "night_image", "label": "Image (ou affiche de la vidéo)" },
    { "type": "text", "id": "night_image_asset", "label": "Image fournie avec le thème" },
    { "type": "video", "id": "night_video", "label": "Vidéo (hébergée par Shopify)" },
    { "type": "text", "id": "night_video_asset", "label": "Vidéo fournie avec le thème (MP4)" },
    { "type": "text", "id": "night_title", "label": "Titre", "default": "Le soir venu" },
    { "type": "richtext", "id": "night_text", "label": "Texte", "default": "<p>[À compléter : comment il accompagne vos soirées.]</p>" },
    { "type": "range", "id": "night_tint", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Filtre bleu nuit sur l'image", "default": 50, "info": "Permet d'utiliser la même photo pour le jour et la nuit." },
    { "type": "checkbox", "id": "stars", "label": "Étoiles discrètes la nuit", "default": true },
    { "type": "header", "content": "Affichage" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "height", "label": "Hauteur (sans bascule au défilement)", "default": "large", "options": [ { "value": "large", "label": "Grande" }, { "value": "screen", "label": "Plein écran" } ] },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Voile sur l'image", "default": 30 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Expérience jour / nuit" }]
}
{% endschema %}
