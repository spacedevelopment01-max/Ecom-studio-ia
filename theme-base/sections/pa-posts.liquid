{%- comment -%}
  PARENTHÈSE : articles du journal.
  - row : « Conseils et inspirations » (accueil) : trois lignes vignette + titre + texte + « Lire l'article » ;
  - journal : filtres par catégorie (Tous, Quotidien, La pratique, Le cabinet) qui filtrent vraiment, article à la une,
    grille de cartes (planche 05) ;
  - related : « Ces articles pourraient vous intéresser » (fin d'article).
  Chaque carte mène à la page complète de l'article. Blocs : « Article ».
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if section.blocks.size > 0 -%}
<section class="pa-section pa-posts pa-posts--{{ s.layout }}" {% if s.layout == 'journal' %}data-pa-filter-root{% endif %}>
  <div class="pa-wrap">
    {%- if s.heading != blank -%}<h2 class="pa-title pa-title--md">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.layout == 'journal' -%}
      <div class="pa-chips" role="group" aria-label="{{ s.filters_label | escape }}">
        <button type="button" class="pa-chip" aria-pressed="true" data-pa-filter="all">{{ s.all_label }}</button>
        {%- if s.cat1_label != blank -%}<button type="button" class="pa-chip" aria-pressed="false" data-pa-filter="{{ s.cat1_key }}">{{ s.cat1_label }}</button>{%- endif -%}
        {%- if s.cat2_label != blank -%}<button type="button" class="pa-chip" aria-pressed="false" data-pa-filter="{{ s.cat2_key }}">{{ s.cat2_label }}</button>{%- endif -%}
        {%- if s.cat3_label != blank -%}<button type="button" class="pa-chip" aria-pressed="false" data-pa-filter="{{ s.cat3_key }}">{{ s.cat3_label }}</button>{%- endif -%}
      </div>
      <p class="pa-empty" data-pa-empty hidden>{{ s.empty_text }}</p>
    {%- endif -%}
    <ul class="pa-posts__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="pa-post{% if b.featured and s.layout == 'journal' %} pa-post--featured{% endif %}" data-pa-cat="{{ b.category_key }}" {{ block.shopify_attributes }}>
          <a class="pa-post__media" href="{{ b.link }}" tabindex="-1" aria-hidden="true">{% render 'pa-img', image: b.image, asset: b.image_asset, alt: '', pos: b.image_position, class: 'pa-post__img' %}</a>
          <div class="pa-post__body">
            {%- if s.layout != 'row' -%}<p class="pa-post__cat">{% if b.featured and s.layout == 'journal' %}<span>{{ s.featured_label }}</span><span aria-hidden="true">•</span>{% endif %}<span>{{ b.category }}</span></p>{%- endif -%}
            <h3 class="pa-post__title"><a href="{{ b.link }}">{{ b.title | escape | newline_to_br }}</a></h3>
            {%- if b.text != blank -%}<p class="pa-post__text">{{ b.text }}</p>{%- endif -%}
            <span class="pa-link" aria-hidden="true">{{ s.read_label }}{% render 'pa-icon', name: 'arrow' %}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Articles du journal",
  "class": "pa-posts-section",
  "max_blocks": 16,
  "settings": [
    { "type": "select", "id": "layout", "label": "Disposition", "default": "row", "options": [{ "value": "row", "label": "Lignes (accueil)" }, { "value": "journal", "label": "Journal avec filtres" }, { "value": "related", "label": "Articles associés" }] },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Conseils et inspirations" },
    { "type": "text", "id": "read_label", "label": "Texte du lien", "default": "Lire l'article" },
    { "type": "header", "content": "Filtres (journal)" },
    { "type": "text", "id": "filters_label", "label": "Nom du groupe de filtres (lecteurs d'écran)", "default": "Filtrer les articles" },
    { "type": "text", "id": "all_label", "label": "Filtre « tous »", "default": "Tous" },
    { "type": "text", "id": "cat1_key", "label": "Catégorie 1 : identifiant", "default": "quotidien" },
    { "type": "text", "id": "cat1_label", "label": "Catégorie 1 : nom", "default": "Quotidien" },
    { "type": "text", "id": "cat2_key", "label": "Catégorie 2 : identifiant", "default": "pratique" },
    { "type": "text", "id": "cat2_label", "label": "Catégorie 2 : nom", "default": "La pratique" },
    { "type": "text", "id": "cat3_key", "label": "Catégorie 3 : identifiant", "default": "cabinet" },
    { "type": "text", "id": "cat3_label", "label": "Catégorie 3 : nom", "default": "Le cabinet" },
    { "type": "text", "id": "featured_label", "label": "Mention de l'article à la une", "default": "À la une" },
    { "type": "text", "id": "empty_text", "label": "Texte sans article", "default": "Aucun article dans cette catégorie pour le moment." }
  ],
  "blocks": [
    {
      "type": "post", "name": "Article",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Photo fournie avec le thème" },
        { "type": "text", "id": "image_position", "label": "Cadrage de la photo", "default": "50% 50%" },
        { "type": "text", "id": "category", "label": "Catégorie affichée", "default": "Quotidien" },
        { "type": "text", "id": "category_key", "label": "Identifiant de la catégorie (filtre)", "default": "quotidien" },
        { "type": "textarea", "id": "title", "label": "Titre", "default": "Faire une place à la pause" },
        { "type": "text", "id": "text", "label": "Résumé" },
        { "type": "url", "id": "link", "label": "Page de l'article" },
        { "type": "checkbox", "id": "featured", "label": "À la une", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Articles du journal" }]
}
{% endschema %}
