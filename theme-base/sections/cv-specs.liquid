{%- comment -%}
  Caractéristiques et contenu du colis : groupes dépliables (titre + lignes « Libellé : valeur », une par ligne) et
  liste du contenu de la boîte. Tout vient des réglages : aucune caractéristique n'est inventée ; les valeurs à
  confirmer se notent « [À compléter] ».
  MUSEAU CLUB (maquettes du 23 octobre) : tableau (guide des tailles : une ligne par groupe, colonnes tirées des
  libellés du premier groupe) et cartes ouvertes avec pictogramme et texte (livraison, suivi, retours).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign speed = s.animation_speed | default: 'normal'
-%}
<section class="es-section cv-specs cv-specs--{{ s.layout }} cv-anim cv-anim--{{ speed }} color-{{ s.color_scheme }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;">
  <div class="es-container cv-specs__inner">
    <header class="cv-head cv-specs__head"{% render 'cv-reveal', animation: s.animation %}>
      {%- if s.eyebrow != blank -%}<p class="cv-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="es-heading cv-title cv-title--h2">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em class="cv-accent">{{ s.heading_accent | escape }}</em>{% endif %}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="es-rte cv-head__text">{{ s.text }}</div>{%- endif -%}
    </header>
    {%- if s.layout == 'table' -%}
      {%- assign first_group = section.blocks | where: 'type', 'group' | first -%}
      {%- assign head_lines = first_group.settings.rows | newline_to_br | split: '<br />' -%}
      <div class="cv-specs__table-wrap"{% render 'cv-reveal', animation: s.animation %}>
        <table class="cv-specs__table">
          <thead><tr><th scope="col">{{ s.table_first_column | escape }}</th>{%- for item in head_lines -%}{%- assign line = item | strip -%}{%- if line != blank -%}{%- assign parts = line | split: ' : ' -%}<th scope="col">{{ parts[0] | escape }}</th>{%- endif -%}{%- endfor -%}</tr></thead>
          <tbody>
            {%- for block in section.blocks -%}{%- if block.type == 'group' -%}
              {%- assign lines = block.settings.rows | newline_to_br | split: '<br />' -%}
              <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.title | escape }}</th>{%- for item in lines -%}{%- assign line = item | strip -%}{%- if line != blank -%}{%- assign parts = line | split: ' : ' -%}<td>{% if parts.size > 1 %}{{ parts[1] | escape }}{% endif %}</td>{%- endif -%}{%- endfor -%}</tr>
            {%- endif -%}{%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- else -%}
    <div class="cv-specs__groups">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            {%- if s.layout == 'cards' -%}
            <div class="cv-specs__card" {{ block.shopify_attributes }}{% render 'cv-reveal', animation: s.animation, index: forloop.index0 %}>
              <div class="cv-specs__card-head">{%- if block.settings.icon != blank and block.settings.icon != 'none' -%}<span class="cv-specs__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</span>{%- endif -%}<div><h3 class="es-heading cv-specs__card-title">{{ block.settings.title | escape }}</h3>{%- if block.settings.text != blank -%}<div class="es-rte cv-specs__card-text">{{ block.settings.text }}</div>{%- endif -%}</div></div>
              <dl class="cv-specs__rows">
                {%- assign lines = block.settings.rows | newline_to_br | split: '<br />' -%}
                {%- for item in lines -%}{%- assign line = item | strip -%}{%- if line != blank -%}
                  {%- assign parts = line | split: ' : ' -%}
                  <div class="cv-specs__row"><dt>{{ parts[0] | escape }}</dt><dd>{% if parts.size > 1 %}{{ parts[1] | escape }}{% else %}&nbsp;{% endif %}</dd></div>
                {%- endif -%}{%- endfor -%}
              </dl>
            </div>
            {%- else -%}
            <details class="cv-specs__group" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %} {% render 'cv-reveal', animation: s.animation, index: forloop.index0 %}>
              <summary class="cv-specs__summary"><span>{{ block.settings.title | escape }}</span><span class="es-faq__icon" aria-hidden="true"><i></i><i></i></span></summary>
              <dl class="cv-specs__rows">
                {%- assign lines = block.settings.rows | newline_to_br | split: '<br />' -%}
                {%- for item in lines -%}{%- assign line = item | strip -%}{%- if line != blank -%}
                  {%- assign parts = line | split: ' : ' -%}
                  <div class="cv-specs__row"><dt>{{ parts[0] | escape }}</dt><dd>{% if parts.size > 1 %}{{ parts[1] | escape }}{% else %}&nbsp;{% endif %}</dd></div>
                {%- endif -%}{%- endfor -%}
              </dl>
            </details>
            {%- endif -%}
          {%- when 'box' -%}
            <div class="cv-specs__box" {{ block.shopify_attributes }}{% render 'cv-reveal', animation: s.animation, index: forloop.index0 %}>
              <h3 class="cv-specs__box-title">{{ block.settings.title | escape }}</h3>
              <ul class="cv-specs__items" role="list">
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}{%- assign line = item | strip -%}{%- if line != blank -%}<li><span class="cv-check" aria-hidden="true">{% render 'icon', name: 'check' %}</span><span>{{ line | escape }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if s.note != blank -%}<p class="cv-fictional-note"><span class="cv-fictional">{{ s.note | escape }}</span></p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fiche et contenu du colis",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Caractéristiques"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Fin du titre en accent"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "default": "stacked",
      "options": [
        {
          "value": "stacked",
          "label": "Titre puis groupes"
        },
        {
          "value": "side",
          "label": "Titre à gauche, groupes à droite sur ordinateur"
        },
        {
          "value": "table",
          "label": "Tableau (une ligne par groupe)"
        },
        {
          "value": "cards",
          "label": "Cartes ouvertes avec pictogramme"
        }
      ]
    },
    {
      "type": "text",
      "id": "table_first_column",
      "label": "Tableau : titre de la première colonne",
      "default": "Taille"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Mention",
      "info": "Ex. « Valeurs à confirmer avant publication ». Vide : aucune mention."
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "rise",
      "options": [
        {
          "value": "none",
          "label": "Aucune"
        },
        {
          "value": "fade",
          "label": "Fondu"
        },
        {
          "value": "rise",
          "label": "Montée en fondu"
        },
        {
          "value": "zoom",
          "label": "Léger zoom"
        }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Vitesse",
      "default": "normal",
      "options": [
        {
          "value": "slow",
          "label": "Lente"
        },
        {
          "value": "normal",
          "label": "Normale"
        },
        {
          "value": "fast",
          "label": "Rapide"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schéma de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espace en dessous",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Groupe dépliable",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Dimensions et matières"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Lignes",
          "info": "Une par ligne, « Libellé : valeur ». Notez « [À compléter] » pour une valeur non confirmée."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Ouvert par défaut",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Pictogramme (cartes)",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "Aucun"
            },
            {
              "value": "truck",
              "label": "Livraison"
            },
            {
              "value": "return",
              "label": "Retour"
            },
            {
              "value": "search",
              "label": "Suivi"
            },
            {
              "value": "shield",
              "label": "Protection"
            },
            {
              "value": "mail",
              "label": "E-mail"
            },
            {
              "value": "ruler",
              "label": "Mesure"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte (cartes)"
        }
      ]
    },
    {
      "type": "box",
      "name": "Contenu du colis",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Dans la boîte"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Éléments",
          "info": "Un par ligne."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Fiche et contenu du colis",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "open": true
          }
        },
        {
          "type": "group"
        },
        {
          "type": "box"
        }
      ]
    }
  ]
}
{% endschema %}
