{%- comment -%}
  Parcours de livraison : commande → préparation → expédition → livraison. Délais saisis par le marchand
  (espaces réservés par défaut, jamais de délai inventé). Frise qui se dessine à l'apparition.
{%- endcomment -%}
{%- assign steps = section.blocks | size -%}
<section class="es-section es-ship color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --n: {{ steps | at_least: 1 }};" data-ship>
  <div class="es-container">
    <header class="es-ship__head">
      {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading }}</h2>{%- endif -%}
    </header>
    <ol class="es-ship__list" role="list">
      <li class="es-ship__line" aria-hidden="true"><span class="es-ship__fill"><span class="es-ship__head-dot"></span></span></li>
      {%- for block in section.blocks -%}
        <li class="es-ship__step" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="es-ship__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'package' -%}<svg class="es-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9M7.8 5.2l8.5 4.6"/></svg>
              {%- when 'home' -%}<svg class="es-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/></svg>
              {%- when 'store' -%}<svg class="es-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="M4 9.5 5.5 4h13L20 9.5"/><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0"/><path d="M5.5 11.5V20h13v-8.5M10 20v-4.5h4V20"/></svg>
              {%- else -%}{% render 'icon', name: block.settings.icon %}
            {%- endcase -%}
            <span class="es-ship__num">{{ forloop.index }}</span>
          </span>
          <div class="es-ship__body">
            {%- if block.settings.delay != blank -%}<p class="es-ship__delay">{{ block.settings.delay }}</p>{%- endif -%}
            <h3 class="es-heading es-h4 es-ship__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<div class="es-ship__text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank or section.settings.link_label != blank -%}
      <div class="es-ship__foot" data-reveal="up">
        {%- if section.settings.note != blank -%}<div class="es-ship__note">{% render 'icon', name: 'truck' %}<div class="es-rte">{{ section.settings.note }}</div></div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}<a class="es-link-arrow" href="{{ section.settings.link | default: '/policies/shipping-policy' }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.es-ship__head { text-align: center; max-width: 720px; margin: 0 auto clamp(32px, 5vw, 64px); }
.es-ship__list { --on: 0; list-style: none; margin: 0; padding: 0 0 0 76px; position: relative; display: grid; gap: 28px; }
.es-ship__line { position: absolute; left: 27px; top: 28px; bottom: 28px; width: 2px; background: repeating-linear-gradient(to bottom, rgba(var(--c-text-rgb), .22) 0 6px, transparent 6px 12px); }
.es-ship__fill { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: linear-gradient(var(--c-accent), color-mix(in srgb, var(--c-accent) 60%, var(--c-text))); transform-origin: top; transform: scaleY(var(--on)); transition: transform 1.2s var(--ease-in-out); }
.es-ship__head-dot { display: none; }
.es-ship__step { position: relative; }
.es-ship__icon { position: absolute; left: -76px; top: 0; width: 56px; height: 56px; display: grid; place-items: center; border-radius: 50%; background: var(--c-bg); border: 1.5px solid rgba(var(--c-text-rgb), .18); color: var(--c-text); transition: background .5s var(--ease-out), color .5s, border-color .5s, transform .6s var(--ease-out), box-shadow .6s; transition-delay: calc(var(--i) * .22s + .1s); }
.es-ship__icon .es-icon { width: 24px; height: 24px; }
.es-ship__num { position: absolute; right: -4px; top: -4px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 10px; display: grid; place-items: center; background: var(--c-text); color: var(--c-bg); font-size: .68rem; font-weight: 700; }
.es-ship.is-on .es-ship__icon { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-accent-text); transform: scale(1.06); box-shadow: 0 14px 30px -14px rgba(var(--c-accent-rgb), .8); }
.es-ship__body { padding-top: 4px; }
.es-ship__delay { display: inline-block; margin: 0 0 8px; padding: 4px 11px; border-radius: 999px; background: rgba(var(--c-accent-rgb), .13); font-size: .8rem; font-weight: 700; letter-spacing: .02em; }
.es-ship__title { margin-bottom: .3em; }
.es-ship__text { color: var(--c-muted); font-size: .96rem; line-height: 1.55; }
.es-ship__text p { margin: 0; }
.motion-ready .es-ship__body { opacity: 0; transform: translateY(14px); transition: opacity .7s var(--ease-out), transform .8s var(--ease-out); transition-delay: calc(var(--i) * .22s + .15s); }
.motion-ready .es-ship.is-on .es-ship__body { opacity: 1; transform: none; }
.es-ship__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; margin-top: clamp(32px, 5vw, 56px); padding: 18px 22px; border-radius: var(--radius-card); background: rgba(var(--c-text-rgb), .04); border: 1px solid var(--c-border); }
.es-ship__note { display: flex; gap: 12px; align-items: flex-start; font-size: .92rem; flex: 1 1 320px; }
.es-ship__note .es-icon { width: 22px; height: 22px; color: var(--c-accent); }
.es-ship__note p { margin: 0; }
@media (min-width: 750px) {
  .es-ship__list { padding: 0; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); }
  .es-ship__line { left: calc(50% / var(--n)); right: calc(50% / var(--n)); top: 35px; bottom: auto; width: auto; height: 2px; background: repeating-linear-gradient(to right, rgba(var(--c-text-rgb), .22) 0 6px, transparent 6px 12px); }
  .es-ship__fill { transform-origin: left; transform: scaleX(var(--on)); }
  .es-ship__step { display: grid; justify-items: center; align-content: start; text-align: center; gap: 22px; }
  .es-ship__icon { position: relative; left: auto; width: 72px; height: 72px; }
  .es-ship__icon .es-icon { width: 30px; height: 30px; }
  .es-ship__text { max-width: 30ch; margin-inline: auto; }
}
@media (prefers-reduced-motion: reduce) {
  .es-ship__fill, .es-ship__icon { transition: none; }
  .motion-ready .es-ship__body { opacity: 1; transform: none; transition: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.esShippingJourney) return; window.esShippingJourney = true;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || (window.themeSettings && window.themeSettings.motion === false);
  function on(s) { s.classList.add('is-on'); var l = s.querySelector('.es-ship__list'); if (l) l.style.setProperty('--on', '1'); }
  function init(root) {
    Array.prototype.forEach.call((root || document).querySelectorAll('[data-ship]'), function (s) {
      if (s._es) return; s._es = true;
      if (reduce || !('IntersectionObserver' in window)) return on(s);
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { on(s); io.disconnect(); } }); }, { threshold: 0.35 });
      io.observe(s.querySelector('.es-ship__list') || s);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); }); else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Parcours de livraison",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Indiquez uniquement vos délais réels (jours ouvrés), identiques à votre politique de livraison." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Livraison" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "De la commande à chez vous" },
    { "type": "richtext", "id": "note", "label": "Précisions", "default": "<p>[À compléter : délais indicatifs en jours ouvrés, transporteurs et pays livrés.]</p>" },
    { "type": "text", "id": "link_label", "label": "Lien (texte)", "default": "Politique de livraison" },
    { "type": "url", "id": "link", "label": "Lien", "info": "Vide : votre politique de livraison Shopify." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 80 }
  ],
  "blocks": [
    { "type": "step", "name": "Étape", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "truck", "options": [{ "value": "cart", "label": "Panier" }, { "value": "package", "label": "Colis" }, { "value": "truck", "label": "Camion" }, { "value": "home", "label": "Maison" }, { "value": "store", "label": "Boutique" }, { "value": "check", "label": "Coche" }, { "value": "clock", "label": "Horloge" }, { "value": "globe", "label": "Globe" }, { "value": "mail", "label": "E-mail" }, { "value": "gift", "label": "Cadeau" }, { "value": "return", "label": "Retour" }] },
      { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
      { "type": "text", "id": "delay", "label": "Délai", "default": "[À compléter : délai]", "info": "Ex. « 24 à 48 h ouvrées ». Vide : aucun délai affiché." },
      { "type": "richtext", "id": "text", "label": "Texte" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Parcours de livraison", "blocks": [
    { "type": "step", "settings": { "icon": "cart", "title": "Commande", "delay": "Jour J", "text": "<p>Vous validez votre commande et recevez une confirmation par e-mail.</p>" } },
    { "type": "step", "settings": { "icon": "package", "title": "Préparation", "text": "<p>Votre commande est préparée et emballée.</p>" } },
    { "type": "step", "settings": { "icon": "truck", "title": "Expédition", "text": "<p>[À compléter : transporteur et suivi du colis.]</p>" } },
    { "type": "step", "settings": { "icon": "home", "title": "Livraison", "text": "<p>Votre colis arrive à l'adresse choisie.</p>" } }
  ] }]
}
{% endschema %}
