{%- comment -%}
  TABLE SAISON : pages légales (Mentions légales, Confidentialité, Conditions de réservation, Cookies) avec onglets
  entre ces pages. Chaque rubrique : titre, valeur à renseigner, texte. Rien n'est inventé : société, numéro
  d'immatriculation, hébergeur et engagements restent « [À renseigner] » tant que le restaurant ne les a pas saisis.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ts-section ts-legal">
  <div class="ts-wrap">
    <h1 class="ts-title ts-title--xl">{{ s.heading }}</h1>
    <nav class="ts-legal__tabs" aria-label="{{ s.tabs_label | escape }}">
      {%- for i in (1..4) -%}
        {%- assign lk = 'tab' | append: i | append: '_label' -%}
        {%- assign ll = 'tab' | append: i | append: '_link' -%}
        {%- if s[lk] != blank -%}<a href="{{ s[ll] }}"{% if s.current == i %} aria-current="page"{% endif %}>{{ s[lk] }}</a>{%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="ts-legal__box">
      {%- for block in section.blocks -%}
        <div class="ts-legal__item" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.title }}</h2>
          {%- if block.settings.value != blank -%}<p class="ts-text ts-todo" style="margin-bottom:6px">{{ block.settings.value }}</p>{%- endif -%}
          <div class="ts-text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page légale du restaurant",
  "class": "ts-legal-section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Mentions légales" },
    { "type": "text", "id": "tabs_label", "label": "Nom des onglets (accessibilité)", "default": "Informations légales" },
    { "type": "range", "id": "current", "label": "Onglet de cette page", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "text", "id": "tab1_label", "label": "Onglet 1", "default": "Mentions légales" },
    { "type": "url", "id": "tab1_link", "label": "Lien de l'onglet 1" },
    { "type": "text", "id": "tab2_label", "label": "Onglet 2", "default": "Confidentialité" },
    { "type": "url", "id": "tab2_link", "label": "Lien de l'onglet 2" },
    { "type": "text", "id": "tab3_label", "label": "Onglet 3", "default": "Conditions de réservation" },
    { "type": "url", "id": "tab3_link", "label": "Lien de l'onglet 3" },
    { "type": "text", "id": "tab4_label", "label": "Onglet 4", "default": "Cookies" },
    { "type": "url", "id": "tab4_link", "label": "Lien de l'onglet 4" }
  ],
  "blocks": [
    { "type": "item", "name": "Rubrique", "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Éditeur du site" },
      { "type": "text", "id": "value", "label": "Information à renseigner", "default": "[À renseigner]" },
      { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Contenu à compléter avant publication.</p>" }
    ] }
  ],
  "presets": [{ "name": "Page légale du restaurant" }]
}
{% endschema %}
