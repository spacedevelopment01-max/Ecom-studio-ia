{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="es-section es-fcoll color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    <header class="es-section-head es-section-head--split">
      <h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading | default: coll.title }}</h2>
      <a href="{{ coll.url }}" class="es-link-arrow" data-reveal="up">{{ 'collections.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>
    </header>
    <div class="es-product-grid" style="--cols: {{ section.settings.columns }}">
      {%- for p in coll.products limit: section.settings.limit -%}
        {% render 'product-card', product_card: p, show_secondary: true, ratio: section.settings.ratio %}
      {%- else -%}
        {%- for i in (1..3) -%}<article class="es-card"><div class="es-card__media">{{ 'product-1' | placeholder_svg_tag: 'es-placeholder__svg' }}</div></article>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection en vedette",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Colonnes", "default": 4 },
    { "type": "select", "id": "ratio", "label": "Format des images", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Carré" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "presets": [{ "name": "Collection en vedette" }]
}
{% endschema %}
