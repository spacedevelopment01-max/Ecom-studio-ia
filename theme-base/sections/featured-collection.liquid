{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="es-section es-fcoll color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="es-container">
    {%- assign shown = coll.products.size | at_most: section.settings.limit -%}
    <header class="es-section-head es-section-head--split es-fcoll__head{% if shown > 0 and shown < section.settings.columns %} es-fcoll__head--few{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="es-eyebrow" data-reveal="up">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="es-heading es-h2" data-reveal="words">{{ section.settings.heading | default: coll.title }}</h2>
      </div>
      <a href="{{ coll.url }}" class="es-link-arrow" data-reveal="up">{{ 'collections.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>
    </header>
    <div class="es-product-grid es-fcoll__grid{% if shown > 0 and shown < section.settings.columns %} es-fcoll__grid--few{% endif %}{% if shown == 1 %} es-fcoll__grid--one{% endif %}" style="--cols: {{ section.settings.columns }}; --n: {{ shown }};">
      {%- for p in coll.products limit: section.settings.limit -%}
        {% render 'product-card', product_card: p, show_secondary: true, ratio: section.settings.ratio %}
      {%- else -%}
        {%- for i in (1..3) -%}<article class="es-card"><div class="es-card__media">{{ 'product-1' | placeholder_svg_tag: 'es-placeholder__svg' }}</div></article>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>


{% stylesheet %}
.es-fcoll__head { align-items: flex-end; }
.es-fcoll__head .es-heading { margin: 0; }
.es-fcoll__head .es-eyebrow { margin-bottom: 10px; }
.es-fcoll__head .es-link-arrow { white-space: nowrap; flex: none; }
/* Moins de produits que de colonnes : cartes à leur taille habituelle, centrées (pas de vide à droite). */
@media (min-width: 990px) {
  .es-fcoll__grid--few { grid-template-columns: repeat(var(--n), calc((100% - (var(--cols) - 1) * clamp(14px, 2vw, 28px)) / var(--cols))); justify-content: center; }
}
@media (min-width: 990px) {
  .es-fcoll__head--few { flex-direction: column; align-items: center; text-align: center; gap: 14px; }
}
@media (max-width: 749px) {
  .es-fcoll__head { flex-wrap: wrap; }
  .es-fcoll .es-card__info { flex-direction: column; align-items: flex-start; gap: 4px; }
  .es-fcoll__grid--one { grid-template-columns: minmax(0, 340px); justify-content: center; }
}
.es-fcoll .es-price { white-space: nowrap; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection en vedette",
  "tag": "div",
  "class": "es-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Colonnes", "default": 4 },
    { "type": "select", "id": "ratio", "label": "Format des images", "default": "portrait", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Carré" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge haute", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "label": "Marge basse", "default": 96 }
  ],
  "presets": [{ "name": "Collection en vedette" }]
}
{% endschema %}
