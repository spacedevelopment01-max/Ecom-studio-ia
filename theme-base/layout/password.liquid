<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
    -%}
    {% style %}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {% for scheme in settings.color_schemes limit: 1 -%}
      :root { --c-bg: {{ scheme.settings.background }}; --c-text: {{ scheme.settings.text }}; --c-accent: {{ scheme.settings.accent }}; --c-accent-text: {{ scheme.settings.accent_text }}; --c-border: {{ scheme.settings.border }}; --c-surface: {{ scheme.settings.surface }}; --c-muted: {{ scheme.settings.muted }}; }
      {%- endfor %}
      :root { --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }}; --font-body: {{ body_font.family }}, {{ body_font.fallback_families }}; --page-width: {{ settings.page_width }}px; --radius-button: {{ settings.button_radius }}px; }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="es-body dir-{{ settings.style_preset }} button-{{ settings.button_style }}">
    <main class="es-main">{{ content_for_layout }}</main>
  </body>
</html>
