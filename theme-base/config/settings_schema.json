      },
      {
        "type": "checkbox",
        "id": "cart_total_count",
        "label": "Total avec le nombre d'articles",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_checkout_label",
        "label": "Libellé du bouton de commande",
        "info": "Vide : « Passer commande »."
      },
      {
        "type": "checkbox",
        "id": "cart_checkout_lock",
        "label": "Cadenas dans le bouton de commande",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_show_payment_icons",
        "label": "Logos des moyens de paiement confirmés",
        "default": false,
        "info": "Uniquement les moyens réellement activés sur la boutique ; aucun logo présumé."
      },
      {
        "type": "checkbox",
        "id": "cart_protection",
        "label": "Bloc « Protection des expéditions » (interrupteur visuel, jamais précoché)",
