    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Logo et identité",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "text",
        "id": "logo_asset",
        "label": "Logo fourni avec le thème",
        "info": "Fichier du dossier assets utilisé si aucun logo n'est choisi ci-dessus."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Largeur du logo",
        "default": 140
      },
      {
        "type": "checkbox",
        "id": "logo_light_on_dark",
        "label": "Logo éclairci sur fond sombre",
        "info": "Pour un logo foncé : sur l'en-tête transparent, le pied et les menus sombres, il s'affiche en version claire (couleurs inversées).",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "favicon_asset",
        "label": "Favicon fourni avec le thème"
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Arrière-plan",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Surface (cartes, champs)",
            "default": "#F5F3EF"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Texte",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "muted",
            "label": "Texte secondaire",
            "default": "#6B6B6B"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Boutons et accents",
            "default": "#1A1A1A"
          },
          {
            "type": "color",
            "id": "accent_text",
            "label": "Texte des boutons",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Bordures",
            "default": "#E3E0DA"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "accent",
          "on_primary_button": "accent_text",
          "primary_button_border": "accent",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "icons": "text",
          "links": "accent"
        }
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Police des titres",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police du texte",
        "default": "dm_sans_n4"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "label": "Police d'accent (mots en italique)",
        "default": "cormorant_i5",
        "info": "Utilisée pour les mots mis en valeur dans les titres."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Taille des titres",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Taille du texte",
        "default": 100
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "Casse des titres",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "Normale"
          },
          {
            "value": "uppercase",
            "label": "Majuscules"
          }
        ]
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "min": -6,
        "max": 20,
        "step": 1,
        "label": "Interlettrage des titres (‰ ×10)",
        "default": 0
      },
      {
        "type": "range",
        "id": "heading_weight_boost",
        "min": 0,
        "max": 400,
        "step": 100,
        "label": "Graisse supplémentaire des titres",
        "default": 0
      }
    ]
  },
  {
    "name": "Style des sites composés",
    "settings": [
      {
        "type": "paragraph",
        "content": "Langage visuel des sites composés par le studio. « Aucun » garde le style des directions précédentes."
