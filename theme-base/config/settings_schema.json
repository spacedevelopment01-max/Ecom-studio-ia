  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Panier latéral"
          },
          {
            "value": "page",
            "label": "Page panier"
          },
          {
            "value": "none",
            "label": "Aucun (site vitrine ou de services)"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Permettre une note de commande",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_reassurance",
        "label": "Message sous le bouton de commande",
        "info": "N'indiquez que des engagements réels (livraison, retours)."
      },
      {
        "type": "checkbox",
        "id": "price_trim_zeros",
        "label": "Prix ronds sans « ,00 »",
        "info": "Ex. « 129 € » au lieu de « 129,00 € » (les centimes restent affichés quand il y en a).",
        "default": false
      },
      {
        "type": "text",
        "id": "card_price_note",
        "label": "Mention sous le nom des cartes produit",
        "info": "Ex. « Prix de démonstration » dans une boutique d'exemple. Vide : aucune mention."
      },
      {
        "type": "checkbox",
        "id": "card_arrow",
        "label": "Flèche ronde vers la fiche sur les cartes produit",
        "default": false
      },
      {
        "type": "header",
        "content": "Présentation du panier"
      },
      {
        "type": "color_scheme",
        "id": "cart_color_scheme",
        "label": "Schéma de couleurs du panier",
