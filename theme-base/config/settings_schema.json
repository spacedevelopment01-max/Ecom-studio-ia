        "info": "Aucun montant n'est ajouté : reliez un service réel avant d'activer une facturation."
      },
      {
        "type": "text",
        "id": "cart_protection_title",
        "label": "Titre du bloc protection",
        "default": "Protection des expéditions"
      },
      {
        "type": "text",
        "id": "cart_protection_text",
        "label": "Texte du bloc protection",
        "default": "Protégez votre commande contre les dommages, la perte ou le vol pendant l'expédition."
      },
      {
        "type": "checkbox",
        "id": "cart_show_login",
        "label": "Invitation à se connecter sous le panier vide",
