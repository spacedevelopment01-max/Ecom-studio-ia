          {
            "value": "none",
            "label": "Aucun (style des directions)"
          },
          {
            "value": "craft",
            "label": "Atelier précis (artisans)"
          },
          {
            "value": "maison",
            "label": "Maison éditoriale (soin, beauté)"
          },
          {
            "value": "precision",
            "label": "Précision technique (high-tech)"
          },
          {
            "value": "bistro",
            "label": "Bistrot (restaurants)"
          },
          {
            "value": "product",
            "label": "Produit numérique (SaaS)"
          }
        ]
      },
      {
        "type": "range",
        "id": "ds_ratio",
        "min": 112,
        "max": 150,
        "step": 2,
        "label": "Rapport de l'échelle des titres",
        "default": 125,
        "info": "Écart entre deux tailles de titres. Plus il est grand, plus la hiérarchie est contrastée."
      },
      {
        "type": "select",
        "id": "ds_density",
        "label": "Densité",
        "default": "balanced",
        "options": [
          {
            "value": "airy",
