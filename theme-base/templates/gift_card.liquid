{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
</head>
<body class="es-body">
  <main class="es-section es-center" style="--pt: 80px; --pb: 80px;">
    <div class="es-container">
      <p class="es-header__wordmark">{{ shop.name }}</p>
      <h1 class="es-heading es-h2">{{ 'gift_card.title' | t }}</h1>
      <p class="es-display">{{ gift_card.balance | money }}</p>
      {%- if gift_card.expired -%}<p class="es-form-error">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <p><code class="es-giftcode">{{ gift_card.code | format_code }}</code></p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p><a href="{{ shop.url }}" class="es-button">{{ 'cart.continue' | t }}</a></p>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet" loading="lazy"></a>{%- endif -%}
    </div>
  </main>
</body>
</html>
