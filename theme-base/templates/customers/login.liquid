<section class="es-section es-account" style="--pt: 64px; --pb: 96px;">
  <div class="es-container es-account__narrow">
    <h1 class="es-heading es-h2">{{ 'customer.login.title' | t }}</h1>
    {%- form 'customer_login', class: 'es-form' -%}
      {{ form.errors | default_errors }}
      <label>{{ 'contact.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label>
      {%- if form.password_needed -%}<label>{{ 'customer.login.password' | t }}<input type="password" name="customer[password]" autocomplete="current-password" required></label>{%- endif -%}
      <button class="es-button es-button--full" type="submit">{{ 'customer.login.submit' | t }}</button>
      <a href="#recover" class="es-link-button">{{ 'customer.login.forgot' | t }}</a>
      <a href="{{ routes.account_register_url }}" class="es-link-button">{{ 'customer.register.title' | t }}</a>
    {%- endform -%}
    <div id="recover">
      <h2 class="es-heading es-h4">{{ 'customer.recover.title' | t }}</h2>
      {%- form 'recover_customer_password', class: 'es-form' -%}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}<p class="es-form-success">{{ 'customer.recover.success' | t }}</p>{%- endif -%}
        <label>{{ 'contact.email' | t }}<input type="email" name="email" autocomplete="email" required></label>
        <button class="es-button es-button--secondary" type="submit">{{ 'customer.recover.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
