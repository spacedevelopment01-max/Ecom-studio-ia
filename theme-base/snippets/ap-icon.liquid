  {%- when 'roller' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="4" y="3" width="14" height="6" rx="1.2"/><path d="M18 6h2v5h-8v3"/><rect x="10.5" y="14" width="3" height="7" rx="1"/></svg>
  {%- when 'shield' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8 7.5 9.5 4.4-1.5 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.5 12 2.5 2.5 4.5-5" stroke-linecap="round"/></svg>
  {%- when 'brush' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m20 4-9.5 9.5"/><path d="M10.5 13.5c-1.6-.4-3.2.6-3.6 2.2L5.5 20.5l4.8-1.4c1.6-.4 2.6-2 2.2-3.6l-2-2Z"/></svg>
  {%- when 'info' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
  {%- when 'alert' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M12 6.5v7M12 16.5v.6" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>
  {%- when 'doc' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 2.5h8.5L19 7v14.5H6Z"/><path d="M14 2.5V7h5M9 11.5h7M9 14.5h7M9 17.5h5" stroke-linecap="round"/></svg>
  {%- when 'image' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9" r="1.7"/><path d="m3.5 17.5 5.5-5 4 3.5 3-2.5 4.5 4"/></svg>
  {%- when 'image-plus' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M12 8v8M8 12h8" stroke-linecap="round"/></svg>
  {%- when 'upload' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18.5H6a4 4 0 0 1-.5-8A6 6 0 0 1 17 8.5a4.5 4.5 0 0 1 1 9.9h-1"/><path d="M12 12v8M8.8 14.8 12 11.6l3.2 3.2"/></svg>
  {%- when 'camera' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h3l1.5-2.5h6L16.5 7h3A1.5 1.5 0 0 1 21 8.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5Z"/><circle cx="12" cy="13" r="3.7"/></svg>
  {%- when 'pin' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></svg>
  {%- when 'user' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.4-3.6 4.2-5.5 7.5-5.5s6.1 1.9 7.5 5.5" stroke-linecap="round"/></svg>
  {%- when 'users' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3"/><circle cx="5.5" cy="9.5" r="2.3"/><circle cx="18.5" cy="9.5" r="2.3"/><path d="M7 19.5c.6-3 2.6-5 5-5s4.4 2 5 5M1.8 18c.3-2.2 1.7-3.6 3.7-3.6 1 0 1.8.3 2.4.9M22.2 18c-.3-2.2-1.7-3.6-3.7-3.6-1 0-1.8.3-2.4.9" stroke-linecap="round"/></svg>
  {%- when 'gear' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8 13.6 5l2.6-.6.8 2.6 2.6.8-.6 2.6 2.2 1.6-2.2 1.6.6 2.6-2.6.8-.8 2.6-2.6-.6L12 21.2 10.4 19l-2.6.6-.8-2.6-2.6-.8.6-2.6L2.8 12 5 10.4l-.6-2.6 2.6-.8.8-2.6 2.6.6Z"/></svg>
  {%- when 'clock' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
  {%- when 'chart' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 20v-5M10 20V10M15 20v-8M20 20V5"/></svg>
  {%- when 'play' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m10 8.5 5.5 3.5-5.5 3.5Z"/></svg>
  {%- when 'trash' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 6.5h15M9.5 6.5V4h5v2.5M6.5 6.5l1 14h9l1-14M10 10.5v6.5M14 10.5v6.5"/></svg>
  {%- when 'quote' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M4 18v-4.5C4 9.7 5.8 7 9.3 5.8l.7 1.4C8 8.1 7.2 9.6 7.2 11.3H10V18Zm10 0v-4.5c0-3.8 1.8-6.5 5.3-7.7l.7 1.4c-2 .9-2.8 2.4-2.8 4.1H20V18Z"/></svg>
  {%- when 'paint' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 3.5h11.5v5H6Z"/><path d="M17.5 6H20v4.5h-8.5v3"/><path d="M10 13.5h3v7h-3Z"/></svg>
  {%- when 'bucket' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M5 7h14l-1.5 13.5h-11Z"/><path d="M5 7c0-2 3.1-3.5 7-3.5S19 5 19 7M8 11h8" stroke-linecap="round"/></svg>
  {%- else -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/></svg>
{%- endcase -%}
