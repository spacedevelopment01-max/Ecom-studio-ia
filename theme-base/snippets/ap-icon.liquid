{%- comment -%}
  Icônes au trait d'APLAT (planches du 25 octobre) : un seul style, trait fin, décoratives (aria-hidden).
  Paramètre : name.
{%- endcomment -%}
{%- case name -%}
  {%- when 'arrow' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/></svg>
  {%- when 'arrow-left' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12H5M10.5 6.5 5 12l5.5 5.5"/></svg>
  {%- when 'arrow-down' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M6.5 13.5 12 19l5.5-5.5"/></svg>
  {%- when 'arrow-up' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V5M6.5 10.5 12 5l5.5 5.5"/></svg>
  {%- when 'swap' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 12h17M8 7.5 3.5 12 8 16.5M16 7.5l4.5 4.5-4.5 4.5"/></svg>
  {%- when 'chevron' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5.5 6.5 6.5L9 18.5"/></svg>
  {%- when 'chevron-down' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 9 12 15.5 18.5 9"/></svg>
  {%- when 'plus' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14"/></svg>
  {%- when 'check' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 12.5 4.5 4.5L19.5 6.5"/></svg>
  {%- when 'menu' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"/></svg>
  {%- when 'close' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="m5 5 14 14M19 5 5 19"/></svg>
  {%- when 'search' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
  {%- when 'chat' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M20.5 11.5c0 4.4-3.8 8-8.5 8-1.2 0-2.3-.2-3.3-.6L4 20.5l1.4-3.6C4.2 15.5 3.5 13.6 3.5 11.5c0-4.4 3.8-8 8.5-8s8.5 3.6 8.5 8Z"/></svg>
  {%- when 'chats' -%}<svg class="ap-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M15.5 9.5c0 3.3-2.9 6-6.5 6-.9 0-1.7-.2-2.5-.4L3 16.5l1.1-2.8C3.4 12.5 2.5 11.1 2.5 9.5c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6Z"/><path d="M17.8 8.6c2.2.8 3.7 2.6 3.7 4.8 0 1.2-.5 2.3-1.3 3.2l.9 2.4-3-1c-.7.2-1.4.3-2.1.3-1.9 0-3.6-.7-4.7-1.8"/></svg>
