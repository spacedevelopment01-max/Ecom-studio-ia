{% if image != blank or asset != blank %}<div class="ed-media" style="--ed-fx:{{ focus_x | default: 50 }}%;--ed-fy:{{ focus_y | default: 50 }}%;--ed-fxm:{{ mobile_focus_x | default: focus_x | default: 50 }}%;--ed-fym:{{ mobile_focus_y | default: focus_y | default: 50 }}%;">{% render 'es-image', image: image, asset: asset, alt: alt, class: 'ed-image', loading: loading %}</div>{% elsif request.host == 'apercu' and role_label != blank %}<div class="ed-media ed-media--pending" role="img" aria-label="{{ role_label | escape }}"><p>{{ 'editorial.pending_media' | t }}<span>{{ role_label | escape }}</span></p></div>{% endif %}
