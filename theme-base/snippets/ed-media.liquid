{% if image != blank or asset != blank %}<div class="ed-media{% if ratio != blank and ratio != 'layout' %} ed-media--ratio{% endif %}" style="--ed-fx:{{ focus_x | default: 50 }}%;--ed-fy:{{ focus_y | default: 50 }}%;--ed-fit:{{ fit | default: 'cover' }};{% if ratio != blank and ratio != 'layout' %}--ed-ratio:{{ ratio }};--ed-mobile-ratio:{{ mobile_ratio | default: ratio }};{% endif %}">{% render 'es-image', image: image, asset: asset, alt: alt, class: 'ed-image', loading: loading, fetchpriority: fetchpriority %}</div>{% elsif request.host == 'apercu' and role_label != blank %}<div class="ed-media ed-media--pending" role="img" aria-label="{{ role_label | escape }}"><p>{{ 'editorial.pending_media' | t }}<span>{{ role_label | escape }}</span></p></div>{% endif %}
