{% if image != blank or asset != blank %}<div class="ed-media" style="--ed-fx:{{ focus_x | default: 50 }}%;--ed-fy:{{ focus_y | default: 50 }}%;--ed-fxm:{{ mobile_focus_x | default: focus_x | default: 50 }}%;--ed-fym:{{ mobile_focus_y | default: focus_y | default: 50 }}%;">{% if mobile_image != blank or mobile_asset != blank %}<picture>{% if mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1200 }}">{% else %}<source media="(max-width: 749px)" srcset="{{ mobile_asset | asset_url }}">{% endif %}{% render 'es-image', image: image, asset: asset, alt: alt, class: 'ed-image', loading: loading %}</picture>{% else %}{% render 'es-image', image: image, asset: asset, alt: alt, class: 'ed-image', loading: loading %}{% endif %}</div>{% elsif request.host == 'apercu' and role_label != blank %}<div class="ed-media ed-media--pending" role="img" aria-label="{{ role_label | escape }}"><p>{{ 'editorial.pending_media' | t }}<span>{{ role_label | escape }}</span></p></div>{% endif %}
