{%- comment -%}
  FRAISE : titre à plusieurs lignes et deux écritures (planches) — une ligne par retour à la ligne ; [i]…[/i] : italique
  d'accent rouge ; [r]…[/r] : rouge ; [s]…[/s] : grande écriture arrondie ; [m]…[/m] : manuscrite.
  Paramètres : text, tag (h1, h2, h3, p), class, id.
{%- endcomment -%}
{%- liquid
  assign fg_tag = tag | default: 'h2'
  assign fg_html = text | escape | replace: '[i]', '<em class="fg-i">' | replace: '[/i]', '</em>' | replace: '[r]', '<span class="fg-r">' | replace: '[/r]', '</span>' | replace: '[s]', '<span class="fg-s">' | replace: '[/s]', '</span>' | replace: '[m]', '<span class="fg-hand">' | replace: '[/m]', '</span>' | newline_to_br
  assign fg_lines = fg_html | split: '<br />'
-%}
{%- if text != blank -%}
<{{ fg_tag }} class="fg-title {{ class }}"{% if id != blank %} id="{{ id }}"{% endif %}>
  {%- for l in fg_lines -%}<span class="fg-ln fg-ln--{{ forloop.index }}">{{ l | strip }}</span>{% unless forloop.last %} {% endunless %}{%- endfor -%}
</{{ fg_tag }}>
{%- endif -%}
