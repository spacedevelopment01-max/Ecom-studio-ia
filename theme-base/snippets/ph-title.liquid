{%- comment -%}
  PHASE : titre à plusieurs lignes — une ligne par retour à la ligne (mêmes césures que les planches) ; [y]…[/y] : mots
  en jaune électrique (sur fond sombre) ; [b]…[/b] : mots en bleu nuit (sur fond jaune).
  Paramètres : text, tag (h1, h2, h3, p), class, id.
{%- endcomment -%}
{%- liquid
  assign ph_tag = tag | default: 'h2'
  assign ph_html = text | escape | replace: '[y]', '<span class="ph-y">' | replace: '[/y]', '</span>' | replace: '[b]', '<span class="ph-b">' | replace: '[/b]', '</span>' | newline_to_br
  assign ph_lines = ph_html | split: '<br />'
-%}
{%- if text != blank -%}
<{{ ph_tag }} class="ph-title {{ class }}"{% if id != blank %} id="{{ id }}"{% endif %}>
  {%- for l in ph_lines -%}<span class="ph-ln">{{ l | strip }}</span>{% unless forloop.last %} {% endunless %}{%- endfor -%}
</{{ ph_tag }}>
{%- endif -%}
