{%- comment -%}
  TABLE SAISON : icônes d'un seul style, au trait (1,5 px), dessinées en SVG (issue #175).
  Paramètres : name, class
{%- endcomment -%}
<svg class="ts-ico {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'arrow' -%}<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M20 12H5"/><path d="m11 6-6 6 6 6"/>
    {%- when 'calendar' -%}<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>
    {%- when 'calendar-grid' -%}<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4M7.5 13h1M11.5 13h1M15.5 13h1M7.5 16.5h1M11.5 16.5h1M15.5 16.5h1"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="3.6"/><path d="M5 20.5c.8-3.8 3.6-5.6 7-5.6s6.2 1.8 7 5.6"/>
    {%- when 'users' -%}<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.3 2.9-5 6-5s5.4 1.7 6 5"/><path d="M15.5 5.6a3 3 0 0 1 0 5.8M17.5 14.7c2 .5 3.2 2.1 3.5 4.8"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9"/><path d="m7.8 12.3 2.9 2.9 5.5-5.6"/>
    {%- when 'mail' -%}<rect x="3" y="5.5" width="18" height="13" rx="1.2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'pin' -%}<path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>
    {%- when 'phone' -%}<path d="M6.6 3.5h2.6l1.4 4-2 1.4a11 11 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a1.8 1.8 0 0 1-2 1.8A16.5 16.5 0 0 1 4.8 5.5a1.8 1.8 0 0 1 1.8-2Z"/>
    {%- when 'car' -%}<path d="M4.5 15.5V12l1.8-4.6A1.5 1.5 0 0 1 7.7 6.5h8.6a1.5 1.5 0 0 1 1.4.9l1.8 4.6v3.5"/><rect x="3.5" y="12" width="17" height="4.5" rx="1"/><path d="M6 16.5V19M18 16.5V19M7 14.2h1.5M15.5 14.2H17"/>
    {%- when 'train' -%}<rect x="5.5" y="3.5" width="13" height="13.5" rx="2.5"/><path d="M5.5 10h13M9 13.5h.01M15 13.5h.01M8.5 17l-2 3.5M15.5 17l2 3.5M10 6.5h4"/>
    {%- when 'bike' -%}<circle cx="6" cy="16" r="3.5"/><circle cx="18" cy="16" r="3.5"/><path d="M6 16 9.5 9h6l2.5 7M9.5 9 12 16h-6M14 6h2.5"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13.5 14-14-.3 9-5.8 14-14 14Z" fill="currentColor" stroke="none"/><path d="M5 19c3-4 6-6.5 9.5-8.5" stroke="#F6F0E5" stroke-width="1.2"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'chevron' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'prev' -%}<path d="m15 6-6 6 6 6"/>
    {%- when 'next' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'edit' -%}<path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="M13.5 6.5l4 4"/>
    {%- when 'note' -%}<path d="M14 4H6a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5V10"/><path d="M19.5 4.5 12 12l-1 3 3-1 7.5-7.5a1.4 1.4 0 0 0-2-2Z"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/>
    {%- when 'shield' -%}<path d="M12 3.5 19 6v5.5c0 4.3-3 7.6-7 9-4-1.4-7-4.7-7-9V6l7-2.5Z"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><path d="M17.3 6.7h.01"/>
    {%- when 'facebook' -%}<path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5Z" fill="currentColor" stroke="none"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M10.6 20.6 12 14.5m0 0c.4 1 1.3 1.5 2.4 1.5 2.3 0 3.6-2.3 3.6-4.6A5.6 5.6 0 0 0 12.2 6c-3.3 0-5.6 2.4-5.6 5.2 0 1.4.6 2.6 1.6 3M12 14.5l1.2-4.8"/>
    {%- else -%}<circle cx="12" cy="12" r="2"/>
  {%- endcase -%}
</svg>
