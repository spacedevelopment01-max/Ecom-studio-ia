{%- comment -%}
  Pictogrammes au trait des sections premium (promesse, réassurance, bénéfices, précautions, professionnels).
  Paramètres : name, class. Les tracés portent des classes (es-g-a, es-g-b) animées par les sections.
{%- endcomment -%}
<svg class="es-icon es-glyph es-glyph--{{ name }} {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'sparkle' -%}<path class="es-g-a" d="M12 3c.6 4.2 2.8 6.4 7 7-4.2.6-6.4 2.8-7 7-.6-4.2-2.8-6.4-7-7 4.2-.6 6.4-2.8 7-7Z"/><path class="es-g-b" d="M19 16.5v3M17.5 18h3"/>
    {%- when 'leaf' -%}<path class="es-g-a" d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path class="es-g-b" d="M5 19 13 11"/>
    {%- when 'drop' -%}<path class="es-g-a" d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/><path class="es-g-b" d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>
    {%- when 'heart' -%}<path class="es-g-a" d="M12 20s-7-4.4-9.2-9A4.8 4.8 0 0 1 12 6a4.8 4.8 0 0 1 9.2 5c-2.2 4.6-9.2 9-9.2 9Z"/>
    {%- when 'shield' -%}<path class="es-g-a" d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path class="es-g-b" d="m9 12 2.2 2.2L15.5 10"/>
    {%- when 'lock' -%}<rect class="es-g-a" x="5" y="10.5" width="14" height="10" rx="2.2"/><path class="es-g-b" d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.2"/>
    {%- when 'card' -%}<rect class="es-g-a" x="3" y="5.5" width="18" height="13" rx="2.2"/><path d="M3 10h18"/><path class="es-g-b" d="M7 14.5h4"/>
    {%- when 'truck' -%}<path class="es-g-a" d="M2.5 6.5h11v9.5h-11zM13.5 10h4l3 3.2V16h-7"/><g class="es-g-b"><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/></g>
    {%- when 'return' -%}<path class="es-g-b" d="M9 7 4 12l5 5"/><path class="es-g-a" d="M4 12h11a5 5 0 0 1 0 10h-3"/>
    {%- when 'chat' -%}<path class="es-g-a" d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><g class="es-g-b"><path d="M8.5 12h.01M12 12h.01M15.5 12h.01" stroke-width="2.2"/></g>
    {%- when 'clock' -%}<circle class="es-g-a" cx="12" cy="12" r="9"/><path class="es-g-b" d="M12 7v5l3 2"/>
    {%- when 'star' -%}<path class="es-g-a" d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9Z"/>
    {%- when 'globe' -%}<circle class="es-g-a" cx="12" cy="12" r="9"/><path class="es-g-b" d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
    {%- when 'hand' -%}<path class="es-g-a" d="M8 12V5.5a1.5 1.5 0 0 1 3 0V11m0-5.5a1.5 1.5 0 0 1 3 0V11m0-4a1.5 1.5 0 0 1 3 0v6c0 4-2.5 8-7 8-3 0-4.5-1.5-6-4l-1.5-3a1.5 1.5 0 0 1 2.5-1.5L8 14"/>
    {%- when 'check' -%}<circle class="es-g-a" cx="12" cy="12" r="9"/><path class="es-g-b" d="m8 12.3 2.8 2.8L16.5 9.5"/>
    {%- when 'award' -%}<circle class="es-g-a" cx="12" cy="9" r="5.5"/><path class="es-g-b" d="M8.6 13.4 7 21l5-2.8 5 2.8-1.6-7.6"/>
    {%- when 'recycle' -%}<path class="es-g-a" d="M20 11a8 8 0 0 0-14.9-3M4 13a8 8 0 0 0 14.9 3"/><path class="es-g-b" d="M5 3v5h5M19 21v-5h-5"/>
    {%- when 'package' -%}<path class="es-g-a" d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path class="es-g-b" d="m3 7.5 9 4.5 9-4.5M12 12v9"/>
    {%- when 'gift' -%}<rect class="es-g-a" x="3" y="8" width="18" height="13" rx="1.2"/><path class="es-g-b" d="M12 8v13M3 12h18M12 8S10 3 7.5 4.5 9 8 12 8Zm0 0s2-5 4.5-3.5S15 8 12 8Z"/>
    {%- when 'sun' -%}<circle class="es-g-a" cx="12" cy="12" r="4"/><path class="es-g-b" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
    {%- when 'smile' -%}<circle class="es-g-a" cx="12" cy="12" r="9"/><path class="es-g-b" d="M8.5 14.5a4.5 4.5 0 0 0 7 0M9 9.5h.01M15 9.5h.01"/>
    {%- when 'bolt' -%}<path class="es-g-a" d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>
    {%- when 'alert' -%}<path class="es-g-a" d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/><path class="es-g-b" d="M12 9.5v4.5M12 17.2v.1"/>
    {%- when 'info' -%}<circle class="es-g-a" cx="12" cy="12" r="9"/><path class="es-g-b" d="M12 11v5.5M12 7.8v.1"/>
    {%- when 'child' -%}<circle class="es-g-a" cx="12" cy="5.5" r="2.5"/><path class="es-g-b" d="M12 9v6.5M7.5 11.5 12 10l4.5 1.5M9.5 21l2.5-5.5 2.5 5.5"/>
    {%- when 'eye' -%}<path class="es-g-a" d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle class="es-g-b" cx="12" cy="12" r="3"/>
    {%- when 'thermometer' -%}<path class="es-g-a" d="M10 4.5a2 2 0 0 1 4 0v9.3a4 4 0 1 1-4 0V4.5Z"/><path class="es-g-b" d="M12 10.5v6"/>
    {%- when 'ban' -%}<circle class="es-g-a" cx="12" cy="12" r="9"/><path class="es-g-b" d="m5.7 5.7 12.6 12.6"/>
    {%- when 'book' -%}<path class="es-g-a" d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v14H6.5A1.5 1.5 0 0 0 5 18.5v-14Z"/><path class="es-g-b" d="M5 18.5A1.5 1.5 0 0 0 6.5 20H19M9 7h6M9 10.5h4"/>
    {%- when 'user' -%}<circle class="es-g-a" cx="12" cy="8.5" r="4"/><path class="es-g-b" d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'verified' -%}<path class="es-g-a" d="m12 2.6 2.3 1.7 2.9-.1.9 2.7 2.3 1.7-.9 2.8.9 2.8-2.3 1.7-.9 2.7-2.9-.1L12 21.4l-2.3-1.7-2.9.1-.9-2.7-2.3-1.7.9-2.8-.9-2.8 2.3-1.7.9-2.7 2.9.1Z"/><path class="es-g-b" d="m8.6 12.1 2.3 2.3 4.5-4.7"/>
    {%- when 'link' -%}<path class="es-g-a" d="M14 4h6v6M20 4l-9 9"/><path class="es-g-b" d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>
    {%- else -%}<circle class="es-g-a" cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
