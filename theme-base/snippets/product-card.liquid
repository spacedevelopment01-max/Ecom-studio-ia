{%- comment -%} Carte produit. Paramètres : product_card, show_secondary, ratio {%- endcomment -%}
{%- liquid
  assign card_ratio = ratio | default: 'portrait'
-%}
<article class="es-card es-card--{{ card_ratio }}" data-reveal="up">
  <a href="{{ product_card.url | default: '#' }}" class="es-card__media" aria-label="{{ product_card.title | escape }}">
    {%- if product_card.featured_media -%}
      {{ product_card.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 50vw', widths: '360, 540, 720, 900', class: 'es-card__img', alt: product_card.featured_media.alt }}
      {%- if show_secondary and product_card.media[1] != blank -%}
        {{ product_card.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 50vw', class: 'es-card__img es-card__img--hover', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'es-placeholder__svg' }}
    {%- endif -%}
    {%- if product_card.available == false -%}<span class="es-badge">{{ 'products.product.sold_out' | t }}</span>{%- endif -%}
  </a>
  <div class="es-card__info">
    <h3 class="es-card__title"><a href="{{ product_card.url | default: '#' }}">{%- if product_card.title != blank -%}{{ product_card.title }}{%- else -%}{{ 'products.product.placeholder_card' | t }}{%- endif -%}</a></h3>
    {% render 'price', product: product_card, use_variant: false %}
  </div>
</article>
