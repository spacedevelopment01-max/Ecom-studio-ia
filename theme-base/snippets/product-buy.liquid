{%- comment -%}
  Formulaire d'achat : variantes, quantité, ajout au panier, paiement accéléré.
  Paramètres : product, section_id, show_quantity, show_dynamic_checkout, picker, price_in_button ; swatch_color (pastille
  devant les valeurs de l'option « Couleur »), guide_label et guide_link (lien sous l'option « Taille »), quantity_label.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section_id
  comment
    Variante sans prix (« Prix à définir ») : rien ne peut être commandé, le bouton le dit au lieu de sembler actif puis
    de refuser l'ajout. Une boutique Shopify a toujours un prix : la condition ne joue que dans le studio et ses exports.
  endcomment
  assign unpriced = false
  if current_variant.price == nil
    assign unpriced = true
  endif
-%}
<div class="es-buy" data-product-buy data-section="{{ section_id }}" data-product-url="{{ product.url }}">
  {%- unless product.has_only_default_variant -%}
    {%- for option in product.options_with_values -%}
      {%- assign option_index = forloop.index0 -%}
      {%- assign opt_name = option.name | downcase -%}
      {%- assign is_color = false -%}{%- if opt_name == 'couleur' or opt_name == 'color' or opt_name == 'colour' or opt_name == 'coloris' -%}{%- assign is_color = true -%}{%- endif -%}
      {%- assign is_size = false -%}{%- if opt_name == 'taille' or opt_name == 'size' or opt_name == 'pointure' -%}{%- assign is_size = true -%}{%- endif -%}
      <fieldset class="es-option es-option--{{ picker | default: 'buttons' }}{% if is_color and swatch_color != blank %} es-option--swatch{% endif %}{% if is_size %} es-option--size{% endif %}">
        <legend class="es-option__label">{{ option.name }}{% if request.locale.iso_code contains 'fr' %}&nbsp;:{% else %}:{% endif %} <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
        {%- if picker == 'dropdown' -%}
          <select class="es-select" data-option-index="{{ forloop.index0 }}" aria-label="{{ option.name }}">
            {%- for value in option.values -%}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{%- endfor -%}
          </select>
        {%- else -%}
          <div class="es-option__values">
            {%- for value in option.values -%}
              {%- assign input_id = section_id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
              <input type="radio" class="visually-hidden" id="{{ input_id }}" name="{{ section_id }}-{{ option.name | handleize }}" value="{{ value | escape }}" data-option-index="{{ option_index }}"{% if option.selected_value == value %} checked{% endif %}>
              <label for="{{ input_id }}" class="es-chip">{% if is_color and swatch_color != blank %}<span class="es-chip__swatch" style="background:{{ swatch_color }}" aria-hidden="true"></span>{% endif %}{{ value }}</label>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if is_size and guide_label != blank -%}<a class="es-option__guide" href="{{ guide_link | default: '#' }}">{% render 'icon', name: 'ruler' %}{{ guide_label | escape }}</a>{%- endif -%}
      </fieldset>
    {%- endfor -%}
  {%- endunless -%}

  {%- form 'product', product, id: form_id, class: 'es-buy__form', data-product-form: '' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
    {%- if show_quantity and quantity_label != blank -%}<p class="es-option__label es-buy__qty-label">{{ quantity_label | escape }}</p>{%- endif -%}
    <div class="es-buy__row">
      {%- if show_quantity -%}
        <div class="es-qty">
          <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
          <label class="visually-hidden" for="Quantity-{{ section_id }}">{{ 'products.product.quantity' | t }}</label>
          <input id="Quantity-{{ section_id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
          <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
        </div>
      {%- endif -%}
      <button type="submit" name="add" class="es-button es-button--grow" data-add-button{% if current_variant.available == false or unpriced %} disabled{% endif %}>
        <span data-add-label>{%- if unpriced -%}{{ 'products.product.not_for_sale' | t }}{%- elsif current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- if price_in_button -%}<span data-button-price> – {{ current_variant.price | money }}</span>{%- endif -%}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
      </button>
    </div>
    {%- if show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
    <p class="es-small es-muted es-buy__note" data-price-pending{% unless unpriced %} hidden{% endunless %}>{{ 'products.product.price_pending_note' | t }}</p>
    <p class="es-form-error" role="alert" data-form-error hidden></p>
  {%- endform -%}
  <script type="application/json" data-variants>{{ product.variants | json }}</script>
</div>
