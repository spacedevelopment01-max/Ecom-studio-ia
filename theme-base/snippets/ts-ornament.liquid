{%- comment -%}
  TABLE SAISON : ornements botaniques au trait (SVG net, couleur réglée par la feuille de style), jamais une capture.
  Paramètres : name (« sprig » petit rameau, « branch » rameau d'olivier, « leaves » grande branche feuillue), class
{%- endcomment -%}
<span class="ts-ornament {{ class }}" aria-hidden="true">
  {%- case name -%}
    {%- when 'branch' -%}
      <svg viewBox="0 0 120 160" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
        <path d="M60 156C58 120 52 80 60 6"/>
        <path d="M59 126c-12-4-22-14-26-26 12 3 22 12 26 26Z"/><path d="M59 126c-8-8-16-12-26-26"/>
        <path d="M61 104c12-4 21-14 24-27-12 4-21 13-24 27Z"/><path d="M61 104c7-9 14-15 24-27"/>
        <path d="M58 82c-11-5-19-15-21-28 11 5 19 15 21 28Z"/><path d="M58 82c-7-9-13-16-21-28"/>
        <path d="M61 62c10-6 16-17 16-30-10 7-16 17-16 30Z"/><path d="M61 62c5-10 10-19 16-30"/>
        <path d="M59 42c-9-6-14-17-13-29 9 7 14 17 13 29Z"/><path d="M59 42c-4-10-8-19-13-29"/>
      </svg>
    {%- when 'leaves' -%}
      <svg viewBox="0 0 160 220" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
        <path d="M14 214C40 170 70 120 150 8"/>
        <path d="M44 166c-26 2-38-10-40-26 22-2 36 8 40 26Z"/><path d="M44 166c-14-6-26-14-40-26"/>
        <path d="M52 152c4-26 22-36 40-34-2 20-18 32-40 34Z"/><path d="M52 152c12-12 24-24 40-34"/>
        <path d="M74 120c-24-4-32-20-30-34 20 2 30 16 30 34Z"/><path d="M74 120c-12-10-22-20-30-34"/>
        <path d="M84 106c8-22 28-28 44-22-6 18-24 26-44 22Z"/><path d="M84 106c14-8 28-16 44-22"/>
        <path d="M104 78c-20-8-24-24-20-38 18 6 24 22 20 38Z"/><path d="M104 78c-8-12-16-24-20-38"/>
        <path d="M114 64c12-18 30-20 42-12-8 14-26 18-42 12Z"/><path d="M114 64c14-4 28-8 42-12"/>
        <path d="M132 38c-14-12-14-26-8-36 14 10 14 24 8 36Z"/>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 60 80" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
        <path d="M8 76C18 58 30 34 50 4"/>
        <path d="M18 58c-10-1-14-8-14-15 9 1 14 7 14 15Z"/><path d="M22 52c2-10 9-14 16-13-1 8-7 13-16 13Z"/>
        <path d="M28 40c-9-3-11-11-9-17 8 2 11 9 9 17Z"/><path d="M34 32c4-9 12-11 18-8-3 7-10 10-18 8Z"/>
        <path d="M41 20c-6-5-6-12-3-17 7 4 7 11 3 17Z"/>
      </svg>
  {%- endcase -%}
</span>
