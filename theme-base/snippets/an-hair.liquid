{%- comment -%}
  ATELIER NUANCE : pictogrammes des longueurs de cheveux (planche 05), mèches dessinées au trait en SVG.
  Paramètres : length (short, mid, long), class
{%- endcomment -%}
<svg class="an-hair {{ class }}" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
  {%- case length -%}
    {%- when 'short' -%}
      <path d="M30 34c22-6 46 2 58 20"/><path d="M34 42c18-4 38 4 48 18"/><path d="M38 50c14-2 30 4 38 16"/><path d="M44 58c10 0 20 4 26 12"/><path d="M52 66c6 0 11 3 14 7"/>
    {%- when 'mid' -%}
      <path d="M28 22c20 2 34 18 34 40s10 32 28 38"/><path d="M38 20c16 6 26 22 26 42s8 30 22 36"/><path d="M48 20c12 8 20 22 20 40s6 26 16 32"/><path d="M58 22c8 8 14 20 14 36s4 22 10 28"/><path d="M68 26c4 8 8 18 8 30s2 18 6 22"/>
    {%- else -%}
      <path d="M26 10c18 10 26 30 22 54s4 40 20 52"/><path d="M36 10c14 12 20 32 18 52s4 38 18 50"/><path d="M46 10c12 12 16 32 14 50s4 36 16 48"/><path d="M56 12c8 12 12 30 10 48s2 34 12 46"/><path d="M66 14c6 12 8 28 6 44s2 30 8 42"/><path d="M76 18c4 10 6 24 4 38s0 26 4 36"/>
  {%- endcase -%}
</svg>
