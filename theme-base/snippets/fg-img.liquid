{%- comment -%}
  FRAISE : photo d'un emplacement (image choisie dans l'éditeur, sinon fichier du thème), cadrée par object-position et
  un agrandissement réglable (« zoom », en %), pour caler le cadrage sur la planche.
  Paramètres : image, asset, alt, pos, pos_mobile, zoom, zoom_mobile (téléphone), loading, class, sizes. Sans photo : rien.
  Placement (facultatif) : place_w (largeur de la photo, repère 1440 px), place_x, place_y (coin haut gauche) ; au
  téléphone mplace_w, mplace_x, mplace_y (repère 390 px). La photo garde ses proportions et peut déborder du cadre
  (une même photo continue d'une section à l'autre, comme sur les planches).
{%- endcomment -%}
{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_pos = pos | default: '50% 50%'
  assign img_pos_m = pos_mobile | default: img_pos
  assign img_zoom = zoom | default: 100
  assign img_zoom_m = zoom_mobile | default: img_zoom
  assign img_place = place_w | default: 0 | plus: 0
  assign img_mplace = mplace_w | default: 0 | plus: 0
-%}
{%- if image != blank or asset != blank -%}
  <div class="fg-img {{ class }}{% if img_place > 0 %} has-place{% endif %}{% if img_mplace > 0 %} has-mplace{% endif %}" style="--pos: {{ img_pos }}; --pos-m: {{ img_pos_m }}; --z: {{ img_zoom | divided_by: 100.0 }}; --z-m: {{ img_zoom_m | divided_by: 100.0 }};{% if img_place > 0 %} --pw: {{ img_place }}; --px: {{ place_x | default: 0 }}; --py: {{ place_y | default: 0 }};{% endif %}{% if img_mplace > 0 %} --mpw: {{ img_mplace }}; --mpx: {{ mplace_x | default: 0 }}; --mpy: {{ mplace_y | default: 0 }};{% endif %}">
    {%- if image != blank -%}
      {{ image | image_url: width: 2400 | image_tag: loading: img_loading, sizes: sizes | default: '100vw', widths: '400, 750, 1100, 1600, 2400', alt: alt, class: 'fg-img__main' }}
    {%- else -%}
      <img class="fg-img__main" src="{{ asset | asset_url }}" alt="{{ alt | escape }}" loading="{{ img_loading }}" decoding="async"{% if img_loading == 'eager' %} fetchpriority="high"{% endif %} width="1600" height="1067">
    {%- endif -%}
  </div>
{%- endif -%}
