  {%- when 'petals' -%}
    <svg class="fg-art fg-art--petals {{ class }}" viewBox="0 0 64 62" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2.4"><ellipse cx="16" cy="17" rx="6.5" ry="15" transform="rotate(28 16 17)"/><ellipse cx="47" cy="44" rx="6.5" ry="15" transform="rotate(24 47 44)"/></g></svg>
  {%- when 'petal-duo' -%}
    <svg class="fg-art fg-art--petal-duo {{ class }}" viewBox="0 0 44 62" aria-hidden="true" focusable="false"><path d="M27 2c8 6 13 16 14 27C33 23 27 13 27 2z" fill="#E66A70"/><ellipse cx="15" cy="43" rx="6.6" ry="17" transform="rotate(-34 15 43)" fill="#FFF6F2" stroke="#E3363E" stroke-width="2.6"/></svg>
