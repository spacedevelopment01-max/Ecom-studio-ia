{%- comment -%}
  FRAISE : petites illustrations des planches redessinées en SVG (décor, jamais une information) : pétales cerclés,
  fraise et feuilles du menu, branche de feuilles, grande fraise rose pâle, fraise coupée, cœur, éclats.
  Paramètres : name, class.
{%- endcomment -%}
{%- case name -%}
  {%- when 'petal' -%}
    <svg class="fg-art fg-art--petal {{ class }}" viewBox="0 0 12 18" aria-hidden="true" focusable="false"><ellipse cx="6" cy="9" rx="3.6" ry="6.8" transform="rotate(18 6 9)" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'petals' -%}
    <svg class="fg-art fg-art--petals {{ class }}" viewBox="0 0 60 44" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="14" cy="26" rx="5.5" ry="11" transform="rotate(28 14 26)"/><ellipse cx="38" cy="16" rx="5" ry="10" transform="rotate(34 38 16)"/><ellipse cx="44" cy="36" rx="4.5" ry="8" transform="rotate(64 44 36)"/></g></svg>
  {%- when 'leaf-branch' -%}
    <svg class="fg-art fg-art--branch {{ class }}" viewBox="0 0 120 160" aria-hidden="true" focusable="false"><path d="M18 156C40 118 58 84 98 22" fill="none" stroke="#5E7B47" stroke-width="2.4" stroke-linecap="round"/><path d="M60 96C34 92 18 74 14 50c26 6 40 22 46 46z" fill="#6E8F52"/><path d="M60 96C34 92 18 74 14 50" fill="none" stroke="#4B6A38" stroke-width="1.2"/><path d="M76 66c4-26 22-42 42-46-2 24-18 40-42 46z" fill="#7FA05F"/><path d="M40 128c-22 2-38-10-44-30 22-2 38 10 44 30z" fill="#5E7F45"/><path d="M88 44C74 30 74 14 82 0c12 12 14 28 6 44z" fill="#93B371"/></svg>
  {%- when 'berry-ghost' -%}
    <svg class="fg-art fg-art--ghost {{ class }}" viewBox="0 0 120 150" aria-hidden="true" focusable="false"><path d="M60 34c34-10 62 6 58 42-4 38-32 66-58 74C34 142 6 114 2 76-2 40 26 24 60 34z" fill="#F6C2B8"/><g fill="#FBE0D9"><ellipse cx="38" cy="62" rx="2.6" ry="4"/><ellipse cx="62" cy="56" rx="2.6" ry="4"/><ellipse cx="86" cy="64" rx="2.6" ry="4"/><ellipse cx="30" cy="88" rx="2.6" ry="4"/><ellipse cx="54" cy="84" rx="2.6" ry="4"/><ellipse cx="78" cy="88" rx="2.6" ry="4"/><ellipse cx="96" cy="92" rx="2.4" ry="3.6"/><ellipse cx="44" cy="110" rx="2.6" ry="4"/><ellipse cx="68" cy="112" rx="2.6" ry="4"/><ellipse cx="58" cy="132" rx="2.4" ry="3.6"/></g><path d="M60 36C46 18 26 14 12 22c12 10 30 14 48 14zM60 36c12-18 30-24 46-18-10 12-28 18-46 18zM60 36c-4-14-2-26 8-34 6 12 2 24-8 34z" fill="#9BB386"/></svg>
  {%- when 'strawberry-menu' -%}
    <svg class="fg-art fg-art--menu {{ class }}" viewBox="0 0 300 250" aria-hidden="true" focusable="false"><path d="M-10 250c10-60 60-92 120-92 30 0 52-22 70-60 22-46 60-80 108-86 18 40 10 120-6 168-6 20-6 40 18 70z" fill="#F7C9BF"/><path d="M40 250c18-30 56-52 98-48 40 4 70-24 86-62 10 40 26 80 76 110z" fill="#F3B3A6" opacity=".7"/><g transform="translate(150 150) rotate(-18)"><path d="M0-66C42-66 70-40 66 0 62 42 30 74 0 82-30 74-62 42-66 0-70-40-42-66 0-66z" fill="#E2353D"/><path d="M0-50C30-50 50-32 48 0 46 32 24 56 0 62-24 56-46 32-48 0-50-32-30-50 0-50z" fill="#F7B3AC"/><path d="M0-40C20-40 34-26 32 0 30 26 16 44 0 48-16 44-30 26-32 0-34-26-20-40 0-40z" fill="#FBE3DB"/><g fill="#E2353D"><ellipse cx="-14" cy="-20" rx="1.8" ry="3"/><ellipse cx="12" cy="-22" rx="1.8" ry="3"/><ellipse cx="-22" cy="4" rx="1.8" ry="3"/><ellipse cx="20" cy="4" rx="1.8" ry="3"/><ellipse cx="-10" cy="26" rx="1.8" ry="3"/><ellipse cx="10" cy="26" rx="1.8" ry="3"/></g><path d="M0-66C-20-96-56-104-80-92c18 18 48 28 80 26zM0-66c14-30 44-46 72-40-12 22-40 36-72 40zM0-66c-2-24 6-42 22-54 6 22-2 40-22 54z" fill="#5E7F45"/><path d="M0-66c-34 6-60 0-74-16M0-66c30 0 56-12 66-30" fill="none" stroke="#3F5D2E" stroke-width="1.5"/></g><g fill="#E2353D"><circle cx="78" cy="160" r="2.4"/><circle cx="88" cy="170" r="2.4"/><circle cx="72" cy="176" r="2.4"/><circle cx="84" cy="186" r="2.4"/><circle cx="240" cy="62" r="2.4"/><circle cx="252" cy="70" r="2.4"/><circle cx="244" cy="80" r="2.4"/><circle cx="256" cy="54" r="2.4"/></g></svg>
  {%- when 'half' -%}
    <svg class="fg-art fg-art--half {{ class }}" viewBox="0 0 100 110" aria-hidden="true" focusable="false"><path d="M50 18c26 0 44 16 42 42-2 26-22 44-42 48C30 104 10 86 8 60 6 34 24 18 50 18z" fill="#E2353D"/><path d="M50 28c20 0 34 12 32 32-2 20-16 34-32 38-16-4-30-18-32-38-2-20 12-32 32-32z" fill="#F8B9B0"/><path d="M50 40c11 0 18 8 17 20-1 12-8 22-17 25-9-3-16-13-17-25-1-12 6-20 17-20z" fill="#FDE5DF"/><path d="M50 18C40 4 24 0 12 6c10 10 24 13 38 12zM50 18c8-14 22-20 36-14-8 10-22 15-36 14z" fill="#5E7F45"/></svg>
  {%- when 'heart' -%}
    <svg class="fg-art fg-art--heart {{ class }}" viewBox="0 0 24 22" aria-hidden="true" focusable="false"><path d="M12 21S1 14.2 1 7.3A5.6 5.6 0 0 1 12 4.9a5.6 5.6 0 0 1 11 2.4C23 14.2 12 21 12 21z" fill="currentColor"/></svg>
  {%- when 'sparks' -%}
    <svg class="fg-art fg-art--sparks {{ class }}" viewBox="0 0 40 30" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 24 16 8M20 26l14-8M22 14l8-10"/></g></svg>
  {%- when 'arrow-hand' -%}
    <svg class="fg-art fg-art--hand {{ class }}" viewBox="0 0 60 40" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6c12 2 28 10 40 26"/><path d="M34 30l10 3 1-11"/></g></svg>
{%- endcase -%}
