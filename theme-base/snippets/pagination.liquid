{%- if paginate.pages > 1 -%}
  <nav class="es-pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="es-icon-button" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="es-icon-button" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
  </nav>
{%- endif -%}
