{%- comment -%}
  PARENTHÈSE : ornements au trait des planches, redessinés en SVG (jamais incrustés dans une photo).
  Paramètres : name (branch, sprig, leaves, curve, mark, quill), class.
{%- endcomment -%}
{%- case name -%}
  {%- when 'mark' -%}
    <svg class="pa-orn pa-orn--mark {{ class }}" viewBox="0 0 40 48" aria-hidden="true" focusable="false"><path d="M17 4C8.5 10.5 5 17.5 5 24s3.5 13.5 12 20" fill="none" stroke="var(--pa-sage-deep)" stroke-width="1.6" stroke-linecap="round"/><path d="M26 7c-6.6 5.4-9.4 11-9.4 17s2.8 11.6 9.4 17" fill="none" stroke="var(--pa-apricot-deep)" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'sprig' -%}
    <svg class="pa-orn pa-orn--sprig {{ class }}" viewBox="0 0 120 160" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"><path d="M18 156C40 118 62 70 104 6"/><path d="M38 118c-12-4-20-14-20-26 12 3 20 13 20 26zM52 92c-11-6-16-17-14-29 11 5 16 16 14 29zM66 68c-9-8-12-19-8-30 9 7 12 18 8 30zM80 44c-6-8-7-18-2-27 7 7 8 17 2 27zM46 106c10-6 22-6 32 2-11 5-23 4-32-2zM60 80c10-5 21-4 30 3-10 4-21 3-30-3zM74 56c9-5 19-4 27 2-9 4-19 3-27-2z"/></svg>
  {%- when 'leaves' -%}
    <svg class="pa-orn pa-orn--leaves {{ class }}" viewBox="0 0 220 200" aria-hidden="true" focusable="false"><path d="M30 196C70 150 120 100 205 30" fill="none" stroke="var(--pa-sage-deep)" stroke-width="1.4"/><path d="M118 108C96 70 104 30 150 8c18 40 8 78-32 100z" fill="var(--pa-sage-leaf)" opacity=".75"/><path d="M150 76c28-28 58-30 66-24-14 34-42 44-66 24z" fill="var(--pa-sage-leaf)" opacity=".55"/><path d="M82 140C56 116 54 84 80 60c18 28 18 56 2 80z" fill="var(--pa-sage-leaf)" opacity=".45"/></svg>
  {%- when 'curve' -%}
    <svg class="pa-orn pa-orn--curve {{ class }}" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M2 210C70 120 150 300 240 220S360 60 398 40" fill="none" stroke="var(--pa-apricot-deep)" stroke-width="1.4" opacity=".75"/></svg>
  {%- when 'quill' -%}
    <svg class="pa-orn pa-orn--quill {{ class }}" viewBox="0 0 60 40" aria-hidden="true" focusable="false" fill="none" stroke="var(--pa-apricot-deep)" stroke-width="1.2" stroke-linecap="round"><path d="M4 36C20 30 36 18 56 4"/><path d="M14 30c2-8 8-14 18-18-2 10-8 16-18 18zM28 22c4-6 10-10 18-12-3 7-9 11-18 12z"/></svg>
  {%- else -%}
    <svg class="pa-orn pa-orn--branch {{ class }}" viewBox="0 0 160 220" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"><path d="M10 214C60 170 96 110 150 10"/><path d="M58 168c-20-2-34-14-38-32 20 2 34 14 38 32zM76 140c-18-6-28-20-28-38 18 6 28 20 28 38zM94 110c-15-8-22-23-18-40 15 8 22 23 18 40zM112 80c-12-10-15-25-9-40 12 10 15 25 9 40zM62 150c16-14 36-16 54-6-16 12-36 14-54 6zM84 118c15-12 33-13 50-3-15 11-33 12-50 3zM104 88c13-10 29-10 43-1-13 9-29 9-43 1z"/></svg>
{%- endcase -%}
