{%- comment -%}
  SILLON V2 : pictogrammes au trait d'un seul style (planches 01 à 03), en SVG. Paramètres : name, class.
{%- endcomment -%}
<svg class="sv-ico {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'arrow-ne' -%}<path d="M7 17 17 7M9 7h8v8"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'cart' -%}<path d="M3 4h2.2l2.3 10.2a1.5 1.5 0 0 0 1.5 1.2h7.7a1.5 1.5 0 0 0 1.5-1.1L20 8H6.3"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="16.5" cy="19.5" r="1.3"/><path d="M11 10.8h5"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>
    {%- when 'mail' -%}<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/>
    {%- when 'pin' -%}<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>
    {%- when 'box' -%}<path d="M12 3 20 7v10l-8 4-8-4V7z"/><path d="m4 7 8 4 8-4M12 11v10M8 5l8 4"/>
    {%- when 'chat' -%}<path d="M4 5.5h16v10H10l-4.5 3.5v-3.5H4z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01" stroke-width="2.2"/>
    {%- when 'question' -%}<circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 3.6M12 16.8h.01"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'trash' -%}<path d="M5 7h14M10 4h4M7 7l.8 12.2a1 1 0 0 0 1 .8h6.4a1 1 0 0 0 1-.8L17 7M10.5 10.5v6M13.5 10.5v6"/>
    {%- when 'chevron' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'up' -%}<path d="m6 15 6-6 6 6"/>
    {%- when 'check' -%}<path d="m5 12.5 4.2 4.2L19 7"/>
    {%- when 'cycle' -%}<path d="M18.5 12a6.5 6.5 0 1 1-2-4.7"/><path d="M17 3.8v3.9h-3.9"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8h.01"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
    {%- when 'drop' -%}<path d="M12 3.5s-5.5 6-5.5 10a5.5 5.5 0 0 0 11 0c0-4-5.5-10-5.5-10z"/>
    {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H8"/>
    {%- when 'doc' -%}<path d="M6.5 3h8l4 4v14h-12z"/><path d="M14.5 3v4h4M9.5 12h6M9.5 15.5h6"/>
    {%- else -%}<path d="M5 12h14M13 6l6 6-6 6"/>
  {%- endcase -%}
</svg>
