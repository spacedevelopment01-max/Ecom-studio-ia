<div class="es-section es-eng es-fond-{{ section.settings.fond }}" data-es="engagements">
  <div class="es-conteneur">
    <div class="es-eng__tete">
      {%- if section.settings.surtitre != blank -%}
        <p class="es-surtitre">{{ section.settings.surtitre | escape }}</p>
      {%- endif -%}
      <h2 class="es-t2">{{ section.settings.titre | escape }}</h2>
    </div>
    <ul class="es-eng__liste es-eng__liste--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="es-eng__item" {{ block.shopify_attributes }}>
          <span class="es-eng__icone">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {%- case block.settings.icone -%}
                {%- when 'colis' -%}<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9M7.7 5.3l8.6 4.5"/>
                {%- when 'retour' -%}<path d="M4 8h10a5 5 0 0 1 0 10H8"/><path d="M7.5 4.5 4 8l3.5 3.5"/>
                {%- when 'main' -%}<path d="M8 11V5.5a1.5 1.5 0 0 1 3 0V10m0-.5V4.5a1.5 1.5 0 0 1 3 0V10m0-3.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-.6a6 6 0 0 1-4.6-2.2L4.5 14a1.5 1.5 0 0 1 2.3-1.9L8 13.5"/>
                {%- when 'horloge' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
                {%- when 'bouclier' -%}<path d="M12 3 5 6v5.5c0 4.2 2.9 7.6 7 9.5 4.1-1.900 7-5.300 7-9.500V6z"/><path d="m9 12 2.200 2.200L15 10.400"/>
                {%- else -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-14 14z"/><path d="M5 19c2.500-4.500 5.500-7.500 9-9.500"/>
              {%- endcase -%}
            </svg>
          </span>
          <h3 class="es-t3">{{ block.settings.titre | escape }}</h3>
          <p class="es-eng__phrase">{{ block.settings.texte | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
