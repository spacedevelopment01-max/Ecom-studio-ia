<div class="es-ouv es-ouv--{{ section.settings.cote_texte }}" data-es="ouverture-photo">
  {%- if section.settings.photo != blank -%}
    {{ section.settings.photo | image_url: width: 2400 | image_tag: class: 'es-ouv__photo', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2400' }}
  {%- else -%}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'es-ouv__photo es-ouv__photo--vide' }}
  {%- endif -%}
  <div class="es-ouv__voile"></div>
  <div class="es-conteneur es-ouv__cadre">
    <div class="es-ouv__texte">
      {%- if section.settings.surtitre != blank -%}
        <p class="es-surtitre es-ouv__surtitre">{{ section.settings.surtitre | escape }}</p>
      {%- endif -%}
      <h1 class="es-t1">{{ section.settings.titre | escape }}</h1>
      {%- if section.settings.texte != blank -%}
        <p class="es-paragraphe es-ouv__paragraphe">{{ section.settings.texte | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="es-ouv__points">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <svg class="es-ouv__coche" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ block.settings.texte | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.bouton != blank or section.settings.bouton_second != blank -%}
        <div class="es-actions">
          {%- if section.settings.bouton != blank -%}
            <a class="es-bouton es-ouv__bouton" href="{{ section.settings.bouton_lien | default: routes.all_products_collection_url }}">{{ section.settings.bouton | escape }}</a>
          {%- endif -%}
          {%- if section.settings.bouton_second != blank -%}
            <a class="es-bouton es-bouton--second es-ouv__bouton-second" href="{{ section.settings.bouton_second_lien | default: routes.root_url }}">{{ section.settings.bouton_second | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
