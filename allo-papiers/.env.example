# ───────────────────────────────────────────────────────────────
# Allô Papiers — paramètres (à saisir dans Vercel › Settings › Environment Variables)
# Ne mettez JAMAIS ces valeurs dans le code ni dans un message.
# ───────────────────────────────────────────────────────────────

# Adresse publique du site (sans / final)
APP_URL=https://allopapiers.fr

# Base de données Supabase : bouton « Connect » › « Transaction pooler »
DATABASE_URL=postgres://postgres.xxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Secrets générés au hasard (voir docs/DEPLOIEMENT.md, étape « Générer les secrets »)
SESSION_SECRET=
# 32 octets en base64 — NE JAMAIS CHANGER après la mise en service (sinon fichiers illisibles)
FILE_ENCRYPTION_KEY=
CRON_SECRET=

# Stockage privé Supabase : Project Settings › API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# IA (Anthropic) : console.anthropic.com › API Keys
ANTHROPIC_API_KEY=
# claude-opus-5-5 (par défaut) ou claude-sonnet-5-5 (environ deux fois moins cher)
AI_MODEL=claude-opus-5-5
# true = analyses SIMULÉES (bandeau affiché), pour des essais sans clé IA
DEMO_MODE=false

# Emails (Resend) : resend.com › API Keys
RESEND_API_KEY=
MAIL_FROM=Allô Papiers <bonjour@allopapiers.fr>

# Paiements (Stripe) — commencer avec des clés de TEST (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# identifiant du prix mensuel 4,99 € (price_…)
STRIPE_PRICE_PLUS=

# Limites de l'offre Plus (usage raisonnable)
PLUS_DOCUMENTS_PER_MONTH=30
PLUS_QUESTIONS_PER_MONTH=150
PLUS_COMPARISONS_PER_MONTH=20

# Verrouillage après inactivité (minutes)
LOCK_MINUTES=20

# Recommandés : 'test' = simulation explicite (aucun envoi). 'real' est REFUSÉ tant que
# l'adaptateur réel La Poste/Maileva n'est pas développé (contrat + documentation).
LAPOSTE_MODE=test
TEST_LRAR_PRICE_CENTS=990
