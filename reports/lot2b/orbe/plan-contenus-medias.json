        {
          "id": "questions",
          "type": "v2-faq",
          "settings": {
            "layout": "side",
            "heading": "Les réponses, simplement.",
            "color_scheme": "scheme-1",
            "padding_top": 96,
            "padding_bottom": 96
          },
          "blocks": {
            "b0": {
              "type": "question",
              "settings": {
                "question": "Quelles finitions puis-je choisir ?",
                "answer": "<p>Dune, Argile et Charbon. Chaque lampe d'un lot peut avoir sa propre finition.</p>"
              }
            },
            "b1": {
              "type": "question",
              "settings": {
                "question": "Puis-je mélanger les couleurs dans un lot ?",
                "answer": "<p>Oui. Sélectionnez votre offre puis la finition de chaque lampe avant de l'ajouter au panier de test.</p>"
              }
            },
            "b2": {
              "type": "question",
              "settings": {
                "question": "Quand la pochette est-elle ajoutée ?",
                "answer": "<p>Une pochette par lot de trois ou quatre lampes, selon le stock de démonstration. Elle est retirée si le lot passe sous trois lampes.</p>"
              }
            },
            "b3": {
              "type": "question",
              "settings": {
                "question": "La boîte est-elle un cadeau automatique ?",
                "answer": "<p>Non. La boîte et la pochette sont deux accessoires distincts ; seule la pochette suit la condition affichée.</p>"
              }
            },
            "b4": {
              "type": "question",
              "settings": {
                "question": "Où trouver les caractéristiques techniques ?",
                "answer": "<p>Autonomie, puissance, dimensions et alimentation restent à confirmer. Cette démonstration ne présente pas de performances ni de délais de livraison inventés.</p>"
              }
            }
          },
          "block_order": [
