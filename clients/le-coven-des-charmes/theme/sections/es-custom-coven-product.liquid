{%- comment -%}
  Le Coven des Charmes — fiche du bracelet de charms surprise. Le client choisit la taille et la quantité ; il ne
  choisit pas ses charms : ils sont tirés au scoop après la commande puis assemblés. Le prix vient de la boutique ;
  tant qu'il n'est pas confirmé (réglage « Tarif confirmé »), la fiche affiche « — € Tarif à renseigner ».
  Galerie : photos de la section (cadrages réglables), sinon celles du produit ; vignettes, flèches et toucher.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant | default: product.variants.first
  assign sizes = s.sizes | newline_to_br | split: '<br />'
  assign has_sizes = false
  for z in sizes
    assign zz = z | strip
    if zz != ''
      assign has_sizes = true
    endif
  endfor
-%}
<section class="cvn-product" style="--mmt: {{ s.mobile_media_top }}px;" id="CvnProduct-{{ section.id }}" data-cvn-product data-price="{{ current.price }}" data-price-confirmed="{% if s.price_confirmed and current.price > 0 %}true{% else %}false{% endif %}" data-title="{{ product.title | escape }}" data-image="{{ product.featured_image | image_url: width: 400 }}" data-size-prop="{{ s.size_property | escape }}" data-adding="{{ s.adding_label | escape }}" data-added="{{ s.added_label | escape }}" data-see-cart="{{ s.see_cart_label | escape }}" data-cart-url="{{ routes.cart_url }}" data-error="{{ s.error_label | escape }}">
  <div class="cvn-product__inner cvn-scale">
    {%- if s.show_breadcrumb -%}
      <nav class="cvn-crumbs" aria-label="{{ s.breadcrumb_label }}">
        <a href="{{ routes.root_url }}">{{ s.home_label }}</a><svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-droite"></use></svg>
        {%- if s.collection_label != blank -%}<a href="{{ s.collection_link | default: routes.all_products_collection_url }}" class="cvn-only-d">{{ s.collection_label }}</a><svg class="cvn-icon cvn-only-d" aria-hidden="true"><use href="#coven-chevron-droite"></use></svg>{%- endif -%}
        <span aria-current="page">{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="cvn-pgal" data-cvn-gallery>
      <div class="cvn-pgal__stage">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign src = ''
              if b.image != blank
                assign src = b.image | image_url: width: 1600
              elsif b.image_asset != blank
                assign src = b.image_asset | asset_url
              endif
            -%}
            <figure class="cvn-pgal__slide" data-cvn-slide {{ block.shopify_attributes }} style="--fx: {{ b.focus_x }}%; --fy: {{ b.focus_y }}%; --z: {{ b.zoom | divided_by: 100.0 }};"{% unless forloop.first %} hidden{% endunless %}>
              <picture>{%- if b.mobile_image_asset != blank -%}<source media="(max-width: 1023px)" srcset="{{ b.mobile_image_asset | asset_url }}">{%- endif -%}<img src="{{ src }}" alt="{{ b.image_alt | default: product.title | escape }}" width="1200" height="1060"{% unless forloop.first %} loading="lazy"{% endunless %}></picture>
            </figure>
          {%- endfor -%}
        {%- else -%}
          {%- for image in product.images -%}
            <figure class="cvn-pgal__slide" data-cvn-slide{% unless forloop.first %} hidden{% endunless %}>{{ image | image_url: width: 1600 | image_tag: alt: product.title }}</figure>
          {%- endfor -%}
        {%- endif -%}
        <button type="button" class="cvn-pgal__arrow cvn-pgal__arrow--prev" data-cvn-prev><svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-droite"></use></svg><span class="cvn-sr">{{ s.prev_label }}</span></button>
        <button type="button" class="cvn-pgal__arrow cvn-pgal__arrow--next" data-cvn-next><svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-droite"></use></svg><span class="cvn-sr">{{ s.next_label }}</span></button>
        <p class="cvn-sr" aria-live="polite" data-cvn-gallery-status></p>
      </div>
      <div class="cvn-pgal__thumbs" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign tsrc = ''
            if b.thumb_asset != blank
              assign tsrc = b.thumb_asset | asset_url
            elsif b.image != blank
              assign tsrc = b.image | image_url: width: 300
            elsif b.image_asset != blank
              assign tsrc = b.image_asset | asset_url
            endif
          -%}
          <button type="button" class="cvn-pgal__thumb{% if b.mobile_hidden %} cvn-only-d{% endif %}" role="listitem" data-cvn-thumb aria-current="{% if forloop.first %}true{% else %}false{% endif %}" style="--fx: {{ b.thumb_focus_x }}%; --fy: {{ b.thumb_focus_y }}%; --z: {{ b.thumb_zoom | divided_by: 100.0 }};">
            <picture>{%- if b.mobile_thumb_asset != blank -%}<source media="(max-width: 1023px)" srcset="{{ b.mobile_thumb_asset | asset_url }}">{%- endif -%}<img src="{{ tsrc }}" alt="" loading="lazy" width="240" height="200"></picture><span class="cvn-sr">{{ s.thumb_label }} {{ forloop.index }}</span>
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="cvn-pinfo">
      <h1 class="cvn-pinfo__title">{{ product.title }}</h1>
      <p class="cvn-pinfo__price">
        {%- if s.price_confirmed and current.price > 0 -%}<span class="cvn-pinfo__amount">{{ current.price | money }}</span>
        {%- else -%}<span class="cvn-pinfo__amount" aria-hidden="true">— €</span><span class="cvn-pinfo__pricenote">{{ s.price_note }}</span>{%- endif -%}
      </p>
      {%- if s.subtitle != blank -%}<p class="cvn-pinfo__sub">{{ s.subtitle }}</p>{%- endif -%}
      {%- if s.mobile_text != blank -%}<p class="cvn-pinfo__text cvn-only-m">{{ s.mobile_text }}</p>{%- endif -%}
      <div class="cvn-pinfo__notice">
        <svg class="cvn-pinfo__moon" viewBox="0 0 40 40" aria-hidden="true"><path fill="currentColor" d="M26 4a17 17 0 1 0 8 29A15 15 0 0 1 26 4z"/><path fill="currentColor" d="M33 14l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg>
        <p class="cvn-only-d">{{ s.notice | newline_to_br }}</p>
        <p class="cvn-only-m">{{ s.mobile_notice | default: s.notice | newline_to_br }}</p>
      </div>
      {%- form 'product', product, id: 'CvnProductForm', class: 'cvn-pform', novalidate: 'novalidate', data-cvn-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        <div class="cvn-pform__row">
          <div class="cvn-field cvn-pform__size">
            <label class="cvn-field__label" for="CvnSize-{{ section.id }}">{{ s.size_label }}</label>
            <div class="cvn-select">
              <select id="CvnSize-{{ section.id }}" name="properties[{{ s.size_property }}]" data-cvn-size{% if has_sizes %} required aria-describedby="CvnSizeErr-{{ section.id }}"{% endif %}>
                {%- if has_sizes -%}
                  <option value="" selected>{{ s.size_placeholder }}</option>
                  {%- for z in sizes -%}{%- assign zz = z | strip -%}{%- if zz != '' -%}<option value="{{ zz | escape }}">{{ zz }}</option>{%- endif -%}{%- endfor -%}
                {%- else -%}
                  <option value="{{ s.size_placeholder | escape }}" selected>{{ s.size_placeholder }}</option>
                {%- endif -%}
              </select>
              <svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-bas"></use></svg>
            </div>
            <p class="cvn-field__error" id="CvnSizeErr-{{ section.id }}" hidden>{{ s.size_error }}</p>
            {%- unless has_sizes -%}<p class="cvn-field__hint cvn-sr">{{ s.size_unknown_hint }}</p>{%- endunless -%}
          </div>
          <div class="cvn-field cvn-pform__qty">
            <label class="cvn-field__label" for="CvnQty-{{ section.id }}">{{ s.qty_label }}</label>
            <div class="cvn-qty" data-cvn-qty>
              <button type="button" class="cvn-qty__btn" data-cvn-qty-step="-1"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-moins"></use></svg><span class="cvn-sr">{{ s.qty_less }}</span></button>
              <input id="CvnQty-{{ section.id }}" type="number" name="quantity" value="1" min="1" max="{{ s.qty_max }}" inputmode="numeric">
              <button type="button" class="cvn-qty__btn" data-cvn-qty-step="1"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-plus"></use></svg><span class="cvn-sr">{{ s.qty_more }}</span></button>
            </div>
          </div>
        </div>
        <button type="submit" class="cvn-btn cvn-btn--gold cvn-pform__add" data-cvn-add{% unless current.available %} disabled{% endunless %}>
          <svg class="cvn-icon cvn-pform__bag" aria-hidden="true"><use href="#coven-sac"></use></svg>
          <span data-cvn-add-label>{% if current.available %}{{ s.add_label }}{% else %}{{ s.soldout_label }}{% endif %}</span>
          <svg class="cvn-icon cvn-pform__arrow" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg>
        </button>
        <p class="cvn-pform__status" role="status" aria-live="polite" data-cvn-add-status></p>
      {%- endform -%}
      {%- if s.reassure_1 != blank or s.reassure_2 != blank or s.reassure_3 != blank -%}
        <ul class="cvn-pinfo__reassure" role="list">
          {%- if s.reassure_1 != blank -%}<li><span class="cvn-pinfo__ricon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ s.reassure_1_icon }}"></use></svg></span>{{ s.reassure_1 | newline_to_br }}</li>{%- endif -%}
          {%- if s.reassure_2 != blank -%}<li><span class="cvn-pinfo__ricon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ s.reassure_2_icon }}"></use></svg></span>{{ s.reassure_2 | newline_to_br }}</li>{%- endif -%}
          {%- if s.reassure_3 != blank -%}<li><span class="cvn-pinfo__ricon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ s.reassure_3_icon }}"></use></svg></span>{{ s.reassure_3 | newline_to_br }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coven — fiche bracelet",
  "class": "cvn-section cvn-section--product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Fil d'Ariane", "default": true },
    { "type": "text", "id": "breadcrumb_label", "label": "Nom du fil d'Ariane", "default": "Fil d'Ariane" },
    { "type": "text", "id": "home_label", "label": "Accueil", "default": "Accueil" },
    { "type": "text", "id": "collection_label", "label": "Rubrique", "default": "Les Bracelets de charms" },
    { "type": "url", "id": "collection_link", "label": "Lien de la rubrique" },
    { "type": "header", "content": "Prix" },
    { "type": "checkbox", "id": "price_confirmed", "label": "Tarif confirmé par le client", "default": false, "info": "Tant que le tarif n'est pas confirmé, la fiche affiche « — € » et la commande reste fermée." },
    { "type": "text", "id": "price_note", "label": "Mention sans tarif", "default": "Tarif à renseigner" },
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "subtitle", "label": "Accroche", "default": "Charms tirés au sort au scoop, puis assemblés pour vous." },
    { "type": "textarea", "id": "mobile_text", "label": "Texte sur téléphone (facultatif)" },
    { "type": "textarea", "id": "notice", "label": "Encadré du tirage", "default": "Après votre commande, le tirage au scoop\ndétermine les charms de votre bracelet.\nLes photos sont des exemples." },
    { "type": "textarea", "id": "mobile_notice", "label": "Encadré du tirage sur téléphone (facultatif)" },
    { "type": "header", "content": "Taille" },
    { "type": "text", "id": "size_label", "label": "Libellé", "default": "Taille du bracelet" },
    { "type": "textarea", "id": "sizes", "label": "Tailles proposées (une par ligne)", "info": "À renseigner par le client. Sans taille, la commande indique « À préciser »." },
    { "type": "text", "id": "size_placeholder", "label": "Choix par défaut", "default": "À préciser" },
    { "type": "text", "id": "size_property", "label": "Nom de la précision de commande", "default": "Taille" },
    { "type": "text", "id": "size_error", "label": "Erreur sans taille", "default": "Choisissez la taille de votre bracelet." },
    { "type": "text", "id": "size_unknown_hint", "label": "Aide sans taille", "default": "Les tailles seront indiquées par la boutique." },
    { "type": "header", "content": "Quantité et ajout" },
    { "type": "text", "id": "qty_label", "label": "Quantité", "default": "Quantité" },
    { "type": "text", "id": "qty_less", "label": "Diminuer", "default": "Diminuer la quantité" },
    { "type": "text", "id": "qty_more", "label": "Augmenter", "default": "Augmenter la quantité" },
    { "type": "range", "id": "qty_max", "label": "Quantité maximale", "min": 1, "max": 20, "step": 1, "default": 10 },
    { "type": "text", "id": "add_label", "label": "Bouton", "default": "Ajouter au panier" },
    { "type": "text", "id": "soldout_label", "label": "Bouton si indisponible", "default": "Indisponible" },
    { "type": "text", "id": "adding_label", "label": "Ajout en cours", "default": "Ajout…" },
    { "type": "text", "id": "added_label", "label": "Message après ajout", "default": "Votre bracelet est dans le panier." },
    { "type": "text", "id": "see_cart_label", "label": "Lien vers le panier", "default": "Voir le panier" },
    { "type": "text", "id": "error_label", "label": "Message d'erreur", "default": "L'ajout n'a pas abouti. Réessayez dans un instant." },
    { "type": "header", "content": "Repères" },
    { "type": "textarea", "id": "reassure_1", "label": "Repère 1", "default": "Un bracelet\nassemblé" },
    { "type": "select", "id": "reassure_1_icon", "label": "Icône 1", "default": "bracelet", "options": [{ "value": "bracelet", "label": "Bracelet" }, { "value": "assemblage", "label": "Assemblage" }, { "value": "scoop", "label": "Scoop" }, { "value": "mysteres-lune", "label": "Lune" }, { "value": "symboles-tires", "label": "Symboles" }] },
    { "type": "textarea", "id": "reassure_2", "label": "Repère 2", "default": "Charms tirés\nau sort" },
    { "type": "select", "id": "reassure_2_icon", "label": "Icône 2", "default": "mysteres-lune", "options": [{ "value": "bracelet", "label": "Bracelet" }, { "value": "assemblage", "label": "Assemblage" }, { "value": "scoop", "label": "Scoop" }, { "value": "mysteres-lune", "label": "Lune" }, { "value": "symboles-tires", "label": "Symboles" }] },
    { "type": "textarea", "id": "reassure_3", "label": "Repère 3", "default": "Tirage après\ncommande" },
    { "type": "select", "id": "reassure_3_icon", "label": "Icône 3", "default": "scoop", "options": [{ "value": "bracelet", "label": "Bracelet" }, { "value": "assemblage", "label": "Assemblage" }, { "value": "scoop", "label": "Scoop" }, { "value": "mysteres-lune", "label": "Lune" }, { "value": "symboles-tires", "label": "Symboles" }] },
    { "type": "header", "content": "Galerie" },
    { "type": "range", "id": "mobile_media_top", "label": "Galerie sous l'en-tête (téléphone)", "min": 0, "max": 120, "step": 1, "unit": "px", "default": 0 },
    { "type": "text", "id": "prev_label", "label": "Photo précédente", "default": "Photo précédente" },
    { "type": "text", "id": "next_label", "label": "Photo suivante", "default": "Photo suivante" },
    { "type": "text", "id": "thumb_label", "label": "Vignette", "default": "Voir la photo" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
      { "type": "text", "id": "image_alt", "label": "Description de la photo" },
      { "type": "range", "id": "focus_x", "label": "Cadrage horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "focus_y", "label": "Cadrage vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "zoom", "label": "Zoom", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
      { "type": "text", "id": "mobile_image_asset", "label": "Photo sur téléphone (fichier du thème, facultatif)" },
      { "type": "text", "id": "thumb_asset", "label": "Vignette (fichier du thème, facultatif)" },
      { "type": "text", "id": "mobile_thumb_asset", "label": "Vignette sur téléphone (fichier du thème, facultatif)" },
      { "type": "range", "id": "thumb_focus_x", "label": "Cadrage de la vignette (horizontal)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "thumb_focus_y", "label": "Cadrage de la vignette (vertical)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "thumb_zoom", "label": "Zoom de la vignette", "min": 100, "max": 400, "step": 5, "unit": "%", "default": 100 },
      { "type": "checkbox", "id": "mobile_hidden", "label": "Vignette masquée sur téléphone", "default": false }
    ] }
  ]
}
{% endschema %}
