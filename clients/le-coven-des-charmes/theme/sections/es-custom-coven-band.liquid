{%- comment -%}
  Le Coven des Charmes — bandeaux. Compositions des planches : photo et texte côte à côte (« Des symboles, des
  charms »), appel à commander sur photo (« Votre prochain bracelet »), note parchemin, renvoi vers la FAQ, tableau
  de correspondance, texte et photos (Le Coven), trois engagements à icônes, inscription aux nouvelles (téléphone).
  L'inscription aux nouvelles n'envoie rien tant qu'un service n'est pas relié à la boutique.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign img = ''
  if s.image != blank
    assign img = s.image | image_url: width: 2000
  elsif s.image_asset != blank
    assign img = s.image_asset | asset_url
  endif
  assign mimg = img
  if s.mobile_image != blank
    assign mimg = s.mobile_image | image_url: width: 1000
  elsif s.mobile_image_asset != blank
    assign mimg = s.mobile_image_asset | asset_url
  endif
-%}
<section class="cvn-band cvn-band--{{ s.layout }} cvn-band--m-{{ s.mobile_layout }}{% if s.framed %} cvn-band--framed{% endif %}{% if s.hide_desktop %} cvn-only-m{% endif %}{% if s.hide_mobile %} cvn-only-d{% endif %}" style="--h: {{ s.height }}px; --mh: {{ s.mobile_height }}px; --fx: {{ s.focus_x }}%; --fy: {{ s.focus_y }}%; --z: {{ s.zoom | divided_by: 100.0 }}; --mfx: {{ s.mobile_focus_x }}%; --mfy: {{ s.mobile_focus_y }}%; --media-w: {{ s.media_width }}%; --pad-t: {{ s.padding_top }}px; --pad-b: {{ s.padding_bottom }}px; --tx: {{ s.text_x }}px; --ty: {{ s.text_y }}px; --tw: {{ s.text_width }}px; --ts: {{ s.title_size }}px; --mts: {{ s.mobile_title_size }}px;">
  <div class="cvn-band__inner cvn-scale">
    {%- if img != blank -%}
      <picture class="cvn-band__media">
        {%- if mimg != img -%}<source media="(max-width: 1023px)" srcset="{{ mimg }}">{%- endif -%}
        <img src="{{ img }}" alt="{{ s.image_alt | escape }}" loading="lazy" width="1600" height="900">
      </picture>
    {%- endif -%}
    {%- if s.layout == 'cta' or s.layout == 'cta_left' or s.layout == 'question' or s.layout == 'table' -%}<div class="cvn-band__shade" aria-hidden="true"></div>{%- endif -%}
    <div class="cvn-band__copy">
      {%- if s.icon != 'none' -%}<span class="cvn-band__icon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ s.icon }}"></use></svg></span>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="cvn-band__heading{% if s.heading_style == 'caps' %} cvn-band__heading--caps{% endif %}">{%- if s.heading_style == 'caps' -%}<svg class="cvn-star4" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0l1.6 10.4L24 12l-10.4 1.6L12 24l-1.6-10.4L0 12l10.4-1.6z"/></svg>{%- endif -%}{{ s.heading | newline_to_br }}{%- if s.heading_style == 'caps' -%}<svg class="cvn-star4" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0l1.6 10.4L24 12l-10.4 1.6L12 24l-1.6-10.4L0 12l10.4-1.6z"/></svg>{%- endif -%}</h2>{%- endif -%}
      {%- if s.mobile_heading != blank -%}<p class="cvn-band__heading cvn-band__heading--m" aria-hidden="true">{{ s.mobile_heading | newline_to_br }}</p>{%- endif -%}
      {%- if s.text != blank -%}<div class="cvn-band__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.mobile_text != blank -%}<div class="cvn-band__text cvn-band__text--m">{{ s.mobile_text }}</div>{%- endif -%}
      {%- if s.layout == 'newsletter' -%}
        <form class="cvn-news" novalidate data-cvn-form="newsletter" data-cvn-simulated="{% if s.newsletter_connected %}false{% else %}true{% endif %}">
          <label class="cvn-sr" for="CvNews-{{ section.id }}">{{ s.email_label }}</label>
          <input class="cvn-news__input" id="CvNews-{{ section.id }}" name="email" type="email" autocomplete="email" placeholder="{{ s.email_placeholder }}" required>
          <label class="cvn-news__consent"><input type="checkbox" name="consent" required><span class="cvn-sr">{{ s.consent_label }}</span></label>
          <button class="cvn-news__send" type="submit"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-droite"></use></svg><span class="cvn-sr">{{ s.send_label }}</span></button>
          <p class="cvn-news__status" role="status" aria-live="polite" data-cvn-status></p>
          <p class="cvn-news__legal">{{ s.consent_label }}</p>
        </form>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <div class="cvn-band__actions">
          <a class="cvn-btn cvn-btn--{{ s.button_style }} cvn-band__btn" href="{{ s.button_link }}">{{ s.button_label }}{%- if s.button_arrow -%}<svg class="cvn-icon" aria-hidden="true"><use href="#coven-{% if s.layout == 'cta' %}fleche-droite{% else %}chevron-droite{% endif %}"></use></svg>{%- endif -%}</a>
          {%- if s.price_note != blank -%}<p class="cvn-band__price">{{ s.price_note }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="cvn-band__items" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign src = ''
            if b.image != blank
              assign src = b.image | image_url: width: 700
            elsif b.image_asset != blank
              assign src = b.image_asset | asset_url
            endif
          -%}
          <li class="cvn-band__item cvn-band__item--{{ block.type }}{% if b.desktop_hidden %} cvn-only-m{% endif %}" {{ block.shopify_attributes }} style="--do: {{ b.desktop_order | default: forloop.index }}; --fx: {{ b.focus_x | default: 50 }}%; --fy: {{ b.focus_y | default: 50 }}%; --z: {{ b.zoom | default: 100 | divided_by: 100.0 }};">
            {%- if src != blank -%}<span class="cvn-band__item-media"><img src="{{ src }}" alt="{{ b.image_alt | escape }}" loading="lazy" width="500" height="400"></span>{%- endif -%}
            {%- if b.icon != blank and b.icon != 'none' -%}<span class="cvn-band__item-icon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ b.icon }}"></use></svg></span>{%- endif -%}
            {%- if b.title != blank -%}<span class="cvn-band__item-title">{{ b.title | newline_to_br }}</span>{%- endif -%}
            {%- if b.text != blank -%}<span class="cvn-band__item-text">{{ b.text | newline_to_br }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coven — bandeau",
  "class": "cvn-section cvn-section--band",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition sur ordinateur", "default": "split", "options": [
      { "value": "split", "label": "Photo à gauche, texte à droite" },
      { "value": "cta", "label": "Appel à commander sur photo" },
      { "value": "cta_left", "label": "Appel à commander, texte à gauche (produit)" },
      { "value": "note", "label": "Note parchemin" },
      { "value": "question", "label": "Renvoi vers les questions" },
      { "value": "table", "label": "Tableau de correspondance" },
      { "value": "photos", "label": "Texte et photos (Le Coven)" },
      { "value": "features", "label": "Engagements à icônes" },
      { "value": "order", "label": "Bouton de commande et rappel" },
      { "value": "newsletter", "label": "Inscription aux nouvelles" }
    ] },
    { "type": "select", "id": "mobile_layout", "label": "Composition sur téléphone", "default": "stack", "options": [
      { "value": "stack", "label": "Photo puis texte" },
      { "value": "side", "label": "Photo à gauche, texte à droite" },
      { "value": "over", "label": "Texte sur la photo" },
      { "value": "card", "label": "Carte parchemin" }
    ] },
    { "type": "checkbox", "id": "framed", "label": "Cadre doré", "default": false },
    { "type": "checkbox", "id": "hide_desktop", "label": "Masquer sur ordinateur", "default": false },
    { "type": "checkbox", "id": "hide_mobile", "label": "Masquer sur téléphone", "default": false },
    { "type": "range", "id": "height", "label": "Hauteur sur ordinateur", "min": 0, "max": 900, "step": 2, "unit": "px", "default": 0, "info": "0 : selon le contenu." },
    { "type": "range", "id": "mobile_height", "label": "Hauteur sur téléphone", "min": 0, "max": 900, "step": 2, "unit": "px", "default": 0 },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
    { "type": "text", "id": "image_alt", "label": "Description de la photo" },
    { "type": "range", "id": "media_width", "label": "Largeur de la photo", "min": 20, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_x", "label": "Cadrage horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y", "label": "Cadrage vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "zoom", "label": "Zoom", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
    { "type": "image_picker", "id": "mobile_image", "label": "Photo sur téléphone (facultative)" },
    { "type": "text", "id": "mobile_image_asset", "label": "Photo sur téléphone (fichier du thème)" },
    { "type": "range", "id": "mobile_focus_x", "label": "Cadrage horizontal (téléphone)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "mobile_focus_y", "label": "Cadrage vertical (téléphone)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "select", "id": "icon", "label": "Icône", "default": "none", "options": [
      { "value": "none", "label": "Aucune" }, { "value": "mysteres-lune", "label": "Lune" }, { "value": "information", "label": "Information" },
      { "value": "email", "label": "Enveloppe" }, { "value": "charms-etoile", "label": "Étoile" }
    ] },
    { "type": "textarea", "id": "heading", "label": "Titre" },
    { "type": "textarea", "id": "mobile_heading", "label": "Titre sur téléphone (facultatif)" },
    { "type": "select", "id": "heading_style", "label": "Style du titre", "default": "title", "options": [
      { "value": "title", "label": "Titre" }, { "value": "caps", "label": "Capitales espacées entre étoiles" }
    ] },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "richtext", "id": "mobile_text", "label": "Texte sur téléphone (facultatif)" },
    { "type": "range", "id": "title_size", "label": "Taille du titre (ordinateur)", "min": 18, "max": 80, "step": 1, "unit": "px", "default": 42 },
    { "type": "range", "id": "mobile_title_size", "label": "Taille du titre (téléphone)", "min": 16, "max": 50, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "text_x", "label": "Retrait du texte (ordinateur)", "min": 0, "max": 900, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_y", "label": "Position verticale du texte (ordinateur)", "min": 0, "max": 400, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_width", "label": "Largeur du texte (ordinateur)", "min": 200, "max": 1400, "step": 10, "unit": "px", "default": 640 },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "select", "id": "button_style", "label": "Style du bouton", "default": "gold", "options": [
      { "value": "gold", "label": "Or" }, { "value": "line", "label": "Contour doré" }, { "value": "dark", "label": "Sombre" }
    ] },
    { "type": "checkbox", "id": "button_arrow", "label": "Flèche dans le bouton", "default": true },
    { "type": "text", "id": "price_note", "label": "Prix sous le bouton" },
    { "type": "header", "content": "Inscription aux nouvelles" },
    { "type": "text", "id": "email_label", "label": "Champ e-mail", "default": "Votre e-mail" },
    { "type": "text", "id": "email_placeholder", "label": "Exemple dans le champ", "default": "Votre e-mail" },
    { "type": "text", "id": "consent_label", "label": "Accord", "default": "J'accepte de recevoir les nouvelles du Coven (désinscription à tout moment)." },
    { "type": "text", "id": "send_label", "label": "Bouton d'envoi", "default": "S'inscrire" },
    { "type": "checkbox", "id": "newsletter_connected", "label": "Service d'envoi relié à la boutique", "default": false, "info": "Sans service relié, le formulaire indique qu'aucune inscription n'est enregistrée." },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
      { "type": "text", "id": "image_alt", "label": "Description de la photo" },
      { "type": "text", "id": "title", "label": "Légende" },
      { "type": "range", "id": "desktop_order", "label": "Position sur ordinateur", "min": 1, "max": 8, "step": 1, "default": 1 },
      { "type": "checkbox", "id": "desktop_hidden", "label": "Masquer sur ordinateur", "default": false },
      { "type": "range", "id": "focus_x", "label": "Cadrage horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "focus_y", "label": "Cadrage vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "zoom", "label": "Zoom", "min": 100, "max": 400, "step": 5, "unit": "%", "default": 100 }
    ] },
    { "type": "feature", "name": "Engagement", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "mysteres-lune", "options": [
        { "value": "mysteres-lune", "label": "Lune" }, { "value": "cabinet-tiroirs", "label": "Cabinet" }, { "value": "cristal", "label": "Cristal" },
        { "value": "bracelet", "label": "Bracelet" }, { "value": "scoop", "label": "Scoop" }, { "value": "assemblage", "label": "Assemblage" }
      ] },
      { "type": "textarea", "id": "title", "label": "Titre" },
      { "type": "textarea", "id": "text", "label": "Texte" }
    ] }
  ],
  "presets": [{ "name": "Coven — bandeau" }]
}
{% endschema %}
