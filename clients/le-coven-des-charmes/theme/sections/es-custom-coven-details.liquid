{%- comment -%}
  Le Coven des Charmes — détails du produit en accordéons (matières, dimensions, entretien, livraison et retours)
  et note parchemin « Les charms dépendent du tirage ». Les informations non fournies par le client restent
  « À renseigner » : rien n'est inventé.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="cvn-details{% if s.hide_note_mobile %} cvn-details--m-nonote{% endif %}{% if s.note_title == blank and s.note_text == blank %} cvn-details--solo{% endif %}">
  <div class="cvn-details__inner cvn-scale">
    <div class="cvn-details__box">
      {%- if s.heading != blank -%}<h2 class="cvn-details__heading">{{ s.heading }}</h2>{%- endif -%}
      <div class="cvn-acc" data-cvn-acc>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="cvn-acc__item{% if b.desktop_hidden %} cvn-only-m{% endif %}{% if b.mobile_hidden %} cvn-only-d{% endif %}" data-cvn-acc-item {{ block.shopify_attributes }}>
            <h3 class="cvn-acc__head">
              <button type="button" class="cvn-acc__btn" aria-expanded="false" aria-controls="CvnAcc-{{ section.id }}-{{ forloop.index }}" data-cvn-acc-btn>
                {%- if b.icon != 'none' -%}<svg class="cvn-icon cvn-acc__icon" aria-hidden="true"><use href="#coven-{{ b.icon }}"></use></svg>{%- endif -%}
                <span class="cvn-acc__title">{{ b.title }}</span>
                {%- if b.value != blank -%}<span class="cvn-acc__value">{{ b.value }}</span>{%- endif -%}
                <svg class="cvn-icon cvn-acc__chev" aria-hidden="true"><use href="#coven-chevron-bas"></use></svg>
              </button>
            </h3>
            <div class="cvn-acc__panel" id="CvnAcc-{{ section.id }}-{{ forloop.index }}" hidden>{{ b.content | default: s.empty_text }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if s.note_title != blank or s.note_text != blank -%}
      <aside class="cvn-parch cvn-details__note">
        <svg class="cvn-parch__moon" viewBox="0 0 40 40" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M26 4a17 17 0 1 0 8 29A15 15 0 0 1 26 4z"/></svg>
        <svg class="cvn-parch__sprig" viewBox="0 0 30 90" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M15 88V6"/><path d="M15 70c-8-2-12-8-12-14 7 1 11 6 12 14zM15 70c8-2 12-8 12-14-7 1-11 6-12 14zM15 50c-7-2-10-7-10-12 6 1 9 5 10 12zM15 50c7-2 10-7 10-12-6 1-9 5-10 12zM15 31c-6-2-8-6-8-10 5 1 7 4 8 10zM15 31c6-2 8-6 8-10-5 1-7 4-8 10z"/></g></svg>
        {%- if s.note_title != blank -%}<h2 class="cvn-parch__title">{{ s.note_title }}</h2>{%- endif -%}
        <div class="cvn-parch__text">{{ s.note_text }}</div>
      </aside>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coven — détails",
  "class": "cvn-section cvn-section--details",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Détails du produit" },
    { "type": "richtext", "id": "empty_text", "label": "Texte d'un détail non renseigné", "default": "<p>Information à renseigner par la boutique.</p>" },
    { "type": "checkbox", "id": "hide_note_mobile", "label": "Masquer la note sur téléphone", "default": true },
    { "type": "text", "id": "note_title", "label": "Note : titre", "default": "Les charms dépendent du tirage." },
    { "type": "richtext", "id": "note_text", "label": "Note : texte", "default": "<p>Les symboles du scoop déterminent les charms qui composeront votre bracelet. Les photos montrent des exemples de créations, et ne garantissent pas la présence de ces charms sur votre bracelet.</p>" }
  ],
  "blocks": [
    { "type": "detail", "name": "Détail", "settings": [
      { "type": "text", "id": "title", "label": "Titre" },
      { "type": "text", "id": "value", "label": "Valeur résumée", "default": "À renseigner" },
      { "type": "richtext", "id": "content", "label": "Contenu" },
      { "type": "select", "id": "icon", "label": "Icône (téléphone)", "default": "none", "options": [
        { "value": "none", "label": "Aucune" }, { "value": "cristal", "label": "Matières" }, { "value": "protection", "label": "Entretien" },
        { "value": "expedition", "label": "Livraison" }, { "value": "bracelet", "label": "Bracelet" }, { "value": "information", "label": "Information" }
      ] },
      { "type": "checkbox", "id": "desktop_hidden", "label": "Masquer sur ordinateur", "default": false },
      { "type": "checkbox", "id": "mobile_hidden", "label": "Masquer sur téléphone", "default": false }
    ] }
  ]
}
{% endschema %}
