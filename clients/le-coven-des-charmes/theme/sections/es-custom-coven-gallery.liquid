{%- comment -%}
  Le Coven des Charmes — exemples de bracelets réalisés. Chaque légende rappelle que les charms dépendent du tirage :
  ces exemples ne sont pas des modèles à commander. Compositions : trois arches (accueil), quatre cartes (produit),
  grande photo et mosaïque (créations), photos légendées (Coven) ; téléphone : pile, trois ou deux colonnes.
  Un clic agrandit la photo si l'option est active.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="cvn-gal cvn-gal--{{ s.layout }} cvn-gal--m-{{ s.mobile_layout }}{% if s.framed %} cvn-gal--framed{% endif %}" style="--pad-t: {{ s.padding_top }}px; --pad-b: {{ s.padding_bottom }}px; --mpad-t: {{ s.mobile_padding_top }}px; --mpad-b: {{ s.mobile_padding_bottom }}px;">
  <div class="cvn-gal__inner cvn-scale">
    {%- if s.bg_asset != blank -%}<div class="cvn-gal__bg" aria-hidden="true"><img src="{{ s.bg_asset | asset_url }}" alt="" loading="lazy" width="1600" height="900"></div>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="cvn-gal__heading">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
    {%- if s.mobile_heading != blank -%}<p class="cvn-gal__heading cvn-gal__heading--m" aria-hidden="true">{{ s.mobile_heading | newline_to_br }}</p>{%- endif -%}
    {%- if s.subheading != blank -%}<div class="cvn-gal__sub">{{ s.subheading }}</div>{%- endif -%}
    <ul class="cvn-gal__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign src = ''
          assign big = ''
          if b.image != blank
            assign src = b.image | image_url: width: 1000
            assign big = b.image | image_url: width: 2000
          elsif b.image_asset != blank
            assign src = b.image_asset | asset_url
            assign big = src
          endif
          assign caption = b.caption | default: s.default_caption
        -%}
        <li class="cvn-gal__item{% if forloop.first %} cvn-gal__item--first{% endif %}{% if b.desktop_hidden %} cvn-only-m{% endif %}{% if b.mobile_hidden %} cvn-only-d{% endif %}" {{ block.shopify_attributes }} style="--fx: {{ b.focus_x }}%; --fy: {{ b.focus_y }}%; --z: {{ b.zoom | divided_by: 100.0 }};">
          <figure class="cvn-gal__fig">
            {%- if src != blank -%}
              {%- if s.zoom_enabled -%}<button type="button" class="cvn-gal__media" data-cvn-zoom="{{ big }}" data-cvn-zoom-alt="{{ b.image_alt | escape }}" data-cvn-zoom-caption="{{ caption | escape }}"><span class="cvn-sr">{{ s.zoom_label }}</span>{%- else -%}<span class="cvn-gal__media">{%- endif -%}
              <picture>{%- if b.mobile_image_asset != blank -%}<source media="(max-width: 1023px)" srcset="{{ b.mobile_image_asset | asset_url }}">{%- endif -%}<img src="{{ src }}" alt="{{ b.image_alt | escape }}" loading="lazy" width="800" height="600"></picture>
              {%- if s.zoom_enabled -%}</button>{%- else -%}</span>{%- endif -%}
            {%- endif -%}
            {%- if caption != blank -%}<figcaption class="cvn-gal__caption{% if b.mobile_caption != blank %} cvn-gal__caption--d{% endif %}">{{ caption | newline_to_br }}</figcaption>{%- endif -%}
            {%- if b.mobile_caption != blank -%}<figcaption class="cvn-gal__caption cvn-gal__caption--m">{{ b.mobile_caption | newline_to_br }}</figcaption>{%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.note != blank -%}<p class="cvn-gal__note cvn-note"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-information"></use></svg><span>{{ s.note | newline_to_br }}</span></p>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="cvn-gal__actions"><a class="cvn-btn cvn-btn--gold cvn-gal__btn" href="{{ s.button_link }}">{{ s.button_label }}{%- if s.button_arrow -%}<svg class="cvn-icon" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg>{%- endif -%}</a>
      {%- if s.price_note != blank -%}<p class="cvn-gal__price">{{ s.price_note }}</p>{%- endif -%}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coven — exemples",
  "class": "cvn-section cvn-section--gallery",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition sur ordinateur", "default": "arches", "options": [
      { "value": "arches", "label": "Trois arches dorées (accueil)" },
      { "value": "cards", "label": "Cartes en ligne (produit)" },
      { "value": "mosaic", "label": "Grande photo et mosaïque (créations)" },
      { "value": "tiles", "label": "Photos légendées en grille (Coven)" }
    ] },
    { "type": "select", "id": "mobile_layout", "label": "Composition sur téléphone", "default": "three", "options": [
      { "value": "three", "label": "Trois colonnes (accueil)" },
      { "value": "two", "label": "Deux colonnes (produit)" },
      { "value": "stack", "label": "Pile de grandes photos légendées (créations)" },
      { "value": "tiles", "label": "Grille de photos légendées (Coven)" }
    ] },
    { "type": "checkbox", "id": "framed", "label": "Cadre doré", "default": true },
    { "type": "textarea", "id": "heading", "label": "Titre" },
    { "type": "textarea", "id": "mobile_heading", "label": "Titre sur téléphone (facultatif)" },
    { "type": "richtext", "id": "subheading", "label": "Sous-titre" },
    { "type": "textarea", "id": "default_caption", "label": "Légende par défaut", "default": "Exemple de bracelet —\nles charms dépendent du tirage." },
    { "type": "text", "id": "bg_asset", "label": "Décor de fond (fichier du thème)" },
    { "type": "checkbox", "id": "zoom_enabled", "label": "Agrandir la photo au clic", "default": true },
    { "type": "text", "id": "zoom_label", "label": "Texte du bouton d'agrandissement", "default": "Agrandir la photo" },
    { "type": "textarea", "id": "note", "label": "Note (encadré)" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "button_arrow", "label": "Flèche dans le bouton", "default": false },
    { "type": "text", "id": "price_note", "label": "Prix sous le bouton (téléphone)" },
    { "type": "range", "id": "padding_top", "label": "Marge haute (ordinateur)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse (ordinateur)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_padding_top", "label": "Marge haute (téléphone)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Marge basse (téléphone)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 10 }
  ],
  "blocks": [
    { "type": "example", "name": "Exemple", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
      { "type": "text", "id": "image_alt", "label": "Description de la photo" },
      { "type": "text", "id": "mobile_image_asset", "label": "Photo sur téléphone (fichier du thème, facultatif)" },
      { "type": "textarea", "id": "caption", "label": "Légende (sinon celle par défaut)" },
      { "type": "textarea", "id": "mobile_caption", "label": "Légende sur téléphone (facultative)" },
      { "type": "range", "id": "focus_x", "label": "Cadrage horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "focus_y", "label": "Cadrage vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "zoom", "label": "Zoom", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
      { "type": "checkbox", "id": "desktop_hidden", "label": "Masquer sur ordinateur", "default": false },
      { "type": "checkbox", "id": "mobile_hidden", "label": "Masquer sur téléphone", "default": false }
    ] }
  ],
  "presets": [{ "name": "Coven — exemples" }]
}
{% endschema %}
