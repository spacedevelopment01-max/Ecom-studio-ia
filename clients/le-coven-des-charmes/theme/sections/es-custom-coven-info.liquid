{%- comment -%}
  Le Coven des Charmes — informations de la boutique en onglets : mentions légales, CGV, confidentialité, cookies,
  livraison et retours (adresse directe : #mentions, #cgv…). Les textes juridiques restent une STRUCTURE à compléter
  et à valider avec les informations du vendeur : rien n'est présenté comme validé. Préférences de cookies réelles :
  essentiels toujours actifs, mesure d'audience désactivée tant que le visiteur ne l'accepte pas.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="cvn-info">
  <div class="cvn-info__inner cvn-scale">
    <div class="cvn-info__tabs" role="tablist" aria-label="{{ s.tabs_label }}" data-cvn-tabs data-cvn-tabs-hash>
      {%- for block in section.blocks -%}
        <button type="button" role="tab" id="CvnInfoTab-{{ block.id }}" aria-controls="CvnInfo-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} data-cvn-tab="{{ block.settings.anchor }}"{% if block.settings.mobile_hidden %} class="cvn-only-d"{% endif %}>{{ block.settings.tab }}</button>
      {%- endfor -%}
    </div>
    <div class="cvn-info__body cvn-paper">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="cvn-info__panel" id="CvnInfo-{{ block.id }}" role="tabpanel" aria-labelledby="CvnInfoTab-{{ block.id }}" tabindex="0"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="cvn-info__main">
            <h2 class="cvn-info__title">{{ b.title }}</h2>
            {%- if b.fields != blank -%}
              <dl class="cvn-info__fields">
                {%- assign rows = b.fields | newline_to_br | split: '<br />' -%}
                {%- for r in rows -%}{%- assign pair = r | strip | split: '|' -%}{%- if pair[0] != blank -%}<div><dt>{{ pair[0] | strip }}</dt><dd>{{ pair[1] | strip | default: s.todo }}</dd></div>{%- endif -%}{%- endfor -%}
              </dl>
            {%- endif -%}
            {%- if b.content != blank -%}<div class="cvn-info__rte">{{ b.content }}</div>{%- endif -%}
          </div>
          {%- if b.aside_title != blank -%}
            <div class="cvn-info__aside">
              <h3>{{ b.aside_title }}</h3>
              <div class="cvn-info__rte">{{ b.aside_text }}</div>
              {%- if b.aside2_title != blank -%}<div class="cvn-info__box"><h3>{{ b.aside2_title }}</h3><p>{{ b.aside2_text }}</p></div>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
      <div class="cvn-prefs" data-cvn-prefs data-saved="{{ s.saved | escape }}">
        <h2 class="cvn-prefs__title">{{ s.prefs_title }}</h2>
        <p class="cvn-prefs__text">{{ s.prefs_text }}</p>
        <div class="cvn-prefs__switches">
          <label class="cvn-switch"><input type="checkbox" checked disabled><span class="cvn-switch__ui" aria-hidden="true"></span><span><strong>{{ s.essential }}</strong><small>{{ s.essential_note }}</small></span></label>
          <label class="cvn-switch"><input type="checkbox" data-cvn-consent="audience"><span class="cvn-switch__ui" aria-hidden="true"></span><span><strong>{{ s.audience }}</strong><small>{{ s.audience_note }}</small></span></label>
        </div>
        <div class="cvn-prefs__actions">
          <button type="button" class="cvn-btn cvn-btn--cream" data-cvn-consent-all="false">{{ s.refuse }}</button>
          <button type="button" class="cvn-btn cvn-btn--cream" data-cvn-consent-save>{{ s.save }}</button>
          <button type="button" class="cvn-btn cvn-btn--gold" data-cvn-consent-all="true">{{ s.accept }}</button>
        </div>
        <p class="cvn-form-status" role="status" aria-live="polite" data-cvn-prefs-status></p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coven — informations",
  "class": "cvn-section cvn-section--info",
  "settings": [
    { "type": "text", "id": "tabs_label", "label": "Nom des onglets", "default": "Informations de la boutique" },
    { "type": "text", "id": "todo", "label": "Mention à renseigner", "default": "À renseigner" },
    { "type": "text", "id": "prefs_title", "label": "Cookies : titre", "default": "Gestion des cookies" },
    { "type": "textarea", "id": "prefs_text", "label": "Cookies : texte", "default": "Nous utilisons des cookies pour assurer le bon fonctionnement du site et, avec votre accord, mesurer l'audience." },
    { "type": "text", "id": "essential", "label": "Cookies essentiels", "default": "Cookies essentiels" },
    { "type": "text", "id": "essential_note", "label": "Précision (essentiels)", "default": "Requis au fonctionnement du site." },
    { "type": "text", "id": "audience", "label": "Cookies d'audience", "default": "Cookies d'audience" },
    { "type": "text", "id": "audience_note", "label": "Précision (audience)", "default": "Mesure d'audience (facultatif)." },
    { "type": "text", "id": "refuse", "label": "Bouton Tout refuser", "default": "Tout refuser" },
    { "type": "text", "id": "save", "label": "Bouton Enregistrer", "default": "Enregistrer mes choix" },
    { "type": "text", "id": "accept", "label": "Bouton Tout accepter", "default": "Tout accepter" },
    { "type": "text", "id": "saved", "label": "Choix enregistrés", "default": "Vos choix sont enregistrés." }
  ],
  "blocks": [
    { "type": "tab", "name": "Onglet", "settings": [
      { "type": "text", "id": "tab", "label": "Nom de l'onglet" },
      { "type": "text", "id": "anchor", "label": "Adresse de l'onglet (#)", "info": "Exemple : mentions, cgv, confidentialite, cookies, livraison." },
      { "type": "text", "id": "title", "label": "Titre" },
      { "type": "textarea", "id": "fields", "label": "Informations (une par ligne : libellé | valeur)", "info": "Sans valeur, la ligne affiche « À renseigner »." },
      { "type": "richtext", "id": "content", "label": "Texte" },
      { "type": "text", "id": "aside_title", "label": "Encadré : titre" },
      { "type": "richtext", "id": "aside_text", "label": "Encadré : texte" },
      { "type": "text", "id": "aside2_title", "label": "Second encadré : titre" },
      { "type": "text", "id": "aside2_text", "label": "Second encadré : texte" },
      { "type": "checkbox", "id": "mobile_hidden", "label": "Onglet masqué sur téléphone", "default": false }
    ] }
  ]
}
{% endschema %}
