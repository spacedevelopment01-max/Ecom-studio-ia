{%- comment -%}
  Le Coven des Charmes — confirmation. Reprend les vraies saisies de la commande (taille, quantité, coordonnées
  abrégées) et montre quatre états distincts : commande enregistrée, tirage à réaliser, assemblage, expédition.
  Seule la première étape peut être atteinte au moment de la commande ; le tirage, l'assemblage et l'expédition sont
  « à venir » et mis à jour par le créateur au moment réel. Dans l'aperçu, rien n'a été enregistré (bandeau).
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="cvn-confirm" data-cvn-confirm data-photo="{{ s.photo_asset | asset_url }}" data-example="{{ s.example_label | escape }}" data-size="{{ s.size_label | escape }}" data-qty="{{ s.qty_label | escape }}" data-size-placeholder="À préciser" data-price-note="{{ s.price_note | escape }}" data-later="{{ s.status_later | escape }}">
  <div class="cvn-confirm__inner cvn-scale">
    <p class="cvn-demo-banner" role="note" data-cvn-sim-only><svg class="cvn-icon" aria-hidden="true"><use href="#coven-information"></use></svg>{{ s.demo_banner }}</p>
    <div class="cvn-confirm__card cvn-paper">
      <h2 class="cvn-confirm__title">{{ s.summary_title }}</h2>
      <div class="cvn-sum__lines cvn-confirm__lines" data-cvn-sum-lines></div>
      <p class="cvn-confirm__who" data-cvn-confirm-who hidden></p>
      <p class="cvn-confirm__empty" data-cvn-confirm-empty hidden>{{ s.empty_text }}</p>
      <div class="cvn-paper-note"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-information"></use></svg><p>{{ s.note }}</p></div>
    </div>
    <h2 class="cvn-confirm__next">{{ s.next_title }}</h2>
    <ol class="cvn-states" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="cvn-state{% if forloop.first %} is-first{% endif %}" data-cvn-state="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="cvn-state__icon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ b.icon }}"></use></svg></span>
          <span class="cvn-state__body">
            <span class="cvn-state__title">{{ b.title | newline_to_br }}</span>
            <span class="cvn-state__text">{{ b.text | newline_to_br }}</span>
            <span class="cvn-state__status" data-cvn-state-status>{% if forloop.first %}{{ s.status_now }}{% else %}{{ s.status_later }}{% endif %}</span>
          </span>
        </li>
      {%- endfor -%}
    </ol>
    <div class="cvn-paper-note cvn-confirm__mnote cvn-only-m"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-mysteres-lune"></use></svg><p>{{ s.note }}</p></div>
    <div class="cvn-confirm__actions">
      <a class="cvn-btn cvn-btn--dark" href="{{ s.back_link }}">{{ s.back_label }}</a>
      <a class="cvn-btn cvn-btn--gold" href="{{ s.order_link }}">{{ s.order_label }}<svg class="cvn-icon cvn-only-m" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coven — confirmation",
  "class": "cvn-section cvn-section--confirm",
  "settings": [
    { "type": "text", "id": "photo_asset", "label": "Photo d'exemple du récapitulatif (fichier du thème)" },
    { "type": "text", "id": "example_label", "label": "Mention de la photo", "default": "Exemple de bracelet" },
    { "type": "text", "id": "size_label", "label": "Taille", "default": "Taille" },
    { "type": "text", "id": "qty_label", "label": "Quantité", "default": "Quantité" },
    { "type": "text", "id": "price_note", "label": "Mention sans tarif", "default": "Tarif à renseigner" },
    { "type": "textarea", "id": "demo_banner", "label": "Bandeau de simulation", "default": "Confirmation de démonstration : aucune commande n'a été enregistrée, aucun paiement ni e-mail." },
    { "type": "text", "id": "summary_title", "label": "Titre du récapitulatif", "default": "Aperçu de votre commande" },
    { "type": "textarea", "id": "empty_text", "label": "Sans commande", "default": "Aucune commande en cours dans ce navigateur." },
    { "type": "textarea", "id": "note", "label": "Rappel du tirage", "default": "Les charms sont tirés au sort au scoop après votre commande, puis assemblés sur votre bracelet." },
    { "type": "text", "id": "next_title", "label": "Titre des étapes (téléphone)", "default": "Et maintenant ?" },
    { "type": "text", "id": "status_now", "label": "Statut de la première étape", "default": "Étape actuelle" },
    { "type": "text", "id": "status_later", "label": "Statut des étapes suivantes", "default": "À venir" },
    { "type": "text", "id": "back_label", "label": "Bouton retour", "default": "Retour au Coven" },
    { "type": "url", "id": "back_link", "label": "Lien retour" },
    { "type": "text", "id": "order_label", "label": "Bouton commande", "default": "Voir ma commande" },
    { "type": "url", "id": "order_link", "label": "Lien commande (espace client)" }
  ],
  "blocks": [
    { "type": "state", "name": "État", "settings": [
      { "type": "textarea", "id": "title", "label": "Titre" },
      { "type": "textarea", "id": "text", "label": "Texte" },
      { "type": "select", "id": "icon", "label": "Icône", "default": "validation", "options": [
        { "value": "validation", "label": "Validation" }, { "value": "scoop", "label": "Scoop" }, { "value": "assemblage", "label": "Assemblage" },
        { "value": "expedition", "label": "Expédition" }, { "value": "panier", "label": "Panier" }, { "value": "coupelle", "label": "Coupelle" }
      ] }
    ] }
  ]
}
{% endschema %}
