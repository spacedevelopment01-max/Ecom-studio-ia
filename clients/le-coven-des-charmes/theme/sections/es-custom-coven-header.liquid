{%- comment -%}
  Le Coven des Charmes — en-tête (projet client dédié, hors catalogue). Liens à gauche et à droite, logo original du
  client au centre (dessin inchangé, simplement cadré dans son médaillon), compte, panier et bouton « Commander ».
  Téléphone : menu à gauche, logo au centre, panier à droite ; le menu s'ouvre en panneau plein écran.
  La feuille de style commune du site est chargée ici : cette section est présente sur toutes les pages.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign logo_src = ''
  if s.logo != blank
    assign logo_src = s.logo | image_url: width: 640
  elsif s.logo_asset != blank
    assign logo_src = s.logo_asset | asset_url
  endif
  assign cart_count = cart.item_count | default: 0
  assign here = page.handle | default: template.name
  assign compact = false
  assign compact_list = s.compact_on | split: ','
  for h in compact_list
    assign hh = h | strip
    if here == hh or template.name == hh
      assign compact = true
    endif
  endfor
  assign mlogo = s.mobile_logo
  assign size_lines = s.mobile_logo_sizes | newline_to_br | split: '<br />'
  for l in size_lines
    assign pair = l | strip | split: ':'
    assign key = pair[0] | strip
    if key != '' and pair[1] != blank
      if here == key or template.name == key
        assign mlogo = pair[1] | strip | plus: 0
      endif
    endif
  endfor
  assign mbar = s.mobile_bar
  assign bar_lines = s.mobile_bar_heights | newline_to_br | split: '<br />'
  for l in bar_lines
    assign pair = l | strip | split: ':'
    assign key = pair[0] | strip
    if key != '' and pair[1] != blank
      if here == key or template.name == key
        assign mbar = pair[1] | strip | plus: 0
      endif
    endif
  endfor
  assign left_menu = s.menu_left
  if compact and s.menu_left_compact != blank
    assign left_menu = s.menu_left_compact
  endif
-%}
{% style %}
  @font-face { font-family: "Coven Garamond"; src: url({{ s.font_regular | default: 'coven-eb-garamond-400.ttf' | asset_url }}) format("truetype"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Coven Garamond"; src: url({{ s.font_medium | default: 'coven-eb-garamond-500.ttf' | asset_url }}) format("truetype"); font-weight: 500; font-display: swap; }
  @font-face { font-family: "Coven Garamond"; src: url({{ s.font_semibold | default: 'coven-eb-garamond-600.ttf' | asset_url }}) format("truetype"); font-weight: 600; font-display: swap; }
  :root {
    --cvn-bg: {{ s.color_bg }};
    --cvn-panel: {{ s.color_panel }};
    --cvn-gold: {{ s.color_gold }};
    --cvn-gold-line: {{ s.color_line }};
    --cvn-cream: {{ s.color_title }};
    --cvn-text: {{ s.color_text }};
    --cvn-parchment: {{ s.color_parchment }};
    --cvn-violet: {{ s.color_violet }};
  }
{% endstyle %}
<div class="cvn-site-flag" hidden data-cvn-mode="{% if s.commerce_mode == 'shopify' and request.host != 'apercu' %}shopify{% else %}simulation{% endif %}" data-cvn-icons="{{ s.icons_asset | default: 'coven-icones.svg' | asset_url }}"></div>
<header class="cvn-header{% if s.mobile_overlay %} cvn-header--m-overlay{% endif %}{% if compact %} cvn-header--compact{% endif %}" data-cvn-header style="--cvn-mlogo: {{ mlogo }}px; --cvn-mbar: {{ mbar }}px;">
  <div class="cvn-header__bar cvn-scale">
    <button class="cvn-header__burger" type="button" aria-expanded="false" aria-controls="CvMenu" data-cvn-menu-open>
      <svg class="cvn-icon" aria-hidden="true"><use href="#coven-menu"></use></svg><span class="cvn-sr">{{ s.menu_label }}</span>
    </button>
    <svg class="cvn-header__star" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0l1.6 10.4L24 12l-10.4 1.6L12 24l-1.6-10.4L0 12l10.4-1.6z"/></svg>
    <nav class="cvn-header__nav cvn-header__nav--left" aria-label="{{ s.nav_label_left }}">
      {%- for link in linklists[left_menu].links -%}
        <a class="cvn-header__link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <a class="cvn-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — {{ s.home_label }}">
      {%- if logo_src != blank -%}
        <img src="{{ logo_src }}" alt="{{ s.logo_alt | default: shop.name | escape }}" width="640" height="640" style="--cvn-logo-zoom: {{ s.logo_zoom | divided_by: 100.0 }}">
      {%- else -%}
        <span class="cvn-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <nav class="cvn-header__nav cvn-header__nav--right" aria-label="{{ s.nav_label_right }}">
      {%- for link in linklists[s.menu_right].links -%}
        <a class="cvn-header__link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div class="cvn-header__tools">
      {%- if s.show_account -%}
        <a class="cvn-header__tool cvn-header__tool--account" href="{{ s.account_link | default: routes.account_url }}"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-compte"></use></svg><span class="cvn-sr">{{ s.account_label }}</span></a>
      {%- endif -%}
      <a class="cvn-header__tool cvn-header__tool--cart" href="{{ routes.cart_url }}" data-cvn-cart-link>
        <svg class="cvn-icon" aria-hidden="true"><use href="#coven-sac"></use></svg>
        <span class="cvn-sr">{{ s.cart_label }}</span>
        <span class="cvn-header__count" data-cvn-cart-count{% if cart_count == 0 %} hidden{% endif %}>{{ cart_count }}</span>
      </a>
      {%- if s.cta_label != blank -%}
        <a class="cvn-btn cvn-btn--gold cvn-header__cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="cvn-menu" id="CvMenu" role="dialog" aria-modal="true" aria-label="{{ s.menu_label }}" hidden data-cvn-menu>
    <div class="cvn-menu__head">
      <button class="cvn-menu__close" type="button" data-cvn-menu-close><svg class="cvn-icon" aria-hidden="true"><use href="#coven-fermer"></use></svg><span class="cvn-sr">{{ s.close_label }}</span></button>
      {%- if logo_src != blank -%}<img class="cvn-menu__logo" src="{{ logo_src }}" alt="" width="640" height="640" loading="lazy">{%- endif -%}
    </div>
    <nav class="cvn-menu__nav" aria-label="{{ s.menu_label }}">
      {%- for link in linklists[s.menu_mobile].links -%}
        <a class="cvn-menu__link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}<svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-droite"></use></svg></a>
      {%- endfor -%}
    </nav>
    <div class="cvn-menu__tools">
      {%- if s.show_account -%}<a class="cvn-menu__tool" href="{{ s.account_link | default: routes.account_url }}"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-compte"></use></svg>{{ s.account_label }}</a>{%- endif -%}
      <a class="cvn-menu__tool" href="{{ routes.cart_url }}"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-sac"></use></svg>{{ s.cart_label }}</a>
      {%- if s.cta_label != blank -%}<a class="cvn-btn cvn-btn--gold" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a>{%- endif -%}
    </div>
  </div>
</header>

{% stylesheet %}
/*COVEN_CSS*/
{% endstylesheet %}

{% schema %}
{
  "name": "Coven — en-tête",
  "class": "cvn-section cvn-section--header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo (fichier original du client)" },
    { "type": "text", "id": "logo_asset", "label": "Logo (fichier du thème)", "default": "coven-logo.jpg" },
    { "type": "text", "id": "logo_alt", "label": "Texte alternatif du logo", "default": "Le Coven des Charmes" },
    { "type": "range", "id": "logo_zoom", "label": "Cadrage du logo dans le médaillon", "min": 100, "max": 140, "step": 1, "unit": "%", "default": 118, "info": "Agrandit l'image dans le cercle sans modifier le dessin du logo." },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu_left", "label": "Liens à gauche du logo", "default": "coven-gauche" },
    { "type": "link_list", "id": "menu_left_compact", "label": "Liens à gauche, version courte (avec étoile)", "default": "coven-gauche-court" },
    { "type": "text", "id": "compact_on", "label": "Pages à la version courte avec étoile", "default": "le-tirage, le-coven, creations, faq, cart, commande, confirmation, compte, contact, informations, 404", "info": "Identifiants des pages ou gabarits (cart, 404), séparés par des virgules." },
    { "type": "link_list", "id": "menu_right", "label": "Liens à droite du logo", "default": "coven-droite" },
    { "type": "link_list", "id": "menu_mobile", "label": "Menu sur téléphone", "default": "coven-mobile" },
    { "type": "range", "id": "mobile_logo", "label": "Taille du logo sur téléphone", "min": 60, "max": 200, "step": 2, "unit": "px", "default": 78 },
    { "type": "textarea", "id": "mobile_logo_sizes", "label": "Taille du logo sur téléphone selon la page (page:taille)", "default": "" },
    { "type": "range", "id": "mobile_bar", "label": "Hauteur de la barre sur téléphone", "min": 30, "max": 100, "step": 1, "unit": "px", "default": 34 },
    { "type": "textarea", "id": "mobile_bar_heights", "label": "Hauteur de la barre sur téléphone selon la page (page:hauteur)", "default": "" },
    { "type": "checkbox", "id": "show_account", "label": "Afficher le lien Compte", "default": true },
    { "type": "url", "id": "account_link", "label": "Lien du compte (facultatif)" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Commander" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "select", "id": "commerce_mode", "label": "Panier et commande", "default": "simulation", "options": [
      { "value": "simulation", "label": "Simulation (aucune commande ni paiement)" },
      { "value": "shopify", "label": "Panier Shopify réel (une fois le tarif renseigné)" }
    ], "info": "L'aperçu du studio reste toujours en simulation. Sans tarif confirmé, la commande reste fermée." },
    { "type": "checkbox", "id": "mobile_overlay", "label": "Téléphone : en-tête posé sur la première photo", "default": true },
    { "type": "header", "content": "Textes d'accessibilité" },
    { "type": "text", "id": "menu_label", "label": "Menu", "default": "Menu" },
    { "type": "text", "id": "close_label", "label": "Fermer le menu", "default": "Fermer le menu" },
    { "type": "text", "id": "home_label", "label": "Accueil", "default": "Accueil" },
    { "type": "text", "id": "nav_label_left", "label": "Navigation (gauche)", "default": "Navigation principale" },
    { "type": "text", "id": "nav_label_right", "label": "Navigation (droite)", "default": "Navigation secondaire" },
    { "type": "text", "id": "account_label", "label": "Compte", "default": "Mon compte" },
    { "type": "text", "id": "cart_label", "label": "Panier", "default": "Panier" },
    { "type": "header", "content": "Couleurs du Coven" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#0a090d" },
    { "type": "color", "id": "color_panel", "label": "Panneaux", "default": "#0e0c11" },
    { "type": "color", "id": "color_gold", "label": "Or", "default": "#e2b765" },
    { "type": "color", "id": "color_line", "label": "Filets dorés", "default": "#8c6a3a" },
    { "type": "color", "id": "color_title", "label": "Titres", "default": "#f4e4c3" },
    { "type": "color", "id": "color_text", "label": "Textes", "default": "#ece4d6" },
    { "type": "color", "id": "color_parchment", "label": "Parchemin", "default": "#ecd3ad" },
    { "type": "color", "id": "color_violet", "label": "Violet", "default": "#3a1c48" },
    { "type": "header", "content": "Fichiers du site" },
    { "type": "text", "id": "icons_asset", "label": "Icônes (fichier SVG du thème)", "default": "coven-icones.svg" },
    { "type": "text", "id": "font_regular", "label": "Police des textes (fichier)", "default": "coven-eb-garamond-400.ttf" },
    { "type": "text", "id": "font_medium", "label": "Police des titres (fichier)", "default": "coven-eb-garamond-500.ttf" },
    { "type": "text", "id": "font_semibold", "label": "Police grasse (fichier)", "default": "coven-eb-garamond-600.ttf" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
