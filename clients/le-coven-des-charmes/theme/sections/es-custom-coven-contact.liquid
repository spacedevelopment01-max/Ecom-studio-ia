{%- comment -%}
  Le Coven des Charmes — contact : formulaire (nom, e-mail, objet, message, accord), autres moyens de contact
  « à renseigner » et renvoi vers la FAQ. Sur Shopify, le formulaire est celui de la boutique ; dans l'aperçu, il est
  vérifié puis simulé : aucun message n'est envoyé.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign subjects = s.subjects | newline_to_br | split: '<br />'
-%}
<section class="cvn-contact" data-sim="{{ s.simulated_text | escape }}">
  <div class="cvn-contact__inner cvn-scale">
    <div class="cvn-contact__form cvn-paper">
      <h2 class="cvn-paper__title cvn-only-m">{{ s.form_title }}</h2>
      {%- form 'contact', novalidate: 'novalidate', id: 'CvnContactForm', data-cvn-form: 'contact' -%}
        <div class="cvn-errors" role="alert" tabindex="-1" hidden data-cvn-errors><p>{{ s.errors_title }}</p><ul></ul></div>
        {%- if form.posted_successfully? -%}<p class="cvn-form-status is-ok" role="status">{{ s.sent_text }}</p>{%- endif -%}
        <div class="cvn-field"><label class="cvn-field__label" for="CvnCName">{{ s.name_label }} <span aria-hidden="true">*</span></label><input class="cvn-input" id="CvnCName" name="contact[name]" autocomplete="name" placeholder="{{ s.name_placeholder }}" required data-cvn-msg="{{ s.required_error }}"><p class="cvn-field__error" hidden></p></div>
        <div class="cvn-field"><label class="cvn-field__label" for="CvnCEmail">{{ s.email_label }} <span aria-hidden="true">*</span></label><input class="cvn-input" id="CvnCEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ s.email_placeholder }}" required data-cvn-msg="{{ s.email_error }}"><p class="cvn-field__error" hidden></p></div>
        <div class="cvn-field"><label class="cvn-field__label" for="CvnCSubject">{{ s.subject_label }} <span aria-hidden="true">*</span></label>
          <div class="cvn-select cvn-select--light"><select id="CvnCSubject" name="contact[subject]" required data-cvn-msg="{{ s.subject_error }}">
            <option value="">{{ s.subject_placeholder }}</option>
            {%- for o in subjects -%}{%- assign oo = o | strip -%}{%- if oo != '' -%}<option value="{{ oo | escape }}">{{ oo }}</option>{%- endif -%}{%- endfor -%}
          </select><svg class="cvn-icon" aria-hidden="true"><use href="#coven-chevron-bas"></use></svg></div><p class="cvn-field__error" hidden></p></div>
        <div class="cvn-field"><label class="cvn-field__label" for="CvnCMessage">{{ s.message_label }} <span aria-hidden="true">*</span></label><textarea class="cvn-input cvn-textarea" id="CvnCMessage" name="contact[body]" rows="6" placeholder="{{ s.message_placeholder }}" required minlength="10" data-cvn-msg="{{ s.message_error }}"></textarea><p class="cvn-field__error" hidden></p></div>
        <div class="cvn-field"><label class="cvn-check"><input type="checkbox" name="contact[consent]" value="oui" required data-cvn-msg="{{ s.consent_error }}"><span>{{ s.consent_label }}</span></label><p class="cvn-field__error" hidden></p></div>
        <button type="submit" class="cvn-btn cvn-btn--gold cvn-contact__send" data-cvn-submit><span data-cvn-submit-label>{{ s.send_label }}</span><span data-cvn-submit-busy hidden>{{ s.sending_label }}</span><svg class="cvn-icon cvn-only-m" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg></button>
        <p class="cvn-form-status" role="status" aria-live="polite" data-cvn-status></p>
      {%- endform -%}
    </div>
    <div class="cvn-contact__aside">
      <div class="cvn-contact__ways">
        <h2 class="cvn-contact__ways-title cvn-only-d">{{ s.ways_title }}</h2>
        <p class="cvn-contact__way"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-email"></use></svg><span><strong>{{ s.email_way }}</strong>{% if s.email_value != blank %}<a href="mailto:{{ s.email_value }}">{{ s.email_value }}</a>{% else %}<em>{{ s.todo }}</em>{% endif %}</span></p>
        <p class="cvn-contact__way"><svg class="cvn-icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg><span><strong>{{ s.social_way }}</strong>{% if s.social_value != blank %}<a href="{{ s.social_link }}">{{ s.social_value }}</a>{% else %}<em>{{ s.todo }}</em>{% endif %}</span></p>
      </div>
      <div class="cvn-contact__faq">
        <h2>{{ s.faq_title }}</h2>
        <p>{{ s.faq_text }}</p>
        <a class="cvn-btn cvn-btn--gold" href="{{ s.faq_link }}">{{ s.faq_button }}<svg class="cvn-icon cvn-only-m" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coven — contact",
  "class": "cvn-section cvn-section--contact",
  "settings": [
    { "type": "text", "id": "form_title", "label": "Titre du formulaire (téléphone)", "default": "Écrivez-nous" },
    { "type": "text", "id": "errors_title", "label": "Résumé des erreurs", "default": "Vérifiez les champs suivants :" },
    { "type": "text", "id": "required_error", "label": "Erreur champ obligatoire", "default": "Ce champ est obligatoire." },
    { "type": "text", "id": "name_label", "label": "Nom", "default": "Nom" },
    { "type": "text", "id": "name_placeholder", "label": "Exemple de nom", "default": "Votre nom" },
    { "type": "text", "id": "email_label", "label": "E-mail", "default": "E-mail" },
    { "type": "text", "id": "email_placeholder", "label": "Exemple d'e-mail", "default": "votre@email.com" },
    { "type": "text", "id": "email_error", "label": "Erreur e-mail", "default": "Indiquez une adresse e-mail valide." },
    { "type": "text", "id": "subject_label", "label": "Objet", "default": "Objet" },
    { "type": "text", "id": "subject_placeholder", "label": "Objet par défaut", "default": "À préciser" },
    { "type": "textarea", "id": "subjects", "label": "Objets proposés (un par ligne)", "default": "Ma commande\nLe tirage au scoop\nLa taille du bracelet\nLivraison et retours\nAutre question" },
    { "type": "text", "id": "subject_error", "label": "Erreur objet", "default": "Choisissez l'objet de votre message." },
    { "type": "text", "id": "message_label", "label": "Message", "default": "Message" },
    { "type": "text", "id": "message_placeholder", "label": "Exemple de message", "default": "Votre message…" },
    { "type": "text", "id": "message_error", "label": "Erreur message", "default": "Écrivez votre message (10 caractères au moins)." },
    { "type": "textarea", "id": "consent_label", "label": "Accord", "default": "J'accepte que mes informations soient utilisées pour répondre à ma demande." },
    { "type": "text", "id": "consent_error", "label": "Erreur accord", "default": "Votre accord est nécessaire pour vous répondre." },
    { "type": "text", "id": "send_label", "label": "Bouton", "default": "Envoyer mon message" },
    { "type": "text", "id": "sending_label", "label": "Envoi en cours", "default": "Envoi…" },
    { "type": "textarea", "id": "sent_text", "label": "Message envoyé (boutique)", "default": "Merci, votre message a bien été envoyé." },
    { "type": "textarea", "id": "simulated_text", "label": "Message de l'aperçu", "default": "Aperçu : votre message est prêt, mais rien n'a été envoyé." },
    { "type": "text", "id": "ways_title", "label": "Autres moyens : titre", "default": "Autres moyens de nous contacter" },
    { "type": "text", "id": "email_way", "label": "E-mail : libellé", "default": "E-mail" },
    { "type": "text", "id": "email_value", "label": "E-mail de la boutique", "info": "À renseigner par le client." },
    { "type": "text", "id": "social_way", "label": "Réseaux : libellé", "default": "Réseaux sociaux" },
    { "type": "text", "id": "social_value", "label": "Réseau (nom affiché)" },
    { "type": "url", "id": "social_link", "label": "Réseau (lien)" },
    { "type": "text", "id": "todo", "label": "Mention à renseigner", "default": "À renseigner" },
    { "type": "text", "id": "faq_title", "label": "FAQ : titre", "default": "Questions fréquentes ?" },
    { "type": "textarea", "id": "faq_text", "label": "FAQ : texte", "default": "Retrouvez la réponse aux questions les plus courantes dans notre FAQ." },
    { "type": "text", "id": "faq_button", "label": "FAQ : bouton", "default": "Voir la FAQ" },
    { "type": "url", "id": "faq_link", "label": "FAQ : lien" }
  ]
}
{% endschema %}
