{%- comment -%}
  Le Coven des Charmes — espace client : connexion, inscription, mot de passe oublié, accès aux commandes, au suivi,
  aux adresses et aux informations. Sur la boutique Shopify, les formulaires sont ceux des comptes clients (chaque
  client ne voit que ses propres commandes) ; dans l'aperçu, rien n'est envoyé et aucun compte n'est connecté d'office.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="cvn-account" data-cvn-account data-needs="{{ s.needs_login | escape }}">
  <div class="cvn-account__inner cvn-scale">
    <p class="cvn-demo-banner" role="note" data-cvn-sim-only><svg class="cvn-icon" aria-hidden="true"><use href="#coven-information"></use></svg>{{ s.demo_banner }}</p>
    <div class="cvn-account__forms cvn-paper">
      <div class="cvn-account__tabs cvn-only-m" role="tablist" data-cvn-tabs>
        <button type="button" role="tab" id="CvnTabLogin" aria-controls="CvnLogin" aria-selected="true" data-cvn-tab="connexion">{{ s.login_title }}</button>
        <button type="button" role="tab" id="CvnTabRegister" aria-controls="CvnRegister" aria-selected="false" tabindex="-1" data-cvn-tab="inscription">{{ s.register_tab }}</button>
      </div>
      <div class="cvn-account__panel" id="CvnLogin" role="tabpanel" aria-labelledby="CvnTabLogin">
        <h2 class="cvn-paper__title cvn-only-d">{{ s.login_title }}</h2>
        {%- form 'customer_login', novalidate: 'novalidate', class: 'cvn-account__form', data-cvn-form: 'login' -%}
          <div class="cvn-errors" role="alert" tabindex="-1" hidden data-cvn-errors><p>{{ s.errors_title }}</p><ul></ul></div>
          {%- if form.errors -%}<p class="cvn-field__error">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="cvn-field"><label class="cvn-field__label" for="CvnLoginEmail">{{ s.email_label }} <span aria-hidden="true">*</span></label><input class="cvn-input" id="CvnLoginEmail" type="email" name="customer[email]" autocomplete="email" placeholder="{{ s.email_placeholder }}" required data-cvn-msg="{{ s.email_error }}"><p class="cvn-field__error" hidden></p></div>
          <div class="cvn-field"><label class="cvn-field__label" for="CvnLoginPass">{{ s.password_label }} <span aria-hidden="true">*</span></label>
            <div class="cvn-pass"><input class="cvn-input" id="CvnLoginPass" type="password" name="customer[password]" autocomplete="current-password" required data-cvn-msg="{{ s.password_error }}"><button type="button" class="cvn-pass__toggle" aria-pressed="false" data-cvn-pass><svg class="cvn-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><span class="cvn-sr">{{ s.show_password }}</span></button></div><p class="cvn-field__error" hidden></p></div>
          <button type="button" class="cvn-link" aria-expanded="false" aria-controls="CvnRecover" data-cvn-toggle>{{ s.forgot_label }}</button>
          <button type="submit" class="cvn-btn cvn-btn--gold cvn-account__submit">{{ s.login_button }}<svg class="cvn-icon cvn-only-m" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg></button>
          <p class="cvn-form-status" role="status" aria-live="polite" data-cvn-status></p>
        {%- endform -%}
        <div class="cvn-account__recover" id="CvnRecover" hidden>
          {%- form 'recover_customer_password', novalidate: 'novalidate', data-cvn-form: 'recover' -%}
            <p class="cvn-account__hint">{{ s.recover_text }}</p>
            <div class="cvn-field"><label class="cvn-field__label" for="CvnRecoverEmail">{{ s.email_label }} <span aria-hidden="true">*</span></label><input class="cvn-input" id="CvnRecoverEmail" type="email" name="email" autocomplete="email" required data-cvn-msg="{{ s.email_error }}"><p class="cvn-field__error" hidden></p></div>
            <button type="submit" class="cvn-btn cvn-btn--line cvn-account__submit">{{ s.recover_button }}</button>
            <p class="cvn-form-status" role="status" aria-live="polite" data-cvn-status></p>
          {%- endform -%}
        </div>
        <p class="cvn-account__or cvn-only-m">{{ s.or_label }}</p>
        <button type="button" class="cvn-btn cvn-btn--line cvn-account__switch cvn-only-m" data-cvn-tab-go="inscription">{{ s.register_button }}</button>
      </div>
      <div class="cvn-account__panel cvn-account__panel--register" id="CvnRegister" role="tabpanel" aria-labelledby="CvnTabRegister" data-cvn-desktop-visible hidden>
        <h2 class="cvn-paper__title">{{ s.register_title }}</h2>
        <p class="cvn-account__hint">{{ s.register_text }}</p>
        {%- form 'create_customer', novalidate: 'novalidate', class: 'cvn-account__form cvn-account__form--register', data-cvn-form: 'register' -%}
          <div class="cvn-errors" role="alert" tabindex="-1" hidden data-cvn-errors><p>{{ s.errors_title }}</p><ul></ul></div>
          <div class="cvn-account__regfields" data-cvn-reg-fields>
            <div class="cvn-field"><label class="cvn-field__label" for="CvnRegFirst">{{ s.first_label }}</label><input class="cvn-input" id="CvnRegFirst" name="customer[first_name]" autocomplete="given-name"></div>
            <div class="cvn-field"><label class="cvn-field__label" for="CvnRegEmail">{{ s.email_label }} <span aria-hidden="true">*</span></label><input class="cvn-input" id="CvnRegEmail" type="email" name="customer[email]" autocomplete="email" required data-cvn-msg="{{ s.email_error }}"><p class="cvn-field__error" hidden></p></div>
            <div class="cvn-field"><label class="cvn-field__label" for="CvnRegPass">{{ s.password_label }} <span aria-hidden="true">*</span></label><input class="cvn-input" id="CvnRegPass" type="password" name="customer[password]" autocomplete="new-password" minlength="8" required data-cvn-msg="{{ s.new_password_error }}"><p class="cvn-field__error" hidden></p></div>
          </div>
          <button type="submit" class="cvn-btn cvn-btn--gold cvn-account__submit">{{ s.register_button }}</button>
          <p class="cvn-form-status" role="status" aria-live="polite" data-cvn-status></p>
        {%- endform -%}
      </div>
    </div>
    <div class="cvn-account__cards">
      <h2 class="cvn-account__cards-title cvn-only-m">{{ s.cards_title }}</h2>
      <ul class="cvn-account__list" role="list">
        <li class="cvn-acard"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-cabinet-tiroirs"></use></svg><h3><span class="cvn-only-d">{{ s.orders_title }}</span><span class="cvn-only-m">{{ s.orders_m }}</span></h3><p>{{ s.orders_text }}</p><a class="cvn-btn cvn-btn--gold" href="{{ s.orders_link | default: routes.account_url }}" data-cvn-needs-login>{{ s.orders_button }}</a></li>
        <li class="cvn-acard"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-expedition"></use></svg><h3><span class="cvn-only-d">{{ s.addresses_title }}</span><span class="cvn-only-m">{{ s.addresses_m }}</span></h3><p>{{ s.addresses_text }}</p><a class="cvn-btn cvn-btn--gold" href="{{ s.addresses_link | default: routes.account_addresses_url }}" data-cvn-needs-login>{{ s.addresses_button }}</a></li>
        <li class="cvn-acard"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-compte"></use></svg><h3><span class="cvn-only-d">{{ s.info_title }}</span><span class="cvn-only-m">{{ s.info_m }}</span></h3><p>{{ s.info_text }}</p><a class="cvn-btn cvn-btn--gold" href="{{ s.info_link | default: routes.account_url }}" data-cvn-needs-login>{{ s.info_button }}</a></li>
      </ul>
      <p class="cvn-form-status cvn-account__needs" role="status" aria-live="polite" data-cvn-needs-status></p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coven — compte",
  "class": "cvn-section cvn-section--account",
  "settings": [
    { "type": "textarea", "id": "demo_banner", "label": "Bandeau de l'aperçu", "default": "Aperçu de l'espace client : aucun compte n'est connecté et aucun formulaire n'est envoyé." },
    { "type": "text", "id": "errors_title", "label": "Résumé des erreurs", "default": "Vérifiez les champs suivants :" },
    { "type": "text", "id": "login_title", "label": "Connexion", "default": "Connexion" },
    { "type": "text", "id": "register_tab", "label": "Onglet inscription", "default": "Inscription" },
    { "type": "text", "id": "email_label", "label": "E-mail", "default": "E-mail" },
    { "type": "text", "id": "email_placeholder", "label": "Exemple d'e-mail", "default": "votre@email.com" },
    { "type": "text", "id": "email_error", "label": "Erreur e-mail", "default": "Indiquez une adresse e-mail valide." },
    { "type": "text", "id": "password_label", "label": "Mot de passe", "default": "Mot de passe" },
    { "type": "text", "id": "password_error", "label": "Erreur mot de passe", "default": "Indiquez votre mot de passe." },
    { "type": "text", "id": "new_password_error", "label": "Erreur nouveau mot de passe", "default": "Choisissez un mot de passe d'au moins 8 caractères." },
    { "type": "text", "id": "show_password", "label": "Afficher le mot de passe", "default": "Afficher le mot de passe" },
    { "type": "text", "id": "forgot_label", "label": "Mot de passe oublié", "default": "Mot de passe oublié ?" },
    { "type": "text", "id": "login_button", "label": "Bouton de connexion", "default": "Me connecter" },
    { "type": "textarea", "id": "recover_text", "label": "Récupération : texte", "default": "Indiquez votre e-mail : vous recevrez un lien pour choisir un nouveau mot de passe." },
    { "type": "text", "id": "recover_button", "label": "Récupération : bouton", "default": "Recevoir le lien" },
    { "type": "text", "id": "or_label", "label": "Séparateur", "default": "ou" },
    { "type": "text", "id": "register_title", "label": "Inscription : titre", "default": "Pas encore de compte ?" },
    { "type": "textarea", "id": "register_text", "label": "Inscription : texte", "default": "Créez votre compte pour suivre vos commandes et retrouver votre univers." },
    { "type": "text", "id": "first_label", "label": "Prénom", "default": "Prénom" },
    { "type": "text", "id": "register_button", "label": "Inscription : bouton", "default": "Créer mon compte" },
    { "type": "text", "id": "cards_title", "label": "Titre des accès (téléphone)", "default": "Votre parcours au Coven" },
    { "type": "text", "id": "orders_title", "label": "Commandes : titre", "default": "Mes commandes" },
    { "type": "text", "id": "orders_m", "label": "Commandes : titre court", "default": "Suivre vos commandes" },
    { "type": "textarea", "id": "orders_text", "label": "Commandes : texte", "default": "Suivez l'état de vos commandes de bracelets de charms." },
    { "type": "text", "id": "orders_button", "label": "Commandes : bouton", "default": "Voir mes commandes" },
    { "type": "url", "id": "orders_link", "label": "Commandes : lien" },
    { "type": "text", "id": "addresses_title", "label": "Adresses : titre", "default": "Mes adresses" },
    { "type": "text", "id": "addresses_m", "label": "Adresses : titre court", "default": "Gérer vos adresses" },
    { "type": "textarea", "id": "addresses_text", "label": "Adresses : texte", "default": "Gérez vos adresses de livraison." },
    { "type": "text", "id": "addresses_button", "label": "Adresses : bouton", "default": "Gérer mes adresses" },
    { "type": "url", "id": "addresses_link", "label": "Adresses : lien" },
    { "type": "text", "id": "info_title", "label": "Informations : titre", "default": "Mes informations" },
    { "type": "text", "id": "info_m", "label": "Informations : titre court", "default": "Modifier vos informations" },
    { "type": "textarea", "id": "info_text", "label": "Informations : texte", "default": "Mettez à jour vos informations de compte." },
    { "type": "text", "id": "info_button", "label": "Informations : bouton", "default": "Modifier mes informations" },
    { "type": "url", "id": "info_link", "label": "Informations : lien" },
    { "type": "text", "id": "needs_login", "label": "Message sans connexion", "default": "Connectez-vous pour accéder à cet espace : seules vos propres commandes y apparaissent." }
  ]
}
{% endschema %}
