{%- comment -%}
  Le Coven des Charmes — le parcours du bracelet, étape par étape : commande, tirage au scoop, réunion des charms,
  assemblage (et expédition). Le tirage est physique et a lieu après la commande ; cette section l'explique, elle ne
  tire rien. Compositions des planches : bandeau à quatre étapes et photo (accueil), trois photos fléchées (produit),
  quatre cartes (tirage), parcours d'icônes (panier, commande) ; sur téléphone : liste à photos, vignettes, liste à icônes.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign aside = ''
  if s.aside_image != blank
    assign aside = s.aside_image | image_url: width: 1400
  elsif s.aside_asset != blank
    assign aside = s.aside_asset | asset_url
  endif
-%}
{%- capture orn -%}<svg class="cvn-orn-svg" viewBox="0 0 48 48" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M3 45V12C3 7 7 3 12 3h33"/><path d="M8 40V15c0-4 3-7 7-7h25"/><path d="M14 14c4-6 12-6 14 0-6-2-10 0-14 0zM14 14c-6 4-6 12 0 14-2-6 0-10 0-14z"/><circle cx="14" cy="14" r="2.2" fill="currentColor"/></g></svg>{%- endcapture -%}
<section class="cvn-steps{% if s.hide_heading_mobile %} cvn-steps--m-nohead{% endif %} cvn-steps--{{ s.layout }} cvn-steps--m-{{ s.mobile_layout }}{% if s.framed %} cvn-steps--framed{% endif %}" style="--pad-t: {{ s.padding_top }}px; --pad-b: {{ s.padding_bottom }}px; --mpad-t: {{ s.mobile_padding_top }}px; --mpad-b: {{ s.mobile_padding_bottom }}px; --afx: {{ s.aside_focus_x }}%; --afy: {{ s.aside_focus_y }}%; --az: {{ s.aside_zoom | divided_by: 100.0 }}; --aside-l: {{ s.aside_left }}px;">
  <div class="cvn-steps__inner cvn-scale">
    {%- if s.framed -%}<span class="cvn-orn cvn-orn--tl">{{ orn }}</span><span class="cvn-orn cvn-orn--tr">{{ orn }}</span><span class="cvn-orn cvn-orn--bl">{{ orn }}</span><span class="cvn-orn cvn-orn--br">{{ orn }}</span>{%- endif -%}
    {%- if aside != blank -%}<div class="cvn-steps__aside" aria-hidden="true"><img src="{{ aside }}" alt="" loading="lazy" width="1200" height="800"></div>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="cvn-steps__heading{% if s.heading_style == 'caps' %} cvn-steps__heading--caps{% endif %}">{%- if s.heading_style == 'caps' -%}<svg class="cvn-star4" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0l1.6 10.4L24 12l-10.4 1.6L12 24l-1.6-10.4L0 12l10.4-1.6z"/></svg>{%- endif -%}{{ s.heading }}{%- if s.heading_style == 'caps' -%}<svg class="cvn-star4" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0l1.6 10.4L24 12l-10.4 1.6L12 24l-1.6-10.4L0 12l10.4-1.6z"/></svg>{%- endif -%}</h2>{%- endif -%}
    {%- if s.mobile_heading != blank -%}<p class="cvn-steps__heading cvn-steps__heading--m" aria-hidden="true">{{ s.mobile_heading }}</p>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="cvn-steps__sub">{{ s.subheading }}</p>{%- endif -%}
    <ol class="cvn-steps__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign src = ''
          if b.image != blank
            assign src = b.image | image_url: width: 900
          elsif b.image_asset != blank
            assign src = b.image_asset | asset_url
          endif
        -%}
        <li class="cvn-step{% if b.mobile_image_asset != blank %} cvn-step--mimg{% endif %}{% if b.desktop_hidden %} cvn-only-m{% endif %}{% if b.mobile_hidden %} cvn-only-d{% endif %}" {{ block.shopify_attributes }} style="--fx: {{ b.focus_x }}%; --fy: {{ b.focus_y }}%; --z: {{ b.zoom | divided_by: 100.0 }};">
          <span class="cvn-step__num" aria-hidden="true">{{ forloop.index }}</span>
          {%- if src != blank -%}
            <span class="cvn-step__media"><picture>{%- if b.mobile_image_asset != blank -%}<source media="(max-width: 1023px)" srcset="{{ b.mobile_image_asset | asset_url }}">{%- endif -%}<img src="{{ src }}" alt="{{ b.image_alt | escape }}" loading="lazy" width="600" height="400"></picture></span>
          {%- elsif b.icon != 'none' -%}
            <span class="cvn-step__media cvn-step__media--icon"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ b.icon }}"></use></svg></span>
          {%- endif -%}
          {%- if b.icon != 'none' and src != blank -%}<span class="cvn-step__badge"><svg class="cvn-icon" aria-hidden="true"><use href="#coven-{{ b.icon }}"></use></svg></span>{%- endif -%}
          <span class="cvn-step__body">
            <span class="cvn-step__title">{{ b.title | newline_to_br }}</span>
            {%- if b.mobile_title != blank -%}<span class="cvn-step__title cvn-step__title--m" aria-hidden="true">{{ b.mobile_title | newline_to_br }}</span>{%- endif -%}
            {%- if b.text != blank -%}<span class="cvn-step__text">{{ b.text | newline_to_br }}</span>{%- endif -%}
            {%- if b.mobile_text != blank -%}<span class="cvn-step__text cvn-step__text--m">{{ b.mobile_text | newline_to_br }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.footnote != blank -%}<p class="cvn-steps__foot">{{ s.footnote | newline_to_br }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coven — étapes",
  "class": "cvn-section cvn-section--steps",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition sur ordinateur", "default": "band", "options": [
      { "value": "band", "label": "Bandeau : quatre étapes et photo (accueil)" },
      { "value": "photos", "label": "Photos fléchées et légendes (produit)" },
      { "value": "cards", "label": "Cartes numérotées (tirage)" },
      { "value": "path", "label": "Parcours d'icônes (panier, commande)" },
      { "value": "list", "label": "Liste verticale" }
    ] },
    { "type": "select", "id": "mobile_layout", "label": "Composition sur téléphone", "default": "photos", "options": [
      { "value": "photos", "label": "Liste numérotée avec photos (accueil)" },
      { "value": "thumbs", "label": "Quatre vignettes numérotées (produit)" },
      { "value": "icons", "label": "Liste numérotée avec icônes (tirage)" },
      { "value": "path", "label": "Parcours d'icônes" }
    ] },
    { "type": "checkbox", "id": "framed", "label": "Cadre doré à ornements", "default": true },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "text", "id": "mobile_heading", "label": "Titre sur téléphone (facultatif)" },
    { "type": "select", "id": "heading_style", "label": "Style du titre", "default": "title", "options": [
      { "value": "title", "label": "Titre" },
      { "value": "caps", "label": "Capitales espacées entre étoiles" }
    ] },
    { "type": "checkbox", "id": "hide_heading_mobile", "label": "Masquer le titre sur téléphone", "default": false },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "textarea", "id": "footnote", "label": "Phrase de conclusion" },
    { "type": "image_picker", "id": "aside_image", "label": "Photo d'accompagnement (bandeau)" },
    { "type": "text", "id": "aside_asset", "label": "Photo d'accompagnement (fichier du thème)" },
    { "type": "range", "id": "aside_focus_x", "label": "Cadrage horizontal de la photo", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "aside_focus_y", "label": "Cadrage vertical de la photo", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "aside_zoom", "label": "Zoom de la photo", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "aside_left", "label": "Début de la photo (bandeau, ordinateur)", "min": 600, "max": 1300, "step": 10, "unit": "px", "default": 690 },
    { "type": "range", "id": "padding_top", "label": "Marge haute (ordinateur)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse (ordinateur)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_padding_top", "label": "Marge haute (téléphone)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Marge basse (téléphone)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 14 }
  ],
  "blocks": [
    { "type": "step", "name": "Étape", "settings": [
      { "type": "textarea", "id": "title", "label": "Titre" },
      { "type": "textarea", "id": "mobile_title", "label": "Titre sur téléphone (facultatif)" },
      { "type": "textarea", "id": "text", "label": "Texte" },
      { "type": "textarea", "id": "mobile_text", "label": "Texte sur téléphone (facultatif)" },
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_asset", "label": "Photo (fichier du thème)" },
      { "type": "text", "id": "image_alt", "label": "Description de la photo" },
      { "type": "text", "id": "mobile_image_asset", "label": "Photo sur téléphone (fichier du thème, facultatif)" },
      { "type": "range", "id": "focus_x", "label": "Cadrage horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "focus_y", "label": "Cadrage vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
      { "type": "range", "id": "zoom", "label": "Zoom", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 100 },
      { "type": "select", "id": "icon", "label": "Icône", "default": "none", "options": [
        { "value": "none", "label": "Aucune" }, { "value": "panier", "label": "Panier" }, { "value": "sac", "label": "Sac" }, { "value": "scoop", "label": "Scoop" },
        { "value": "coupelle", "label": "Coupelle" }, { "value": "symboles-tires", "label": "Symboles tirés" }, { "value": "cabinet-tiroirs", "label": "Tiroirs" },
        { "value": "assemblage", "label": "Assemblage" }, { "value": "bracelet", "label": "Bracelet" }, { "value": "expedition", "label": "Expédition" },
        { "value": "validation", "label": "Validation" }, { "value": "charms-etoile", "label": "Charms" },
        { "value": "colis", "label": "Colis" }, { "value": "etoile-8", "label": "Étoile à huit branches" }
      ] },
      { "type": "checkbox", "id": "desktop_hidden", "label": "Masquer sur ordinateur", "default": false },
      { "type": "checkbox", "id": "mobile_hidden", "label": "Masquer sur téléphone", "default": false }
    ] }
  ],
  "presets": [{ "name": "Coven — étapes" }]
}
{% endschema %}
