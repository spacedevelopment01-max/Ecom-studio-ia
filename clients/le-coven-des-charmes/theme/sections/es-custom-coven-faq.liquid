{%- comment -%}
  Le Coven des Charmes — questions fréquentes : rubriques (raccourcis vers chaque groupe de questions), accordéons,
  carte « Une autre question ? ». Les réponses que la boutique n'a pas encore fournies restent « à compléter ».
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="cvn-faq">
  <div class="cvn-faq__inner cvn-scale">
    {%- if s.cat_1 != blank -%}
      <nav class="cvn-faq__cats" aria-label="{{ s.cats_label }}" data-cvn-faq-cats>
        {%- for i in (1..4) -%}
          {%- capture key -%}cat_{{ i }}{%- endcapture -%}
          {%- if s[key] != blank -%}<a href="#CvnFaqCat{{ i }}" data-cvn-faq-cat="{{ i }}"{% if i == 1 %} aria-current="true"{% endif %}>{{ s[key] }}</a>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
    <div class="cvn-acc cvn-faq__list" data-cvn-acc data-cvn-acc-single>
      {%- assign seen = '' -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- capture cat_key -%},{{ b.category }},{%- endcapture -%}
        <div class="cvn-acc__item cvn-faq__item{% if b.desktop_hidden %} cvn-only-m{% endif %}{% if b.mobile_hidden %} cvn-only-d{% endif %}{% if forloop.first %} is-open{% endif %}" data-cvn-acc-item{% unless seen contains cat_key %} id="CvnFaqCat{{ b.category }}"{% endunless %} data-cvn-faq-group="{{ b.category }}" {{ block.shopify_attributes }}>
          {%- assign seen = seen | append: cat_key -%}
          <h3 class="cvn-acc__head">
            <button type="button" class="cvn-acc__btn" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="CvnFaq-{{ block.id }}" data-cvn-acc-btn>
              <span class="cvn-faq__sign" aria-hidden="true"></span>
              <span class="cvn-acc__title">{{ b.question }}</span>
              <svg class="cvn-icon cvn-acc__chev" aria-hidden="true"><use href="#coven-chevron-bas"></use></svg><svg class="cvn-icon cvn-faq__plus" aria-hidden="true"><use href="#coven-plus"></use></svg>
            </button>
          </h3>
          <div class="cvn-acc__panel" id="CvnFaq-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>{{ b.answer | default: s.todo_answer }}</div>
        </div>
      {%- endfor -%}
    </div>
    <div class="cvn-faq__more">
      <svg class="cvn-faq__moon cvn-only-d" viewBox="0 0 40 40" aria-hidden="true"><path fill="currentColor" d="M26 4a17 17 0 1 0 8 29A15 15 0 0 1 26 4z"/></svg>
      <svg class="cvn-icon cvn-faq__mail cvn-only-m" aria-hidden="true"><use href="#coven-email"></use></svg>
      <div class="cvn-faq__more-text"><h2>{{ s.more_title }}</h2><p>{{ s.more_text | newline_to_br }}</p></div>
      <a class="cvn-btn cvn-btn--gold" href="{{ s.more_link }}">{{ s.more_button }}<svg class="cvn-icon cvn-only-m" aria-hidden="true"><use href="#coven-fleche-droite"></use></svg></a>
      {%- if s.more_image_asset != blank -%}<img class="cvn-faq__more-img cvn-only-d" src="{{ s.more_image_asset | asset_url }}" alt="" loading="lazy" width="400" height="200">{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coven — questions",
  "class": "cvn-section cvn-section--faq",
  "settings": [
    { "type": "text", "id": "cats_label", "label": "Nom des rubriques", "default": "Rubriques des questions" },
    { "type": "text", "id": "cat_1", "label": "Rubrique 1", "default": "Le tirage au scoop" },
    { "type": "text", "id": "cat_2", "label": "Rubrique 2", "default": "Le bracelet" },
    { "type": "text", "id": "cat_3", "label": "Rubrique 3", "default": "La commande" },
    { "type": "text", "id": "cat_4", "label": "Rubrique 4", "default": "Livraison & retours" },
    { "type": "richtext", "id": "todo_answer", "label": "Réponse non fournie", "default": "<p>Réponse à compléter par la boutique.</p>" },
    { "type": "text", "id": "more_title", "label": "Carte : titre", "default": "Une autre question ?" },
    { "type": "textarea", "id": "more_text", "label": "Carte : texte", "default": "Nous sommes là pour vous répondre.\nN'hésitez pas à nous contacter via notre formulaire." },
    { "type": "text", "id": "more_button", "label": "Carte : bouton", "default": "Nous contacter" },
    { "type": "url", "id": "more_link", "label": "Carte : lien" },
    { "type": "text", "id": "more_image_asset", "label": "Carte : décor (fichier du thème)" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Réponse (vide : « à compléter »)" },
      { "type": "select", "id": "category", "label": "Rubrique", "default": "1", "options": [{ "value": "1", "label": "Rubrique 1" }, { "value": "2", "label": "Rubrique 2" }, { "value": "3", "label": "Rubrique 3" }, { "value": "4", "label": "Rubrique 4" }] },
      { "type": "checkbox", "id": "desktop_hidden", "label": "Masquer sur ordinateur", "default": false },
      { "type": "checkbox", "id": "mobile_hidden", "label": "Masquer sur téléphone", "default": false }
    ] }
  ]
}
{% endschema %}
